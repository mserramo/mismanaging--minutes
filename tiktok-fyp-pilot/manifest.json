{
  "manifest_version": 3,
  "name": "TikTok FYP Research Pilot",
  "version": "0.5.4",
  "key": "",
  "description": "Runs covered-harvest and natural-browsing TikTok FYP research sessions for allowlisted Qualtrics surveys.",
  "minimum_chrome_version": "111",
  "incognito": "not_allowed",
  "permissions": [
    "alarms",
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://www.tiktok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TikTok FYP Research Pilot",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "externally_connectable": {
    "matches": [
      "https://stanforduniversity.qualtrics.com/*"
    ]
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; connect-src 'none'; frame-src https://www.tiktok.com;"
  }
}
