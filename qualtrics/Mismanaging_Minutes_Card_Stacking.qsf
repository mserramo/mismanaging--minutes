    {
      "SurveyID": "SV_07McTW65bCwKmGi",
      "Element": "SO",
      "PrimaryAttribute": "Survey Options",
      "SecondaryAttribute": null,
      "TertiaryAttribute": null,
      "Payload": {
        "BackButton": "false",
        "SaveAndContinue": "false",
        "SurveyProtection": "PublicSurvey",
        "BallotBoxStuffingPrevention": "false",
        "NoIndex": "Yes",
        "SecureResponseFiles": "true",
        "SurveyExpiration": "None",
        "SurveyTermination": "DefaultMessage",
        "Header": "<style>\n.cs-shell {\n    max-width: 760px;\n    margin: 0 auto;\n    line-height: 1.5;\n}\n\n.cs-task {\n    width: min(1120px, 100%);\n    margin: 0 auto;\n    padding: 20px 22px 24px;\n    border: 1px solid #b8c4d4;\n    border-radius: 8px;\n    background: #f6f8fb;\n    box-shadow: inset 0 1px 0 #ffffff;\n}\n\n.cs-status {\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-start;\n    gap: 8px 16px;\n    margin-bottom: 18px;\n    color: #334155;\n    font-weight: 600;\n}\n\n.cs-status span {\n    white-space: nowrap;\n}\n\n.cs-status-left,\n.cs-status-right {\n    display: flex;\n    flex-direction: column;\n    gap: 4px;\n}\n\n.cs-status-left {\n    text-align: left;\n    align-items: flex-start;\n}\n\n.cs-status-right {\n    text-align: right;\n    align-items: flex-end;\n    margin-left: auto;\n}\n\n.cs-cue {\n    min-height: 32px;\n    margin-bottom: 10px;\n    text-align: center;\n    font-size: 20px;\n    font-weight: 800;\n    color: #0f172a;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    gap: 8px;\n    opacity: 0;\n    transform: scale(0.96);\n    transition:\n        opacity 80ms ease,\n        transform 80ms ease;\n}\n\n.cs-cue-visible {\n    opacity: 1;\n    transform: scale(1);\n}\n\n.cs-cue-box {\n    display: block;\n    width: fit-content;\n    max-width: 100%;\n    padding: 2px 12px;\n    border: 2px solid currentColor;\n    border-radius: 6px;\n}\n\n.cs-cue-multiplier {\n    border-color: #0e7490;\n    background: #ecfeff;\n    color: #0e7490;\n    text-shadow: 0 0 18px rgba(6, 182, 212, 0.35);\n}\n\n.cs-cue-points {\n    border-color: #334155;\n    background: #f8fafc;\n    color: #334155;\n    text-shadow: 0 0 14px rgba(100, 116, 139, 0.28);\n}\n\n.cs-cue-main-bonus {\n    border: 2px solid #047857;\n    background: #ecfdf5;\n    color: #047857;\n    text-shadow: 0 0 18px rgba(16, 185, 129, 0.32);\n}\n\n.cs-cue-multiplier-badge {\n    min-width: 52px;\n    border-color: #0e7490;\n    background: #ecfeff;\n    color: #0e7490;\n    font-size: 24px;\n    text-shadow: 0 0 18px rgba(6, 182, 212, 0.42);\n}\n\n.cs-card-row {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));\n    gap: 14px;\n    align-items: stretch;\n}\n\n.cs-card-row-new {\n    animation: cs-new-screen var(--cs-screen-motion-ms, 600ms) ease-out;\n}\n\n.cs-card {\n    min-height: 210px;\n    border: 3px solid var(--card-color);\n    border-radius: 8px;\n    background: #ffffff;\n    color: #0f172a;\n    cursor: pointer;\n    padding: 16px 12px;\n    text-align: center;\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.18);\n    transition:\n        box-shadow var(--cs-screen-motion-ms, 600ms) ease,\n        transform var(--cs-screen-motion-ms, 600ms) ease;\n}\n\n.cs-card:hover,\n.cs-card:focus {\n    outline: 3px solid color-mix(in srgb, var(--card-color) 45%, white);\n    outline-offset: 2px;\n}\n\n.cs-card-selected {\n    box-shadow:\n        0 0 0 5px color-mix(in srgb, var(--card-color) 26%, white),\n        0 14px 24px rgba(15, 23, 42, 0.22);\n    transform: translateY(-3px) scale(1.015);\n}\n\n.cs-card:disabled {\n    cursor: default;\n}\n\n.cs-card-label {\n    color: var(--card-color);\n    font-weight: 700;\n}\n\n.cs-points {\n    font-size: 24px;\n    font-weight: 800;\n}\n\n.cs-multiplier,\n.cs-main-mark {\n    font-size: 14px;\n    font-weight: 650;\n    white-space: nowrap;\n}\n\n.cs-setup,\n.cs-debug {\n    max-width: 980px;\n    margin: 0 auto;\n}\n\n.cs-debug-notice {\n    border: 2px solid #b91c1c;\n    background: #fef2f2;\n    color: #7f1d1d;\n    font-weight: 700;\n    padding: 12px 14px;\n    margin-bottom: 16px;\n}\n\n.cs-debug-panel {\n    border: 1px solid #cbd5e1;\n    background: #f8fafc;\n    padding: 14px;\n    margin-bottom: 18px;\n}\n\n.cs-debug-panel h4 {\n    margin: 0 0 10px;\n}\n\n.cs-setup-note {\n    max-width: 760px;\n    margin: 0 0 14px;\n    color: #475569;\n    font-size: 14px;\n}\n\n.cs-setup-section {\n    border-top: 1px solid #cbd5e1;\n    padding-top: 14px;\n    margin-top: 14px;\n}\n\n.cs-setup-section:first-of-type {\n    margin-top: 0;\n}\n\n.cs-setup-section h5 {\n    margin: 0 0 12px;\n    color: #334155;\n    font-size: 16px;\n    font-weight: 700;\n}\n\n.cs-field-note {\n    max-width: 620px;\n    margin: -4px 0 8px;\n    color: #64748b;\n    font-size: 13px;\n}\n\n.cs-setup-readonly {\n    background: #e2e8f0;\n    color: #64748b;\n    cursor: not-allowed;\n}\n\n.cs-debug-panel dl {\n    display: grid;\n    grid-template-columns: 220px 1fr;\n    gap: 6px 12px;\n    margin: 0;\n}\n\n.cs-debug-panel dt {\n    font-weight: 700;\n}\n\n.cs-debug-panel dd {\n    margin: 0;\n}\n\n.cs-debug-table {\n    width: 100%;\n    border-collapse: collapse;\n    font-size: 14px;\n    margin-bottom: 18px;\n}\n\n.cs-debug-table th,\n.cs-debug-table td {\n    border: 1px solid #cbd5e1;\n    padding: 6px 8px;\n    text-align: left;\n}\n\n.cs-debug-table th {\n    background: #f1f5f9;\n}\n\n.cs-debug-details {\n    border: 1px solid #cbd5e1;\n    margin-bottom: 12px;\n    padding: 10px 12px;\n}\n\n.cs-debug-details summary {\n    cursor: pointer;\n    font-weight: 700;\n}\n\n.cs-debug-details pre {\n    max-height: 260px;\n    overflow: auto;\n    white-space: pre-wrap;\n}\n\n.cs-debug-end {\n    color: #334155;\n    font-weight: 650;\n}\n\n@keyframes cs-new-screen {\n    0% {\n        opacity: 0.68;\n        transform: translateY(8px);\n    }\n\n    100% {\n        opacity: 1;\n        transform: translateY(0);\n    }\n}\n\n@media (min-width: 920px) {\n    .cs-card-row {\n        grid-template-columns: repeat(5, minmax(0, 1fr));\n    }\n}\n\n@media (max-width: 680px) {\n    .cs-status {\n        flex-direction: column;\n    }\n\n    .cs-status-right {\n        align-items: flex-start;\n        margin-left: 0;\n        text-align: left;\n    }\n\n    .cs-card {\n        min-height: 160px;\n    }\n}\n\n/* Qualtrics host-page adjustments, scoped to the Card Stacking survey. */\n.Skin .SkinInner { width: min(1180px, 96vw); max-width: none; }\n.Skin .QuestionOuter { max-width: none; }\n.cs-task { box-sizing: border-box; }\n.csq-field {\n  display: grid;\n  grid-template-columns: minmax(240px, 1fr) minmax(150px, 220px);\n  align-items: center;\n  gap: 10px 24px;\n  margin: 12px 0;\n}\n.csq-checkbox-field { display: block; }\n.csq-label { font-weight: 650; }\n.csq-checkbox-label {\n  position: relative;\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  width: fit-content;\n  cursor: pointer;\n}\n.csq-checkbox {\n  position: absolute !important;\n  width: 1px !important;\n  height: 1px !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  border: 0 !important;\n  opacity: 0 !important;\n  overflow: hidden !important;\n  pointer-events: none !important;\n}\n.csq-checkbox-box {\n  box-sizing: border-box;\n  display: inline-flex !important;\n  flex: 0 0 20px;\n  align-items: center;\n  justify-content: center;\n  width: 20px;\n  height: 20px;\n  border: 2px solid #64748b;\n  border-radius: 4px;\n  background: #fff;\n  color: #fff;\n}\n.csq-checkbox:checked + .csq-checkbox-box {\n  border-color: #0f4c81;\n  background: #0f4c81;\n}\n.csq-checkbox:checked + .csq-checkbox-box::after {\n  content: \"\";\n  width: 5px;\n  height: 10px;\n  margin-top: -2px;\n  border: solid currentColor;\n  border-width: 0 2px 2px 0;\n  transform: rotate(45deg);\n}\n.csq-checkbox:focus + .csq-checkbox-box,\n.csq-checkbox:focus-visible + .csq-checkbox-box {\n  outline: 3px solid rgba(15, 76, 129, 0.28);\n  outline-offset: 2px;\n}\n.csq-checkbox:disabled + .csq-checkbox-box {\n  border-color: #9ca3af;\n  background: #e5e7eb;\n}\n.csq-input {\n  box-sizing: border-box;\n  width: 100%;\n  min-height: 42px;\n  padding: 8px 10px;\n  border: 1px solid #9ca3af;\n  border-radius: 6px;\n  background: #fff;\n  color: #111827;\n  font: inherit;\n}\n.csq-input:disabled { background: #f3f4f6; color: #6b7280; }\n.csq-continue-button {\n  min-height: 44px;\n  margin-top: 16px;\n  padding: 10px 22px;\n  border: 0;\n  border-radius: 6px;\n  background: #0f4c81;\n  color: #fff;\n  cursor: pointer;\n  font: inherit;\n  font-weight: 700;\n}\n.csq-continue-button:hover, .csq-continue-button:focus { background: #0b365b; }\n.csq-validation-errors { color: #991b1b; font-weight: 700; margin-top: 12px; }\n.csq-debug-table-wrap { overflow-x: auto; }\n@media (max-width: 680px) {\n  .csq-field { grid-template-columns: 1fr; gap: 5px; }\n}\n</style>\n<script>\nwindow.CSQ_BOOTSTRAP = {\"cardDeck\":[{\"color\":\"#2563eb\",\"color_id\":\"blue\",\"label\":\"Blue card\"},{\"color\":\"#16a34a\",\"color_id\":\"green\",\"label\":\"Green card\"},{\"color\":\"#f59e0b\",\"color_id\":\"amber\",\"label\":\"Yellow card\"},{\"color\":\"#e11d48\",\"color_id\":\"rose\",\"label\":\"Red card\"},{\"color\":\"#7c3aed\",\"color_id\":\"violet\",\"label\":\"Violet card\"}],\"chunkCount\":64,\"chunkMaxBytes\":18000,\"logColumns\":[\"screen_number\",\"screen_type_index\",\"chosen_card_id\",\"chosen_card_label\",\"chosen_card_position\",\"chosen_is_main\",\"chosen_x\",\"chosen_y\",\"chosen_z\",\"response_time_ms\",\"task_elapsed_ms\",\"main_cards_collected\",\"points_before\",\"card_points_added\",\"multiplier_applied\",\"multiplier_y\",\"multiplier_z\",\"main_bonus_triggered_this_round\",\"main_bonus_points_added\",\"points_after\"],\"maxAnimationMs\":5000,\"maxDecisions\":4800,\"maxDurationMinutes\":40,\"pointsPerMainCard\":30,\"screenTypes\":[{\"side_values\":[{\"x\":5,\"y\":10,\"z\":1},{\"x\":6,\"y\":12,\"z\":2},{\"x\":7,\"y\":14,\"z\":3},{\"x\":8,\"y\":16,\"z\":4}],\"type_index\":1},{\"side_values\":[{\"x\":6,\"y\":11,\"z\":2},{\"x\":7,\"y\":13,\"z\":3},{\"x\":8,\"y\":15,\"z\":4},{\"x\":9,\"y\":17,\"z\":1}],\"type_index\":2},{\"side_values\":[{\"x\":7,\"y\":12,\"z\":3},{\"x\":8,\"y\":14,\"z\":4},{\"x\":9,\"y\":16,\"z\":1},{\"x\":10,\"y\":18,\"z\":2}],\"type_index\":3