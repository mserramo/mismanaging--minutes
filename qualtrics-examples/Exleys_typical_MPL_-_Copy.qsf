tionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"QuestionID":"QID269","QuestionText_Unsafe":"Timing"}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID507","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"Configuration":{"MaxSeconds":"0","MinSeconds":"0","QuestionDescriptionOption":"UseText"},"DataExportTag":"Q1","DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":16,"QuestionDescription":"Timing","QuestionID":"QID507","QuestionText":"Timing","QuestionText_Unsafe":"Timing","QuestionType":"Timing","Selector":"PageTimer","Validation":"None"}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID508","SecondaryAttribute":"Protocol Director: Professor Muriel Niederle Protocol Number: IRB-44866 IRB Approval Date: March...","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[],"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"Q2","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":4,"QuestionDescription":"Protocol Director: Professor Muriel Niederle Protocol Number: IRB-44866 IRB Approval Date: March...","QuestionID":"QID508","QuestionJS":"\/\/ INCREMENT current_page\nQualtrics.SurveyEngine.addOnPageSubmit(function()\n{\t\n\tlet currentPage = parseInt(\"${e:\/\/Field\/current_page}\");\n\n\tcurrentPage = currentPage + 1;\n\tQualtrics.SurveyEngine.setEmbeddedData(\"current_page\", currentPage);\n\tconsole.log(\"current_page\", currentPage);\n});","QuestionText":"<strong>Protocol Director:<\/strong> Professor Muriel Niederle<br \/>\n<br \/>\nProtocol Number: IRB-44866<br \/>\nIRB Approval Date: March 31, 2025 Expiration Date: March 31, 2026<br \/>\n<br \/>\n<strong>Description: <\/strong>You are invited to participate in a research study on decision- making. You will be asked to read several pages of instructions. Then you will be asked to make several choices that will determine the precise amount you will be paid, and then possibly answer several survey questions.<br \/>\n<br \/>\n<strong>Risk and benefits: <\/strong>We cannot and do not guarantee or promise that you will receive any benefits from this study. There are no risks associated with this study.<br \/>\n<br \/>\n<strong>Time involvement:<\/strong> Your participation in this experiment will take approximately as long as is indicated in the advertisement.<br \/>\n<br \/>\n<strong>Payments: <\/strong>You will be compensated at the advertised rate.<br \/>\n<br \/>\n<strong>Subject&rsquo;s rights:<\/strong> If you have read this form and have decided to participate in this project, please understand your participation is voluntary and you have the right to discontinue participation at any time without penalty or loss of benefits to which you are otherwise entitled. You have the right to refuse to answer particular questions. Your individual privacy will be maintained in all published and written data resulting from the study.<br \/>\n<br \/>\n<strong>Contact information:<\/strong> Questions, concerns, or complaints: If you have any questions, concerns or complaints about this research study, its procedures, risk and benefits, you should ask the Protocol Director, Muriel Niederle, (650)-723-7359. Independent Contact: If you are not satisfied with how this study is being conducted, or if you have any concerns, complaints, or general questions about the research or your rights as a participant, please contact the Stanford Institutional Review Board (IRB) to speak to someone independent of the research team at (650)-723-2480 or toll free at 1-866-680-2906. You can also write to the Stanford IRB, Stanford University, Stanford, CA 94305-5401.<br \/>\n<br \/>\n<strong>By continuing with this study, you are consenting to participate. <\/strong>Please make a copy of this consent form for your own records. You can do so by right-clicking and selecting &ldquo;print&rdquo; in most browsers. If you cannot do so on your browser, please contact the protocol director for a copy of the consent form.\n<p>&nbsp;<\/p>","QuestionText_Unsafe":"<strong>Protocol Director:<\/strong> Professor Muriel Niederle<br \/>\n<br \/>\nProtocol Number: IRB-44866<br \/>\nIRB Approval Date: March 31, 2025 Expiration Date: March 31, 2026<br \/>\n<br \/>\n<strong>Description: <\/strong>You are invited to participate in a research study on decision- making. You will be asked to read several pages of instructions. Then you will be asked to make several choices that will determine the precise amount you will be paid, and then possibly answer several survey questions.<br \/>\n<br \/>\n<strong>Risk and benefits: <\/strong>We cannot and do not guarantee or promise that you will receive any benefits from this study. There are no risks associated with this study.<br \/>\n<br \/>\n<strong>Time involvement:<\/strong> Your participation in this experiment will take approximately as long as is indicated in the advertisement.<br \/>\n<br \/>\n<strong>Payments: <\/strong>You will be compensated at the advertised rate.<br \/>\n<br \/>\n<strong>Subject&rsquo;s rights:<\/strong> If you have read this form and have decided to participate in this project, please understand your participation is voluntary and you have the right to discontinue participation at any time without penalty or loss of benefits to which you are otherwise entitled. You have the right to refuse to answer particular questions. Your individual privacy will be maintained in all published and written data resulting from the study.<br \/>\n<br \/>\n<strong>Contact information:<\/strong> Questions, concerns, or complaints: If you have any questions, concerns or complaints about this research study, its procedures, risk and benefits, you should ask the Protocol Director, Muriel Niederle, (650)-723-7359. Independent Contact: If you are not satisfied with how this study is being conducted, or if you have any concerns, complaints, or general questions about the research or your rights as a participant, please contact the Stanford Institutional Review Board (IRB) to speak to someone independent of the research team at (650)-723-2480 or toll free at 1-866-680-2906. You can also write to the Stanford IRB, Stanford University, Stanford, CA 94305-5401.<br \/>\n<br \/>\n<strong>By continuing with this study, you are consenting to participate. <\/strong>Please make a copy of this consent form for your own records. You can do so by right-clicking and selecting &ldquo;print&rdquo; in most browsers. If you cannot do so on your browser, please contact the protocol director for a copy of the consent form.\n<p>&nbsp;<\/p>","QuestionType":"DB","Selector":"TB","Validation":{"Settings":{"Type":"None"}}}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID509","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"Configuration":{"MaxSeconds":"0","MinSeconds":"0","QuestionDescriptionOption":"UseText"},"DataExportTag":"Q33","DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":16,"QuestionDescription":"Timing","QuestionID":"QID509","QuestionText":"Timing","QuestionText_Unsafe":"Timing","QuestionType":"Timing","Selector":"PageTimer","Validation":"None"}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID510","SecondaryAttribute":"Please copy and paste your Prolific ID here: Please note that this response should auto-fill with...","TertiaryAttribute":null,"Payload":{"Co