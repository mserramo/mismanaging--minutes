amount of money as a bonus payment.<\/span> Is <span class=\"OpDesc\">Selected<\/span> ","LeftOperand":"q:\/\/QID1720918530\/SelectableChoice\/2","LogicType":"Question","Operator":"Selected","QuestionID":"QID1720918530","QuestionIDFromLocator":"QID1720918530","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"Error Text","libraryID":"URH_8ANTtuI8sFaoioc","messageID":"MS_8jf5XKLYcBtRcd6","subMessageID":"VE_ERROR"}},"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation"}}}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID573","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"Configuration":{"MaxSeconds":"0","MinSeconds":"0","QuestionDescriptionOption":"UseText"},"DataExportTag":"Q5.5","DefaultChoices":false,"GradingData":[],"Language":[],"QuestionDescription":"Timing","QuestionID":"QID573","QuestionText":"Timing","QuestionText_Unsafe":"Timing","QuestionType":"Timing","Selector":"PageTimer"}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID574","SecondaryAttribute":"You have successfully completed the previous understanding questions. Please proceed to make your...","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[],"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"Q5.6","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":1,"QuestionDescription":"You have successfully completed the previous understanding questions. Please proceed to make your...","QuestionID":"QID574","QuestionText":"You have successfully completed the previous understanding questions. &nbsp;Please proceed to make your Part 1 decisions.&nbsp;","QuestionText_Unsafe":"You have successfully completed the previous understanding questions. &nbsp;Please proceed to make your Part 1 decisions.&nbsp;","QuestionType":"DB","Selector":"TB","Validation":{"Settings":{"Type":"None"}}}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID58","SecondaryAttribute":"Please indicate which payment option you prefer on each row by clicking on the row where you woul...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div>Please indicate which payment option you prefer on each row by clicking on the row where you would like to switch from choosing the option on the left to choosing the option on the right.<\/div>\n\n<div>&nbsp;<\/div>\n\n<div>\n<div>(Note that you cannot click on the submit button until you have selected an answer.)<\/div>\n<\/div>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function()\n{\n\t\/*Place your JavaScript here to run when the page loads*\/\n\n\n\/\/ disable submit button\nthis.hideNextButton();\n\n\/\/\t this.disableNextButton();\n\n\tvar loop = parseInt(\"${lm:\/\/CurrentLoopNumber}\");\n\t\/\/$j(\".QuestionText\").remove();\n\tvar inputId = \"#\" + String(this.questionId);\n\n\/\/ Using Piped Text to get embedded data fields\n\tvar stake = parseInt(\"${e:\/\/Field\/stake}\");\n\tvar optionA = \"150\"\n\tvar optionAunits = \" cents\";\n\tvar optionBunits = \" cents\";\n\tvar prefix = \"xnorm\";\n\/\/ ============================================================================\n\/\/ TABLE COLUMN HEADERS \n\t$j(inputId).append(\"<table  align='center' class='uncertainty'>\\\n<thead class='uncertaintyhead'>\\\n<tr>\\\n\t<th style='width:12em' class='thtext'> Donation for Make-A-Wish Foundation  <\/th>\\\n\t<th style='width:1em'><\/th>\\\n\t<th style='width:12em' class='thtext'> Bonus Payment for You   <\/th>\\\n<\/tr>\\\n<\/thead>\\\n<tbody class='uncert' id='maintable'>\\\n<tr class='middletd'>\\\n\t<td><\/td>\\\n\t<td><\/td>\\\n\t<td><\/td>\\\n<\/tr>\\\n<\/tbody>\\\n<\/table>\")\n\/\/ ============================================================================\n\/\/ TABLE ROWS \nmultistring = \"\";\nincrement = 5;\nfor (i = 0; i <= stake\/increment; i++) {\n\tvar num = i*increment;\n\tvar n = num.toFixed(0);\n\tmultistring = multistring + \"\\\n<tr class='middletd'> <td style='width:10em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i+1) + \"left' name='\" + (i+1) + \"'>\" + optionA + \" \"+ optionAunits + \"<\/td> <td style='width:10em'>OR<\/td> <td style='width:10em;border-top: 1px solid black;border-bottom: 1px solid black'  class='letters' id='\" + (i+1) + \"right' name='\" + (i+1) + \"'>\" + n + \" \"+ optionBunits +\"<\/td> <\/tr>\";\n}\n\/\/ ============================================================================\n\/\/ SAVE OUTPUT \n\n$j('#maintable').append(multistring)\n\t\t\t\n\nvar choiceThatCounts = -1;\n\/\/save the data\n    var time_start = Date.now() \/ 1000;\n    var times = [];\n    var choices = [];\n    var changed=[];\n\/\/ Up the list count\n\tvar list = \"${e:\/\/Field\/list}\"\n\tvar list =\tparseInt(list);\n\tvar list = list + 1;\n\tQualtrics.SurveyEngine.setEmbeddedData(\"list\", list);\n\t\n\/\/ set var = -1 \nvar choice_now = -1 ; \n\n$j('.letters').click(function() {\n\tid = $j(this).attr('name');\n\tvar time = Date.now() \/ 1000 - time_start;      \n    choice_now = $j(this).attr('id');\n    times.push(time.toFixed(2));\n    choices.push(choice_now);\n       \t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"Time\", times);\n      \t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"Choices\", choices);\n\t\n\tvar id_number = parseInt(id, 10);\n\t$j(\"td[name='\"+id+\"']\").removeClass(\"letters_selected\").addClass(\"letters\");\n\t$j(this ).removeClass(\"letters\").addClass(\"letters_selected\");\t\n            Qualtrics.SurveyEngine.setEmbeddedData(prefix+\"IdFinal\", id_number);\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"ChoiceFinal\", choice_now);\n\tif (choice_now.indexOf(\"left\") >= 0) { \n\t\t\t\tvar norm_lb = (id_number-1)*increment;\n\t\t\t\tvar norm_ub = (id_number)*increment;\n\t\t\t} else {\t\n\t \t\t\tvar norm_lb = (id_number-2)*increment; \n\t \t\t\tvar norm_ub = (id_number-1)*increment; \n\t \t\t};   \n\tif (choice_now==\"21left\") { \n\t\tvar norm_lb = stake;\n\t\tvar norm_ub = stake;\n\t\tvar changed_now =1; \n\t\tchanged.push(changed_now);\n\t};\n\tif (choice_now==\"1right\") { \n\t\tvar norm_lb = 0;\n\t\tvar norm_ub = 0;\n\t\tvar changed_now =2; \n\t\tchanged.push(changed_now);\n\t};\n\tif (norm_lb < increment) { \n\t\tvar norm_lb = 0;\n\t\tvar changed_now =3 ;\n\t\tchanged.push(changed_now);\n\t};\n\tif (norm_lb > stake) { \n\t\tvar norm_lb = stake;\n\t\tvar changed_now =4 ;\n\t\tchanged.push(changed_now);\n\t};\n\tif (norm_ub < increment) { \n\t\tvar norm_ub = 0;\n\t\tvar changed_now =5 ;\n\t\tchanged.push(changed_now);\n\t};\n\tif (norm_ub > stake) { \n\t\tvar norm_ub = stake;\n\t\tvar changed_now =6 ;\n\t\tchanged.push(changed_now);\n\t};\n\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"LB\", norm_lb);\n\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"UB\", norm_ub);\t\t\t\n\tQualtrics.SurveyEngine.setEmbeddedData(prefix+\"Changed\", changed);\t\t\t\n\t\tfor (k = id_number -1; k > 0; k--) {\t\n\t\t\tx = \"#\" + String(k) + \"left\";\n\t\t\ty = \"#\" + String(k) + \"right\";\n\t\t\t$j( x ).removeClass(\"letters\").addClass(\"letters_selected\");\n\t\t\t$j( y ).addClass(\"letters\").removeClass(\"letters_selected\");\n\t\t}\n\t\tfor (k = id_number +1; k < 101; k++) {\n\t\t\tx = \"#\" + String(k) + \"right\";\n\t\t\ty = \"#\" + String(k) + \"left\";\n\t\t\t$j(x).prop(\"checked\", true);\n\t\t\t$j( x ).removeClass(\"letters\").addClass(\"letters_selected\");\n\t\t\t$j( y ).addClass(\"letters\").removeClass(\"letters_selected\");\n\t\t}\n});\n\n$j('table.uncertainty').floatThead({\n\tuseAbsolutePositioning: false\n\t\/\/ absolutePositioning is better for\n\t\/\/ highly dynamic sites\n\t\/\/ (which this is not)\n});\n\n\t\/\/ enable submit button when variable no longer -1 \n this.questionclick = function(event,element)\n     { \t\t \n\t  if (choice_now != -1 ) {this.showNextButton();}\n else   { \tthis.hideNextButton(); }\n \t}\n\n\t\/\/ enable submit button when variable no longer -1 \n\t\/\/this.questionclick = function(event,element)\n\t\/\/    { \t\t \n\t\/\/\t if (choice_now != -1 ) {this.enableNextButton(); }\n\t\/\/  else   { this.disableNextButton();  }\n\t\t\/\/}\n\t\n});","DefaultChoices":false,"DataExportTag":"Q6.2","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please indicate which payment option you prefer on each row by clicking on the row where you woul...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID58","QuestionText_Unsafe":"<div>Please indicate which payment option you prefer on each row by clicking on the row where you would like to switch from choosing the option on the left to choosing the option on the right.<\/div>\n\n<div>&nbsp;<\/div>\n\n<div>\n<div>(Note that you cannot click on the submit button until you have selected an answer.)<\/div>\n<\/div>","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":1,"NextAnswerId":1}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID75","SecondaryAttribute":"Part 1 Instructions: In Part 1, you will have to make several decisions by completing one list. \u00a0..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div style=\"text-align: center;\"><u><strong>Part 1 Instructions:<\/strong><\/u><\/div>\n\n<div><br>\nIn Part 1, you will have to make several decisions by completing one list. &nbsp;Each row of the list will present two payment options.<\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"margin-left: 40px;\">- The payment option on the left will always involve the Make-A-Wish Foundation receiving&nbsp;${e:\/\/Field\/stake} cents as a donation.&nbsp;<\/div>\n\n<div style=\"margin-left: 40px;\"><br>\n- The payment option on the right will involve&nbsp;you receiving some amount of money as a bonus payment.&nbsp;The amount of money will increase from 0 to ${e:\/\/Field\/stake} cents as you proceed down the rows of the list.&nbsp;<\/div>\n\n<div>&nbsp;<br>\nYour task is to decide which payment option you prefer on each row by clicking on the row at which you prefer to switch from choosing the option on the left to the option on the right.<br>\n<br>\nIf Part 1 is randomly selected as the part-that-counts, one row from this list will be randomly selected. &nbsp;The payment option you select on that row would then be distributed. &nbsp;&nbsp;<\/div>","DefaultChoices":false,"DataExportTag":"Q5.2","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Part 1 Instructions: In Part 1, you will have to make several decisions by completing one list. \u00a0...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"QuestionID":"QID75","QuestionText_Unsafe":"<div style=\"text-align: center;\"><u><strong>Part 1 Instructions:<\/strong><\/u><\/div>\n\n<div><br \/>\nIn Part 1, you will have to make several decisions by completing one list. &nbsp;Each row of the list will present two payment options.<\/div>\n\n<div>&nbsp;<\/div>\n\n<div style=\"margin-left: 40px;\">- The payment option on the left will always involve the Make-A-Wish Foundation, which according to CharityNavigator is a charity that strives&nbsp;&quot;to grant the wish of every child diagnosed with a critical illness,&quot;&nbsp;receiving ${e:\/\/Field\/stake} cents as a donation.&nbsp;<\/div>\n\n<div style=\"margin-left: 40px;\"><br \/>\n- The payment option on the right will involve&nbsp;you receiving some amount of money as a bonus payment.&nbsp;The amount of money will increase from 0 to ${e:\/\/Field\/stake} cents as you proceed down the rows of the list.&nbsp;<\/div>\n\n<div>&nbsp;<br \/>\nYour task is to decide which payment option you prefer on each row by clicking on the row at which you prefer to switch from choosing the option on the left to the option on the right.<br \/>\n<br \/>\nIf Part 1 is randomly selected as the part-that-counts, one row from this list will be randomly selected. &nbsp;The payment option you select on that row would then be distributed. &nbsp;&nbsp;<\/div>","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":1,"NextAnswerId":1}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID76","SecondaryAttribute":"Understanding Question: If Part 1 is randomly selected as the part-that-counts and you chose the...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Understanding Question<\/strong>: If Part 1 is randomly selected as the part-that-counts and you chose the option on the left in the randomly selected row, what would happen?&nbsp;<\/p>","DataExportTag":"Q5.3","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Understanding Question: If Part 1 is randomly selected as the part-that-counts and you chose the...","Choices":{"2":{"Display":"Make-A-Wish Foundation would receive ${e:\/\/Field\/stake} cents as a donation."},"3":{"Display":"I would receive some amount of money as a bonus payment."}},"ChoiceOrder":["2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID76\/SelectableChoice\/2","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Understanding Question: If Part 1 is randomly selected as the part-that-count and you chose the option on the left in the randomly selected row, what would happen?&amp;nbsp;<\/span> <span class=\"LeftOpDesc\">The national chapter of MAW Foundation would receive ${e:\/\/Field\/stake} cents as a donation.<\/span> Is <span class=\"OpDesc\">Selected<\/span> ","LeftOperand":"q:\/\/QID76\/SelectableChoice\/2","LogicType":"Question","Operator":"Selected","QuestionID":"QID76","QuestionIDFromLocator":"QID76","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"Error Text","libraryID":"URH_8ANTtuI8sFaoioc","messageID":"MS_8jf5XKLYcBtRcd6","subMessageID":"VE_ERROR"}}}},"Language":[],"QuestionID":"QID76","QuestionText_Unsafe":"<p><strong>Understanding Question<\/strong>: If Part 1 is randomly selected as the part-that-counts and you chose the option on the left in the randomly selected row, what would happen?&nbsp;<\/p>","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID77","SecondaryAttribute":"Understanding Question:\u00a0If Part 1 is randomly selected as the part-that-counts and you chose the...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p><strong>Understanding Question:<\/strong>&nbsp;If Part 1 is randomly selected as the part-that-counts and you chose the option on the right in the randomly selected row, what would happen?&nbsp;<\/p>","DataExportTag":"Q5.4","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Understanding Question:\u00a0If Part 1 is randomly selected as the part-that-counts and you chose the...","Choices":{"1":{"Display":"Make-A-Wish Foundation would receive ${e:\/\/Field\/stake} cents as a donation."},"2":{"Display":"I would receive some amount of money as a bonus payment."}},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID77\/SelectableChoice\/2","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Understanding Question:&amp;nbsp;If Part 1 is randomly selected as the part-that-count and you chose the option on the right in the randomly selected row, what would happen?&amp;nbsp;<\/span> <span class=\"LeftOpDesc\">I would receive some amount of money as a bonus payment.<\/span> Is <span class=\"OpDesc\">Selected<\/span> ","LeftOperand":"q:\/\/QID77\/SelectableChoice\/2","LogicType":"Question","Operator":"Selected","QuestionID":"QID77","QuestionIDFromLocator":"QID77","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"Error Text","libraryID":"URH_8ANTtuI8sFaoioc","messageID":"MS_8jf5XKLYcBtRcd6","subMessageID":"VE_ERROR"}}}},"Language":[],"QuestionID":"QID77","QuestionText_Unsafe":"<p><strong>Understanding Question:<\/strong>&nbsp;If Part 1 is randomly selected as the part-that-counts and you chose the option on the right in the randomly selected row, what would happen?&nbsp;<\/p>","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":3,"NextAnswerId":1}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"STAT","PrimaryAttribute":"Survey Statistics","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"MobileCompatible":true,"ID":"Survey Statistics"}}]}