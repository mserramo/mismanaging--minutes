e:\/\/Field\/correct_T2_5}\")\n\tconst CorrectT26 = parseInt(\"${e:\/\/Field\/correct_T2_6}\")\n\tconst CorrectT27 = parseInt(\"${e:\/\/Field\/correct_T2_7}\")\n\tconst CorrectT28 = parseInt(\"${e:\/\/Field\/correct_T2_8}\")\n\tconst CorrectT29 = parseInt(\"${e:\/\/Field\/correct_T2_9}\")\n\tconst CorrectT210 = parseInt(\"${e:\/\/Field\/correct_T2_10}\")\n\tconst CorrectT211 = parseInt(\"${e:\/\/Field\/correct_T2_11}\")\n\tconst CorrectT212 = parseInt(\"${e:\/\/Field\/correct_T2_12}\")\n\tconst CorrectT213 = parseInt(\"${e:\/\/Field\/correct_T2_13}\")\n\tconst CorrectT214 = parseInt(\"${e:\/\/Field\/correct_T2_14}\")\n\tconst CorrectT215 = parseInt(\"${e:\/\/Field\/correct_T2_15}\")\n\n\tconst CorrectT31 = parseInt(\"${e:\/\/Field\/correct_T3_1}\")\n\tconst CorrectT32 = parseInt(\"${e:\/\/Field\/correct_T3_2}\")\n\tconst CorrectT33 = parseInt(\"${e:\/\/Field\/correct_T3_3}\")\n\tconst CorrectT34 = parseInt(\"${e:\/\/Field\/correct_T3_4}\")\n\tconst CorrectT35 = parseInt(\"${e:\/\/Field\/correct_T3_5}\")\n\tconst CorrectT36 = parseInt(\"${e:\/\/Field\/correct_T3_6}\")\n\tconst CorrectT37 = parseInt(\"${e:\/\/Field\/correct_T3_7}\")\n\tconst CorrectT38 = parseInt(\"${e:\/\/Field\/correct_T3_8}\")\n\tconst CorrectT39 = parseInt(\"${e:\/\/Field\/correct_T3_9}\")\n\tconst CorrectT310 = parseInt(\"${e:\/\/Field\/correct_T3_10}\")\n\tconst CorrectT311 = parseInt(\"${e:\/\/Field\/correct_T3_11}\")\n\tconst CorrectT312 = parseInt(\"${e:\/\/Field\/correct_T3_12}\")\n\tconst CorrectT313 = parseInt(\"${e:\/\/Field\/correct_T3_13}\")\n\tconst CorrectT314 = parseInt(\"${e:\/\/Field\/correct_T3_14}\")\n\tconst CorrectT315 = parseInt(\"${e:\/\/Field\/correct_T3_15}\")\n\t\n\n\tconst score1 = CorrectT11 + CorrectT12 + CorrectT13 + CorrectT14 + CorrectT15 + CorrectT16 + CorrectT17 + CorrectT18 + CorrectT19 + CorrectT110 + CorrectT111 + CorrectT112 + CorrectT113 + CorrectT114 + CorrectT115\n\tQualtrics.SurveyEngine.setEmbeddedData(\"score1\", score1);\n\t\n\tconst score2 = CorrectT21 + CorrectT22 + CorrectT23 + CorrectT24 + CorrectT25 + CorrectT26 + CorrectT27 + CorrectT28 + CorrectT29 + CorrectT210 + CorrectT211 + CorrectT212 + CorrectT213 + CorrectT214 + CorrectT215\n\tQualtrics.SurveyEngine.setEmbeddedData(\"score2\", score2);\n\t\n\tconst score3 = CorrectT31 + CorrectT32 + CorrectT33 + CorrectT34 + CorrectT35 + CorrectT36 + CorrectT37 + CorrectT38 + CorrectT39 + CorrectT310 + CorrectT311 + CorrectT312 + CorrectT313 + CorrectT314 + CorrectT315\n\tQualtrics.SurveyEngine.setEmbeddedData(\"score3\", score3);\n\n\tconst score = score1 + score2 + score3;\n\tQualtrics.SurveyEngine.setEmbeddedData(\"score\", score);\n\n\n});","QuestionText":"<h3>Follow-up (Page 2 of 2)&nbsp;<\/h3>\n\n<p><strong>Please indicate your agreement with the following statements.<\/strong><\/p>","QuestionText_Unsafe":"<h3>Follow-up (Page 2 of 2)&nbsp;<\/h3>\n\n<p><strong>Please indicate your agreement with the following statements.<\/strong><\/p>","QuestionType":"SBS","RecodeValues":{"1":"1"},"Selector":"SBSMatrix","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}}}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID567","SecondaryAttribute":"Please consider both the decisions that YOU made and the decisions that OTHER PARTICIPANTS may ha...","TertiaryAttribute":null,"Payload":{"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"Q83","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":4,"QuestionDescription":"Please consider both the decisions that YOU made and the decisions that OTHER PARTICIPANTS may ha...","QuestionID":"QID567","QuestionText":"<p>Please consider both the decisions that <strong>YOU <\/strong>made and the decisions that <strong>OTHER PARTICIPANTS<\/strong> may have made in this study.<\/p>\n\n<ul>\n\t<li>How would you describe your decisions?&nbsp;<\/li>\n\t<li>What factors and considerations influenced your decisions?<\/li>\n\t<li>How do you think other participants might have approached these decisions?<\/li>\n\t<li>Are there any reasons why others might have made different choices?<\/li>\n<\/ul>\n\n<p>Please write at least 3-4 full sentences.&nbsp;<\/p>","QuestionText_Unsafe":"<p>Please consider both the decisions that <strong>YOU <\/strong>made and the decisions that <strong>OTHER PARTICIPANTS<\/strong> may have made in this study.<\/p>\n\n<ul>\n\t<li>How would you describe your decisions?&nbsp;<\/li>\n\t<li>What factors and considerations influenced your decisions?<\/li>\n\t<li>How do you think other participants might have approached these decisions?<\/li>\n\t<li>Are there any reasons why others might have made different choices?<\/li>\n<\/ul>\n\n<p>Please write at least 3-4 full sentences.&nbsp;<\/p>","QuestionType":"TE","SearchSource":{"AllowFreeResponse":"false"},"Selector":"ML","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","MinChars":"2","Type":"MinChar"}}}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID568","SecondaryAttribute":"Please let us know if anything seemed not to work or was confusing. Thanks!","TertiaryAttribute":null,"Payload":{"Configuration":{"InputHeight":115,"InputWidth":580,"QuestionDescriptionOption":"UseText"},"DataExportTag":"feedback","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":4,"QuestionDescription":"Please let us know if anything seemed not to work or was confusing. Thanks!","QuestionID":"QID568","QuestionJS":"\/* Qualtrics \u2013 count paste actions in THIS textarea without double-counting\n * Put the whole block in Question \u2192 gear icon \u2192 Add JavaScript\n * Uses only vanilla JS (no $)\n *\/\nQualtrics.SurveyEngine.addOnReady(function () {\n  const qContainer   = this.getQuestionContainer();\n  const textArea     = qContainer.querySelector('textarea');\n  const EMBED_VAR    = 'number_of_pastes';\n\n  \/\/ ---- state -----------------------------------------------------------\n  let pasteCount = Number(Qualtrics.SurveyEngine.getEmbeddedData(EMBED_VAR)) || 0;\n  let lastStamp  = 0;                     \/\/ ms since epoch of previous counted paste\n\n  \/\/ ---- helper ----------------------------------------------------------\n  function recordPaste () {\n    const now = Date.now();\n    if (now - lastStamp < 80) return;     \/\/ ignore a 2nd hit within 80 ms\n    lastStamp  = now;\n\n    pasteCount += 1;\n    Qualtrics.SurveyEngine.setEmbeddedData(EMBED_VAR, String(pasteCount));\n    console.log('[Qualtrics] Paste #'+ pasteCount +' recorded');\n  }\n\n  \/\/ ---- event listener --------------------------------------------------\n  \/* Modern browsers fire ONE input event whose inputType is \"insertFromPaste\".\n     This catches right-click, menu Paste, long-press paste on mobile,\n     *and* Ctrl\/\u2318-V, all with a single signal. *\/\n  textArea.addEventListener('input', event => {\n    if (event.inputType === 'insertFromPaste') recordPaste();\n  });\n\n  \/* Fallback: really old browsers (IE11 \/ early Edge) have no inputType,\n     but *do* fire a ClipboardEvent \"paste\". This listener runs only there,\n     and the 80 ms guard still prevents double counts. *\/\n  textArea.addEventListener('paste', recordPaste);\n});","QuestionText":"Please let us know if anything seemed not to work or was confusing.\n            Thanks!","QuestionText_Unsafe":"Please let us know if anything seemed not to work or was confusing.\n            Thanks!","QuestionType":"TE","SearchSource":{"AllowFreeResponse":"false"},"Selector":"ML","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}}}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID569","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"#QuestionText, TimingPageSubmit#"},"4":{"Display":"#QuestionText, TimingClickCount#"}},"Configuration":{"MaxSeconds":"0","MinSeconds":"0","QuestionDescriptionOption":"UseText"},"DataExportTag":"Q5.1","DefaultChoices":false,"GradingData":[],"Language":[],"QuestionDescription":"Timing","QuestionID":"QID569","QuestionText":"Timing","QuestionText_Unsafe":"Timing","QuestionType":"Timing","Selector":"PageTimer"}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID570","SecondaryAttribute":"In the next part of the study, you will make a series of decisions involving a lottery. Before ma...","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[],"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"Q5.2","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":1,"QuestionDescription":"In the next part of the study, you will make a series of decisions involving a lottery. Before ma...","QuestionID":"QID570","QuestionText":"<p>In the next part of the study, you will make a series of decisions involving a lottery.<\/p>\n\n<p>Before making these decisions, please read the following information carefully.<\/p>\n\n<p>Each row in the list presents two payment options.<\/p>\n\n<p><strong>Option A <\/strong>is a lottery. Under this option, <strong>you receive $10 with 95% probability and $0 with 5% probability.<\/strong><\/p>\n\n<p><strong>Option B <\/strong>is a certain payment. Under this option, <strong>you receive a fixed amount of money with certainty.<\/strong><\/p>\n\n<p><strong>As you proceed down the rows of the list,<\/strong> the certain payment in <strong>Option B increases from $0.00 to $10.00.<\/strong><\/p>\n\n<p>For each row, your task is simply to decide whether you prefer Option A or Option B.<\/p>\n\n<p>If this part is randomly selected as the part-that-counts, <strong>one row from the list will be randomly selected, <\/strong>and the payment option you chose in that row will determine your earnings from this part.<\/p>\n\n<ul>\n\t<li><strong>If Option A is selected, your payment will be determined by the lottery outcome.<\/strong><\/li>\n\t<li><strong>If Option B is selected,<\/strong> <strong>you will receive the amount shown in that row with certainty.&nbsp;&nbsp;<\/strong><\/li>\n<\/ul>\nRegardless of the option selected, a<strong>ny earnings from this part will be paid to you on the same day as the rest of your study payment.<\/strong> Now, please make your decisions below.","QuestionText_Unsafe":"<p>In the next part of the study, you will make a series of decisions involving a lottery.<\/p>\n\n<p>Before making these decisions, please read the following information carefully.<\/p>\n\n<p>Each row in the list presents two payment options.<\/p>\n\n<p><strong>Option A <\/strong>is a lottery. Under this option, <strong>you receive $10 with 95% probability and $0 with 5% probability.<\/strong><\/p>\n\n<p><strong>Option B <\/strong>is a certain payment. Under this option, <strong>you receive a fixed amount of money with certainty.<\/strong><\/p>\n\n<p><strong>As you proceed down the rows of the list,<\/strong> the certain payment in <strong>Option B increases from $0.00 to $10.00.<\/strong><\/p>\n\n<p>For each row, your task is simply to decide whether you prefer Option A or Option B.<\/p>\n\n<p>If this part is randomly selected as the part-that-counts, <strong>one row from the list will be randomly selected, <\/strong>and the payment option you chose in that row will determine your earnings from this part.<\/p>\n\n<ul>\n\t<li><strong>If Option A is selected, your payment will be determined by the lottery outcome.<\/strong><\/li>\n\t<li><strong>If Option B is selected,<\/strong> <strong>you will receive the amount shown in that row with certainty.&nbsp;&nbsp;<\/strong><\/li>\n<\/ul>\nRegardless of the option selected, a<strong>ny earnings from this part will be paid to you on the same day as the rest of your study payment.<\/strong> Now, please make your decisions below.","QuestionType":"DB","Selector":"TB","Validation":{"Settings":{"Type":"None"}}}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID571","SecondaryAttribute":"Understanding Question: If Part 1 is randomly selected as the part-that-counts and you chose the...","TertiaryAttribute":null,"Payload":{"ChoiceOrder":["2","3"],"Choices":{"2":{"Display":"My payment will be determined by the lottery outcome."},"3":{"Display":"My payment will be determined with certainty"}},"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"Q5.3","DataVisibility":{"Hidden":false,"Private":false},"Language":[],"NextAnswerId":1,"NextChoiceId":5,"QuestionDescription":"Understanding Question: If Part 1 is randomly selected as the part-that-counts and you chose the...","QuestionID":"QID571","QuestionText":"<p><strong>Understanding Question<\/strong>: If Part 1 is randomly selected as the part-that-counts and you chose the option on the left in the randomly selected row, what would happen?&nbsp;<\/p>","QuestionText_Unsafe":"<p><strong>Understanding Question<\/strong>: If Part 1 is randomly selected as the part-that-counts and you chose the option on the left in the randomly selected row, what would happen?&nbsp;<\/p>","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Validation":{"Settings":{"CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID1720918529\/SelectableChoice\/2","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Understanding Question: If Part 1 is randomly selected as the part-that-count and you chose the option on the left in the randomly selected row, what would happen?&amp;nbsp;<\/span> <span class=\"LeftOpDesc\">The national chapter of MAW Foundation would receive ${e:\/\/Field\/stake} cents as a donation.<\/span> Is <span class=\"OpDesc\">Selected<\/span> ","LeftOperand":"q:\/\/QID1720918529\/SelectableChoice\/2","LogicType":"Question","Operator":"Selected","