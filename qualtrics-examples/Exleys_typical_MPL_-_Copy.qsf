ere is no pair that sums up to 100.<\/li>\n<\/ul>","QuestionText_Unsafe":"<h3>Part ${e:\/\/Field\/current_part} out of ${e:\/\/Field\/nparts}<\/h3>\n\n<p>Please continue to begin the math test in this part. Recall that:<\/p>\n\t\n<p>Each question on this math test will ask you to select a pair of numbers that sums up to 100, or select nothing if there are none.<\/p>\n\n<p>Related, your answer to each question is awarded 1 point if:&nbsp;<\/p>\n\n<ul>\n\t<li>you select a pair of numbers that sums up to 100, or&nbsp;<strong>&nbsp;<\/strong><\/li>\n\t<li>you select nothing when there is no pair that sums up to 100.<\/li>\n<\/ul>","QuestionType":"DB","Selector":"TB","Validation":{"Settings":{"Type":"None"}}}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID537","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"Configuration":{"CountDirection":"Decrementing","MaxSeconds":10,"MinSeconds":0.01000000000000000020816681711721685132943093776702880859375,"QuestionDescriptionOption":"UseText","Seconds":10,"ShowTimer":true},"DataExportTag":"Q76","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":332,"QuestionDescription":"Timing","QuestionID":"QID537","QuestionText":"Timing","QuestionText_Unsafe":"Timing","QuestionType":"Timing","Selector":"D"}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID538","SecondaryAttribute":"QUESTION ${lm:\/\/CurrentLoopNumber} of ${lm:\/\/TotalLoops}: Please select the pair of numbers that...","TertiaryAttribute":null,"Payload":{"ChoiceOrder":["1","2","3","4","5","6","7","8","9"],"Choices":{"1":{"Display":"${lm:\/\/Field\/2}"},"2":{"Display":"${lm:\/\/Field\/3}"},"3":{"Display":"${lm:\/\/Field\/4}"},"4":{"Display":"${lm:\/\/Field\/5}"},"5":{"Display":"${lm:\/\/Field\/6}"},"6":{"Display":"${lm:\/\/Field\/7}"},"7":{"Display":"${lm:\/\/Field\/8}"},"8":{"Display":"${lm:\/\/Field\/9}"},"9":{"Display":"${lm:\/\/Field\/10}"}},"Configuration":{"NumColumns":3,"QuestionDescriptionOption":"UseText"},"DataExportTag":"Q77","DataVisibility":{"Hidden":false,"Private":false},"Language":[],"NextAnswerId":1,"NextChoiceId":10,"QuestionDescription":"QUESTION ${lm:\/\/CurrentLoopNumber} of ${lm:\/\/TotalLoops}: Please select the pair of numbers that...","QuestionID":"QID538","QuestionJS":"\/\/ Save the choice value\nQualtrics.SurveyEngine.addOnPageSubmit(function () {\n\tconst varName = \"${lm:\/\/Field\/1}\";\n\tconst correctChoice = \"${lm:\/\/Field\/11}\";\n\n\tconst selectedChoices = this.getSelectedChoices();\n\tlet choiceName = null;\n\tlet choiceIsCorrect = 0;\n\n\tif (selectedChoices.length > 0) {\n\t\tconst choiceNumber = selectedChoices[0];\n\t\tconst questionInfo = this.getQuestionInfo();\n\t\tif (questionInfo && questionInfo[\"Choices\"] && questionInfo[\"Choices\"][choiceNumber]) {\n\t\t\tchoiceName = questionInfo[\"Choices\"][choiceNumber][\"Text\"];\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(varName, choiceName);\n\t\t\tconsole.log(varName, choiceName);\n\n\t\t\tchoiceIsCorrect = choiceName === correctChoice ? 1 : 0;\n\t\t}\n\t}\n\tif (selectedChoices.length === 0) {\n\t\tchoiceIsCorrect = correctChoice === \"none\" ? 1 : 0\n\t}\n\t\n\n \tQualtrics.SurveyEngine.setEmbeddedData(\"correct_\" + varName, choiceIsCorrect);\n\tconsole.log(\"correct_\" + varName, choiceIsCorrect);\n});\n\n\/\/ Save the order of questions\nQualtrics.SurveyEngine.addOnPageSubmit(function () {\n\tconst varName = \"${lm:\/\/Field\/1}\";\n\tlet currentQuestion = parseInt(\"${e:\/\/Field\/current_question}\");\n\tcurrentQuestion = currentQuestion + 1;\n\n\tQualtrics.SurveyEngine.setEmbeddedData(\"o_\"+varName, currentQuestion);\n\tconsole.log(\"o_\"+varName, currentQuestion);\n\tQualtrics.SurveyEngine.setEmbeddedData(\"current_question\", currentQuestion);\n});","QuestionText":"<h3 class=\"question-title\">QUESTION ${lm:\/\/CurrentLoopNumber} of ${lm:\/\/TotalLoops}:<\/h3>\n<strong>Please select the pair of numbers that add up to 100, or select nothing if there are none.&nbsp;<\/strong>&nbsp;","QuestionText_Unsafe":"<h3 class=\"question-title\">QUESTION ${lm:\/\/CurrentLoopNumber} of ${lm:\/\/TotalLoops}:<\/h3>\n<strong>Please select the pair of numbers that add up to 100, or select nothing if there are none.&nbsp;<\/strong>&nbsp;","QuestionType":"MC","Selector":"SACOL","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}}}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID539","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"Configuration":{"MaxSeconds":"0","MinSeconds":"0","QuestionDescriptionOption":"UseText"},"DataExportTag":"Q78","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":16,"QuestionDescription":"Timing","QuestionID":"QID539","QuestionText":"Timing","QuestionText_Unsafe":"Timing","QuestionType":"Timing","Selector":"PageTimer","Validation":"None"}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID540","SecondaryAttribute":"Instructions for Part 2 out of ${e:\/\/Field\/nparts} In this part, you will again complete a math t...","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[],"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"Q79","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":4,"QuestionDescription":"Instructions for Part 2 out of ${e:\/\/Field\/nparts} In this part, you will again complete a math t...","QuestionID":"QID540","QuestionJS":"\/\/ INCREMENT current_page\nQualtrics.SurveyEngine.addOnPageSubmit(function()\n{\t\n\tlet currentPage = parseInt(\"${e:\/\/Field\/current_page}\");\n\n\tcurrentPage = currentPage + 1;\n\tQualtrics.SurveyEngine.setEmbeddedData(\"current_page\", currentPage);\n\tconsole.log(\"current_page\", currentPage);\n});","QuestionText":"<h3>Instructions for Part 2 out of ${e:\/\/Field\/nparts}<\/h3>\n\n<p dir=\"ltr\">In this part, you will again complete a math test. You will also be randomly paired with a partner who is another participant who completed this study and who takes the exact same math tests as you. There is an equal chance that your partner will be a man or a woman.&nbsp;<\/p>\n\n<h3 dir=\"ltr\">The Winner&nbsp;<\/h3>\n\n<p dir=\"ltr\">Your score on the math test in this part will be compared to your partner's score on the math test in this part to determine whether you are or are not the winner in this part. Specifically:&nbsp;<\/p>\n\n<ul dir=\"ltr\">\n\t<li>If <strong>you have a higher score&nbsp;<\/strong>than your partner does, <strong>you are the winner.&nbsp;<\/strong><\/li>\n\t<li>If <strong>your have a lower score<\/strong>&nbsp;than&nbsp;your partner does,<strong> your are NOT the winner.<\/strong><\/li>\n\t<li>If <strong>you have the same<\/strong> <strong>score<\/strong>&nbsp;as your partner did in this part, there is an <strong>equal chance<\/strong> that you are or are NOT the winner in this part.&nbsp;&nbsp;<\/li>\n<\/ul>\n\n<h3 dir=\"ltr\">Additional Payment<\/h3>\n\n<p dir=\"ltr\">In this part, you only earn money if you are the winner in the math test in this part.&nbsp; Specifically:&nbsp;<\/p>\n\n<ul dir=\"ltr\">\n\t<li><strong>If you are the winner, you will earn $1<\/strong> for each point&nbsp;you scored on the math test in this part.&nbsp;&nbsp;<\/li>\n\t<li><strong>If you are NOT the winner<\/strong>, <strong>you will earn $0<\/strong> for sure.&nbsp;<\/li>\n<\/ul>\n<strong>You maximize your expected additional payment by trying your best on all questions in the math test.&nbsp;<\/strong>","QuestionText_Unsafe":"<h3>Instructions for Part 2 out of ${e:\/\/Field\/nparts}<\/h3>\n\n<p dir=\"ltr\">In this part, you will again complete a math test. You will also be randomly paired with a partner who is another participant who completed this study and who takes the exact same math tests as you. There is an equal chance that your partner will be a man or a woman.&nbsp;<\/p>\n\n<h3 dir=\"ltr\">The Winner&nbsp;<\/h3>\n\n<p dir=\"ltr\">Your score on the math test in this part will be compared to your partner's score on the math test in this part to determine whether you are or are not the winner in this part. Specifically:&nbsp;<\/p>\n\n<ul dir=\"ltr\">\n\t<li>If <strong>you have a higher score&nbsp;<\/strong>than your partner does, <strong>you are the winner.&nbsp;<\/strong><\/li>\n\t<li>If <strong>your have a lower score<\/strong>&nbsp;than&nbsp;your partner does,<strong> your are NOT the winner.<\/strong><\/li>\n\t<li>If <strong>you have the same<\/strong> <strong>score<\/strong>&nbsp;as your partner did in this part, there is an <strong>equal chance<\/strong> that you are or are NOT the winner in this part.&nbsp;&nbsp;<\/li>\n<\/ul>\n\n<h3 dir=\"ltr\">Additional Payment<\/h3>\n\n<p dir=\"ltr\">In this part, you only earn money if you are the winner in the math test in this part.&nbsp; Specifically:&nbsp;<\/p>\n\n<ul dir=\"ltr\">\n\t<li><strong>If you are the winner, you will earn $1<\/strong> for each point&nbsp;you scored on the math test in this part.&nbsp;&nbsp;<\/li>\n\t<li><strong>If you are NOT the winner<\/strong>, <strong>you will earn $0<\/strong> for sure.&nbsp;<\/li>\n<\/ul>\n<strong>You maximize your expected additional payment by trying your best on all questions in the math test.&nbsp;<\/strong>","QuestionType":"DB","Selector":"TB","Validation":{"Settings":{"Type":"None"}}}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID541","SecondaryAttribute":"Comprehension check: In this part, you are the winner if...","TertiaryAttribute":null,"Payload":{"ChoiceOrder":["1","2"],"Choices":{"1":{"Display":"you score higher than you partner"},"2":{"Display":"your partner scores higher than you"}},"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"Q81","DataVisibility":{"Hidden":false,"Private":false},"Language":[],"NextAnswerId":1,"NextChoiceId":4,"QuestionDescription":"Comprehension check: In this part, you are the winner if...","QuestionID":"QID541","QuestionText":"<b>Comprehension check: <\/b>In this part, you are the winner if...","QuestionText_Unsafe":"<b>Comprehension check: <\/b>In this part, you are the winner if...","QuestionType":"MC","Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"None"},"Selector":"SAVR","SubSelector":"TX","Validation":{"Settings":{"CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID81\/SelectableChoice\/1","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Comprehension check: In this part, you are the winner if...<\/span> <span class=\"LeftOpDesc\">you score higher than you partner<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID81\/SelectableChoice\/1","LogicType":"Question","Operator":"Selected","QuestionID":"QID81","QuestionIDFromLocator":"QID81","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"incorrect answer","libraryID":"UR_cAtjJf4eqOWGcDA","messageID":"MS_42EWahFVsD2E0jY","subMessageID":"VE_CUSTOM_VALIDATION_0"}},"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation"}}}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID542","SecondaryAttribute":"Comprehension check: In this part, how much will you earn if you are the winner?\u00a0","TertiaryAttribute":null,"Payload":{"ChoiceOrder":["4","3"],"Choices":{"3":{"Display":"$1 for each correct answer"},"4":{"Display":"$0 for sure"}},"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"Q80","DataVisibility":{"Hidden":false,"Private":false},"Language":[],"NextAnswerId":1,"NextChoiceId":5,"QuestionDescription":"Comprehension check: In this part, how much will you earn if you are the winner?\u00a0","QuestionID":"QID542","QuestionText":"<b>Comprehension check: <\/b>In this part, how much will you earn if you are the winner?&nbsp;","QuestionText_Unsafe":"<b>Comprehension check: <\/b>In this part, how much will you earn if you are the winner?&nbsp;","QuestionType":"MC","Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"None"},"Selector":"SAVR","SubSelector":"TX","Validation":{"Settings":{"CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID80\/SelectableChoice\/3","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Comprehension check: In a part, how much will you earn?&amp;nbsp;<\/span> <span class=\"LeftOpDesc\">$1 for each correct answer, only if you are the winner<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID80\/SelectableChoice\/3","LogicType":"Question","Operator":"Selected","QuestionID":"QID80","QuestionIDFromLocator":"QID80","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"incorrect answer","libraryID":"UR_cAtjJf4eqOWGcDA","messageID":"MS_42EWahFVsD2E0jY","subMessageID":"VE_CUSTOM_VALIDATION_0"}},"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation"}}}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID543","SecondaryAttribute":"Comprehension check: In this part, how much will you earn if you are NOT the winner?\u00a0","TertiaryAttribute":null,"Payload":{"ChoiceOrder":["4","3"],"Choices":{"3":{"Display":"$1 for each correct answer"},"4":{"Display":"$0 for sure"}},"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"Q82","DataVisibility":{"Hidden":false,"Private":false},"Language":[],"NextAnswerId":1,"NextChoiceId":5,"QuestionDescription":"Comprehension check: In this part, how much will you earn if you are NOT the winner?\u00a0","QuestionID":"QID543","QuestionText":"<b>Comprehension check: <\/b>In this part, how much will you earn if you are NOT the winner?&nbsp;","QuestionText_Unsafe":"<b>Comprehension check: <\/b>In this part, how much will you earn if you are NOT the winner?&nbsp;","QuestionType":"MC","Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"None"},"Selector":"SAVR","SubSelector":"TX","Validation":{"Settings":{"CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID82\/SelectableChoice\/4","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Comprehension check: In a part, how much will you earn if you are NOT the winner?&amp;nbsp;<\/span> <span class=\"LeftOpDesc\">$0 for sure<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID82\/SelectableChoice\/4","LogicType":"Question","Operator":"Selected","QuestionID":"QID82","QuestionIDFromLocator":"QID82","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"incorrect answer","libraryID":"UR_cAtjJf4eqOWGcDA","messageID":"MS_42EWahFVsD2E0jY","subMessageID":"VE_CUSTOM_VALIDATION_0"}},"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation"}}}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID544","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"Configuration":{"MaxSeconds":"0","MinSeconds":"0","QuestionDescriptionOption":"UseText"},"DataExportTag":"Q38","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":16,"QuestionDescription":"Timing","QuestionID":"QID544","QuestionText":"Timing","QuestionText_Unsafe":"Timing","QuestionType":"Timing","Selector":"PageTimer","Validation":"None"}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID545","SecondaryAttribute":"Part ${e:\/\/Field\/current_part} out of ${e:\/\/Field\/nparts} Please continue to begin the math test...","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[],"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"Q32","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":4,"QuestionDescription":"Part ${e:\/\/Field\/current_part} out of ${e:\/\/Field\/nparts} Please continue to begin the math test...","QuestionID":"QID545","QuestionText":"<h3>Part ${e:\/\/Field\/current_part} out of ${e:\/\/Field\/nparts}<\/h3>\n\n<p>Please continue to begin the math test in this part.&nbsp; Recall that:<\/p>\n\t\n<p>Each question on this math test will ask you to select a pair of numbers that sums up to 100, or select nothing if there are none.<\/p>\n\t\n<p>Related, your answer to each question is awarded 1 point if:&nbsp;<\/p>\n\n<ul>\n\t<li>you select a pair of numbers that sums up to 100, or&nbsp;<strong>&nbsp;<\/strong><\/li>\n\t<li>you select nothing when there is no pair that sums up to 100.<\/li>\n<\/ul>","QuestionText_Unsafe":"<h3>Part ${e:\/\/Field\/current_part} out of ${e:\/\/Field\/nparts}<\/h3>\n\n<p>Please continue to begin the math test in this part.&nbsp; Recall that:<\/p>\n\t\n<p>Each question on this math test will ask you to select a pair of numbers that sums up to 100, or select nothing if there are none.<\/p>\n\t\n<p>Related, your answer to each question is awarded 1 point if:&nbsp;<\/p>\n\n<ul>\n\t<li>you select a pair of numbers that sums up to 100, or&nbsp;<strong>&nbsp;<\/strong><\/li>\n\t<li>you select nothing when there is no pair that sums up to 100.<\/li>\n<\/ul>","QuestionType":"DB","Selector":"TB","Validation":{"Settings":{"Type":"None"}}}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID546","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"Configuration":{"CountDirection":"Decrementing","MaxSeconds":10,"MinSeconds":0.01000000000000000020816681711721685132943093776702880859375,"QuestionDescriptionOption":"UseText","Seconds":10,"ShowTimer":true},"DataExportTag":"Q83","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":328,"QuestionDescription":"Timing","QuestionID":"QID546","QuestionText":"Timing","QuestionText_Unsafe":"Timing","QuestionType":"Timing","Selector":"D"}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID547","SecondaryAttribute":"QUESTION ${lm:\/\/CurrentLoopNumber} of ${lm:\/\/TotalLoops}: Please select the pair of numbers that...","TertiaryAttribute":null,"Payload":{"ChoiceOrder":["1","2","3","4","5","6","7","8","9"],"Choices":{"1":{"Display":"${lm:\/\/Field\/2}"},"2":{"Display":"${lm:\/\/Field\/3}"},"3":{"Display":"${lm:\/\/Field\/4}"},"4":{"Display":"${lm:\/\/Field\/5}"},"5":{"Display":"${lm:\/\/Field\/6}"},"6":{"Display":"${lm:\/\/Field\/7}"},"7":{"Display":"${lm:\/\/Field\/8}"},"8":{"Display":"${lm:\/\/Field\/9}"},"9":{"Display":"${lm:\/\/Field\/10}"}},"Configuration":{"NumColumns":3,"QuestionDescriptionOption":"UseText"},"DataExportTag":"Q84","DataVisibility":{"Hidden":false,"Private":false},"Language":[],"NextAnswerId":1,"NextChoiceId":10,"QuestionDescription":"QUESTION ${lm:\/\/CurrentLoopNumber} of ${lm:\/\/TotalLoops}: Please select the pair of numbers that...","QuestionID":"QID547","QuestionJS":"\/\/ Save the choice value\nQualtrics.SurveyEngine.addOnPageSubmit(function () {\n\tconst varName = \"${lm:\/\/Field\/1}\";\n\tconst correctChoice = \"${lm:\/\/Field\/11}\";\n\n\tconst selectedChoices = this.getSelectedChoices();\n\tlet choiceName = null;\n\tlet choiceIsCorrect = 0;\n\n\tif (selectedChoices.length > 0) {\n\t\tconst choiceNumber = selectedChoices[0];\n\t\tconst questionInfo = this.getQuestionInfo();\n\t\tif (questionInfo && questionInfo[\"Choices\"] && questionInfo[\"Choices\"][choiceNumber]) {\n\t\t\tchoiceName = questionInfo[\"Choices\"][choiceNumber][\"Text\"];\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(varName, choiceName);\n\t\t\tconsole.log(varName, choiceName);\n\n\t\t\tchoiceIsCorrect = choiceName === correctChoice ? 1 : 0;\n\t\t}\n\t}\n\tif (selectedChoices.length === 0) {\n\t\tchoiceIsCorrect = correctChoice === \"none\" ? 1 : 0\n\t}\n\t\n\n \tQualtrics.SurveyEngine.setEmbeddedData(\"correct_\" + varName, choiceIsCorrect);\n\tconsole.log(\"correct_\" + varName, choiceIsCorrect);\n});\n\n\/\/ Save the order of questions\nQualtrics.SurveyEngine.addOnPageSubmit(function () {\n\tconst varName = \"${lm:\/\/Field\/1}\";\n\tlet currentQuestion = parseInt(\"${e:\/\/Field\/current_question}\");\n\tcurrentQuestion = currentQuestion + 1;\n\n\tQualtrics.SurveyEngine.setEmbeddedData(\"o_\"+varName, currentQuestion);\n\tconsole.log(\"o_\"+varName, currentQuestion);\n\tQualtrics.SurveyEngine.setEmbeddedData(\"current_question\", currentQuestion);\n});","QuestionText":"<h3 class=\"question-title\">QUESTION ${lm:\/\/CurrentLoopNumber} of ${lm:\/\/TotalLoops}:<\/h3>\n\n<strong>Please select the pair of numbers that add up to 100, or select nothing if there are none.&nbsp;<\/strong>&nbsp;","QuestionText_Unsafe":"<h3 class=\"question-title\">QUESTION ${lm:\/\/CurrentLoopNumber} of ${lm:\/\/TotalLoops}:<\/h3>\n\n<strong>Please select the pair of numbers that add up to 100, or select nothing if there are none.&nbsp;<\/strong>&nbsp;","QuestionType":"MC","Selector":"SACOL","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}}}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID548","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"Configuration":{"MaxSeconds":"0","MinSeconds":"0","QuestionDescriptionOption":"UseText"},"DataExportTag":"Q98","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":16,"QuestionDescription":"Timing","QuestionID":"QID548","QuestionText":"Timing","QuestionText_Unsafe":"Timing","QuestionType":"Timing","Selector":"PageTimer","Validation":"None"}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID549","SecondaryAttribute":"Instructions for Part 3 out of ${e:\/\/Field\/nparts}\u00a0 In this part, you will again complete a math...","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[],"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"Q99","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":4,"QuestionDescription":"Instructions for Part 3 out of ${e:\/\/Field\/nparts}\u00a0 In this part, you will again complete a math...","QuestionID":"QID549","QuestionJS":"\/\/ INCREMENT current_page\nQualtrics.SurveyEngine.addOnPageSubmit(function()\n{\t\n\tlet currentPage = parseInt(\"${e:\/\/Field\/current_page}\");\n\n\tcurrentPage = currentPage + 1;\n\tQualtrics.SurveyEngine.setEmbeddedData(\"current_page\", currentPage);\n\tconsole.log(\"current_page\", currentPage);\n});","QuestionText":"<h3>Instructions for Part 3 out of ${e:\/\/Field\/nparts}&nbsp;<\/h3>\n\n<p>In this part, you will again complete a math test.<\/p>\n\n<h3>The Winner<\/h3>\n\n<p>You will also be randomly paired with a partner who is another participant who completed this study and who takes the exact same math tests as you. There is an equal chance that your partner will be a man or a woman.&nbsp; To determine whether you are the winner, your score on the math test in this part will be compared to your partner's score on the math test in the prior part.<\/p>\n\n<p>Specifically:<\/p>\n\n<ul>\n\t<li>If <strong>you have a higher score <\/strong>in the math test in this part than your partner did in the math test in the prior part, <strong>you are the winner.&nbsp;<\/strong><\/li>\n\t<li>If <strong>your have a lower score<\/strong>&nbsp;in the math test in this part than&nbsp;your partner did in the math test in the prior part,<strong> your are NOT&nbsp;the winner.<\/strong><\/li>\n\t<li>If <strong>you have the same<\/strong> <strong>score<\/strong>&nbsp;in the math test in this part as your partner did in the math test in the prior part, there is an <strong>equal chance<\/strong> that you are or are NOT the winner.&nbsp;&nbsp;<\/li>\n<\/ul>\n\n<h3>Additional Payment<\/h3>\n\n<p>In this part, before you complete the math test, you can choose the <strong>fixed wage <\/strong>or&nbsp; the&nbsp;<strong>competition wage.&nbsp;&nbsp;<\/strong><\/p>\n\n<p>If you choose the <strong>fixed wage<\/strong>, you will earn<strong>&nbsp;$0.50 for each point you score&nbsp;<\/strong>on the math test in this part.<\/p>\n\t\n<p>If you choose the <strong>competition wage<\/strong>, you will&nbsp;only earn money if you are the winner in the math test in this part.&nbsp; Specifically:&nbsp;<\/p>\n\n<ul dir=\"ltr\">\n\t<li><strong>If you are the winner, you will earn $1<\/strong> for each point&nbsp;you scored on the math test in this part.&nbsp;&nbsp;<\/li>\n\t<li><strong>If you are NOT the winner<\/strong>, <strong>you will earn $0<\/strong> for sure.&nbsp;<\/li>\n<\/ul>","QuestionText_Unsafe":"<h3>Instructions for Part 3 out of ${e:\/\/Field\/nparts}&nbsp;<\/h3>\n\n<p>In this part, you will again complete a math test.<\/p>\n\n<h3>The Winner<\/h3>\n\n<p>You will also be randomly paired with a partner who is another participant who completed this study and who takes the exact same math tests as you. There is an equal chance that your partner will be a man or a woman.&nbsp; To determine whether you are the winner, your score on the math test in this part will be compared to your partner's score on the math test in the prior part.<\/p>\n\n<p>Specifically:<\/p>\n\n<ul>\n\t<li>If <strong>you have a higher score <\/strong>in the math test in this part than your partner did in the math test in the prior part, <strong>you are the winner.&nbsp;<\/strong><\/li>\n\t<li>If <strong>your have a lower score<\/strong>&nbsp;in the math test in this part than&nbsp;your partner did in the math test in the prior part,<strong> your are NOT&nbsp;the winner.<\/strong><\/li>\n\t<li>If <strong>you have the same<\/strong> <strong>score<\/strong>&nbsp;in the math test in this part as your partner did in the math test in the prior part, there is an <strong>equal chance<\/strong> that you are or are NOT the winner.&nbsp;&nbsp;<\/li>\n<\/ul>\n\n<h3>Additional Payment<\/h3>\n\n<p>In this part, before you complete the math test, you can choose the <strong>fixed wage <\/strong>or&nbsp; the&nbsp;<strong>competition wage.&nbsp;&nbsp;<\/strong><\/p>\n\n<p>If you choose the <strong>fixed wage<\/strong>, you will earn<strong>&nbsp;$0.50 for each point you score&nbsp;<\/strong>on the math test in this part.<\/p>\n\t\n<p>If you choose the <strong>competition wage<\/strong>, you will&nbsp;only earn money if you are the winner in the math test in this part.&nbsp; Specifically:&nbsp;<\/p>\n\n<ul dir=\"ltr\">\n\t<li><strong>If you are the winner, you will earn $1<\/strong> for each point&nbsp;you scored on the math test in this part.&nbsp;&nbsp;<\/li>\n\t<li><strong>If you are NOT the winner<\/strong>, <strong>you will earn $0<\/strong> for sure.&nbsp;<\/li>\n<\/ul>","QuestionType":"DB","Selector":"TB","Validation":{"Settings":{"Type":"None"}}}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID550","SecondaryAttribute":"Comprehension check: In this part, if you choose the fixed wage, how much will you earn?\u00a0","TertiaryAttribute":null,"Payload":{"ChoiceOrder":["1","2","4"],"Choices":{"1":{"Display":"$0 for sure"},"2":{"Display":"$0.50 for each correct answer"},"4":{"Display":"$1 for each correct answer"}},"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"Q100","DataVisibility":{"Hidden":false,"Private":false},"Language":[],"NextAnswerId":1,"NextChoiceId":5,"QuestionDescription":"Comprehension check: In this part, if you choose the fixed wage, how much will you earn?\u00a0","QuestionID":"QID550","QuestionText":"<b>Comprehension check: <\/b>In this part, if you choose the <strong>fixed wage<\/strong>, how much will you earn?&nbsp;","QuestionText_Unsafe":"<b>Comprehension check: <\/b>In this part, if you choose the <strong>fixed wage<\/strong>, how much will you earn?&nbsp;","QuestionType":"MC","Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"None"},"Selector":"SAVR","SubSelector":"TX","Validation":{"Settings":{"CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID100\/SelectableChoice\/2","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Comprehension check: In this part, if you choose the fixed wage, how much will you earn?&amp;nbsp;<\/span> <span class=\"LeftOpDesc\">$0.50 for each correct answer<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID100\/SelectableChoice\/2","LogicType":"Question","Operator":"Selected","QuestionID":"QID100","QuestionIDFromLocator":"QID100","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"incorrect answer","libraryID":"UR_cAtjJf4eqOWGcDA","messageID":"MS_42EWahFVsD2E0jY","subMessageID":"VE_CUSTOM_VALIDATION_0"}},"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation"}}}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID551","SecondaryAttribute":"Comprehension check: In this part, if you choose the competition wage, how much will you earn if...","TertiaryAttribute":null,"Payload":{"ChoiceOrder":["4","3"],"Choices":{"3":{"Display":"$1 for each correct answer"},