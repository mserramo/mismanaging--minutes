eOrder":["4","3"],"Choices":{"3":{"Display":"$1 for each correct answer"},"4":{"Display":"$0 for sure"}},"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"Q102","DataVisibility":{"Hidden":false,"Private":false},"Language":[],"NextAnswerId":1,"NextChoiceId":5,"QuestionDescription":"Comprehension check: In this part, if you choose the competition wage, how much will you earn if...","QuestionID":"QID552","QuestionText":"<b>Comprehension check: <\/b>In this part, if you choose the <strong>competition wage<\/strong>, how much will you earn if you are <strong>NOT the winner<\/strong>?&nbsp;","QuestionText_Unsafe":"<b>Comprehension check: <\/b>In this part, if you choose the <strong>competition wage<\/strong>, how much will you earn if you are <strong>NOT the winner<\/strong>?&nbsp;","QuestionType":"MC","Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"None"},"Selector":"SAVR","SubSelector":"TX","Validation":{"Settings":{"CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID102\/SelectableChoice\/4","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Comprehension check: In this part, if you choose the competition wage, how much will you earn if you are NOT the winner?&amp;nbsp;<\/span> <span class=\"LeftOpDesc\">$0 for sure<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID102\/SelectableChoice\/4","LogicType":"Question","Operator":"Selected","QuestionID":"QID102","QuestionIDFromLocator":"QID102","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"incorrect answer","libraryID":"UR_cAtjJf4eqOWGcDA","messageID":"MS_42EWahFVsD2E0jY","subMessageID":"VE_CUSTOM_VALIDATION_0"}},"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation"}}}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID553","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"Configuration":{"MaxSeconds":"0","MinSeconds":"0","QuestionDescriptionOption":"UseText"},"DataExportTag":"Q103","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":16,"QuestionDescription":"Timing","QuestionID":"QID553","QuestionText":"Timing","QuestionText_Unsafe":"Timing","QuestionType":"Timing","Selector":"PageTimer","Validation":"None"}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID554","SecondaryAttribute":"Recall that: If you choose the fixed wage, you will earn\u00a0$0.50 for each point you score\u00a0on the ma.","TertiaryAttribute":null,"Payload":{"ChoiceOrder":["4","5"],"Choices":{"4":{"Display":"Fixed Wage"},"5":{"Display":"Competition Wage"}},"Configuration":{"LabelPosition":"BELOW","QuestionDescriptionOption":"UseText"},"DataExportTag":"wage_choice","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":4,"QuestionDescription":"Recall that: If you choose the fixed wage, you will earn\u00a0$0.50 for each point you score\u00a0on the ma...","QuestionID":"QID554","QuestionJS":"\/\/ INCREMENT current_page\nQualtrics.SurveyEngine.addOnPageSubmit(function()\n{\t\n\tlet currentPage = parseInt(\"${e:\/\/Field\/current_page}\");\n\n\tcurrentPage = currentPage + 1;\n\tQualtrics.SurveyEngine.setEmbeddedData(\"current_page\", currentPage);\n\tconsole.log(\"current_page\", currentPage);\n});","QuestionText":"<p>Recall that:<\/p>\n\n<p>If you choose the fixed wage, you will earn&nbsp;$0.50 for each point you score&nbsp;on the math test in this part.<\/p>\n\n<p>If you choose the competition wage, you will&nbsp;only earn money if you are the winner in the math test in this part.<\/p>\n\t\n<p>Specifically:<\/p>\n\n<ul>\n\t<li>If you are the winner, you will earn $1 for each point&nbsp;you scored on the math test in this part.&nbsp;&nbsp;<\/li>\n\t<li>If you are NOT the winner, you will earn $0 for sure.&nbsp;<\/li>\n<\/ul>\n\n\n<p><strong>Would you like to choose the fixed wage or competition wage?&nbsp;<\/strong><\/p>","QuestionText_Unsafe":"<p>Recall that:<\/p>\n\n<p>If you choose the fixed wage, you will earn&nbsp;$0.50 for each point you score&nbsp;on the math test in this part.<\/p>\n\n<p>If you choose the competition wage, you will&nbsp;only earn money if you are the winner in the math test in this part.<\/p>\n\t\n<p>Specifically:<\/p>\n\n<ul>\n\t<li>If you are the winner, you will earn $1 for each point&nbsp;you scored on the math test in this part.&nbsp;&nbsp;<\/li>\n\t<li>If you are NOT the winner, you will earn $0 for sure.&nbsp;<\/li>\n<\/ul>\n\n\n<p><strong>Would you like to choose the fixed wage or competition wage?&nbsp;<\/strong><\/p>","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}}}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID555","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"Configuration":{"MaxSeconds":"0","MinSeconds":"0","QuestionDescriptionOption":"UseText"},"DataExportTag":"Q87","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":16,"QuestionDescription":"Timing","QuestionID":"QID555","QuestionText":"Timing","QuestionText_Unsafe":"Timing","QuestionType":"Timing","Selector":"PageTimer","Validation":"None"}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID556","SecondaryAttribute":"Part ${e:\/\/Field\/current_part} out of ${e:\/\/Field\/nparts} Please continue to begin the math test...","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[],"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"Q88","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":4,"QuestionDescription":"Part ${e:\/\/Field\/current_part} out of ${e:\/\/Field\/nparts} Please continue to begin the math test...","QuestionID":"QID556","QuestionText":"<h3>Part ${e:\/\/Field\/current_part} out of ${e:\/\/Field\/nparts}<\/h3>\n\n<p>Please continue to begin the math test in this part.&nbsp; Recall that:<\/p>\n\n<p>Each question on this math test will ask you to select a pair of numbers that sums up to 100, or select nothing if there are none.<\/p>\n\n<p>Related, your answer to each question is awarded 1 point if:&nbsp;<\/p>\n\n<ul>\n\t<li>you select a pair of numbers that sums up to 100, or&nbsp;<strong>&nbsp;<\/strong><\/li>\n\t<li>you select nothing when there is no pair that sums up to 100.<\/li>\n<\/ul>","QuestionText_Unsafe":"<h3>Part ${e:\/\/Field\/current_part} out of ${e:\/\/Field\/nparts}<\/h3>\n\n<p>Please continue to begin the math test in this part.&nbsp; Recall that:<\/p>\n\n<p>Each question on this math test will ask you to select a pair of numbers that sums up to 100, or select nothing if there are none.<\/p>\n\n<p>Related, your answer to each question is awarded 1 point if:&nbsp;<\/p>\n\n<ul>\n\t<li>you select a pair of numbers that sums up to 100, or&nbsp;<strong>&nbsp;<\/strong><\/li>\n\t<li>you select nothing when there is no pair that sums up to 100.<\/li>\n<\/ul>","QuestionType":"DB","Selector":"TB","Validation":{"Settings":{"Type":"None"}}}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID557","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"Configuration":{"CountDirection":"Decrementing","MaxSeconds":10,"MinSeconds":0.01000000000000000020816681711721685132943093776702880859375,"QuestionDescriptionOption":"UseText","Seconds":10,"ShowTimer":true},"DataExportTag":"Q85","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":316,"QuestionDescription":"Timing","QuestionID":"QID557","QuestionText":"Timing","QuestionText_Unsafe":"Timing","QuestionType":"Timing","Selector":"D"}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID558","SecondaryAttribute":"QUESTION ${lm:\/\/CurrentLoopNumber} of ${lm:\/\/TotalLoops}: Please select the pair of numbers that...","TertiaryAttribute":null,"Payload":{"ChoiceOrder":["1","2","3","4","5","6","7","8","9"],"Choices":{"1":{"Display":"${lm:\/\/Field\/2}"},"2":{"Display":"${lm:\/\/Field\/3}"},"3":{"Display":"${lm:\/\/Field\/4}"},"4":{"Display":"${lm:\/\/Field\/5}"},"5":{"Display":"${lm:\/\/Field\/6}"},"6":{"Display":"${lm:\/\/Field\/7}"},"7":{"Display":"${lm:\/\/Field\/8}"},"8":{"Display":"${lm:\/\/Field\/9}"},"9":{"Display":"${lm:\/\/Field\/10}"}},"Configuration":{"NumColumns":3,"QuestionDescriptionOption":"UseText"},"DataExportTag":"Q86","DataVisibility":{"Hidden":false,"Private":false},"Language":[],"NextAnswerId":1,"NextChoiceId":10,"QuestionDescription":"QUESTION ${lm:\/\/CurrentLoopNumber} of ${lm:\/\/TotalLoops}: Please select the pair of numbers that...","QuestionID":"QID558","QuestionJS":"\/\/ Save the choice value\nQualtrics.SurveyEngine.addOnPageSubmit(function () {\n\tconst varName = \"${lm:\/\/Field\/1}\";\n\tconst correctChoice = \"${lm:\/\/Field\/11}\";\n\n\tconst selectedChoices = this.getSelectedChoices();\n\tlet choiceName = null;\n\tlet choiceIsCorrect = 0;\n\n\tif (selectedChoices.length > 0) {\n\t\tconst choiceNumber = selectedChoices[0];\n\t\tconst questionInfo = this.getQuestionInfo();\n\t\tif (questionInfo && questionInfo[\"Choices\"] && questionInfo[\"Choices\"][choiceNumber]) {\n\t\t\tchoiceName = questionInfo[\"Choices\"][choiceNumber][\"Text\"];\n\t\t\tQualtrics.SurveyEngine.setEmbeddedData(varName, choiceName);\n\t\t\tconsole.log(varName, choiceName);\n\n\t\t\tchoiceIsCorrect = choiceName === correctChoice ? 1 : 0;\n\t\t}\n\t}\n\tif (selectedChoices.length === 0) {\n\t\tchoiceIsCorrect = correctChoice === \"none\" ? 1 : 0\n\t}\n\t\n\n \tQualtrics.SurveyEngine.setEmbeddedData(\"correct_\" + varName, choiceIsCorrect);\n\tconsole.log(\"correct_\" + varName, choiceIsCorrect);\n});\n\n\/\/ Save the order of questions\nQualtrics.SurveyEngine.addOnPageSubmit(function () {\n\tconst varName = \"${lm:\/\/Field\/1}\";\n\tlet currentQuestion = parseInt(\"${e:\/\/Field\/current_question}\");\n\tcurrentQuestion = currentQuestion + 1;\n\n\tQualtrics.SurveyEngine.setEmbeddedData(\"o_\"+varName, currentQuestion);\n\tconsole.log(\"o_\"+varName, currentQuestion);\n\tQualtrics.SurveyEngine.setEmbeddedData(\"current_question\", currentQuestion);\n});","QuestionText":"<h3 class=\"question-title\">QUESTION ${lm:\/\/CurrentLoopNumber} of ${lm:\/\/TotalLoops}:<\/h3>\n\n<strong>Please select the pair of numbers that add up to 100, or select nothing if there are none.&nbsp;<\/strong>&nbsp;","QuestionText_Unsafe":"<h3 class=\"question-title\">QUESTION ${lm:\/\/CurrentLoopNumber} of ${lm:\/\/TotalLoops}:<\/h3>\n\n<strong>Please select the pair of numbers that add up to 100, or select nothing if there are none.&nbsp;<\/strong>&nbsp;","QuestionType":"MC","Selector":"SACOL","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}}}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID559","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"Configuration":{"MaxSeconds":"0","MinSeconds":"0","QuestionDescriptionOption":"UseText"},"DataExportTag":"Q110","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"