aximize your expected additional payment by trying your best on all questions on the math test.&nbsp;<\/strong><\/p>","QuestionType":"DB","Selector":"TB","Validation":{"Settings":{"Type":"None"}}}},{"SurveyID":"SV_0fh8gyEGCFDq42a","Element":"SQ","PrimaryAttribute":"QID534","SecondaryAttribute":"Comprehension check: In a part, how much will do you earn for each point you score on the math te...","TertiaryAttribute":null,"Payload":{"ChoiceOrder":["4","3","5"],"Choices":{"3":{"Display":"$0.50 for sure"},"4":{"Display":"$0 for sure"},"5":{"Display":"$1 for sure"}},"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"Q96","DataVisibility":{"Hidden":false,"Private":false},"Language":[],"NextAnswerId":1,"NextChoiceId":6,"QuestionDescription":"Comprehension check: In a part, how much will do you earn for each point you score on the math te...","QuestionID":"QID534","QuestionText":"<b>Comprehension check: <\/b>In a part, how much will do you earn for each point you score on the math test?&nbsp;","QuestionText_Unsafe":"<b>Comprehension check: <\/b>In a part, how much will do you earn for each point you score on the math test?&nbsp;","QuestionType":"MC","Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"None"},"Selector":"SAVR","SubSelector":"TX","Validation":{"Settings":{"CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID96\/SelectableChoice\/3","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Comprehension check: In a part, how much will do you earn for each point you score on the math te...<\/span> <span class=\"LeftOpDesc\">$0.25 for sure<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID96\/SelectableChoice\/3","LogicType":"Question","Operator":"Selected","QuestionID":"QID96","QuestionIDFromLocator":"QID96","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"incorrect answer","libraryID":"UR_cAtjJf4eqOWGcDA","me