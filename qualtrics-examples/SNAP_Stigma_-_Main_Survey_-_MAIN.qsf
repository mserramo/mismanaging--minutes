ces":false,"DataExportTag":"Q169","QuestionID":"QID169","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"s3","Choices":[],"ChoiceOrder":[],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":4,"Answers":{"1":{"Display":"Click to write Scale Point 1"},"2":{"Display":"Click to write Scale Point 2"},"3":{"Display":"Click to write Scale Point 3"}},"AnswerOrder":["1","2","3"],"ChoiceDataExportTags":false,"DynamicChoicesData":[],"DynamicChoices":{"DynamicType":"ChoiceGroup","Locator":"q:\/\/QID168\/ChoiceGroup\/NotDisplayedChoices","Type":"Dynamic"},"Randomization":{"Advanced":null,"Type":"All","TotalRandSubset":""}}},{"SurveyID":"SV_1BvO30bIOZzKpqS","Element":"SQ","PrimaryAttribute":"QID17","SecondaryAttribute":"In your household, how often are you the person who uses the SNAP\/EBT card to pay?","TertiaryAttribute":null,"Payload":{"QuestionText":"In your household, how often are you the person who uses the SNAP\/EBT card to pay?","DefaultChoices":false,"DataExportTag":"Q16","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"In your household, how often are you the person who uses the SNAP\/EBT card to pay?","Choices":{"1":{"Display":"<strong>Always<\/strong> - I am the only one using the card"},"2":{"Display":"<strong>Usually<\/strong> &ndash; I handle more than half of purchases made with the card"},"3":{"Display":"<strong>Sometimes<\/strong> &ndash; I handle fewer than half of purchases made with the card"},"4":{"Display":"<strong>Never<\/strong> &ndash; I never use the card (someone else in the household does)"}},"ChoiceOrder":[1,2,3,4],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID17"}},{"SurveyID":"SV_1BvO30bIOZzKpqS","Element":"SQ","PrimaryAttribute":"QID170","SecondaryAttribute":"How often do you do the following because you are concerned about being negatively judged for usi...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>How often do you do the following<\/strong> <u><strong>because you are concerned about being negatively judged <\/strong><\/u><strong>for using SNAP\/EBT<\/strong>?&nbsp;(part ${e:\/\/Field\/beh_dis_counter})","DefaultChoices":false,"DataExportTag":"strat_3","QuestionID":"QID170","QuestionType":"Matrix","Selector":"Likert","SubSelector":"SingleAnswer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"How often do you do the following because you are concerned about being negatively judged for usi...","Choices":{"1":{"Display":"Shop when you expect fewer people to be in the store"},"2":{"Display":"Shop in stores where you are less likely to be judged"},"3":{"Display":"Use SNAP\/EBT online instead of in-person"},"4":{"Display":"Plan shopping trips so you use SNAP\/EBT as few times as possible"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":7,"NextAnswerId":7,"Answers":{"4":{"Display":"Never"},"5":{"Display":"Sometimes"},"6":{"Display":"Often"}},"AnswerOrder":["4","5","6"],"ChoiceDataExportTags":false,"Randomization":{"Type":"Advanced","Advanced":{"FixedOrder":["{~SubSet~}","{~SubSet~}"],"RandomizeAll":[],"RandomSubSet":["1","2","3","4"],"ScaleReversal":[],"Undisplayed":[],"TotalRandSubset":2},"ConsistentScaleReversal":false,"EvenPresentation":false},"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n    \/\/ CODE TO TRACK PROGRESS OF THE BEHAVIORAL DISTORTION SCREENS \n\t\/\/ Get current value of beh_dis_counter, default to 0 if not defined\n    var counter = parseInt(Qualtrics.SurveyEngine.getEmbeddedData(\"beh_dis_counter\")) || 0;\n    \n    \/\/ Increase by 1\n    counter += 1;\n    \n    \/\/ Update the embedded data variable\n    Qualtrics.SurveyEngine.setEmbeddedData(\"beh_dis_counter\", counter);\n    \n    console.log(\"beh_dis_counter updated to: \" + counter); \/\/ for debugging\n\t\n\t\/\/ CODE TO TRACK ORDER IN WHICH BEHAVIORAL DISTORTIONS WERE PRESENTED \n\t\n\t    var varName = \"block_order\";\n\n    \/\/ The ID for this block (you can change manually per block)\n    var blockId = \"setB\";  \n\n    \/\/ Retrieve current value of the embedded data variable\n    var currentVal = Qualtrics.SurveyEngine.getEmbeddedData(varName);\n\n    if (currentVal) {\n        \/\/ Append new block ID with a separator (e.g., comma)\n        Qualtrics.SurveyEngine.setEmbeddedData(varName, currentVal + \",\" + blockId);\n    } else {\n        \/\/ If it doesn\u2019t exist yet, initialize with this block ID\n        Qualtrics.SurveyEngine.setEmbeddedData(varName, blockId);\n    }\n\t\n\t\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","AnswerRandomization":{"Advanced":null,"ConsistentScaleReversal":true,"TotalRandSubset":"","Type":"ScaleReversal"}}},{"SurveyID":"SV_1BvO30bIOZzKpqS","Element":"SQ","PrimaryAttribute":"QID171","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DataExportTag":"Q171","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Data