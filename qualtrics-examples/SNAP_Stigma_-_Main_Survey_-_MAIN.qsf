r","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"inline","ChoiceColumnWidth":25,"RepeatHeaders":"none","WhiteSpace":"OFF","MobileFirst":true},"QuestionDescription":"How often do you do the following because you are concerned about being negatively judged for usi...","Choices":{"1":{"Display":"Try to hide that you're using a SNAP\/EBT card"},"6":{"Display":"Ask someone else to swipe your SNAP\/EBT card"},"7":{"Display":"Not use SNAP\/EBT if the store is crowded or someone you know is present"},"9":{"Display":"Use SNAP\/EBT in the self-checkout machines"},"10":{"Display":"Place a sticker or a cover on your SNAP\/EBT card"}},"ChoiceOrder":[1,6,"10",7,"9"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":12,"NextAnswerId":6,"Answers":{"1":{"Display":"Never"},"2":{"Display":"Sometimes"},"3":{"Display":"Often"}},"AnswerOrder":["1","2","3"],"ChoiceDataExportTags":false,"QuestionID":"QID46","Randomization":{"Advanced":{"FixedOrder":["2","{~SubSet~}","{~SubSet~}","{~SubSet~}"],"RandomSubSet":["1","6","7","9","10"],"RandomizeAll":[],"ScaleReversal":[],"TotalRandSubset":3,"Undisplayed":[]},"ConsistentScaleReversal":true,"EvenPresentation":false,"TotalRandSubset":"","Type":"Advanced"},"DynamicChoicesData":[],"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function() {\n    \/\/ CODE TO TRACK PROGRESS OF THE BEHAVIORAL DISTORTION SCREENS \n\t\/\/ Get current value of beh_dis_counter, default to 0 if not defined\n    var counter = parseInt(Qualtrics.SurveyEngine.getEmbeddedData(\"beh_dis_counter\")) || 0;\n    \n    \/\/ Increase by 1\n    counter += 1;\n    \n    \/\/ Update the embedded data variable\n    Qualtrics.SurveyEngine.setEmbeddedData(\"beh_dis_counter\", counter);\n    \n    console.log(\"beh_dis_counter updated to: \" + counter); \/\/ for debugging\n\t\n\t\/\/ CODE TO TRACK ORDER IN WHICH BEHAVIORAL DISTORTIONS WERE PRESENTED \n\t\n\t    var varName = \"block_order\";\n\n    \/\/ The ID for this block (you can change manually per block)\n    var blockId = \"setA\";  \n\n    \/\/ Retrieve current value of the embedded data variable\n    var currentVal = Qualtrics.SurveyEngine.getEmbeddedData(varName);\n\n    if (currentVal) {\n        \/\/ Append new block ID with a separator (e.g., comma)\n        Qualtrics.SurveyEngine.setEmbeddedData(varName, currentVal + \",\" + blockId);\n    } else {\n        \/\/ If it doesn\u2019t exist yet, initialize with this block ID\n        Qualtrics.SurveyEngine.setEmbeddedData(varName, blockId);\n    }\n\t\n\t\n});\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});","AnswerRandomization":{"Advanced":null,"ConsistentScaleReversal":true,"TotalRandSubset":"","Type":"ScaleReversal"}}},{"SurveyID":"SV_1BvO30bIOZzKpqS","Element":"SQ","PrimaryAttribute":"QID47","SecondaryAttribute":"You mentioned not buying something because you were worried about being judged for buying it with...","TertiaryAttribute":null,"Payload":{"QuestionText":"You mentioned not buying something because you were worried about being judged for buying it with SNAP\/EBT. What did you decide not to buy, and why?","DefaultChoices":false,"DataExportTag":"Q47","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"You mentioned not buying something because you were worried about being judged for buying it with...","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID47"}},{"SurveyID":"SV_1BvO30bIOZzKpqS","Element":"SQ","PrimaryAttr