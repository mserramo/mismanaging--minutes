","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_1BvO30bIOZzKpqS","Element":"SQ","PrimaryAttribute":"QID94","SecondaryAttribute":"Welcome to the second and final part of this study.\u00a0 This is a study conducted by researchers at...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Welcome to the second and final part of this study.&nbsp;<\/strong><br>\n<br>This is a study conducted by researchers at Stanford University.&nbsp;<br>\n<br>\nThe study will take approximately ${e:\/\/Field\/time} minutes.<br>\n<br>\nIf you complete this study, you will earn $${e:\/\/Field\/fee}.<br>\n<br>\nOn the next page, you will see a consent form. Please review it carefully before deciding whether you want to participate in this study.&nbsp;<br>\n<br>\nWhen ready, continue to read the consent form.","DefaultChoices":false,"DataExportTag":"Q94","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Welcome to the second and final part of this study.\u00a0 This is a study conducted by researchers at...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID94"}},{"SurveyID":"SV_1BvO30bIOZzKpqS","Element":"SQ","PrimaryAttribute":"QID95","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Q95","QuestionID":"QID95","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"Validation":"None","GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1}},{"SurveyID":"SV_1BvO30bIOZzKpqS","Element":"SQ","PrimaryAttribute":"QID96","SecondaryAttribute":"DESCRIPTION: You are invited to participate in the second part of a research study that has the g...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>DESCRIPTION:<\/strong> You are invited to participate in the second part of a research study that has the goal of studying decision making around social benefits. In this part, we will again ask you  some demographic questions (e.g., age, gender) questions about public programs.&nbsp;<br>\n<br>\n<strong>TIME INVOLVEMENT: <\/strong>We anticipate the survey will last approximately ${e:\/\/Field\/time} minutes.<br>\n<br>\n<strong>RISKS AND BENEFITS<\/strong>: Your participation in this study does not involve any risk to you beyond that of everyday life. Study data will be stored securely, in compliance with Stanford University standards, minimizing the risk of confidentiality breach. We cannot and do not guarantee or promise that you will receive any benefits from this study.<br>\n<br>\n<strong>PAYMENTS: <\/strong>If you complete the survey, you will receive $${e:\/\/Field\/fee}.&nbsp;<br>\n<br>\n<strong>PARTICIPANT\u2019S RIGHTS:<\/strong> If you have read this form and have decided to participate in this project, please understand your participation is voluntary and you have the right to withdraw your consent or discontinue participation at any time without penalty or loss of benefits to which you are otherwise entitled. The alternative is not to participate. You have the right to refuse to answer particular questions. The results of this research study may be presented at scientific or professional meetings or published in scientific journals. Your individual privacy will be maintained in all published and written data resulting from the study.<br>\n<br>\n<strong>CONTACT INFORMATION: <\/strong><br>\n<strong>Questions: <\/strong>If you have any questions, concerns or complaints about this research, its procedures, risks and benefits, contact the Protocol Director, Martin Serramo, mserramo@stanford.edu, +(1) 773-808-9211.<br>\n<br>\n<strong>Independent Contact:<\/strong> If you are not satisfied with how this study is being conducted, or if you have any concerns, complaints, or general questions about the research or your rights as a participant, please contact the Stanford Institutional Review Board (IRB) to speak to someone independent of the research team at 650-723-2480 or toll free at 1-866-680-2906, or email at irbnonmed@stanford.edu. You can also write to the Stanford IRB, Stanford University, 1705 El Camino Real, Palo Alto, CA 94306.<br><br>&nbsp;By clicking \u201cAgree\u201d below, you confirm that you have read the consent form, are at least 18 years old, and agree to participate in the research. Please print or save a copy of this page for your records.<br><br>","DefaultChoices":false,"DataExportTag":"consent","QuestionID":"QID96","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"DESCRIPTION: You are invited to participate in the second part of a research study that has the g...","Choices":{"4":{"Display":"I agree to participate in this study"},"5":{"Display":"I do NOT agree to participate in this study"}},"ChoiceOrder":["4","5"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_1BvO30bIOZzKpqS","Element":"SQ","PrimaryAttribute":"QID97","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Q97","QuestionID":"QID97","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"Validation":"None","GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1}},{"SurveyID":"SV_1BvO30bIOZzKpqS","Element":"SQ","PrimaryAttribute":"QID98","SecondaryAttribute":"How many children under 18 live with you?","TertiaryAttribute":null,"Payload":{"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"Q98","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":{"DE":{"QuestionText":"Wie viele Kinder unter 18 leben bei Ihnen?"},"EN-GB":{"QuestionText":"How many children under 18 live with you?"},"ES":{"QuestionText":"\u00bfCuantos ni\u00f1os de menos de 18 a\u00f1os de edad viven en su domicilio?"},"ES-ES":{"QuestionText":"\u00bfCu\u00e1ntos hijos menores de 18 a\u00f1os viven con usted?"},"FR":{"QuestionText":"Combien d'enfants de moins de 18\u00a0ans vivent avec vous\u00a0?"},"IT":{"QuestionText":"Quanti figli al di sotto dei 18 anni vivono con te?"},"JA":{"QuestionText":"\u540c\u5c45\u3057\u3066\u3044\u308b18\u6b73\u672a\u6e80\u306f\u4f55\u4eba\u3044\u307e\u3059\u304b\uff1f"},"KO":{"QuestionText":"\ud568\uaed8 \uc0ac\ub294 \ub9cc 18\uc138 \ubbf8\ub9cc \uc790\ub140\ub294 \uba87 \uba85\uc785\ub2c8\uae4c?"},"NL":{"QuestionText":"Hoeveel kinderen onder de 18 wonen bij u?"},"PT-BR":{"QuestionText":"Quantas pessoas com idade abaixo de 18 anos moram com voc\u00ea?"},"ZH-S":{"QuestionText":"\u6709\u51e0\u4e2a\u672a\u6ee1 18 \u5c81\u7684\u5b50\u5973\u4e0e\u60a8\u540c\u4f4f\uff1f"},"ZH-T":{"QuestionText":"\u60a8\u6709\u5e7e\u500b\u5b50\u5973\u672a\u6eff 18 \u6b72\uff1f"}},"NextAnswerId":1,"NextChoiceId":4,"QuestionDescription":"How many children under 18 live with you?","QuestionID":"QID98","QuestionText":"How many children under 18 live with you?","QuestionText_Unsafe":"How many children under 18 live with you?","QuestionType":"TE","Refere