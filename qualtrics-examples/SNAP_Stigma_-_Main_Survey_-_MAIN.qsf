ibute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Q178","QuestionID":"QID178","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"Validation":"None","GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1}},{"SurveyID":"SV_1BvO30bIOZzKpqS","Element":"SQ","PrimaryAttribute":"QID179","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DefaultChoices":false,"DataExportTag":"Q179","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID179","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n  const qid = this.questionId || (this.getQuestionInfo && this.getQuestionInfo().QuestionID);\n  const prefix = \"pasted\"; \/\/ ED vars will look like pasted_<QID>_<index>\n  const inputs = this.getQuestionContainer().querySelectorAll('input[type=\"text\"], textarea');\n\n  \/\/ remember the source QID (can be useful elsewhere)\n  Qualtrics.SurveyEngine.setEmbeddedData(prefix + \"_qid\", qid);\n\n  inputs.forEach((el, idx) => {\n    const varName = `${prefix}_${qid}_${idx + 1}`;\n\n    \/\/ Initialize ED to \"false\" so it's defined even if no paste happens\n    Qualtrics.SurveyEngine.setEmbeddedData(varName, \"false\");\n\n    \/\/ --- UI: live status under each textbox ---\n    const status = document.createElement(\"div\");\n    status.style.fontSize = \"12px\";\n    status.style.marginTop = \"4px\";\n    status.style.fontFamily = \"inherit\";\n    status.style.opacity = \"0.9\";\n\n    function setStatus(val) {\n      status.textContent = `Paste detected? ${val}`;\n      status.style.fontWeight = val === \"true\" ? \"600\" : \"400\";\n      status.style.color = val === \"true\" ? \"#2e7d32\" : \"#555\";\n    }\n\n    setStatus(\"false\");\n    el.insertAdjacentElement(\"afterend\", status);\n\n    \/\/ Update ED + UI in real time when a paste occurs\n    el.addEventListener(\"paste\", function () {\n      Qualtrics.SurveyEngine.setEmbeddedData(varName, \"true\");\n      setStatus(\"true\");\n    });\n  });\n});\n\n\n\nQualtrics.SurveyEngine.addOnReady(function()\n{\n\t\/*Place your JavaScript here to run when the page is fully displayed*\/\n\n});\n\nQualtrics.SurveyEngine.addOnUnload(function()\n{\n\t\/*Place your JavaScript here to run when the page is unloaded*\/\n\n});"}},{"SurveyID":"SV_1BvO30bIOZzKpqS","Element":"SQ","PrimaryAttribute":"QID18","SecondaryAttribute":"For each of the following programs, please indicate whether you or anyone in your household is en...","TertiaryAttribute":null,"Payload":{"QuestionText":"For each of the following programs, <strong>please indicate whether you or anyone in your household is enrolled in it.<\/strong>","DefaultChoices":false,"DataExportTag":"screen_q1_original","QuestionID":"QID18","QuestionType":"MC","Selector":"MAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"For each of the following programs, please indicate whether you or anyone in your household is en...","Choices":{"1":{"Display":"<strong>SNAP<\/strong> (Supplemental Nutrition Assistance Program, or &ldquo;food stamps&rdquo;)"},"2":{"Display":"<strong>WIC<\/strong> (Special Supplemental Nutrition Program for Women, Infants, and Children)"}