mentById(qid);\n            if (q) {\n                q.style.visibility = \"visible\";\n                q.style.height = \"auto\";\n                q.style.overflow = \"visible\";\n                q.style.margin = \"\";\n                q.style.padding = \"\";\n                void q.offsetHeight;\n            }\n        });\n        setTimeout(function() {\n            window.dispatchEvent(new Event(\"resize\"));\n        }, 50);\n    }\n    \/\/ Color helper for hover\n    function darkenColor(hex, factor) {\n        hex = hex.replace(\"#\", \"\");\n        var r = parseInt(hex.substring(0,2), 16);\n        var g = parseInt(hex.substring(2,4), 16);\n        var b = parseInt(hex.substring(4,6), 16);\n        r = Math.floor(r * factor);\n        g = Math.floor(g * factor);\n        b = Math.floor(b * factor);\n        return \"#\" + [r,g,b].map(x => x.toString(16).padStart(2,\"0\")).join(\"\");\n    }\n    \/\/ Check whether questions were already revealed\n    var alreadyRevealed = sessionStorage.getItem(revealKey) === \"true\";\n    if (alreadyRevealed) {\n        showQuestions();\n        qthis.showNextButton();\n        if (nextButton) {\n            nextButton.style.display = \"\";\n        }\n        return;\n    }\n    \/\/ First load: hide Next button and questions\n    qthis.hideNextButton();\n    if (nextButton) {\n        nextButton.style.display = \"none\";\n    }\n    hideQuestions();\n    \/\/ Create centered button\n    var wrapper = document.createElement(\"div\");\n    wrapper.style.textAlign = \"center\";\n    wrapper.style.margin = \"30px 0\";\n    var button = document.createElement(\"button\");\n    button.type = \"button\";\n    button.innerHTML = \"Click to answer the first 4 questions\";\n    \/\/ Styling\n    button.style.padding = \"12px 24px\";\n    button.style.cursor = \"pointer\";\n    button.style.backgroundColor = bgColor;\n    button.style.border = \"1px solid \" + borderColor;\n    button.style.borderRadius = \"6px\";\n    button.style.fontSize = \"16px\";\n    button.style.fontWeight = \"600\";\n    button.style.color = textColor;\n    \/\/ Hover effect\n    var hoverColor = darkenColor(bgColor, 0.9);\n    button.addEventListener(\"mouseenter\", function() {\n        button.style.backgroundColor = hoverColor;\n    });\n    button.addEventListener(\"mouseleave\", function() {\n        button.style.backgroundColor = bgColor;\n    });\n    wrapper.appendChild(button);\n    controller.appendChild(wrapper);\n    button.addEventListener(\"click\", function () {\n        sessionStorage.setItem(revealKey, \"true\");\n        showQuestions();\n        qthis.showNextButton();\n        if (nextButton) {\n            nextButton.style.display = \"\";\n        }\n        wrapper.remove();\n    });\n});"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID316","SecondaryAttribute":"Understanding Question: For the following questions, who should you compare your choices to?","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Understanding Question:<\/strong> For the following questions, who should you compare your choices to?","DataExportTag":"Q265","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Understanding Question: For the following questions, who should you compare your choices to?","Choices":{"1":{"Display":"Other participants who are equally likely to be men or women"},"2":{"Display":"Other participants who are women"},"3":{"Display":"Other participants who are men"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID316\/SelectableChoice\/1","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Understanding Check: For the following questions, who should you compare your choices to? \n<\/span> <span class=\"LeftOpDesc\">Other participants who are equally likely to be men or women<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID316\/SelectableChoice\/1","LogicType":"Question","Operator":"Selected","QuestionID":"QID316","QuestionIDFromLocator":"QID316","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"Error Text","libraryID":"UR_cZPMLrEO6JJWxpk","messageID":"MS_jHNVdNnhu9SyaST","subMessageID":"VE_ERROR"}}}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID316"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID318","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Q267","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":120,"MaxSeconds":120,"ShowTimer":true,"Seconds":120},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":108,"NextAnswerId":1,"QuestionID":"QID318"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID319","SecondaryAttribute":"Round ${e:\/\/Field\/xcomp_round}: Fixed Payment $${e:\/\/Field\/comp_selected_fixed_amount} per point.","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:22px;\"><strong>Round ${e:\/\/Field\/xcomp_round}: Fixed Payment $${e:\/\/Field\/comp_selected_fixed_amount} per point.<\/strong><\/span>","QuestionJS":"Qualtrics.SurveyEngine.addOnReady(function()\n{\n\tconst qthis = this;\n\tconst questionContainer = this.getQuestionContainer();\n\n\t\/\/ Must be set in Survey Flow before this question:\n\t\/\/ gameRoundCode = P   or   FT   or   C\n\tconst roundCode = \"${e:\/\/Field\/gameRoundCode}\";\n\n\tconst style = document.createElement('style');\n\tstyle.textContent = `\n\t\t.q-grid-3x3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin: 16px 0; max-width: 720px }\n\t\t.q-counter { margin: 8px 0 12px 0; font-weight: 600; font-size: 1.1em; }\n\t\t.q-grid-3x3 > div { aspect-ratio: 2 \/ 1; display: flex; align-items: center; justify-content: center; border: 1px solid #ccc; border-radius: 12px; font-weight: 600; font-size: 1.5em; transition: background-color .2s, border-color .2s, color .2s }\n\t\t.q-grid-3x3 > div.waiting { background: #f6f8fa; border-color: #ddd; color: #9aa3ad; cursor: not-allowed }\n\t\t.q-grid-3x3 > div.ready { background: #eaf2ff; border-color: #90b4ff; color: #10273f; cursor: pointer }\n\t\t.q-grid-3x3 > div.ready:hover { background: #dbe9ff; border-color: #79a6ff }\n\t\t.q-grid-3x3 > div.finished { background: #f6f6f6; border-color: #d0d0d0; color: #666; cursor: default }\n\t`;\n\tdocument.head.appendChild(style);\n\n\tconst delayMs = 0;\n\tconst maxAttempts = 30;\n\n\tfunction randInt(min, max) {\n\t\twhile (true) {\n\t\t\tconst x = Math.floor(Math.random() * (max - min + 1)) + min;\n\t\t\tif (x % 10 !== 0) return x;\n\t\t}\n\t}\n\n\tfunction shuffle(array) {\n\t\tlet m = array.length;\n\t\twhile (m > 0) {\n\t\t\tconst idx = Math.floor(Math.random() * m);\n\t\t\tm -= 1;\n\t\t\tconst temp = array[m];\n\t\t\tarray[m] = array[idx];\n\t\t\tarray[idx] = temp;\n\t\t}\n\t\treturn array;\n\t}\n\n\tfunction pairKey(a, b) {\n\t\treturn a + ',' + b;\n\t}\n\n\tfunction onesSumTo10(a, b) {\n\t\treturn (a % 10) + (b % 10) === 10;\n\t}\n\n\tfunction pairToString(p) {\n\t\treturn '(' + p[0] + ',' + p[1] + ')';\n\t}\n\n\tfunction serializeSet(set) {\n\t\tlet out = [];\n\t\tlet i = 0;\n\t\twhile (i < set.length) {\n\t\t\tout.push(pairToString(set[i]));\n\t\t\ti += 1;\n\t\t}\n\t\treturn out.join('|');\n\t}\n\n\tfunction edName(base, attemptNumber) {\n\t\tif (typeof attemptNumber === 'number') {\n\t\t\treturn base + roundCode + attemptNumber;\n\t\t}\n\t\treturn base + roundCode;\n\t}\n\n\tfunction setED(name, value) {\n\t\tQualtrics.SurveyEngine.setEmbeddedData(name, String(value));\n\t}\n\n\tfunction generateEqual100Pair(used, requireOnes10) {\n\t\twhile (true) {\n\t\t\tconst a = randInt(10, 90);\n\t\t\tconst b = 100 - a;\n\n\t\t\tif (b < 10 || b > 99) continue;\n\t\t\tif (b % 10 === 0) continue;\n\n\t\t\tif (requireOnes10 && !onesSumTo10(a, b)) continue;\n\t\t\tif (!requireOnes10 && onesSumTo10(a, b)) continue;\n\n\t\t\tconst key = pairKey(a, b);\n\t\t\tif (used[key]) continue;\n\n\t\t\tused[key] = true;\n\t\t\treturn [a, b];\n\t\t}\n\t}\n\n\tfunction generateAbove100Pair(used, requireOnes10) {\n\t\twhile (true) {\n\t\t\tconst a = randInt(10, 99);\n\t\t\tconst b = randInt(10, 99);\n\t\t\tconst total = a + b;\n\n\t\t\tif (total <= 100 || total >= 120) continue;\n\n\t\t\tif (requireOnes10 && !onesSumTo10(a, b)) continue;\n\t\t\tif (!requireOnes10 && onesSumTo10(a, b)) continue;\n\n\t\t\tconst key = pairKey(a, b);\n\t\t\tif (used[key]) continue;\n\n\t\t\tused[key] = true;\n\t\t\treturn [a, b];\n\t\t}\n\t}\n\n\tfunction generateBelow100Pair(used, requireOnes10) {\n\t\twhile (true) {\n\t\t\tconst a = randInt(10, 99);\n\t\t\tconst b = randInt(10, 99);\n\t\t\tconst total = a + b;\n\n\t\t\tif (total <= 80 || total >= 100) continue;\n\n\t\t\tif (requireOnes10 && !onesSumTo10(a, b)) continue;\n\t\t\tif (!requireOnes10 && onesSumTo10(a, b)) continue;\n\n\t\t\tconst key = pairKey(a, b);\n\t\t\tif (used[key]) continue;\n\n\t\t\tused[key] = true;\n\t\t\treturn [a, b];\n\t\t}\n\t}\n\n\tfunction generateOneSet() {\n\t\tconst used = {};\n\t\tconst set = [];\n\n\t\t\/\/ Exactly 3 of 9 pairs have ones digits summing to 10:\n\t\t\/\/ 1 exact-100, 1 above-100, 1 below-100\n\t\tset.push(generateEqual100Pair(used, true));\n\n\t\tset.push(generateAbove100Pair(used, true));\n\t\tset.push(generateAbove100Pair(used, false));\n\t\tset.push(generateAbove100Pair(used, false));\n\t\tset.push(generateAbove100Pair(used, false));\n\n\t\tset.push(generateBelow100Pair(used, true));\n\t\tset.push(generateBelow100Pair(used, false));\n\t\tset.push(generateBelow100Pair(used, false));\n\t\tset.push(generateBelow100Pair(used, false));\n\n\t\tshuffle(set);\n\t\treturn set;\n\t}\n\n\tconst counter = document.createElement('div');\n\tcounter.className = 'q-counter';\n\tcounter.innerHTML = \"<strong>You have 0 points (0 correct problems, 0 mistakes)<\/strong>\";\n\n\tconst grid = document.createElement('div');\n\tgrid.className = 'q-grid-3x3';\n\n\tquestionContainer.appendChild(counter);\n\tquestionContainer.appendChild(grid);\n\n\tconst cells = [];\n\tlet j = 0;\n\twhile (j < 9) {\n\t\tconst cell = document.createElement('div');\n\t\tgrid.appendChild(cell);\n\t\tcells.push(cell);\n\t\tj += 1;\n\t}\n\n\tlet currentSet = generateOneSet();\n\tlet score = 0;\n\tlet totalAttempted = 0;\n\tlet totalCorrect = 0;\n\tlet totalIncorrect = 0;\n\tlet locked = false;\n\tlet enabled = false;\n\tlet timer = null;\n\tlet finished = false;\n\tlet matrixStartMs = null;\n\n\tfunction computePoints(correct, incorrect) {\n\t\tif (correct <= incorrect) return 0;\n\t\treturn correct - incorrect;\n\t}\n\n\tfunction updateCounter() {\n\t\tconst pointWord = (score === 1) ? \"point\" : \"points\";\n\t\tconst correctWord = (totalCorrect === 1) ? \"problem\" : \"problems\";\n\t\tconst incorrectWord = (totalIncorrect === 1) ? \"mistake\" : \"mistakes\";\n\n\t\tcounter.innerHTML =\n\t\t\t\"<strong>You have \" + score + \" \" + pointWord +\n\t\t\t\" (\" + totalCorrect + \" correct \" + correctWord +\n\t\t\t\", \" + totalIncorrect + \" \" + incorrectWord + \")<\/strong>\";\n\t}\n\n\tfunction setWaiting() {\n\t\tlet k = 0;\n\t\twhile (k < cells.length) {\n\t\t\tcells[k].classList.remove('ready', 'finished');\n\t\t\tcells[k].classList.add('waiting');\n\t\t\tk += 1;\n\t\t}\n\t}\n\n\tfunction setReady() {\n\t\tlet k = 0;\n\t\twhile (k < cells.length) {\n\t\t\tcells[k].classList.remove('waiting', 'finished');\n\t\t\tcells[k].classList.add('ready');\n\t\t\tk += 1;\n\t\t}\n\t}\n\n\tfunction setFinishedView() {\n\t\tlet k = 0;\n\t\twhile (k < cells.length) {\n\t\t\tcells[k].classList.remove('waiting', 'ready');\n\t\t\tcells[k].classList.add('finished');\n\t\t\tk += 1;\n\t\t}\n\t}\n\n\tfunction readyNow() {\n\t\tif (finished) return;\n\t\tenabled = true;\n\t\tmatrixStartMs = Date.now();\n\t\tsetReady();\n\t}\n\n\tfunction scheduleReady() {\n\t\tif (timer) clearTimeout(timer);\n\t\tenabled = false;\n\t\tmatrixStartMs = null;\n\t\tsetWaiting();\n\t\ttimer = setTimeout(readyNow, delayMs);\n\t}\n\n\tfunction render() {\n\t\tlet k = 0;\n\t\twhile (k < 9) {\n\t\t\tconst p = currentSet[k];\n\t\t\tcells[k].textContent = '(' + p[0] + ', ' + p[1] + ')';\n\t\t\tcells[k].dataset.idx = k;\n\t\t\tk += 1;\n\t\t}\n\t\tscheduleReady();\n\t}\n\n\tfunction timeSpentNow() {\n\t\tif (matrixStartMs === null) return '';\n\t\treturn Date.now() - matrixStartMs;\n\t}\n\n\tfunction saveSummary() {\n\t\tsetED(edName('totalCorrect'), totalCorrect);\n\t\tsetED(edName('totalIncorrect'), totalIncorrect);\n\t\tsetED(edName('totalAttempted'), totalAttempted);\n\t\tsetED(edName('totalPoints'), score);\n\t\tsetED(edName('maxAttempts'), maxAttempts);\n\t}\n\n\tfunction saveAttempt(attemptNumber, matrixSet, chosenPair, isCorrect, timeSpentMs) {\n\t\tsetED(edName('matrixNumber', attemptNumber), attemptNumber);\n\t\tsetED(edName('matrixPairs', attemptNumber), serializeSet(matrixSet));\n\t\tsetED(edName('chosenPair', attemptNumber), pairToString(chosenPair));\n\t\tsetED(edName('isCorrect', attemptNumber), isCorrect);\n\t\tsetED(edName('timeSpentMs', attemptNumber), timeSpentMs);\n\t\tsetED(edName('matrixExitTimeSpentMs', attemptNumber), timeSpentMs);\n\t}\n\n\tfunction initializeEmptyFields() {\n\t\tlet n = 1;\n\t\twhile (n <= maxAttempts) {\n\t\t\tsetED(edName('matrixNumber', n), '');\n\t\t\tsetED(edName('matrixPairs', n), '');\n\t\t\tsetED(edName('chosenPair', n), '');\n\t\t\tsetED(edName('isCorrect', n), '');\n\t\t\tsetED(edName('timeSpentMs', n), '');\n\t\t\tsetED(edName('matrixExitTimeSpentMs', n), '');\n\t\t\tn += 1;\n\t\t}\n\n\t\tsetED(edName('surveyExitTimeSpentMs'), '');\n\t\tsetED(edName('totalIncorrect'), '');\n\t\tsetED(edName('totalPoints'), '');\n\t\tsaveSummary();\n\t}\n\n\tfunction finishGame() {\n\t\tfinished = true;\n\t\tenabled = false;\n\t\tlocked = true;\n\t\tif (timer) clearTimeout(timer);\n\n\t\tconst surveyExitTimeSpentMs = timeSpentNow();\n\t\tsetED(edName('surveyExitTimeSpentMs'), surveyExitTimeSpentMs);\n\t\tsaveSummary();\n\t\tsetFinishedView();\n\n\t\tconsole.log('GAME FINISHED', {\n\t\t\troundCode: roundCode,\n\t\t\ttotalCorrect: totalCorrect,\n\t\t\ttotalIncorrect: totalIncorrect,\n\t\t\ttotalAttempted: totalAttempted,\n\t\t\ttotalPoints: score,\n\t\t\tsurveyExitTimeSpentMs: surveyExitTimeSpentMs\n\t\t});\n\n\t\t\/\/ No autoadvance here.\n\t}\n\n\tfunction nextSet() {\n\t\tcurrentSet = generateOneSet();\n\t\trender();\n\t}\n\n\tfunction pick(e) {\n\t\tif (!enabled) return;\n\t\tif (locked) return;\n\t\tif (finished) return;\n\n\t\tlocked = true;\n\n\t\tconst idx = Number(e.currentTarget.dataset.idx);\n\t\tconst p = currentSet[idx];\n\t\tconst ok = (p[0] + p[1] === 100) ? 1 : 0;\n\t\tconst attemptNumber = totalAttempted + 1;\n\t\tconst matrixShown = currentSet.slice(0);\n\t\tconst timeSpentMs = timeSpentNow();\n\n\t\ttotalAttempted += 1;\n\n\t\tif (ok === 1) {\n\t\t\ttotalCorrect += 1;\n\t\t} else {\n\t\t\ttotalIncorrect += 1;\n\t\t}\n\n\t\tscore = computePoints(totalCorrect, totalIncorrect);\n\n\t\tsaveAttempt(attemptNumber, matrixShown, p, ok, timeSpentMs);\n\t\tupdateCounter();\n\t\tsaveSummary();\n\n\t\tconsole.log('ANSWER SAVED', {\n\t\t\troundCode: roundCode,\n\t\t\tattemptNumber: attemptNumber,\n\t\t\tmatrixNumberVar: edName('matrixNumber', attemptNumber),\n\t\t\tmatrixPairsVar: edName('matrixPairs', attemptNumber),\n\t\t\tchosenPairVar: edName('chosenPair', attemptNumber),\n\t\t\tisCorrectVar: edName('isCorrect', attemptNumber),\n\t\t\ttimeSpentVar: edName('timeSpentMs', attemptNumber),\n\t\t\tmatrixExitTimeSpentVar: edName('matrixExitTimeSpentMs', attemptNumber),\n\t\t\tmatrixPairs: serializeSet(matrixShown),\n\t\t\tchosenPair: pairToString(p),\n\t\t\tisCorrect: ok,\n\t\t\ttimeSpentMs: timeSpentMs,\n\t\t\ttotalCorrectSoFar: totalCorrect,\n\t\t\ttotalIncorrectSoFar: totalIncorrect,\n\t\t\ttotalAttemptedSoFar: totalAttempted,\n\t\t\ttotalPointsSoFar: score\n\t\t});\n\n\t\tif (totalAttempted >= maxAttempts) {\n\t\t\tfinishGame();\n\t\t\treturn;\n\t\t}\n\n\t\tnextSet();\n\t\tlocked = false;\n\t}\n\n\tlet k = 0;\n\twhile (k < cells.length) {\n\t\tcells[k].addEventListener('click', pick);\n\t\tk += 1;\n\t}\n\n\tinitializeEmptyFields();\n\tupdateCounter();\n\trender();\n});","DefaultChoices":false,"DataExportTag":"Q268","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Round ${e:\/\/Field\/xcomp_round}: Fixed Payment $${e:\/\/Field\/comp_selected_fixed_amount} per point.","DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">comp_selected_chose_tournament<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> 0 <\/span>","LeftOperand":"comp_selected_chose_tournament","LogicType":"EmbeddedField","Operator":"EqualTo","RightOperand":"0","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID319"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID32","SecondaryAttribute":"Recall that: You need to select a pair of numbers that sums up to 100. You have 2 minutes to corr...","TertiaryAttribute":null,"Payload":{"QuestionText":"Recall that:\n<ul>\n\t<li>You need to select a pair of numbers that sums up to 100.<\/li>\n\t<li>You have 2 minutes to correctly answer as many of the 30 problems as you can.<\/li>\n\t<li>You gain one point for each correct problem and lose one point for each mistake.<\/li>\n\t<li>You are in a tournament in a group of 2 men and 2 women.<\/li>\n\t<li>If you win, your tournament payment is $2 per point.<\/li>\n\t<li>If you lose, your tournament payment is $0.<\/li>\n\t<li>In the case of a tie, the winner will be randomly determined.<\/li>\n<\/ul>\nYou maximize your expected additional payment by trying your best to solve as many problems correctly as you can.<br>\n<br>\nWhen you\u2019re ready to start the math task, click the forward arrow button. Once you click the forward arrow button, your 2 minutes will start right away.","DefaultChoices":false,"DataExportTag":"Q32","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Recall that: You need to select a pair of numbers that sums up to 100. You have 2 minutes to corr...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID32"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID321","SecondaryAttribute":"Understanding Question: For the following questions, who should you compare your choices to?","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Understanding Question: <\/strong>For the following questions, who should you compare your choices to?","DataExportTag":"Q270","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Understanding Question: For the following questions, who should you compare your choices to?","Choices":{"1":{"Display":"Other participants who are equally likely to be men or women"},"2":{"Display":"Other participants who are women"},"3":{"Display":"Other participants who are men"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID321\/SelectableChoice\/1","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Understanding Check: For the following questions, who should you compare your choices to? \n<\/span> <span class=\"LeftOpDesc\">Other participants who are equally likely to be men or women<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID321\/SelectableChoice\/1","LogicType":"Question","Operator":"Selected","QuestionID":"QID321","QuestionIDFromLocator":"QID321","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"Error Text","libraryID":"UR_cZPMLrEO6JJWxpk","messageID":"MS_jHNVdNnhu9SyaST","subMessageID":"VE_ERROR"}}}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID321"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID323","SecondaryAttribute":"Instructions for Part ${e:\/\/Field\/current_part}, Round 2 of 2 rounds Recall, in this round, you e...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Instructions for Part ${e:\/\/Field\/current_part}, Round 2 of 2 rounds<\/strong><br \/>\n<br \/>\nRecall, in this round, you earn a fixed payment of $1.50 for answering 12 questions.&nbsp;<br \/>\n<br \/>\nYou already answered some questions. The following 4 questions will ask you to compare your choices between lottery payment and fixed payment&nbsp;to those of <b>male participants,<\/b> specifically other participants who went through the same study who are men.\n<ul>\n\t<li><span>Recall, in Round 1, y<\/span><span>ou <strong>selected the lottery<\/strong> when the fixed payment was <strong>$${e:\/\/Field\/xrisk_xl} or less<\/strong> and the <strong>fixed payment<\/strong> when it was <strong>$${e:\/\/Field\/xrisk_xr} or more<\/strong>.&nbsp;<\/span><\/li>\n<\/ul>","QuestionJS":"Qualtrics.SurveyEngine.addOnReady(function () {\n    var qthis = this;\n    var controller = this.getQuestionContainer();\n    var questionIDs = [\"QID417\", \"QID361\", \"QID365\", \"QID419\"];\n    var revealKey = \"revealed_\" + this.questionId;\n\n    var bgColor = \"${e:\/\/Field\/main_button_backgroundColor}\" || \"#AFE1AF\";\n    var borderColor = \"${e:\/\/Field\/main_button_border}\" || \"#7FBF7F\";\n    var textColor = \"${e:\/\/Field\/main_button_color}\" || \"#1f3d1f\";\n\n    function getNextButton(callback) {\n        var btn = document.getElementById(\"NextButton\");\n        if (btn) {\n            callback(btn);\n        } else {\n            var interval = setInterval(function () {\n                btn = document.getElementById(\"NextButton\");\n                if (btn) {\n                    clearInterval(interval);\n                    callback(btn);\n                }\n            }, 50);\n        }\n    }\n\n    function hideNextButton() {\n        qthis.hideNextButton();\n        getNextButton(function (btn) {\n            btn.style.display = \"none\";\n        });\n    }\n\n    function showNextButton() {\n        qthis.showNextButton();\n        getNextButton(function (btn) {\n            btn.style.display = \"\";\n        });\n    }\n\n    function hideQuestions() {\n        questionIDs.forEach(function (qid) {\n            var q = document.getElementById(qid);\n            if (q) {\n                q.style.visibility = \"hidden\";\n                q.style.height = \"0px\";\n                q.style.overflow = \"hidden\";\n                q.style.margin = \"0\";\n                q.style.padding = \"0\";\n            }\n        });\n    }\n\n    function showQuestions() {\n        questionIDs.forEach(function (qid) {\n            var q = document.getElementById(qid);\n            if (q) {\n                q.style.visibility = \"visible\";\n                q.style.height = \"auto\";\n                q.style.overflow = \"visible\";\n                q.style.margin = \"\";\n                q.style.padding = \"\";\n                void q.offsetHeight;\n            }\n        });\n        setTimeout(function () {\n            window.dispatchEvent(new Event(\"resize\"));\n        }, 50);\n    }\n\n    function darkenColor(hex, factor) {\n        hex = hex.replace(\"#\", \"\");\n        var r = Math.floor(parseInt(hex.substring(0, 2), 16) * factor);\n        var g = Math.floor(parseInt(hex.substring(2, 4), 16) * factor);\n        var b = Math.floor(parseInt(hex.substring(4, 6), 16) * factor);\n        return \"#\" + [r, g, b].map(function (x) {\n            return x.toString(16).padStart(2, \"0\");\n        }).join(\"\");\n    }\n\n    var alreadyRevealed = sessionStorage.getItem(revealKey) === \"true\";\n    if (alreadyRevealed) {\n        showQuestions();\n        showNextButton();\n        return;\n    }\n\n    hideNextButton();\n    hideQuestions();\n\n    var wrapper = document.createElement(\"div\");\n    wrapper.style.textAlign = \"center\";\n    wrapper.style.margin = \"30px 0\";\n\n    var button = document.createElement(\"button\");\n    button.type = \"button\";\n    button.innerHTML = \"Click to answer the next 4 questions\";\n    button.style.padding = \"12px 24px\";\n    button.style.cursor = \"pointer\";\n    button.style.backgroundColor = bgColor;\n    button.style.border = \"1px solid \" + borderColor;\n    button.style.borderRadius = \"6px\";\n    button.style.fontSize = \"16px\";\n    button.style.fontWeight = \"600\";\n    button.style.color = textColor;\n\n    var hoverColor = darkenColor(bgColor, 0.9);\n    button.addEventListener(\"mouseenter\", function () {\n        button.style.backgroundColor = hoverColor;\n    });\n    button.addEventListener(\"mouseleave\", function () {\n        button.style.backgroundColor = bgColor;\n    });\n\n    wrapper.appendChild(button);\n    controller.appendChild(wrapper);\n\n    button.addEventListener(\"click\", function () {\n        sessionStorage.setItem(revealKey, \"true\");\n        showQuestions();\n        showNextButton();\n        wrapper.remove();\n    });\n});","DefaultChoices":false,"DataExportTag":"Q272","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Instructions for Part ${e:\/\/Field\/current_part}, Round 2 of 2 rounds Recall, in this round, you e...","DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">xrisk_interior<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> 1 <\/span>","LeftOperand":"xrisk_interior","LogicType":"EmbeddedField","Operator":"EqualTo","RightOperand":"1","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID323"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID324","SecondaryAttribute":"Instructions for Part ${e:\/\/Field\/current_part}, Round 2 of 2 rounds In this round, you earn a fi...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong><span>Instructions for Part ${e:\/\/Field\/current_part}, Round 2 of 2 rounds<\/span><\/strong><br \/>\n<br \/>\n<span>In this round, you earn a fixed payment of $1.50 for answering 12 questions.<\/span><br \/>\n<br \/>\nThese questions will ask you to compare your choices between lottery payment and fixed payment to those of other participants who went through the same study and are <strong>equally likely to be men or women.<\/strong>\n<ul>\n\t<li><span>Recall, in Round 1, y<\/span><span>ou <strong>never selected the lottery.<\/strong>&nbsp;<\/span><\/li>\n<\/ul>","QuestionJS":"Qualtrics.SurveyEngine.addOnReady(function () {\n    var qthis = this;\n    var controller = this.getQuestionContainer();\n    