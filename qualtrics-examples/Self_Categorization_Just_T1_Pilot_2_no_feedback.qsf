4","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Q203","QuestionID":"QID254","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"Validation":"None","GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID255","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Q204","QuestionID":"QID255","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"Validation":"None","GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID256","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Q205","QuestionID":"QID256","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"Validation":"None","GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID257","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Q206","QuestionID":"QID257","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":"0","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"Validation":"None","GradingData":[],"Language":[],"NextChoiceId":16,"NextAnswerId":1}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID26","SecondaryAttribute":"Do you have a disability?","TertiaryAttribute":null,"Payload":{"ChoiceOrder":["1","2","3"],"Choices":{"1":{"Display":"Yes"},"2":{"Display":"No"},"3":{"Display":"Prefer not to say"}},"Configuration":{"LabelPosition":"BELOW","QuestionDescriptionOption":"UseText"},"DataExportTag":"disability","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":4,"QuestionDescription":"Do you have a disability?","QuestionID":"QID26","QuestionText":"<b>Do you have a disability?<\/b>","QuestionText_Unsafe":"<b>Do you have a disability?<\/b>","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}}}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID264","SecondaryAttribute":"Page ${e:\/\/Field\/generosity_position} of 4 pages of Final Questionnaire","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Page ${e:\/\/Field\/generosity_position} of 4 pages of Final Questionnaire<\/strong>","DefaultChoices":false,"DataExportTag":"Q213","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Page ${e:\/\/Field\/generosity_position} of 4 pages of Final Questionnaire","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID264"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID266","SecondaryAttribute":"Instructions for Part ${e:\/\/Field\/current_part} out of ${e:\/\/Field\/n_totalparts} parts This part...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Instructions for Part ${e:\/\/Field\/current_part} out of ${e:\/\/Field\/n_totalparts} parts<\/strong><br>\n<br>\nThis part has&nbsp;${e:\/\/Field\/comp_totalrounds}&nbsp;rounds. In 3 of the ${e:\/\/Field\/comp_totalrounds}&nbsp;rounds you will do a math task. <br><br>Each problem on this math task will ask you to select a pair of numbers that sums up to 100. For each correctly solved problem you receive one point. For each incorrect problem, or \"mistake,\" we will deduct one point. However, for each task, your final number of points is always at least 0. You will have 2 minutes to correctly answer as many problems as you can. There will be no more than 30 problems.","DefaultChoices":false,"DataExportTag":"Q215","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Instructions for Part ${e:\/\/Field\/current_part} out of ${e:\/\/Field\/n_totalparts} parts This part...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID266","QuestionJS":false}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID269","SecondaryAttribute":"Instructions for Part ${e:\/\/Field\/current_part} out of ${e:\/\/Field\/n_totalparts} parts This part...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Instructions for Part ${e:\/\/Field\/current_part} out of ${e:\/\/Field\/n_totalparts} parts<\/strong><br>\n<br>\nThis part has ${e:\/\/Field\/generosity_totalrounds} rounds.","DefaultChoices":false,"DataExportTag":"Q218","QuestionID":"QID269","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Instructions for Part ${e:\/\/Field\/current_part} out of ${e:\/\/Field\/n_totalparts} parts This part...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID296","SecondaryAttribute":"You must choose between Option A and Option B in 16 rows. Option A: Tournament Payment\u00a0\u2014\u00a0Your pe","TertiaryAttribute":null,"Payload":{"QuestionText":"You must choose between Option A and Option B in 16 rows.<br>\n<br>\n<strong>Option A: Tournament Payment&nbsp;\u2014&nbsp;<\/strong>Your performance in Round ${e:\/\/Field\/comp_totalrounds} will be evaluated relative to the performance of the other 3 group members in the Round 2 tournament. The Round 2 tournament is the math task you just completed.&nbsp;\n<ul>\n\t<li>If you have more points&nbsp;in Round ${e:\/\/Field\/comp_totalrounds}&nbsp;than the other 3 group members did in the Round 2 tournament, you are the <strong>winner<\/strong>.<\/li>\n\t<li>If at least one of the other 3 group members has more points&nbsp;in Round 2 than you do in Round ${e:\/\/Field\/comp_totalrounds}, you are <strong>not the winner and lose the tournament.<\/strong><\/li>\n\t<li>If you win, your tournament payment is $2 per point.<\/li>\n\t<li>If you lose, your tournament payment is $0.<\/li>\n\t<li>In the case of a tie, the winner will be randomly determined.<\/li>\n<\/ul>\n<br>\n<strong>Option B: Fixed Payment&nbsp;&nbsp;\u2014&nbsp;<\/strong>You receive a fixed payment for your performance in Round&nbsp;${e:\/\/Field\/comp_totalrounds}.&nbsp;The fixed payment varies from $0 per point in Row 1 and increases by $0.10 per row, reaching $1.50 per point in Row 16.<br>\n<br>\nOne of the 16 rows will be randomly selected as the<strong> row-that-counts.<\/strong>&nbsp;Your choice in the row-that-counts determines whether you complete the Round&nbsp;${e:\/\/Field\/comp_totalrounds} math task in a tournament or using a fixed payment.","DefaultChoices":false,"DataExportTag":"Q245","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"You must choose between Option A and Option B in 16 rows. Option A: Tournament Payment\u00a0\u2014\u00a0Your per...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID296","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n    var qthis = this;\n    var controller = this.getQuestionContainer();\n\n    \/\/ Replace with your actual QIDs\n    var questionIDs = [\"QID145\", \"QID146\"];\n\n    \/\/ Unique key for this page\n    var revealKey = \"revealed_\" + this.questionId;\n\n    function hideQuestions() {\n        questionIDs.forEach(function (qid) {\n            var q = document.getElementById(qid);\n            if (q) {\n                q.style.visibility = \"hidden\";\n                q.style.height = \"0px\";\n                q.style.overflow = \"hidden\";\n                q.style.margin = \"0\";\n                q.style.padding = \"0\";\n                q.style.border = \"0\";\n            }\n        });\n    }\n\n    function showQuestions() {\n        questionIDs.forEach(function (qid) {\n            var q = document.getElementById(qid);\n            if (q) {\n                q.style.visibility = \"visible\";\n                q.style.height = \"auto\";\n                q.style.overflow = \"visible\";\n                q.style.margin = \"\";\n                q.style.padding = \"\";\n                q.style.border = \"\";\n\n                \/\/ force reflow\n                void q.offsetHeight;\n            }\n        });\n\n        setTimeout(function () {\n            window.dispatchEvent(new Event(\"resize\"));\n        }, 50);\n    }\n\n    var alreadyRevealed = sessionStorage.getItem(revealKey) === \"true\";\n\n    if (alreadyRevealed) {\n        showQuestions();\n        qthis.showNextButton();\n        return;\n    }\n\n    qthis.hideNextButton();\n    hideQuestions();\n\n    var wrapper = document.createElement(\"div\");\n    wrapper.style.textAlign = \"center\";\n    wrapper.style.margin = \"30px 0\";\n\nvar bgColor = \"${e:\/\/Field\/understanding_button_backgroundColor}\";\nvar borderColor = \"${e:\/\/Field\/understanding_button_border}\";\nvar textColor = \"${e:\/\/Field\/understanding_button_color}\";\n\n\/\/ Fallbacks (in case something is missing)\nbgColor = bgColor || \"#FFA500\";\nborderColor = borderColor || \"#cc8400\";\ntextColor = textColor || \"#2b1a00\";\n\nvar button = document.createElement(\"button\");\nbutton.type = \"button\";\nbutton.innerHTML = \"Click to answer understanding questions\";\n\n\/\/ Styling\nbutton.style.padding = \"12px 24px\";\nbutton.style.cursor = \"pointer\";\nbutton.style.backgroundColor = bgColor;\nbutton.style.border = \"1px solid \" + borderColor;\nbutton.style.borderRadius = \"6px\";\nbutton.style.fontSize = \"16px\";\nbutton.style.fontWeight = \"600\";\nbutton.style.color = textColor;\n\n    wrapper.appendChild(button);\n    controller.appendChild(wrapper);\n\n    button.addEventListener(\"click\", function () {\n        sessionStorage.setItem(revealKey, \"true\");\n\n        showQuestions();\n        qthis.showNextButton();\n        wrapper.remove();\n    });\n});\n\n\/\/ INCREMENT current_page\nQualtrics.SurveyEngine.addOnPageSubmit(function()\n{\t\n\tlet currentPage = parseInt(\"${e:\/\/Field\/current_page}\");\n\n\tcurrentPage = currentPage + 1;\n\tQualtrics.SurveyEngine.setEmbeddedData(\"current_page\", currentPage);\n\tconsole.log(\"current_page\", currentPage);\n});"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID297","SecondaryAttribute":"Instructions for Part ${e:\/\/Field\/current_part}, Round 1 of 2 rounds You must choose between Opti...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p dir=\"ltr\"><strong>Instructions for Part ${e:\/\/Field\/current_part}, Round 1 of 2 rounds<\/strong><\/p>\n\n<p dir=\"ltr\"><br>\nYou must choose between Option A and Option B in 16 rows.<br>\n<br>\n<strong>Option A: Lottery&nbsp;&nbsp;\u2014&nbsp;<\/strong>You receive $7.50 with 50% probability and $0 with 50% probability.<br>\n<br>\n<strong>Option B: Fixed Payment&nbsp;\u2014&nbsp;<\/strong>You receive a guaranteed fixed payment regardless of the lottery outcome. This fixed payment varies from $0 in Row 1 and increases by $0.50 per row, reaching $7.50 in Row 16.<br>\n<br>\nOne of the 16 rows will be randomly selected as the <strong>row-that-counts.&nbsp;<\/strong>Your choice in the row-that-counts determines your payment in this round.<\/p><br>","DefaultChoices":false,"DataExportTag":"Q246","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Instructions for Part ${e:\/\/Field\/current_part}, Round 1 of 2 rounds You must choose between Opti...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID297","QuestionJS":"Qualtrics.SurveyEngine.addOnReady(function () {\n    var qthis = this;\n    var controller = this.getQuestionContainer();\n    \/\/ Replace with your actual QIDs\n    var questionIDs = [\"QID138\", \"QID139\"];\n    \/\/ Unique key for this page\n    var revealKey = \"revealed_\" + this.questionId;\n    \/\/ Get Qualtrics Next button\n    var nextButton = document.getElementById(\"NextButton\");\n    \/\/ Read embedded color variables\n    var bgColor = \"${e:\/\/Field\/understanding_button_backgroundColor}\";\n    var borderColor = \"${e:\/\/Field\/understanding_button_border}\";\n    var textColor = \"${e:\/\/Field\/understanding_button_color}\";\n    \/\/ Fallbacks\n    bgColor = bgColor || \"#FFA500\";\n    borderColor = borderColor || \"#cc8400\";\n    textColor = textColor || \"#2b1a00\";\n    function hideQuestions() {\n        questionIDs.forEach(function(qid) {\n            var q = document.getElementById(qid);\n            if (q) {\n                q.style.visibility = \"hidden\";\n                q.style.height = \"0px\";\n                q.style.overflow = \"hidden\";\n                q.style.margin = \"0\";\n                q.style.padding = \"0\";\n            }\n        });\n    }\n    function showQuestions() {\n        questionIDs.forEach(function(qid) {\n            var q = document.getElementById(qid);\n            if (q) {\n                q.style.visibility = \"visible\";\n                q.style.height = \"auto\";\n                q.style.overflow = \"visible\";\n                q.style.margin = \"\";\n                q.style.padding = \"\";\n                void q.offsetHeight;\n            }\n        });\n        setTimeout(function() {\n            window.dispatchEvent(new Event(\"resize\"));\n        }, 50);\n    }\n    \/\/ Check whether questions were already revealed\n    var alreadyRevealed = sessionStorage.getItem(revealKey) === \"true\";\n    if (alreadyRevealed) {\n        showQuestions();\n        qthis.showNextButton();\n        if (nextButton) {\n            nextButton.style.display = \"\";\n        }\n        return;\n    }\n    \/\/ First load: hide Next button and questions\n    qthis.hideNextButton();\n    if (nextButton) {\n        nextButton.style.display = \"none\";\n    }\n    hideQuestions();\n    \/\/ Create centered button\n    var wrapper = document.createElement(\"div\");\n    wrapper.style.textAlign = \"center\";\n    wrapper.style.margin = \"30px 0\";\n    var button = document.createElement(\"button\");\n    button.type = \"button\";\n    button.innerHTML = \"Click to answer understanding questions\";\n    \/\/ Styling\n    button.style.padding = \"12px 24px\";\n    button.style.cursor = \"pointer\";\n    button.style.backgroundColor = bgColor;\n    button.style.border = \"1px solid \" + borderColor;\n    button.style.borderRadius = \"6px\";\n    button.style.fontSize = \"16px\";\n    button.style.fontWeight = \"600\";\n    button.style.color = textColor;\n    wrapper.appendChild(button);\n    controller.appendChild(wrapper);\n    button.addEventListener(\"click\", function () {\n        sessionStorage.setItem(revealKey, \"true\");\n        showQuestions();\n        qthis.showNextButton();\n        if (nextButton) {\n            nextButton.style.display = \"\";\n        }\n        wrapper.remove();\n    });\n});"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID298","SecondaryAttribute":"(Optional) Please let us know if anything seemed not to work or was confusing. Thanks!","TertiaryAttribute":null,"Payload":{"QuestionText":"(Optional) Please let us know if anything seemed not to work or was confusing. Thanks!","DefaultChoices":false,"DataExportTag":"feedback","QuestionID":"QID298","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"(Optional) Please let us know if anything seemed not to work or was confusing. Thanks!","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID299","SecondaryAttribute":"Instructions for Part ${e:\/\/Field\/current_part},\u00a0Round 1 of ${e:\/\/Field\/generosity_totalrounds} r..","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Instructions for Part ${e:\/\/Field\/current_part},&nbsp;Round 1 of ${e:\/\/Field\/generosity_totalrounds} rounds<\/strong><br>\n<br>\nIn this round, you and another randomly selected participant from this study have the chance to receive a bonus payment. This participant is equally likely to be a man or woman.<br>\n<br>\nYou must choose between Option A and Option B in 16 rows.<br>\n<br>\n<strong>Option A: Equal Payment \u2014&nbsp;<\/strong>You receive $5 and another participant also receives $5.<br>\n<br>\n<strong>Option B: Payment for Self&nbsp; \u2014&nbsp;<\/strong>You receive a guaranteed fixed payment and the other participant receives $0. This fixed payment for you varies from $5 in Row 1 and increases by $0.50 per row, reaching $12.50 in Row 16.\n<br><br><p dir=\"ltr\">One of the 16 rows will be randomly selected as the <strong>row-that-counts.<\/strong>&nbsp;Your choice in the row-that-counts determines your payment in this round.<\/p>","DefaultChoices":false,"DataExportTag":"Q248","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Instructions for Part ${e:\/\/Field\/current_part},\u00a0Round 1 of ${e:\/\/Field\/generosity_totalrounds} r...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID299","QuestionJS":"Qualtrics.SurveyEngine.addOnReady(function () {\n    var qthis = this; \/\/ ADDED: save reference for API calls\n\n    var controller = this.getQuestionContainer();\n\n    \/\/ Replace with your actual QIDs\n    var questionIDs = [\"QID142\", \"QID143\"];\n\n    \/\/ Unique key for this page\n    var revealKey = \"revealed_\" + this.questionId;\n\n    \/\/ Get Qualtrics Next button\n    var nextButton = document.getElementById(\"NextButton\");\n\n    function hideQuestions() {\n        questionIDs.forEach(function(qid) {\n            var q = document.getElementById(qid);\n            if (q) {\n                q.style.visibility = \"hidden\";\n                q.style.height = \"0px\";\n                q.style.overflow = \"hidden\";\n                q.style.margin = \"0\";\n                q.style.padding = \"0\";\n            }\n        });\n    }\n\n    function showQuestions() {\n        questionIDs.forEach(function(qid) {\n            var q = document.getElementById(qid);\n            if (q) {\n                q.style.visibility = \"visible\";\n                q.style.height = \"auto\";\n                q.style.overflow = \"visible\";\n                q.style.margin = \"\";\n                q.style.padding = \"\";\n                void q.offsetHeight;\n            }\n        });\n\n        setTimeout(function() {\n            window.dispatchEvent(new Event(\"resize\"));\n        }, 50);\n    }\n\n    \/\/ Check whether questions were already revealed\n    var alreadyRevealed = sessionStorage.getItem(revealKey) === \"true\";\n\n    if (alreadyRevealed) {\n        showQuestions();\n        qthis.showNextButton(); \/\/ ADDED: Qualtrics API call\n        if (nextButton) {\n            nextButton.style.display = \"\";\n        }\n        return;\n    }\n\n    \/\/ First load: hide Next button and questions\n    qthis.hideNextButton(); \/\/ ADDED: Qualtrics API call\n    if (nextButton) {\n        nextButton.style.display = \"none\";\n    }\n\n    hideQuestions();\n\n    \/\/ Create centered button\n    var wrapper = document.createElement(\"div\");\n    wrapper.style.textAlign = \"center\";\n    wrapper.style.margin = \"30px 0\";\n\n    var bgColor = \"${e:\/\/Field\/understanding_button_backgroundColor}\";\n    var borderColor = \"${e:\/\/Field\/understanding_button_border}\";\n    var textColor = \"${e:\/\/Field\/understanding_button_color}\";\n\n    \/\/ Fallbacks (in case something is missing)\n    bgColor = bgColor || \"#FFA500\";\n    borderColor = borderColor || \"#cc8400\";\n    textColor = textColor || \"#2b1a00\";\n\n    var button = document.createElement(\"button\");\n    button.type = \"button\";\n    button.innerHTML = \"Click to answer understanding questions\";\n\n    \/\/ Styling\n    button.style.padding = \"12px 24px\";\n    button.style.cursor = \"pointer\";\n    button.style.backgroundColor = bgColor;\n    button.style.border = \"1px solid \" + borderColor;\n    button.style.borderRadius = \"6px\";\n    button.style.fontSize = \"16px\";\n    button.style.fontWeight = \"600\";\n    button.style.color = textColor;\n\n    wrapper.appendChild(button);\n    controller.appendChild(wrapper);\n\n    button.addEventListener(\"click\", function () {\n        sessionStorage.setItem(revealKey, \"true\");\n\n        showQuestions();\n        qthis.showNextButton(); \/\/ ADDED: Qualtrics API call\n        if (nextButton) {\n            nextButton.style.display = \"\";\n        }\n\n        wrapper.remove();\n    });\n});"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID301","SecondaryAttribute":"Understanding Question:\u00a0For the following questions, who should you compare your choices to?","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Understanding Question:<\/strong>&nbsp;For the following questions, who should you compare your choices to?","DataExportTag":"Q250","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Understanding Question:\u00a0For the following questions, who should you compare your choices to?","Choices":{"1":{"Display":"Other participants who are equally likely to be men or women"},"2":{"Display":"Other participants who are women"},"3":{"Display":"Other participants who are men"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID301\/SelectableChoice\/1","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Understanding Check:&amp;nbsp;For the following questions, who should you compare your choices to? \n<\/span> <span class=\"LeftOpDesc\">Other participants who are equally likely to be men or women<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID301\/SelectableChoice\/1","LogicType":"Question","Operator":"Selected","QuestionID":"QID301","QuestionIDFromLocator":"QID301","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"Error Text","libraryID":"UR_cZPMLrEO6JJWxpk","messageID":"MS_jHNVdNnhu9SyaST","subMessageID":"VE_ERROR"}}}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID301"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID302","SecondaryAttribute":"Instructions for Part ${e:\/\/Field\/current_part}, Round 2 of ${e:\/\/Field\/generosity_totalrounds} r...","TertiaryAttribute":null,"Payload":{"QuestionText":"<p class=\"overflow-visible! px-0!\" data-end=\"2559\" data-start=\"1778\"><span><strong>Instructions for Part ${e:\/\/Field\/current_part}, Round 2 of ${e:\/\/Field\/generosity_totalrounds} rounds<\/strong><br \/>\n<br \/>\nIn this round, you earn a fixed payment of $1.50 for answering 12 questions.<\/span><\/p>\n\n<p class=\"overflow-visible! px-0!\" data-end=\"2559\" data-start=\"1778\">&nbsp;<\/p>\n\n<p class=\"overflow-visible! px-0!\" data-end=\"2559\" data-start=\"1778\"><span>These questions will ask you to compare your choices between &ldquo;equal payment&rdquo; and &ldquo;payment for self&rdquo; to those of other participants who went through the same study and are <strong>equally likely to be men or women.<\/strong><\/span><\/p>\n\n<p class=\"overflow-visible! px-0!\" data-end=\"2559\" data-start=\"1778\">&nbsp;<\/p>\n\n<div class=\"relative w-full mt-4 mb-1\">\n<div>\n<div class=\"relative\">\n<div class=\"h-full min-h-0 min-w-0\">\n<div class=\"h-full min-h-0 min-w-0\">\n<div class=\"border border-token-border-light border-radius-3xl corner-superellipse\/1.1 rounded-3xl\">\n<div class=\"h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse\/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback\">\n<div class=\"pe-11 pt-3\">\n<div class=\"relative z-0 flex max-w-full\">\n<div class=\"q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch \u037cs \u037c16\" dir=\"ltr\" id=\"code-block-viewer\">\n<div class=\"cm-scroller\">\n<p class=\"cm-content q9tKkq_readonly\"><span>Recall, in Round 1, you selected between ($5 self, $5 other) and (fixed payment self, $0 other). <\/span><\/p>\n\n<ul>\n\t<li class=\"cm-content q9tKkq_readonly\"><span><strong>You always selected the equal payment of $5 for yourself and $5 for the other participant<\/strong>.&nbsp;<\/span><\/li>\n<\/ul>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>","DefaultChoices":false,"DataExportTag":"Q251","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Instructions for Part ${e:\/\/Field\/current_part}, Round 2 of ${e:\/\/Field\/generosity_totalrounds} r...","DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">xgenerosity_topcorner<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> 1 <\/span>","LeftOperand":"xgenerosity_topcorner","LogicType":"EmbeddedField","Operator":"EqualTo","RightOperand":"1","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID302","QuestionJS":"Qualtrics.SurveyEngine.addOnReady(function () {\n    var qthis = this;\n    var controller = this.getQuestionContainer();\n\n    \/\/ =========================\n    \/\/ SET THESE QIDs\n    \/\/ =========================\n\tvar qidQ2Interior = \"QID197\"; \n\tvar qidQ2Bottom = \"QID221\";    \n\tvar qidQ2Top = \"QID220\";      \n\n\t\/\/ Change these variable names:\n\tvar isInterior = \"${e:\/\/Field\/xgenerosity_interior}\" === \"1\";\n\tvar isBottom   = \"${e:\/\/Field\/xgenerosity_bottomcorner}\" === \"1\";\n\tvar isTop      = \"${e:\/\/Field\/xgenerosity_topcorner}\" === \"1\";\n\n    \/\/ Determine which version of question 2 to use\n    var qidQuestion2 = null;\n    if (isInterior) {\n        qidQuestion2 = qidQ2Interior;\n    } else if (isBottom) {\n        qidQuestion2 = qidQ2Bottom;\n    } else if (isTop) {\n        qidQuestion2 = qidQ2Top;\n    }\n\n    \/\/ Questions to hide\/reveal\n    var questionIDs = [qidQuestion2].filter(Boolean);\n\n    \/\/ Unique key for this page\n    var revealKey = \"revealed_\" + this.questionId;\n\n    function getNextButton() {\n        return document.getElementById(\"NextButton\");\n    }\n\n    function forceHideNextButton() {\n        qthis.hideNextButton();\n        var nextButton = getNextButton();\n        if (nextButton) {\n            nextButton.style.display = \"none\";\n            nextButton.style.visibility = \"hidden\";\n        }\n    }\n\n    function forceShowNextButton() {\n        qthis.showNextButton();\n        var nextButton = getNextButton();\n        if (nextButton) {\n            nextButton.style.display = \"\";\n            nextButton.style.visibility = \"\";\n        }\n    }\n\n    function hideQuestions() {\n        questionIDs.forEach(function (qid) {\n            var q = document.getElementById(qid);\n            if (q) {\n                q.style.visibility = \"hidden\";\n                q.style.height = \"0px\";\n                q.style.overflow = \"hidden\";\n                q.style.margin = \"0\";\n                q.style.padding = \"0\";\n            }\n        });\n    }\n\n    function showQuestions() {\n        questionIDs.forEach(function (qid) {\n            var q = document.getElementById(qid);\n            if (q) {\n                q.style.visibility = \"visible\";\n                q.style.height = \"auto\";\n                q.style.overflow = \"visible\";\n                q.style.margin = \"\";\n                q.style.padding = \"\";\n            }\n        });\n\n        setTimeout(function () {\n            window.dispatchEvent(new Event(\"resize\"));\n        }, 50);\n    }\n\n    var alreadyRevealed = sessionStorage.getItem(revealKey) === \"true\";\n\n    if (alreadyRevealed) {\n        showQuestions();\n        forceShowNextButton();\n        return;\n    }\n\n    \/\/ Hide immediately\n    forceHideNextButton();\n    hideQuestions();\n\n    \/\/ Create centered button\n    var wrapper = document.createElement(\"div\");\n    wrapper.style.textAlign = \"center\";\n    wrapper.style.margin = \"30px 0\";\n\n    \/\/ Read embedded color variables\n    var bgColor = \"${e:\/\/Field\/understanding_button_backgroundColor}\";\n    var borderColor = \"${e:\/\/Field\/understanding_button_border}\";\n    var textColor = \"${e:\/\/Field\/understanding_button_color}\";\n\n    \/\/ Fallbacks (in case something is missing)\n    bgColor = bgColor || \"#FFA500\";\n    borderColor = borderColor || \"#cc8400\";\n    textColor = textColor || \"#2b1a00\";\n\n    var button = document.createElement(\"button\");\n    button.type = \"button\";\n    button.innerHTML = \"Click to answer an understanding question\";\n\n    \/\/ Styling\n    button.style.padding = \"12px 24px\";\n    button.style.cursor = \"pointer\";\n    button.style.backgroundColor = bgColor;\n    button.style.border = \"1px solid \" + borderColor;\n    button.style.borderRadius = \"6px\";\n    button.style.fontSize = \"16px\";\n    button.style.fontWeight = \"600\";\n    button.style.color = textColor;\n\n    wrapper.appendChild(button);\n    controller.appendChild(wrapper);\n\n    button.addEventListener(\"click\", function () {\n        sessionStorage.setItem(revealKey, \"true\");\n\n        showQuestions();\n        forceShowNextButton();\n\n        wrapper.remove();\n    });\n});"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID303","SecondaryAttribute":"Instructions for Part ${e:\/\/Field\/current_part}, Round 2 of ${e:\/\/Field\/generosity_totalrounds} r...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Instructions for Part ${e:\/\/Field\/current_part}, Round 2 of ${e:\/\/Field\/generosity_totalrounds} rounds<\/strong><br \/>\n<br \/>\n<span>In this round, you earn a fixed payment of $1.50 for answering 12 questions.<\/span><br \/>\n<br \/>\nThese questions will ask you to compare your choices between &ldquo;equal payment&rdquo; and &ldquo;payment for self&rdquo; to those of other participants who went through the same study and are <strong>equally likely to be men or women.<\/strong><br \/>\n<br \/>\n<span>Recall, in Round 1, you selected between ($5 self, $5 other) and (fixed payment self, $0 other). <\/span>\n<ul>\n\t<li><span><strong>You never selected the equal payment and always chose payment for yourself&nbsp;and $0 for the other participant.<\/strong><\/span><\/li>\n<\/ul>","DefaultChoices":false,"DataExportTag":"Q252","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Instructions for Part ${e:\/\/Field\/current_part}, Round 2 of ${e:\/\/Field\/generosity_totalrounds} r...","DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">xgenerosity_bottomcorner<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> 1 <\/span>","LeftOperand":"xgenerosity_bottomcorner","LogicType":"EmbeddedField","Operator":"EqualTo","RightOperand":"1","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID303","QuestionJS":"Qualtrics.SurveyEngine.addOnReady(function () {\n    var qthis = this;\n    var controller = this.getQuestionContainer();\n\n    \/\/ =========================\n    \/\/ SET THESE QIDs\n    \/\/ =========================\n\tvar qidQ2Interior = \"QID197\"; \n\tvar qidQ2Bottom = \"QID221\";    \n\tvar qidQ2Top = \"QID220\";      \n\n\t\/\/ Change these variable names:\n\tvar isInterior = \"${e:\/\/Field\/xgenerosity_interior}\" === \"1\";\n\tvar isBottom   = \"${e:\/\/Field\/xgenerosity_bottomcorner}\" === \"1\";\n\tvar isTop      = \"${e:\/\/Field\/xgenerosity_topcorner}\" === \"1\";\n\n    \/\/ Determine which version of question 2 to use\n    var qidQuestion2 = null;\n    if (isInterior) {\n        qidQuestion2 = qidQ2Interior;\n    } else if (isBottom) {\n        qidQuestion2 = qidQ2Bottom;\n    } else if (isTop) {\n        qidQuestion2 = qidQ2Top;\n    }\n\n    \/\/ Questions to hide\/reveal\n    var questionIDs = [qidQuestion2].filter(Boolean);\n\n    \/\/ Unique key for this page\n    var revealKey = \"revealed_\" + this.questionId;\n\n    function getNextButton() {\n        return document.getElementById(\"NextButton\");\n    }\n\n    function forceHideNextButton() {\n        qthis.hideNextButton();\n        var nextButton = getNextButton();\n        if (nextButton) {\n            nextButton.style.display = \"none\";\n            nextButton.style.visibility = \"hidden\";\n        }\n    }\n\n    function forceShowNextButton() {\n        qthis.showNextButton();\n        var nextButton = getNextButton();\n        if (nextButton) {\n            nextButton.style.display = \"\";\n            nextButton.style.visibility = \"\";\n        }\n    }\n\n    function hideQuestions() {\n        questionIDs.forEach(function (qid) {\n            var q = document.getElementById(qid);\n            if (q) {\n                q.style.visibility = \"hidden\";\n                q.style.height = \"0px\";\n                q.style.overflow = \"hidden\";\n                q.style.margin = \"0\";\n                q.style.padding = \"0\";\n            }\n        });\n    }\n\n    function showQuestions() {\n        questionIDs.forEach(function (qid) {\n            var q = document.getElementById(qid);\n            if (q) {\n                q.style.visibility = \"visible\";\n                q.style.height = \"auto\";\n                q.style.overflow = \"visible\";\n                q.style.margin = \"\";\n                q.style.padding = \"\";\n            }\n        });\n\n        setTimeout(function () {\n            window.dispatchEvent(new Event(\"resize\"));\n        }, 50);\n    }\n\n    var alreadyRevealed = sessionStorage.getItem(revealKey) === \"true\";\n\n    if (alreadyRevealed) {\n        showQuestions();\n        forceShowNextButton();\n        return;\n    }\n\n    \/\/ Hide immediately\n    forceHideNextButton();\n    hideQuestions();\n\n    \/\/ Create centered button\n    var wrapper = document.createElement(\"div\");\n    wrapper.style.textAlign = \"center\";\n    wrapper.style.margin = \"30px 0\";\n\n    \/\/ Read embedded color variables\n    var bgColor = \"${e:\/\/Field\/understanding_button_backgroundColor}\";\n    var borderColor = \"${e:\/\/Field\/understanding_button_border}\";\n    var textColor = \"${e:\/\/Field\/understanding_button_color}\";\n\n    \/\/ Fallbacks (in case something is missing)\n    bgColor = bgColor || \"#FFA500\";\n    borderColor = borderColor || \"#cc8400\";\n    textColor = textColor || \"#2b1a00\";\n\n    var button = document.createElement(\"button\");\n    button.type = \"button\";\n    button.innerHTML = \"Click to answer an understanding question\";\n\n    \/\/ Styling\n    button.style.padding = \"12px 24px\";\n    button.style.cursor = \"pointer\";\n    button.style.backgroundColor = bgColor;\n    button.style.border = \"1px solid \" + borderColor;\n    button.style.borderRadius = \"6px\";\n    button.style.fontSize = \"16px\";\n    button.style.fontWeight = \"600\";\n    button.style.color = textColor;\n\n    wrapper.appendChild(button);\n    controller.appendChild(wrapper);\n\n    button.addEventListener(\"click\", function () {\n        sessionStorage.setItem(revealKey, \"true\");\n\n        showQuestions();\n        forceShowNextButton();\n\n        wrapper.remove();\n    });\n});"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID307","SecondaryAttribute":"Instructions for Part ${e:\/\/Field\/current_part}, Round 2 of ${e:\/\/Field\/generosity_totalrounds} r...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Instructions for Part ${e:\/\/Field\/current_part}, Round 2 of ${e:\/\/Field\/generosity_totalrounds} rounds<\/strong><br \/>\n<br \/>\nIn this round, you earn a fixed payment of $1.50 for answering 12 questions.<br \/>\n<br \/>\nThese questions will ask you to compare your choices between &ldquo;equal payment&rdquo; and &ldquo;payment for self&rdquo; to those of other participants<strong> <\/strong>who went through the same study and are <strong>equally likely to be men or women.<\/strong><br \/>\n<br \/>\nRecall, in Round 1, you selected between ($5 self, $5 other) and (fixed payment self, $0 other).\n<ul>\n\t<li><strong>You always selected the equal payment of $5 for yourself and $5 for the other participant.<\/strong><\/li>\n<\/ul>","DefaultChoices":false,"DataExportTag":"Q256","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Instructions for Part ${e:\/\/Field\/current_part}, Round 2 of ${e:\/\/Field\/generosity_totalrounds} r...","DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">xgenerosity_topcorner<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> 1 <\/span>","LeftOperand":"xgenerosity_topcorner","LogicType":"EmbeddedField","Operator":"EqualTo","RightOperand":"1","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID307","QuestionJS":"Qualtrics.SurveyEngine.addOnReady(function () {\n    var qthis = this;\n    var controller = this.getQuestionContainer();\n    \/\/ Replace with your actual QIDs\n    var questionIDs = [\"QID199\", \"QID201\", \"QID338\", \"QID341\"];\n    \/\/ Unique key for this page\n    var revealKey = \"revealed_\" + this.questionId;\n    \/\/ Get Qualtrics Next button\n    var nextButton = document.getElementById(\"NextButton\");\n    \/\/ =========================\n    \/\/ Read embedded color variables\n    \/\/ =========================\n    var bgColor = \"${e:\/\/Field\/main_button_backgroundColor}\";\n    var borderColor = \"${e:\/\/Field\/main_button_border}\";\n    var textColor = \"${e:\/\/Field\/main_button_color}\";\n    \/\/ Fallbacks\n    bgColor = bgColor || \"#AFE1AF\";\n    borderColor = borderColor || \"#7FBF7F\";\n    textColor = textColor || \"#1f3d1f\";\n    function hideQuestions() {\n        questionIDs.forEach(function(qid) {\n            var q = document.getElementById(qid);\n            if (q) {\n                q.style.visibility = \"hidden\";\n                q.style.height = \"0px\";\n                q.style.overflow = \"hidden\";\n                q.style.margin = \"0\";\n                q.style.padding = \"0\";\n            }\n        });\n    }\n    function showQuestions() {\n        questionIDs.forEach(function(qid) {\n            var q = document.getElementById(qid);\n            if (q) {\n                q.style.visibility = \"visible\";\n                q.style.height = \"auto\";\n                q.style.overflow = \"visible\";\n                q.style.margin = \"\";\n                q.style.padding = \"\";\n                void q.offsetHeight;\n            }\n        });\n        setTimeout(function() {\n            window.dispatchEvent(new Event(\"resize\"));\n        }, 50);\n    }\n    \/\/ Color helper for hover\n    function darkenColor(hex, factor) {\n        hex = hex.replace(\"#\", \"\");\n        var r = parseInt(hex.substring(0,2), 16);\n        var g = parseInt(hex.substring(2,4), 16);\n        var b = parseInt(hex.substring(4,6), 16);\n        r = Math.floor(r * factor);\n        g = Math.floor(g * factor);\n        b = Math.floor(b * factor);\n        return \"#\" + [r,g,b].map(x => x.toString(16).padStart(2,\"0\")).join(\"\");\n    }\n    \/\/ Check whether questions were already revealed\n    var alreadyRevealed = sessionStorage.getItem(revealKey) === \"true\";\n    if (alreadyRevealed) {\n        showQuestions();\n        qthis.showNextButton();\n        if (nextButton) {\n            nextButton.style.display = \"\";\n        }\n        return;\n    }\n    \/\/ First load: hide Next button and questions\n    qthis.hideNextButton();\n    if (nextButton) {\n        nextButton.style.display = \"none\";\n    }\n    hideQuestions();\n    \/\/ Create centered button\n    var wrapper = document.createElement(\"div\");\n    wrapper.style.textAlign = \"center\";\n    wrapper.style.margin = \"30px 0\";\n    var button = document.createElement(\"button\");\n    button.type = \"button\";\n    button.innerHTML = \"Click to answer the first 4 questions\";\n    \/\/ Styling\n    button.style.padding = \"12px 24px\";\n    button.style.cursor = \"pointer\";\n    button.style.backgroundColor = bgColor;\n    button.style.border = \"1px solid \" + borderColor;\n    button.style.borderRadius = \"6px\";\n    button.style.fontSize = \"16px\";\n    button.style.fontWeight = \"600\";\n    button.style.color = textColor;\n    \/\/ Hover effect\n    var hoverColor = darkenColor(bgColor, 0.9);\n    button.addEventListener(\"mouseenter\", function() {\n        button.style.backgroundColor = hoverColor;\n    });\n    button.addEventListener(\"mouseleave\", function() {\n        button.style.backgroundColor = bgColor;\n    });\n    wrapper.appendChild(button);\n    controller.appendChild(wrapper);\n    button.addEventListener(\"click\", function () {\n        sessionStorage.setItem(revealKey, \"true\");\n        showQuestions();\n        qthis.showNextButton();\n        if (nextButton) {\n            nextButton.style.display = \"\";\n        }\n        wrapper.remove();\n    });\n});"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID308","SecondaryAttribute":"Instructions for Part ${e:\/\/Field\/current_part}, Round 2 of ${e:\/\/Field\/generosity_totalrounds} r...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Instructions for Part ${e:\/\/Field\/current_part}, Round 2 of ${e:\/\/Field\/generosity_totalrounds} rounds<\/strong><br \/>\n<br \/>\nIn this round, you earn a fixed payment of $1.50 for answering 12 questions.<br \/>\n<br \/>\nThese questions will ask you to compare your choices between &ldquo;equal payment&rdquo; and &ldquo;payment for self&rdquo; to those of other participants who went through the same study and are <strong>equally likely to be men or women.<\/strong><br \/>\n<br \/>\nRecall, in Round 1, you selected between ($5 self, $5 other) and (fixed payment self, $0 other).\n<ul>\n\t<li>You first chose an equal payment for you and the other participant. Then, <strong>when your fixed payment reached $${e:\/\/Field\/xgenerosity_xr} or more, you chose payment for yourself and $0 for the other participant.<\/strong><\/li>\n<\/ul>","DefaultChoices":false,"DataExportTag":"Q257","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Instructions for Part ${e:\/\/Field\/current_part}, Round 2 of ${e:\/\/Field\/generosity_totalrounds} r...","DisplayLogic":{"0":{"0":{"Description":"<span class