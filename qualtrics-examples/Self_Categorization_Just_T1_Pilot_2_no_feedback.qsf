subMessageID":"VE_ERROR","libraryID":"UR_cZPMLrEO6JJWxpk","description":"Error Text"}}}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID142"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID143","SecondaryAttribute":"Understanding Question: If the row-that-counts is\u00a0one where you chose Option B, the \u201cPayment for.","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Understanding Question: <\/strong>If the row-that-counts is&nbsp;one where you chose Option B, the \u201cPayment for Self\u201d option at $8, what payment will you receive?","DataExportTag":"gen_comp_check_2","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Understanding Question: If the row-that-counts is\u00a0one where you chose Option B, the \u201cPayment for...","Choices":{"1":{"Display":"$0.00"},"2":{"Display":"$5"},"3":{"Display":"$8"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"QuestionID":"QID143","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID143\/SelectableChoice\/3","Operator":"Selected","QuestionIDFromLocator":"QID143","LeftOperand":"q:\/\/QID143\/SelectableChoice\/3","Type":"Expression","LogicType":"Question","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Understanding Question: If the row-that-counts is&amp;nbsp;one where you chose Option B, the \u201cPayment for Self\u201d option at $8, what payment will you receive?<\/span> <span class=\"LeftOpDesc\">$8<\/span> <span class=\"OpDesc\">Is Selected<\/span> "},"Type":"If"},"Type":"BooleanExpression"},"Message":{"messageID":"MS_jHNVdNnhu9SyaST","subMessageID":"VE_ERROR","libraryID":"UR_cZPMLrEO6JJWxpk","description":"Error Text"}}}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID143"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID144","SecondaryAttribute":"Instructions for Rounds 3 & 4 of the\u00a0${e:\/\/Field\/comp_totalrounds} rounds of Part\u00a0...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Instructions for Rounds 3 &amp; 4 of the&nbsp;${e:\/\/Field\/comp_totalrounds} rounds of Part&nbsp;${e:\/\/Field\/current_part}<\/strong><br>\n<br>\nYou will complete a third math task in Round ${e:\/\/Field\/comp_totalrounds}. Before you complete the math task in Round ${e:\/\/Field\/comp_totalrounds}, and before we tell you details about Round 3, you have to make some decisions.&nbsp;<br>\n<br>\nSpecifically, you first decide how you are paid for this math task in Round ${e:\/\/Field\/comp_totalrounds}.","DefaultChoices":false,"DataExportTag":"Q93","QuestionID":"QID144","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Instructions for Rounds 3 & 4 of the\u00a0${e:\/\/Field\/comp_totalrounds} rounds of Part\u00a0...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID145","SecondaryAttribute":"Understanding Question:\u00a0Suppose in the row-that-counts you chose Option A, the tournament payment..","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Understanding Question:<\/strong>&nbsp;Suppose in the row-that-counts you chose Option A, the tournament payment. What is the payment per point if you win the tournament?","DataExportTag":"comp_mpl_check_1","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Understanding Question:\u00a0Suppose in the row-that-counts you chose Option A, the tournament payment...","Choices":{"1":{"Display":"$0.00 per point"},"2":{"Display":"$0.50 per point"},"3":{"Display":"$2.00 per point"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID145\/SelectableChoice\/3","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Understanding check: If Round 5 (4) is selected as the round-that-counts, and the randomly selected row is one where you chose Option A, the tournament payment, what is the tournament payment per c...<\/span> <span class=\"LeftOpDesc\">$2.00 per correct problem<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID145\/SelectableChoice\/3","LogicType":"Question","Operator":"Selected","QuestionID":"QID145","QuestionIDFromLocator":"QID145","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"Error Text","libraryID":"UR_cZPMLrEO6JJWxpk","messageID":"MS_jHNVdNnhu9SyaST","subMessageID":"VE_ERROR"}}}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID145"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID146","SecondaryAttribute":"Understanding Question: Suppose in the row-that-counts you chose Option B, the fixed payment at $...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Understanding Question:<\/strong>  Suppose in the row-that-counts you chose Option B, the fixed payment at $0.40. What is the payment per point?","DataExportTag":"comp_mpl_check_2","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Understanding Question: Suppose in the row-that-counts you chose Option B, the fixed payment at $...","Choices":{"1":{"Display":"$0.00 per point"},"2":{"Display":"$0.40 per point"},"3":{"Display":"$2.00 per point"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID146\/SelectableChoice\/2","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Understanding check: If Round 5 (4) is selected as the round-that-counts, and the randomly selected row is one where you chose Option B, the fixed payment at $0.40, what is the fixed payment per co...<\/span> <span class=\"LeftOpDesc\">$0.40 per correct problem<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID146\/SelectableChoice\/2","LogicType":"Question","Operator":"Selected","QuestionID":"QID146","QuestionIDFromLocator":"QID146","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"Error Text","libraryID":"UR_cZPMLrEO6JJWxpk","messageID":"MS_jHNVdNnhu9SyaST","subMessageID":"VE_ERROR"}}}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID146"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID148","SecondaryAttribute":"Protocol Director: Professor Muriel Niederle Protocol Number: IRB-44866 IRB Approval Date: March...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Protocol Director:<\/strong> Professor Muriel Niederle<br>\n<br>\nProtocol Number: IRB-44866<br>\nIRB Approval Date: March 31, 2025<br>\nExpiration Date: March 31, 2026<br>\n<br>\n<strong>Description: <\/strong>You are invited to participate in a research study on decision-making. You will be asked to read several pages of instructions. Then you will be asked to make several choices that will determine the precise amount you will be paid, and then possibly answer several survey questions.<br>\n<br>\n<strong>Risk and benefits: <\/strong>We cannot and do not guarantee or promise that you will receive any benefits from this study. There are no risks associated with this study.<br>\n<br>\n<strong>Time involvement:<\/strong> Your participation in this experiment will take approximately as long as is indicated in the advertisement.<br>\n<br>\n<strong>Payments: <\/strong>You will be compensated at the advertised rate.<br>\n<br>\n<strong>Subject\u2019s rights:<\/strong> If you have read this form and have decided to participate in this project, please understand your participation is voluntary and you have the right to discontinue participation at any time without penalty or loss of benefits to which you are otherwise entitled. You have the right to refuse to answer particular questions. Your individual privacy will be maintained in all published and written data resulting from the study.<br>\n<br>\n<strong>Contact information:<\/strong> Questions, concerns, or complaints: If you have any questions, concerns or complaints about this research study, its procedures, risk and benefits, you should ask the Protocol Director, Muriel Niederle, (650)-723-7359.<br>\n<br>\n<strong>Independent Contact:<\/strong> If you are not satisfied with how this study is being conducted, or if you have any concerns, complaints, or general questions about the research or your rights as a participant, please contact the Stanford Institutional Review Board (IRB) to speak to someone independent of the research team at (650)-723-2480 or toll free at 1-866-680-2906. You can also write to the Stanford IRB, Stanford University, Stanford, CA 94305-5401.<br>\n<br>\n<strong>By continuing with this study, you are consenting to participate. <\/strong>Please make a copy of this consent form for your own records. You can do so by right-clicking and selecting \u201cprint\u201d in most browsers. If you cannot do so on your browser, please contact the protocol director for a copy of the consent form.\n<p>&nbsp;<\/p>","QuestionJS":"\/\/ INCREMENT current_page\nQualtrics.SurveyEngine.addOnPageSubmit(function()\n{\t\n\tlet currentPage = parseInt(\"${e:\/\/Field\/current_page}\");\n\n\tcurrentPage = currentPage + 1;\n\tQualtrics.SurveyEngine.setEmbeddedData(\"current_page\", currentPage);\n\tconsole.log(\"current_page\", currentPage);\n});","DefaultChoices":false,"DataExportTag":"consent","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Protocol Director: Professor Muriel Niederle Protocol Number: IRB-44866 IRB Approval Date: March...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID148"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID15","SecondaryAttribute":"Which of the following racial or ethnic groups do you identify with? (You may select all that apply)","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[1,2,3,4,5,6,7,8,9],"Choices":{"1":{"Display":"<strong>American Indian or Alaska Native<\/strong> (e.g., Navajo Nation, Blackfeet Tribe, Inupiat Traditional Gov&#39;t., etc.)"},"2":{"Display":"<strong>Asian or Asian American<\/strong> (e.g., Chinese, Japanese, Filipino, Korean, South Asian, Vietnamese, etc.)"},"3":{"Display":"<strong>Black or African American<\/strong> (e.g., Jamaican, Nigerian, Haitian, Ethiopian, etc.)"},"4":{"Display":"<strong>Hispanic or Latino\/a<\/strong> (e.g., Puerto Rican, Mexican, Cuban, Salvadoran, Colombian, etc.)"},"5":{"Display":"<strong>Middle Eastern or North African<\/strong> (e.g., Lebanese, Iranian, Egyptian, Moroccan, Israeli, Palestinian, etc.)"},"6":{"Display":"<strong>Native Hawaiian or Pacific Islander <\/strong>(e.g., Samoan, Guamanian, Chamorro, Tongan, etc.)"},"7":{"Display":"<strong>White or European<\/strong> (e.g., German, Irish, English, Italian, Polish, French, etc.)"},"8":{"Display":"<strong>My race or ethnicity is best described as:<\/strong><br \/>\n<br \/>\n<em>(Feel free to use the text box and\/or you can simply select categories above.)<\/em><br \/>\n&nbsp;","TextEntry":"true"},"9":{"Display":"Prefer not to say"}},"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"race","DataVisibility":{"Hidden":false,"Private":false},"Language":[],"NextAnswerId":1,"NextChoiceId":11,"QuestionDescription":"Which of the following racial or ethnic groups do you identify with? (You may select all that apply)","QuestionID":"QID15","QuestionText":"<b>Which of the following racial or ethnic groups do you identify with? (You may select all that apply)<\/b>","QuestionText_Unsafe":"<b>Which of the following racial or ethnic groups do you identify with? (Mark all that apply)<\/b>","QuestionType":"MC","Selector":"MAVR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None","MinChoices":"1"}}}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID151","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Q100","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":120,"MaxSeconds":120,"ShowTimer":true,"Seconds":120},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":108,"NextAnswerId":1,"QuestionID":"QID151"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID152","SecondaryAttribute":"Round 1 Fixed payment: $0.50 per point","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:22px;\"><strong>Round 1 Fixed payment: $0.50 per point<\/strong><\/span>\n<ul>\n<\/ul>","DefaultChoices":false,"DataExportTag":"round_1_math_quiz","QuestionID":"QID152","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Round 1 Fixed payment: $0.50 per point","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionJS":"Qualtrics.SurveyEngine.addOnReady(function()\n{\n\tconst qthis = this;\n\tconst questionContainer = this.getQuestionContainer();\n\n\t\/\/ Must be set in Survey Flow before this question:\n\t\/\/ gameRoundCode = P   or   FT   or   C\n\tconst roundCode = \"${e:\/\/Field\/gameRoundCode}\";\n\n\tconst style = document.createElement('style');\n\tstyle.textContent = `\n\t\t.q-grid-3x3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin: 16px 0; max-width: 720px }\n\t\t.q-counter { margin: 8px 0 12px 0; font-weight: 600; font-size: 1.1em; }\n\t\t.q-grid-3x3 > div { aspect-ratio: 2 \/ 1; display: flex; align-items: center; justify-content: center; border: 1px solid #ccc; border-radius: 12px; font-weight: 600; font-size: 1.5em; transition: background-color .2s, border-color .2s, color .2s }\n\t\t.q-grid-3x3 > div.waiting { background: #f6f8fa; border-color: #ddd; color: #9aa3ad; cursor: not-allowed }\n\t\t.q-grid-3x3 > div.ready { background: #eaf2ff; border-color: #90b4ff; color: #10273f; cursor: pointer }\n\t\t.q-grid-3x3 > div.ready:hover { background: #dbe9ff; border-color: #79a6ff }\n\t\t.q-grid-3x3 > div.finished { background: #f6f6f6; border-color: #d0d0d0; color: #666; cursor: default }\n\t`;\n\tdocument.head.appendChild(style);\n\n\tconst delayMs = 0;\n\tconst maxAttempts = 30;\n\n\tfunction randInt(min, max) {\n\t\twhile (true) {\n\t\t\tconst x = Math.floor(Math.random() * (max - min + 1)) + min;\n\t\t\tif (x % 10 !== 0) return x;\n\t\t}\n\t}\n\n\tfunction shuffle(array) {\n\t\tlet m = array.length;\n\t\twhile (m > 0) {\n\t\t\tconst idx = Math.floor(Math.random() * m);\n\t\t\tm -= 1;\n\t\t\tconst temp = array[m];\n\t\t\tarray[m] = array[idx];\n\t\t\tarray[idx] = temp;\n\t\t}\n\t\treturn array;\n\t}\n\n\tfunction pairKey(a, b) {\n\t\treturn a + ',' + b;\n\t}\n\n\tfunction onesSumTo10(a, b) {\n\t\treturn (a % 10) + (b % 10) === 10;\n\t}\n\n\tfunction pairToString(p) {\n\t\treturn '(' + p[0] + ',' + p[1] + ')';\n\t}\n\n\tfunction serializeSet(set) {\n\t\tlet out = [];\n\t\tlet i = 0;\n\t\twhile (i < set.length) {\n\t\t\tout.push(pairToString(set[i]));\n\t\t\ti += 1;\n\t\t}\n\t\treturn out.join('|');\n\t}\n\n\tfunction edName(base, attemptNumber) {\n\t\tif (typeof attemptNumber === 'number') {\n\t\t\treturn base + roundCode + attemptNumber;\n\t\t}\n\t\treturn base + roundCode;\n\t}\n\n\tfunction setED(name, value) {\n\t\tQualtrics.SurveyEngine.setEmbeddedData(name, String(value));\n\t}\n\n\tfunction generateEqual100Pair(used, requireOnes10) {\n\t\twhile (true) {\n\t\t\tconst a = randInt(10, 90);\n\t\t\tconst b = 100 - a;\n\n\t\t\tif (b < 10 || b > 99) continue;\n\t\t\tif (b % 10 === 0) continue;\n\n\t\t\tif (requireOnes10 && !onesSumTo10(a, b)) continue;\n\t\t\tif (!requireOnes10 && onesSumTo10(a, b)) continue;\n\n\t\t\tconst key = pairKey(a, b);\n\t\t\tif (used[key]) continue;\n\n\t\t\tused[key] = true;\n\t\t\treturn [a, b];\n\t\t}\n\t}\n\n\tfunction generateAbove100Pair(used, requireOnes10) {\n\t\twhile (true) {\n\t\t\tconst a = randInt(10, 99);\n\t\t\tconst b = randInt(10, 99);\n\t\t\tconst total = a + b;\n\n\t\t\tif (total <= 100 || total >= 120) continue;\n\n\t\t\tif (requireOnes10 && !onesSumTo10(a, b)) continue;\n\t\t\tif (!requireOnes10 && onesSumTo10(a, b)) continue;\n\n\t\t\tconst key = pairKey(a, b);\n\t\t\tif (used[key]) continue;\n\n\t\t\tused[key] = true;\n\t\t\treturn [a, b];\n\t\t}\n\t}\n\n\tfunction generateBelow100Pair(used, requireOnes10) {\n\t\twhile (true) {\n\t\t\tconst a = randInt(10, 99);\n\t\t\tconst b = randInt(10, 99);\n\t\t\tconst total = a + b;\n\n\t\t\tif (total <= 80 || total >= 100) continue;\n\n\t\t\tif (requireOnes10 && !onesSumTo10(a, b)) continue;\n\t\t\tif (!requireOnes10 && onesSumTo10(a, b)) continue;\n\n\t\t\tconst key = pairKey(a, b);\n\t\t\tif (used[key]) continue;\n\n\t\t\tused[key] = true;\n\t\t\treturn [a, b];\n\t\t}\n\t}\n\n\tfunction generateOneSet() {\n\t\tconst used = {};\n\t\tconst set = [];\n\n\t\t\/\/ Exactly 3 of 9 pairs have ones digits summing to 10:\n\t\t\/\/ 1 exact-100, 1 above-100, 1 below-100\n\t\tset.push(generateEqual100Pair(used, true));\n\n\t\tset.push(generateAbove100Pair(used, true));\n\t\tset.push(generateAbove100Pair(used, false));\n\t\tset.push(generateAbove100Pair(used, false));\n\t\tset.push(generateAbove100Pair(used, false));\n\n\t\tset.push(generateBelow100Pair(used, true));\n\t\tset.push(generateBelow100Pair(used, false));\n\t\tset.push(generateBelow100Pair(used, false));\n\t\tset.push(generateBelow100Pair(used, false));\n\n\t\tshuffle(set);\n\t\treturn set;\n\t}\n\n\tconst counter = document.createElement('div');\n\tcounter.className = 'q-counter';\n\tcounter.innerHTML = \"<strong>You have 0 points (0 correct problems, 0 mistakes)<\/strong>\";\n\n\tconst grid = document.createElement('div');\n\tgrid.className = 'q-grid-3x3';\n\n\tquestionContainer.appendChild(counter);\n\tquestionContainer.appendChild(grid);\n\n\tconst cells = [];\n\tlet j = 0;\n\twhile (j < 9) {\n\t\tconst cell = document.createElement('div');\n\t\tgrid.appendChild(cell);\n\t\tcells.push(cell);\n\t\tj += 1;\n\t}\n\n\tlet currentSet = generateOneSet();\n\tlet score = 0;\n\tlet totalAttempted = 0;\n\tlet totalCorrect = 0;\n\tlet totalIncorrect = 0;\n\tlet locked = false;\n\tlet enabled = false;\n\tlet timer = null;\n\tlet finished = false;\n\tlet matrixStartMs = null;\n\n\tfunction computePoints(correct, incorrect) {\n\t\tif (correct <= incorrect) return 0;\n\t\treturn correct - incorrect;\n\t}\n\n\tfunction updateCounter() {\n\t\tconst pointWord = (score === 1) ? \"point\" : \"points\";\n\t\tconst correctWord = (totalCorrect === 1) ? \"problem\" : \"problems\";\n\t\tconst incorrectWord = (totalIncorrect === 1) ? \"mistake\" : \"mistakes\";\n\n\t\tcounter.innerHTML =\n\t\t\t\"<strong>You have \" + score + \" \" + pointWord +\n\t\t\t\" (\" + totalCorrect + \" correct \" + correctWord +\n\t\t\t\", \" + totalIncorrect + \" \" + incorrectWord + \")<\/strong>\";\n\t}\n\n\tfunction setWaiting() {\n\t\tlet k = 0;\n\t\twhile (k < cells.length) {\n\t\t\tcells[k].classList.remove('ready', 'finished');\n\t\t\tcells[k].classList.add('waiting');\n\t\t\tk += 1;\n\t\t}\n\t}\n\n\tfunction setReady() {\n\t\tlet k = 0;\n\t\twhile (k < cells.length) {\n\t\t\tcells[k].classList.remove('waiting', 'finished');\n\t\t\tcells[k].classList.add('ready');\n\t\t\tk += 1;\n\t\t}\n\t}\n\n\tfunction setFinishedView() {\n\t\tlet k = 0;\n\t\twhile (k < cells.length) {\n\t\t\tcells[k].classList.remove('waiting', 'ready');\n\t\t\tcells[k].classList.add('finished');\n\t\t\tk += 1;\n\t\t}\n\t}\n\n\tfunction readyNow() {\n\t\tif (finished) return;\n\t\tenabled = true;\n\t\tmatrixStartMs = Date.now();\n\t\tsetReady();\n\t}\n\n\tfunction scheduleReady() {\n\t\tif (timer) clearTimeout(timer);\n\t\tenabled = false;\n\t\tmatrixStartMs = null;\n\t\tsetWaiting();\n\t\ttimer = setTimeout(readyNow, delayMs);\n\t}\n\n\tfunction render() {\n\t\tlet k = 0;\n\t\twhile (k < 9) {\n\t\t\tconst p = currentSet[k];\n\t\t\tcells[k].textContent = '(' + p[0] + ', ' + p[1] + ')';\n\t\t\tcells[k].dataset.idx = k;\n\t\t\tk += 1;\n\t\t}\n\t\tscheduleReady();\n\t}\n\n\tfunction timeSpentNow() {\n\t\tif (matrixStartMs === null) return '';\n\t\treturn Date.now() - matrixStartMs;\n\t}\n\n\tfunction saveSummary() {\n\t\tsetED(edName('totalCorrect'), totalCorrect);\n\t\tsetED(edName('totalIncorrect'), totalIncorrect);\n\t\tsetED(edName('totalAttempted'), totalAttempted);\n\t\tsetED(edName('totalPoints'), score);\n\t\tsetED(edName('maxAttempts'), maxAttempts);\n\t}\n\n\tfunction saveAttempt(attemptNumber, matrixSet, chosenPair, isCorrect, timeSpentMs) {\n\t\tsetED(edName('matrixNumber', attemptNumber), attemptNumber);\n\t\tsetED(edName('matrixPairs', attemptNumber), serializeSet(matrixSet));\n\t\tsetED(edName('chosenPair', attemptNumber), pairToString(chosenPair));\n\t\tsetED(edName('isCorrect', attemptNumber), isCorrect);\n\t\tsetED(edName('timeSpentMs', attemptNumber), timeSpentMs);\n\t\tsetED(edName('matrixExitTimeSpentMs', attemptNumber), timeSpentMs);\n\t}\n\n\tfunction initializeEmptyFields() {\n\t\tlet n = 1;\n\t\twhile (n <= maxAttempts) {\n\t\t\tsetED(edName('matrixNumber', n), '');\n\t\t\tsetED(edName('matrixPairs', n), '');\n\t\t\tsetED(edName('chosenPair', n), '');\n\t\t\tsetED(edName('isCorrect', n), '');\n\t\t\tsetED(edName('timeSpentMs', n), '');\n\t\t\tsetED(edName('matrixExitTimeSpentMs', n), '');\n\t\t\tn += 1;\n\t\t}\n\n\t\tsetED(edName('surveyExitTimeSpentMs'), '');\n\t\tsetED(edName('totalIncorrect'), '');\n\t\tsetED(edName('totalPoints'), '');\n\t\tsaveSummary();\n\t}\n\n\tfunction finishGame() {\n\t\tfinished = true;\n\t\tenabled = false;\n\t\tlocked = true;\n\t\tif (timer) clearTimeout(timer);\n\n\t\tconst surveyExitTimeSpentMs = timeSpentNow();\n\t\tsetED(edName('surveyExitTimeSpentMs'), surveyExitTimeSpentMs);\n\t\tsaveSummary();\n\t\tsetFinishedView();\n\n\t\tconsole.log('GAME FINISHED', {\n\t\t\troundCode: roundCode,\n\t\t\ttotalCorrect: totalCorrect,\n\t\t\ttotalIncorrect: totalIncorrect,\n\t\t\ttotalAttempted: totalAttempted,\n\t\t\ttotalPoints: score,\n\t\t\tsurveyExitTimeSpentMs: surveyExitTimeSpentMs\n\t\t});\n\n\t\t\/\/ No autoadvance here.\n\t}\n\n\tfunction nextSet() {\n\t\tcurrentSet = generateOneSet();\n\t\trender();\n\t}\n\n\tfunction pick(e) {\n\t\tif (!enabled) return;\n\t\tif (locked) return;\n\t\tif (finished) return;\n\n\t\tlocked = true;\n\n\t\tconst idx = Number(e.currentTarget.dataset.idx);\n\t\tconst p = currentSet[idx];\n\t\tconst ok = (p[0] + p[1] === 100) ? 1 : 0;\n\t\tconst attemptNumber = totalAttempted + 1;\n\t\tconst matrixShown = currentSet.slice(0);\n\t\tconst timeSpentMs = timeSpentNow();\n\n\t\ttotalAttempted += 1;\n\n\t\tif (ok === 1) {\n\t\t\ttotalCorrect += 1;\n\t\t} else {\n\t\t\ttotalIncorrect += 1;\n\t\t}\n\n\t\tscore = computePoints(totalCorrect, totalIncorrect);\n\n\t\tsaveAttempt(attemptNumber, matrixShown, p, ok, timeSpentMs);\n\t\tupdateCounter();\n\t\tsaveSummary();\n\n\t\tconsole.log('ANSWER SAVED', {\n\t\t\troundCode: roundCode,\n\t\t\tattemptNumber: attemptNumber,\n\t\t\tmatrixNumberVar: edName('matrixNumber', attemptNumber),\n\t\t\tmatrixPairsVar: edName('matrixPairs', attemptNumber),\n\t\t\tchosenPairVar: edName('chosenPair', attemptNumber),\n\t\t\tisCorrectVar: edName('isCorrect', attemptNumber),\n\t\t\ttimeSpentVar: edName('timeSpentMs', attemptNumber),\n\t\t\tmatrixExitTimeSpentVar: edName('matrixExitTimeSpentMs', attemptNumber),\n\t\t\tmatrixPairs: serializeSet(matrixShown),\n\t\t\tchosenPair: pairToString(p),\n\t\t\tisCorrect: ok,\n\t\t\ttimeSpentMs: timeSpentMs,\n\t\t\ttotalCorrectSoFar: totalCorrect,\n\t\t\ttotalIncorrectSoFar: totalIncorrect,\n\t\t\ttotalAttemptedSoFar: totalAttempted,\n\t\t\ttotalPointsSoFar: score\n\t\t});\n\n\t\tif (totalAttempted >= maxAttempts) {\n\t\t\tfinishGame();\n\t\t\treturn;\n\t\t}\n\n\t\tnextSet();\n\t\tlocked = false;\n\t}\n\n\tlet k = 0;\n\twhile (k < cells.length) {\n\t\tcells[k].addEventListener('click', pick);\n\t\tk += 1;\n\t}\n\n\tinitializeEmptyFields();\n\tupdateCounter();\n\trender();\n});"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID157","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":120,"MaxSeconds":120,"ShowTimer":true,"Seconds":120},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":108,"NextAnswerId":1,"QuestionText_Unsafe":"Timing","DataExportTag":"Q157","QuestionID":"QID157"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID158","SecondaryAttribute":"Round 2 Tournament: Winner: $2 per point","TertiaryAttribute":null,"Payload":{"QuestionText":"<span style=\"font-size:22px;\"><strong>Round 2 Tournament: Winner: $2 per point<\/strong><\/span>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Round 2 Tournament: Winner: $2 per point","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionJS":"Qualtrics.SurveyEngine.addOnReady(function()\n{\n\tconst qthis = this;\n\tconst questionContainer = this.getQuestionContainer();\n\n\t\/\/ Must be set in Survey Flow before this question:\n\t\/\/ gameRoundCode = P   or   FT   or   C\n\tconst roundCode = \"${e:\/\/Field\/gameRoundCode}\";\n\n\tconst style = document.createElement('style');\n\tstyle.textContent = `\n\t\t.q-grid-3x3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin: 16px 0; max-width: 720px }\n\t\t.q-counter { margin: 8px 0 12px 0; font-weight: 600; font-size: 1.1em; }\n\t\t.q-grid-3x3 > div { aspect-ratio: 2 \/ 1; display: flex; align-items: center; justify-content: center; border: 1px solid #ccc; border-radius: 12px; font-weight: 600; font-size: 1.5em; transition: background-color .2s, border-color .2s, color .2s }\n\t\t.q-grid-3x3 > div.waiting { background: #f6f8fa; border-color: #ddd; color: #9aa3ad; cursor: not-allowed }\n\t\t.q-grid-3x3 > div.ready { background: #eaf2ff; border-color: #90b4ff; color: #10273f; cursor: pointer }\n\t\t.q-grid-3x3 > div.ready:hover { background: #dbe9ff; border-color: #79a6ff }\n\t\t.q-grid-3x3 > div.finished { background: #f6f6f6; border-color: #d0d0d0; color: #666; cursor: default }\n\t`;\n\tdocument.head.appendChild(style);\n\n\tconst delayMs = 0;\n\tconst maxAttempts = 30;\n\n\tfunction randInt(min, max) {\n\t\twhile (true) {\n\t\t\tconst x = Math.floor(Math.random() * (max - min + 1)) + min;\n\t\t\tif (x % 10 !== 0) return x;\n\t\t}\n\t}\n\n\tfunction shuffle(array) {\n\t\tlet m = array.length;\n\t\twhile (m > 0) {\n\t\t\tconst idx = Math.floor(Math.random() * m);\n\t\t\tm -= 1;\n\t\t\tconst temp = array[m];\n\t\t\tarray[m] = array[idx];\n\t\t\tarray[idx] = temp;\n\t\t}\n\t\treturn array;\n\t}\n\n\tfunction pairKey(a, b) {\n\t\treturn a + ',' + b;\n\t}\n\n\tfunction onesSumTo10(a, b) {\n\t\treturn (a % 10) + (b % 10) === 10;\n\t}\n\n\tfunction pairToString(p) {\n\t\treturn '(' + p[0] + ',' + p[1] + ')';\n\t}\n\n\tfunction serializeSet(set) {\n\t\tlet out = [];\n\t\tlet i = 0;\n\t\twhile (i < set.length) {\n\t\t\tout.push(pairToString(set[i]));\n\t\t\ti += 1;\n\t\t}\n\t\treturn out.join('|');\n\t}\n\n\tfunction edName(base, attemptNumber) {\n\t\tif (typeof attemptNumber === 'number') {\n\t\t\treturn base + roundCode + attemptNumber;\n\t\t}\n\t\treturn base + roundCode;\n\t}\n\n\tfunction setED(name, value) {\n\t\tQualtrics.SurveyEngine.setEmbeddedData(name, String(value));\n\t}\n\n\tfunction generateEqual100Pair(used, requireOnes10) {\n\t\twhile (true) {\n\t\t\tconst a = randInt(10, 90);\n\t\t\tconst b = 100 - a;\n\n\t\t\tif (b < 10 || b > 99) continue;\n\t\t\tif (b % 10 === 0) continue;\n\n\t\t\tif (requireOnes10 && !onesSumTo10(a, b)) continue;\n\t\t\tif (!requireOnes10 && onesSumTo10(a, b)) continue;\n\n\t\t\tconst key = pairKey(a, b);\n\t\t\tif (used[key]) continue;\n\n\t\t\tused[key] = true;\n\t\t\treturn [a, b];\n\t\t}\n\t}\n\n\tfunction generateAbove100Pair(used, requireOnes10) {\n\t\twhile (true) {\n\t\t\tconst a = randInt(10, 99);\n\t\t\tconst b = randInt(10, 99);\n\t\t\tconst total = a + b;\n\n\t\t\tif (total <= 100 || total >= 120) continue;\n\n\t\t\tif (requireOnes10 && !onesSumTo10(a, b)) continue;\n\t\t\tif (!requireOnes10 && onesSumTo10(a, b)) continue;\n\n\t\t\tconst key = pairKey(a, b);\n\t\t\tif (used[key]) continue;\n\n\t\t\tused[key] = true;\n\t\t\treturn [a, b];\n\t\t}\n\t}\n\n\tfunction generateBelow100Pair(used, requireOnes10) {\n\t\twhile (true) {\n\t\t\tconst a = randInt(10, 99);\n\t\t\tconst b = randInt(10, 99);\n\t\t\tconst total = a + b;\n\n\t\t\tif (total <= 80 || total >= 100) continue;\n\n\t\t\tif (requireOnes10 && !onesSumTo10(a, b)) continue;\n\t\t\tif (!requireOnes10 && onesSumTo10(a, b)) continue;\n\n\t\t\tconst key = pairKey(a, b);\n\t\t\tif (used[key]) continue;\n\n\t\t\tused[key] = true;\n\t\t\treturn [a, b];\n\t\t}\n\t}\n\n\tfunction generateOneSet() {\n\t\tconst used = {};\n\t\tconst set = [];\n\n\t\t\/\/ Exactly 3 of 9 pairs have ones digits summing to 10:\n\t\t\/\/ 1 exact-100, 1 above-100, 1 below-100\n\t\tset.push(generateEqual100Pair(used, true));\n\n\t\tset.push(generateAbove100Pair(used, true));\n\t\tset.push(generateAbove100Pair(used, false));\n\t\tset.push(generateAbove100Pair(used, false));\n\t\tset.push(generateAbove100Pair(used, false));\n\n\t\tset.push(generateBelow100Pair(used, true));\n\t\tset.push(generateBelow100Pair(used, false));\n\t\tset.push(generateBelow100Pair(used, false));\n\t\tset.push(generateBelow100Pair(used, false));\n\n\t\tshuffle(set);\n\t\treturn set;\n\t}\n\n\tconst counter = document.createElement('div');\n\tcounter.className = 'q-counter';\n\tcounter.innerHTML = \"<strong>You have 0 points (0 correct problems, 0 mistakes)<\/strong>\";\n\n\tconst grid = document.createElement('div');\n\tgrid.className = 'q-grid-3x3';\n\n\tquestionContainer.appendChild(counter);\n\tquestionContainer.appendChild(grid);\n\n\tconst cells = [];\n\tlet j = 0;\n\twhile (j < 9) {\n\t\tconst cell = document.createElement('div');\n\t\tgrid.appendChild(cell);\n\t\tcells.push(cell);\n\t\tj += 1;\n\t}\n\n\tlet currentSet = generateOneSet();\n\tlet score = 0;\n\tlet totalAttempted = 0;\n\tlet totalCorrect = 0;\n\tlet totalIncorrect = 0;\n\tlet locked = false;\n\tlet enabled = false;\n\tlet timer = null;\n\tlet finished = false;\n\tlet matrixStartMs = null;\n\n\tfunction computePoints(correct, incorrect) {\n\t\tif (correct <= incorrect) return 0;\n\t\treturn correct - incorrect;\n\t}\n\n\tfunction updateCounter() {\n\t\tconst pointWord = (score === 1) ? \"point\" : \"points\";\n\t\tconst correctWord = (totalCorrect === 1) ? \"problem\" : \"problems\";\n\t\tconst incorrectWord = (totalIncorrect === 1) ? \"mistake\" : \"mistakes\";\n\n\t\tcounter.innerHTML =\n\t\t\t\"<strong>You have \" + score + \" \" + pointWord +\n\t\t\t\" (\" + totalCorrect + \" correct \" + correctWord +\n\t\t\t\", \" + totalIncorrect + \" \" + incorrectWord + \")<\/strong>\";\n\t}\n\n\tfunction setWaiting() {\n\t\tlet k = 0;\n\t\twhile (k < cells.length) {\n\t\t\tcells[k].classList.remove('ready', 'finished');\n\t\t\tcells[k].classList.add('waiting');\n\t\t\tk += 1;\n\t\t}\n\t}\n\n\tfunction setReady() {\n\t\tlet k = 0;\n\t\twhile (k < cells.length) {\n\t\t\tcells[k].classList.remove('waiting', 'finished');\n\t\t\tcells[k].classList.add('ready');\n\t\t\tk += 1;\n\t\t}\n\t}\n\n\tfunction setFinishedView() {\n\t\tlet k = 0;\n\t\twhile (k < cells.length) {\n\t\t\tcells[k].classList.remove('waiting', 'ready');\n\t\t\tcells[k].classList.add('finished');\n\t\t\tk += 1;\n\t\t}\n\t}\n\n\tfunction readyNow() {\n\t\tif (finished) return;\n\t\tenabled = true;\n\t\tmatrixStartMs = Date.now();\n\t\tsetReady();\n\t}\n\n\tfunction scheduleReady() {\n\t\tif (timer) clearTimeout(timer);\n\t\tenabled = false;\n\t\tmatrixStartMs = null;\n\t\tsetWaiting();\n\t\ttimer = setTimeout(readyNow, delayMs);\n\t}\n\n\tfunction render() {\n\t\tlet k = 0;\n\t\twhile (k < 9) {\n\t\t\tconst p = currentSet[k];\n\t\t\tcells[k].textContent = '(' + p[0] + ', ' + p[1] + ')';\n\t\t\tcells[k].dataset.idx = k;\n\t\t\tk += 1;\n\t\t}\n\t\tscheduleReady();\n\t}\n\n\tfunction timeSpentNow() {\n\t\tif (matrixStartMs === null) return '';\n\t\treturn Date.now() - matrixStartMs;\n\t}\n\n\tfunction saveSummary() {\n\t\tsetED(edName('totalCorrect'), totalCorrect);\n\t\tsetED(edName('totalIncorrect'), totalIncorrect);\n\t\tsetED(edName('totalAttempted'), totalAttempted);\n\t\tsetED(edName('totalPoints'), score);\n\t\tsetED(edName('maxAttempts'), maxAttempts);\n\t}\n\n\tfunction saveAttempt(attemptNumber, matrixSet, chosenPair, isCorrect, timeSpentMs) {\n\t\tsetED(edName('matrixNumber', attemptNumber), attemptNumber);\n\t\tsetED(edName('matrixPairs', attemptNumber), serializeSet(matrixSet));\n\t\tsetED(edName('chosenPair', attemptNumber), pairToString(chosenPair));\n\t\tsetED(edName('isCorrect', attemptNumber), isCorrect);\n\t\tsetED(edName('timeSpentMs', attemptNumber), timeSpentMs);\n\t\tsetED(edName('matrixExitTimeSpentMs', attemptNumber), timeSpentMs);\n\t}\n\n\tfunction initializeEmptyFields() {\n\t\tlet n = 1;\n\t\twhile (n <= maxAttempts) {\n\t\t\tsetED(edName('matrixNumber', n), '');\n\t\t\tsetED(edName('matrixPairs', n), '');\n\t\t\tsetED(edName('chosenPair', n), '');\n\t\t\tsetED(edName('isCorrect', n), '');\n\t\t\tsetED(edName('timeSpentMs', n), '');\n\t\t\tsetED(edName('matrixExitTimeSpentMs', n), '');\n\t\t\tn += 1;\n\t\t}\n\n\t\tsetED(edName('surveyExitTimeSpentMs'), '');\n\t\tsetED(edName('totalIncorrect'), '');\n\t\tsetED(edName('totalPoints'), '');\n\t\tsaveSummary();\n\t}\n\n\tfunction finishGame() {\n\t\tfinished = true;\n\t\tenabled = false;\n\t\tlocked = true;\n\t\tif (timer) clearTimeout(timer);\n\n\t\tconst surveyExitTimeSpentMs = timeSpentNow();\n\t\tsetED(edName('surveyExitTimeSpentMs'), surveyExitTimeSpentMs);\n\t\tsaveSummary();\n\t\tsetFinishedView();\n\n\t\tconsole.log('GAME FINISHED', {\n\t\t\troundCode: roundCode,\n\t\t\ttotalCorrect: totalCorrect,\n\t\t\ttotalIncorrect: totalIncorrect,\n\t\t\ttotalAttempted: totalAttempted,\n\t\t\ttotalPoints: score,\n\t\t\tsurveyExitTimeSpentMs: surveyExitTimeSpentMs\n\t\t});\n\n\t\t\/\/ No autoadvance here.\n\t}\n\n\tfunction nextSet() {\n\t\tcurrentSet = generateOneSet();\n\t\trender();\n\t}\n\n\tfunction pick(e) {\n\t\tif (!enabled) return;\n\t\tif (locked) return;\n\t\tif (finished) return;\n\n\t\tlocked = true;\n\n\t\tconst idx = Number(e.currentTarget.dataset.idx);\n\t\tconst p = currentSet[idx];\n\t\tconst ok = (p[0] + p[1] === 100) ? 1 : 0;\n\t\tconst attemptNumber = totalAttempted + 1;\n\t\tconst matrixShown = currentSet.slice(0);\n\t\tconst timeSpentMs = timeSpentNow();\n\n\t\ttotalAttempted += 1;\n\n\t\tif (ok === 1) {\n\t\t\ttotalCorrect += 1;\n\t\t} else {\n\t\t\ttotalIncorrect += 1;\n\t\t}\n\n\t\tscore = computePoints(totalCorrect, totalIncorrect);\n\n\t\tsaveAttempt(attemptNumber, matrixShown, p, ok, timeSpentMs);\n\t\tupdateCounter();\n\t\tsaveSummary();\n\n\t\tconsole.log('ANSWER SAVED', {\n\t\t\troundCode: roundCode,\n\t\t\tattemptNumber: attemptNumber,\n\t\t\tmatrixNumberVar: edName('matrixNumber', attemptNumber),\n\t\t\tmatrixPairsVar: edName('matrixPairs', attemptNumber),\n\t\t\tchosenPairVar: edName('chosenPair', attemptNumber),\n\t\t\tisCorrectVar: edName('isCorrect', attemptNumber),\n\t\t\ttimeSpentVar: edName('timeSpentMs', attemptNumber),\n\t\t\tmatrixExitTimeSpentVar: edName('matrixExitTimeSpentMs', attemptNumber),\n\t\t\tmatrixPairs: serializeSet(matrixShown),\n\t\t\tchosenPair: pairToString(p),\n\t\t\tisCorrect: ok,\n\t\t\ttimeSpentMs: timeSpentMs,\n\t\t\ttotalCorrectSoFar: totalCorrect,\n\t\t\ttotalIncorrectSoFar: totalIncorrect,\n\t\t\ttotalAttemptedSoFar: totalAttempted,\n\t\t\ttotalPointsSoFar: score\n\t\t});\n\n\t\tif (totalAttempted >= maxAttempts) {\n\t\t\tfinishGame();\n\t\t\treturn;\n\t\t}\n\n\t\tnextSet();\n\t\tlocked = false;\n\t}\n\n\tlet k = 0;\n\twhile (k < cells.length) {\n\t\tcells[k].addEventListener('click', pick);\n\t\tk += 1;\n\t}\n\n\tinitializeEmptyFields();\n\tupdateCounter();\n\trender();\n});","QuestionText_Unsafe":"<strong>Please select the pair of numbers that adds up to 100.<\/strong>","DataExportTag":"Q158","QuestionID":"QID158"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID159","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":120,"MaxSeconds":120,"ShowTimer":true,"Seconds":120},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":108,"NextAnswerId":1,"QuestionText_Unsafe":"Timing","DataExportTag":"Q159","QuestionID":"QID159"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID16","SecondaryAttribute":"Which best describes your gender identity? (You may select all that apply)","TertiaryAttribute":null,"Payload":{"ChoiceOrder":["21","22","29","30"],"Choices":{"21":{"Display":"Man"},"22":{"Display":"Woman"},"29":{"Display":"Transgender, Non-binary, or another gender"},"30":{"Display":"Prefer not to answer"}},"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"gender","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":31,"QuestionDescription":"Which best describes your gender identity? (You may select all that apply)","QuestionID":"QID16","QuestionText":"<b>Which best describes your gender identity? (You may select all that apply)<\/b>","QuestionText_Unsafe":"<b>Which best describes your gender identity?\n<br><\/b><i>(Mark all that apply)<\/i>","QuestionType":"MC","Selector":"MAVR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}}}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID161","SecondaryAttribute":"qA","TertiaryAttribute":null,"Payload":{"QuestionText":"qA","DefaultChoices":false,"DataExportTag":"Q110","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"qA","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID161"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID162","SecondaryAttribute":"qB","TertiaryAttribute":null,"Payload":{"QuestionText":"qB","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"qB","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"qA","DataExportTag":"Q162","QuestionID":"QID162"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID163","SecondaryAttribute":"qC","TertiaryAttribute":null,"Payload":{"QuestionText":"qC","DefaultChoices":false,"QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"qC","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionText_Unsafe":"qB","DataExportTag":"Q163","QuestionID":"QID163"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID164","SecondaryAttribute":"male","TertiaryAttribute":null,"Payload":{"QuestionText":"male","DefaultChoices":false,"DataExportTag":"Q113","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"male","Choices":{"1":{"Display":"yes"},"2":{"Display":"yes"}},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID164"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID165","SecondaryAttribute":"female","TertiaryAttribute":null,"Payload":{"QuestionText":"female","DefaultChoices":false,"DataExportTag":"Q114","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"female","Choices":{"1":{"Display":"yes"},"2":{"Display":"also yes"}},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID165"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID166","SecondaryAttribute":"Instructions for Part ${e:\/\/Field\/current_part}, Round 1 of ${e:\/\/Field\/comp_totalrounds} rounds...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Instructions for Part ${e:\/\/Field\/current_part}, Round 1 of ${e:\/\/Field\/comp_totalrounds} rounds<\/strong><br>\n<br>\nIn Round 1, you complete a math task using a <strong>fixed payment<\/strong>.<br>\n<br>\nIn this round, you earn a fixed payment of $0.50 for each point you have at the end of the math task. \n<br><br>","DefaultChoices":false,"DataExportTag":"Q115","QuestionID":"QID166","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Instructions for Part ${e:\/\/Field\/current_part}, Round 1 of ${e:\/\/Field\/comp_totalrounds} rounds...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n    var qthis = this;\n    var controller = this.getQuestionContainer();\n\n    \/\/ Replace with your actual QIDs\n    var questionIDs = [\"QID167\"];\n\n    \/\/ Unique key for this page\n    var revealKey = \"revealed_\" + this.questionId;\n\n    function hideQuestions() {\n        questionIDs.forEach(function (qid) {\n            var q = document.getElementById(qid);\n            if (q) {\n                q.style.visibility = \"hidden\";\n                q.style.height = \"0px\";\n                q.style.overflow = \"hidden\";\n                q.style.margin = \"0\";\n                q.style.padding = \"0\";\n                q.style.border = \"0\";\n            }\n        });\n    }\n\n    function showQuestions() {\n        questionIDs.forEach(function (qid) {\n            var q = document.getElementById(qid);\n            if (q) {\n                q.style.visibility = \"visible\";\n                q.style.height = \"auto\";\n                q.style.overflow = \"visible\";\n                q.style.margin = \"\";\n                q.style.padding = \"\";\n                q.style.border = \"\";\n\n                \/\/ force reflow\n                void q.offsetHeight;\n            }\n        });\n\n        setTimeout(function () {\n            window.dispatchEvent(new Event(\"resize\"));\n        }, 50);\n    }\n\n    var alreadyRevealed = sessionStorage.getItem(revealKey) === \"true\";\n\n    if (alreadyRevealed) {\n        showQuestions();\n        qthis.showNextButton();\n        return;\n    }\n\n    qthis.hideNextButton();\n    hideQuestions();\n\n    var wrapper = document.createElement(\"div\");\n    wrapper.style.textAlign = \"center\";\n    wrapper.style.margin = \"30px 0\";\n\nvar bgColor = \"${e:\/\/Field\/understanding_button_backgroundColor}\";\nvar borderColor = \"${e:\/\/Field\/understanding_button_border}\";\nvar textColor = \"${e:\/\/Field\/understanding_button_color}\";\n\n\/\/ Fallbacks (in case something is missing)\nbgColor = bgColor || \"#FFA500\";\nborderColor = borderColor || \"#cc8400\";\ntextColor = textColor || \"#2b1a00\";\n\n\tvar button = document.createElement(\"button\");\n\tbutton.type = \"button\";\nbutton.innerHTML = \"Click to answer an understanding question\";\n\n\t\/\/ Styling\n\tbutton.style.padding = \"12px 24px\";\n\tbutton.style.cursor = \"pointer\";\n\tbutton.style.backgroundColor = bgColor;\n\tbutton.style.border = \"1px solid \" + borderColor;\n\tbutton.style.borderRadius = \"6px\";\n\tbutton.style.fontSize = \"16px\";\n\tbutton.style.fontWeight = \"600\";\n\tbutton.style.color = textColor;\n\n    wrapper.appendChild(button);\n    controller.appendChild(wrapper);\n\n    button.addEventListener(\"click\", function () {\n        sessionStorage.setItem(revealKey, \"true\");\n\n        showQuestions();\n        qthis.showNextButton();\n        wrapper.remove();\n    });\n});"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID167","SecondaryAttribute":"Understanding Question: In this round, what is the fixed payment per point?","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Understanding Question: <\/strong>In this round, what is the fixed payment per point?","DataExportTag":"Q116","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","LabelPosition":"BELOW"},"QuestionDescription":"Understanding Question: In this round, what is the fixed payment per point?","Choices":{"3":{"Display":"$0.50"},"4":{"Display":"$0"},"5":{"Display":"$1"}},"ChoiceOrder":["4","3","5"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"None"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID167\/SelectableChoice\/3","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Understanding check: If this round is selected as the round-that-counts, what is the fixed paymen...<\/span> <span class=\"LeftOpDesc\">$0.50 for sure<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID167\/SelectableChoice\/3","LogicType":"Question","Operator":"Selected","QuestionID":"QID167","QuestionIDFromLocator":"QID167","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"incorrect answer","libraryID":"UR_cAtjJf4eqOWGcDA","messageID":"MS_42EWahFVsD2E0jY","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID167"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID169","SecondaryAttribute":"Recall that: You need to select a pair of numbers that sums up to 100. You have 2 minutes to corr...","TertiaryAttribute":null,"Payload":{"QuestionText":"Recall that:\n<ul>\n\t<li>You need to select a pair of numbers that sums up to 100.<\/li>\n\t<li>You have 2 minutes to correctly answer as many of the 30 problems as you can.<\/li>\n\t<li>You gain one&nbsp;point for each correct problem and lose one point for each mistake.<\/li>\n\t<li>You receive a fixed payment of $0.50 per point.<\/li>\n<\/ul>\nRemember, you can only advance once the 2 minutes are over.&nbsp;\n\n<div>&nbsp;<\/div>","DefaultChoices":false,"DataExportTag":"r1_math_quiz_remind","QuestionID":"QID169","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Recall that: You need to select a pair of numbers that sums up to 100. You have 2 minutes to corr...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID17","SecondaryAttribute":"Which of the following best represents how you think of yourself? (You may select all that apply)","TertiaryAttribute":null,"Payload":{"ChoiceOrder":["12","13","14","15","16","21"],"Choices":{"12":{"Display":"Gay or lesbian"},"13":{"Display":"Straight, that is not gay or lesbian etc."},"14":{"Display":"Bisexual"},"15":{"Display":"I use a different term","TextEntry":"true"},"16":{"Display":"I don\u2019t know"},"21":{"Display":"Prefer not to answer"}},"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"sexuality","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":22,"QuestionDescription":"Which of the following best represents how you think of yourself? (You may select all that apply)","QuestionID":"QID17","QuestionText":"<b>Which of the following best represents how you think of yourself?  (You may select all that apply)<\/b>","QuestionText_Unsafe":"<b>Which best describes your sexual identity\/orientation?<br><\/b><i>(Mark all that apply)<\/i>","QuestionType":"MC","Selector":"MAVR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}}}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID170","SecondaryAttribute":"Recall that: You need to select a pair of numbers that sums up to 100.\u00a0 You have 2 minutes to cor..","TertiaryAttribute":null,"Payload":{"QuestionText":"Recall that:\n<ul>\n\t<li>You need to select a pair of numbers that sums up to 100.&nbsp;<\/li>\n\t<li>You have 2 minutes to correctly answer as many of the 30 problems as you can.&nbsp;<\/li>\n\t<li>You gain one point for each correct problem and lose one point for each mistake.<\/li>\n\t<li>You are in a tournament in a group of 2 men and 2 women.<\/li>\n\t<li>If you win, your tournament payment is $2 per point.<\/li>\n\t<li>If you lose, your tournament payment is $0.<\/li>\n\t<li>In the case of a tie, the winner will be randomly determined.<\/li>\n<\/ul>\n\n<div>Remember, you can only advance once the 2 minutes are over.&nbsp;<\/div>","DefaultChoices":false,"DataExportTag":"Q119","QuestionID":"QID170","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Recall that: You need to select a pair of numbers that sums up to 100.\u00a0 You have 2 minutes to cor...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID171","SecondaryAttribute":"Recall that: Option A: Tournament Payment \u2014 Your performance in Round ...","TertiaryAttribute":null,"Payload":{"QuestionText":"<br>\nRecall that:<br>\n<br>\n<strong>Option A: Tournament Payment<\/strong> \u2014 Your performance in Round ${e:\/\/Field\/comp_totalrounds} will be evaluated relative to the performance of the other 3 group members in the Round 2 tournament. The Round 2 tournament is the math task you just completed.&nbsp;\n<ul>\n\t<li>If you have more points in Round ${e:\/\/Field\/comp_totalrounds}&nbsp;than the other 3 group members did in the Round 2 tournament, you are the winner.<\/li>\n\t<li>If at least one of the other 3 group members has more points&nbsp;in Round 2 than you do in Round ${e:\/\/Field\/comp_totalrounds}, you are not the winner and lose the tournament.<\/li>\n\t<li>If you win, your tournament payment is $2 per point.<\/li>\n\t<li>If you lose, your tournament payment is $0.<\/li>\n\t<li>In the case of a tie, the winner will be randomly determined.<\/li>\n<\/ul>\n<strong>Option B: Fixed Payment <\/strong>\u2014 You receive a fixed payment for your performance in Round ${e:\/\/Field\/comp_totalrounds}. The fixed payment varies from $0 per point in Row 1 and increases by $0.10 per row, reaching $1.50 per point in Row 16.","DefaultChoices":false,"DataExportTag":"Q120","QuestionID":"QID171","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Recall that: Option A: Tournament Payment \u2014 Your performance in Round ...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID172","SecondaryAttribute":"Before we tell you which row was randomly selected as the row-that-counts, and hence the payment...","TertiaryAttribute":null,"Payload":{"QuestionText":"Before we tell you which row was randomly selected as the row-that-counts, and hence the payment for your Round ${e:\/\/Field\/comp_totalrounds} math task, you have to finish the next round of this part.","DefaultChoices":false,"DataExportTag":"Q121","QuestionID":"QID172","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Before we tell you which row was randomly selected as the row-that-counts, and hence the payment...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID1720918525","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Q6.1","QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":0,"MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"#QuestionText, TimingPageSubmit#"},"4":{"Display":"#QuestionText, TimingClickCount#"}},"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","QuestionID":"QID1720918525"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID1720918526","SecondaryAttribute":"Please indicate which payment option you prefer on each row by clicking on the row where you woul...","TertiaryAttribute":null,"Payload":{"QuestionText":"Please indicate which payment option you prefer on each row by clicking on the row where you would like to switch from choosing Option A on the left to choosing Option B on the right. <br><br>(You cannot click the submit button until you have selected an answer.)","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n    var self = this;\n    var $j = jQuery;\n\n    try {\n        console.log(\"=== COMPETITIVENESS MPL SCRIPT START ===\");\n\n        self.hideNextButton();\n\n        \/\/ ------------------------------------------------------------\n        \/\/ Embedded data \/ settings\n        \/\/ ------------------------------------------------------------\n        var stakeRaw = \"${e:\/\/Field\/stake}\";\n        var minRaw = \"${e:\/\/Field\/comp_min}\";\n        var listRaw = \"${e:\/\/Field\/list}\";\n        var nrowsRaw = \"${e:\/\/Field\/xcomprows}\";\n\n        var stake = parseInt(stakeRaw, 10);\n        var minCents = parseInt(minRaw, 10);\n        var list = parseInt(listRaw, 10);\n        var nrows = parseInt(nrowsRaw, 10);\n\n        var prefix = \"xcomp\";\n\n        console.log(\"stakeRaw =\", stakeRaw);\n        console.log(\"minRaw =\", minRaw);\n        console.log(\"listRaw =\", listRaw);\n        console.log(\"nrowsRaw =\", nrowsRaw);\n        console.log(\"parsed stake =\", stake);\n        console.log(\"parsed minCents =\", minCents);\n        console.log(\"parsed list =\", list);\n        console.log(\"parsed nrows =\", nrows);\n        console.log(\"prefix =\", prefix);\n\n        if (isNaN(stake)) {\n            console.error(\"Stake is NaN\");\n            return;\n        }\n\n        if (isNaN(minCents)) {\n            console.error(\"comp_min is NaN\");\n            return;\n        }\n\n        if (isNaN(nrows) || nrows < 1) {\n            console.error(\"nrows is invalid\");\n            return;\n        }\n\n        if (isNaN(list)) {\n            list = 0;\n        }\n\n        list += 1;\n        Qualtrics.SurveyEngine.setEmbeddedData(\"list\", list);\n        console.log(\"Embedded data set: list =\", list);\n\n        \/\/ CHANGED: compute dollars from cents for both stake and min\n        var stakeDollars = stake \/ 100;\n        var minDollars = minCents \/ 100;\n\n        \/\/ CHANGED: increment spans from minDollars to stakeDollars over (nrows - 1) steps\n        var incrementDollars = (stakeDollars - minDollars) \/ (nrows - 1);\n\n        console.log(\"stakeDollars =\", stakeDollars);\n        console.log(\"minDollars =\", minDollars);\n        console.log(\"incrementDollars =\", incrementDollars);\n\n        var inputId = \"#\" + String(self.questionId);\n        var $container = $j(inputId);\n\n        console.log(\"inputId =\", inputId);\n        console.log(\"container exists? length =\", $container.length);\n\n        if ($container.length === 0) {\n            console.error(\"Question container not found:\", inputId);\n            return;\n        }\n\n        \/\/ ------------------------------------------------------------\n        \/\/ Variable names\n        \/\/ ------------------------------------------------------------\n        var prefixXL = prefix + \"_xl\";\n        var prefixXR = prefix + \"_xr\";\n        var prefixXSide = prefix + \"_xside\";\n        var prefixTopCorner = prefix + \"_topcorner\";\n        var prefixBottomCorner = prefix + \"_bottomcorner\";\n        var prefixInterior = prefix + \"_interior\";\n\n        console.log(\"prefixXL =\", prefixXL);\n        console.log(\"prefixXR =\", prefixXR);\n        console.log(\"prefixXSide =\", prefixXSide);\n        console.log(\"prefixTopCorner =\", prefixTopCorner);\n        console.log(\"prefixBottomCorner =\", prefixBottomCorner);\n        console.log(\"prefixInterior =\", prefixInterior);\n\n        \/\/ ------------------------------------------------------------\n        \/\/ Build table\n        \/\/ ------------------------------------------------------------\n        var tableHTML =\n            \"<table align='center' class='uncertainty'>\" +\n                \"<thead class='uncertaintyhead'>\" +\n                    \"<tr>\" +\n                        \"<th style='width:12em' class='thtext'>Option A:<br>Tournament<br>Payment<\/th>\" +\n                        \"<th style='width:1em'><\/th>\" +\n                        \"<th style='width:12em' class='thtext'>Option B:<br>Fixed<br>Payment<\/th>\" +\n                    \"<\/tr>\" +\n                \"<\/thead>\" +\n                \"<tbody class='uncert' id='maintable'>\" +\n                    \"<tr class='middletd'>\" +\n                        \"<td><\/td>\" +\n                        \"<td><\/td>\" +\n                        \"<td><\/td>\" +\n                    \"<\/tr>\" +\n                \"<\/tbody>\" +\n            \"<\/table>\";\n\n        $container.append(tableHTML);\n        console.log(\"Table appended\");\n\n        var rowsHTML = \"\";\n\n        for (var i = 1; i <= nrows; i++) {\n            \/\/ CHANGED: right-column value starts at minDollars and steps up by incrementDollars\n            var fixedAmount = (minDollars + (i - 1) * incrementDollars).toFixed(2);\n\n            console.log(\"Building row\", i, \"fixedAmount =\", fixedAmount);\n\n            rowsHTML +=\n                \"<tr class='middletd'>\" +\n                    \"<td \" +\n                        \"style='width:10em;border-top:1px solid black;border-bottom:1px solid black' \" +\n                        \"class='letters choice-cell' \" +\n                        \"id='\" + i + \"left' \" +\n                        \"data-row='\" + i + \"' \" +\n                        \"data-side='left'>\" +\n                        \"If win, $2 per point\" +\n                    \"<\/td>\" +\n                    \"<td style='width:10em'>OR<\/td>\" +\n                    \"<td \" +\n                        \"style='width:10em;border-top:1px solid black;border-bottom:1px solid black' \" +\n                        \"class='letters choice-cell' \" +\n                        \"id='\" + i + \"right' \" +\n                        \"data-row='\" + i + \"' \" +\n                        \"data-side='right'>\" +\n                        \"$\" + fixedAmount + \" per point\" +\n                    \"<\/td>\" +\n                \"<\/tr>\";\n        }\n\n        $j(\"#maintable\").append(rowsHTML);\n        console.log(\"Rows appended to #maintable\");\n\n        \/\/ ------------------------------------------------------------\n        \/\/ Response storage\n        \/\/ ------------------------------------------------------------\n        var time_start = Date.now() \/ 1000;\n        var times = [];\n        var choices = [];\n        var changed = [];\n        var choice_now = -1;\n\n        console.log(\"time_start =\", time_start);\n        console.log(\"times initialized =\", times);\n        console.log(\"choices initialized =\", choices);\n        console.log(\"changed initialized =\", changed);\n\n        \/\/ ------------------------------------------------------------\n        \/\/ Helpers\n        \/\/ ------------------------------------------------------------\n        function setSelected($el, isSelected) {\n            if (isSelected) {\n                $el.removeClass(\"letters\").addClass(\"letters_selected\");\n            } else {\n                $el.removeClass(\"letters_selected\").addClass(\"letters\");\n            }\n        }\n\n        function updateVisualSelection(rowNumber, side) {\n            for (var r = 1; r <= nrows; r++) {\n                var $left = $j(\"#\" + r + \"left\");\n                var $right = $j(\"#\" + r + \"right\");\n\n                if (r < rowNumber) {\n                    setSelected($left, true);\n                    setSelected($right, false);\n                } else if (r > rowNumber) {\n                    setSelected($left, false);\n                    setSelected($right, true);\n                } else {\n                    if (side === \"left\") {\n                        setSelected($left, true);\n                        setSelected($right, false);\n                    } else {\n                        setSelected($left, false);\n                        setSelected($right, true);\n                    }\n                }\n            }\n        }\n\n        \/\/ ------------------------------------------------------------\n        \/\/ Click handler\n        \/\/ ------------------------------------------------------------\n        $j(\"#maintable\").on(\"click\", \".choice-cell\", function () {\n            try {\n                console.log(\"=== CLICK EVENT START ===\");\n\n                var rowNumber = parseInt($j(this).attr(\"data-row\"), 10);\n                var side = String($j(this).attr(\"data-side\"));\n                var elapsed = (Date.now() \/ 1000 - time_start).toFixed(2);\n\n                console.log(\"rowNumber =\", rowNumber);\n                console.log(\"side =\", side);\n                console.log(\"elapsed =\", elapsed);\n\n                if (isNaN(rowNumber)) {\n                    console.error(\"rowNumber is NaN\");\n                    return;\n                }\n\n                choice_now = String(rowNumber) + side;\n                console.log(\"choice_now =\", choice_now);\n\n                times.push(elapsed);\n                choices.push(choice_now);\n\n                console.log(\"times =\", times);\n                console.log(\"choices =\", choices);\n\n                updateVisualSelection(rowNumber, side);\n\n                \/\/ ----------------------------------------------------\n                \/\/ Bounds and scalar\n                \/\/ FIX: shifted formulas down by one increment to match\n                \/\/ risk and generosity MPLs. Was off by +1 increment.\n                \/\/ ----------------------------------------------------\n                var norm_lb, norm_ub;\n                var xside;\n                var xvalue;\n\n                if (side === \"left\") {\n                    \/\/ FIX: was rowNumber, rowNumber+1; now rowNumber-1, rowNumber\n                    norm_lb = minDollars + (rowNumber - 1) * incrementDollars;\n                    norm_ub = minDollars + rowNumber * incrementDollars;\n                    xside = \"LEFT\";\n                    xvalue = minDollars + (rowNumber - 1) * incrementDollars;\n                    console.log(\"Left choice detected\");\n                } else {\n                    \/\/ FIX: was rowNumber-1, rowNumber; now rowNumber-2, rowNumber-1\n                    norm_lb = minDollars + (rowNumber - 2) * incrementDollars;\n                    norm_ub = minDollars + (rowNumber - 1) * incrementDollars;\n                    xside = \"RIGHT\";\n                    xvalue = minDollars + (rowNumber - 2) * incrementDollars;\n                    console.log(\"Right choice detected\");\n                }\n\n                console.log(\"Initial norm_lb =\", norm_lb);\n                console.log(\"Initial norm_ub =\", norm_ub);\n                console.log(\"Initial xvalue =\", xvalue);\n                console.log(\"Initial xside =\", xside);\n\n                \/\/ top corner: always tournament\n                if (choice_now === nrows + \"left\") {\n                    norm_lb = stakeDollars;\n                    norm_ub = stakeDollars;\n                    xvalue = stakeDollars;\n                    changed.push(\"topcorner\");\n                    console.log(\"Top-corner case triggered\");\n                }\n\n                \/\/ CHANGED: bottom corner now uses minDollars instead of 0\n                if (choice_now === \"1right\") {\n                    norm_lb = minDollars;\n                    norm_ub = minDollars;\n                    xvalue = minDollars;\n                    changed.push(\"bottomcorner\");\n                    console.log(\"Bottom-corner case triggered\");\n                }\n\n                \/\/ CHANGED: floor guards use minDollars instead of 0\n                if (norm_lb < minDollars) {\n                    norm_lb = minDollars;\n                    changed.push(\"lb_floor\");\n                }\n\n                if (norm_ub < minDollars) {\n                    norm_ub = minDollars;\n                    changed.push(\"ub_floor\");\n                }\n\n                if (norm_lb > stakeDollars) {\n                    norm_lb = stakeDollars;\n                    changed.push(\"lb_cap\");\n                }\n\n                if (norm_ub > stakeDollars) {\n                    norm_ub = stakeDollars;\n                    changed.push(\"ub_cap\");\n                }\n\n                \/\/ CHANGED: xvalue floor uses minDollars instead of 0\/incrementDollars\n                if (xvalue < minDollars) {\n                    console.log(\"xvalue < minDollars, imputing minDollars =\", minDollars);\n                    xvalue = minDollars;\n                }\n\n                if (xvalue > stakeDollars) {\n                    xvalue = stakeDollars;\n                }\n\n                norm_lb = Number(norm_lb.toFixed(2));\n                norm_ub = Number(norm_ub.toFixed(2));\n                xvalue = Number(xvalue.toFixed(2));\n\n                console.log(\"Final norm_lb =\", norm_lb);\n                console.log(\"Final norm_ub =\", norm_ub);\n                console.log(\"Final xvalue =\", xvalue);\n                console.log(\"changed =\", changed);\n\n                Qualtrics.SurveyEngine.setEmbeddedData(prefix + \"Time\", times);\n                Qualtrics.SurveyEngine.setEmbeddedData(prefix + \"Choices\", choices);\n                Qualtrics.SurveyEngine.setEmbeddedData(prefix + \"IdFinal\", rowNumber);\n                Qualtrics.SurveyEngine.setEmbeddedData(prefix + \"ChoiceFinal\", choice_now);\n                Qualtrics.SurveyEngine.setEmbeddedData(prefix + \"LB\", norm_lb);\n                Qualtrics.SurveyEngine.setEmbeddedData(prefix + \"UB\", norm_ub);\n                Qualtrics.SurveyEngine.setEmbeddedData(prefix + \"Changed\", changed);\n\n                console.log(\"Saved main embedded vars\");\n\n                \/\/ respondent-facing thresholds\n                var xl_value = norm_lb;\n                var xr_value = norm_ub;\n\n                Qualtrics.SurveyEngine.setEmbeddedData(prefixXL, xl_value.toFixed(2));\n                Qualtrics.SurveyEngine.setEmbeddedData(prefixXR, xr_value.toFixed(2));\n                Qualtrics.SurveyEngine.setEmbeddedData(prefixXSide, xside);\n                Qualtrics.SurveyEngine.setEmbeddedData(prefix, xvalue);\n\n                console.log(\"Saved respondent-facing thresholds\");\n\n                \/\/ ----------------------------------------------------\n                \/\/ Corner\/interior flags\n                \/\/ ----------------------------------------------------\n                var isTopCorner = (rowNumber === nrows && xside === \"LEFT\") ? \"1\" : \"0\";\n                var isBottomCorner = (rowNumber === 1 && xside === \"RIGHT\") ? \"1\" : \"0\";\n                var isInterior = (isTopCorner === \"0\" && isBottomCorner === \"0\") ? \"1\" : \"0\";\n\n                Qualtrics.SurveyEngine.setEmbeddedData(prefixTopCorner, isTopCorner);\n                Qualtrics.SurveyEngine.setEmbeddedData(prefixBottomCorner, isBottomCorner);\n                Qualtrics.SurveyEngine.setEmbeddedData(prefixInterior, isInterior);\n\n                console.log(\"isTopCorner =\", isTopCorner);\n                console.log(\"isBottomCorner =\", isBottomCorner);\n                console.log(\"isInterior =\", isInterior);\n\n                \/\/ ----------------------------------------------------\n                \/\/ Row ranges for instruction text\n                \/\/ ----------------------------------------------------\n                var tournamentRowsEnd = \"\";\n                var fixedRowsStart = \"\";\n\n                if (isInterior === \"1\") {\n                    if (xside === \"RIGHT\") {\n                        tournamentRowsEnd = rowNumber - 1;\n                        fixedRowsStart = rowNumber;\n                    } else if (xside === \"LEFT\") {\n                        tournamentRowsEnd = rowNumber;\n                        fixedRowsStart = rowNumber + 1;\n                    }\n                }\n\n                Qualtrics.SurveyEngine.setEmbeddedData(\"xcomp_tournament_rows_end\", tournamentRowsEnd);\n                Qualtrics.SurveyEngine.setEmbeddedData(\"xcomp_fixed_rows_start\", fixedRowsStart);\n\n                console.log(\"Embedded data set: xcomp_tournament_rows_end =\", tournamentRowsEnd);\n                console.log(\"Embedded data set: xcomp_fixed_rows_start =\", fixedRowsStart);\n\n                \/\/ ----------------------------------------------------\n                \/\/ Understanding-question dynamic snippet\n                \/\/ ----------------------------------------------------\n                var comp_check_option1_text = \"\";\n                var comp_check_y = \"\";\n                var comp_check_yplus1 = \"\";\n                var comp_check_correct_option = \"\";\n\n                if (isInterior === \"1\") {\n                    comp_check_option1_text =\n                        \"You selected the tournament payment when the fixed payment was $\" + xl_value.toFixed(2) + \" or less and the fixed payment when it was $\" + xr_value.toFixed(2) + \" or more\";\n                    comp_check_y = xl_value.toFixed(2);\n                    comp_check_yplus1 = xr_value.toFixed(2);\n                    comp_check_correct_option = \"1\";\n                }\n\n                if (isBottomCorner === \"1\") {\n                    comp_check_option1_text = \"You never selected the tournament payment\";\n                    comp_check_y = \"0.35\";\n                    comp_check_yplus1 = \"0.40\";\n                    comp_check_correct_option = \"2\";\n                }\n\n                if (isTopCorner === \"1\") {\n                    comp_check_option1_text = \"You always selected the tournament payment\";\n                    comp_check_y = \"0.35\";\n                    comp_check_yplus1 = \"0.40\";\n                    comp_check_correct_option = \"3\";\n                }\n\n                Qualtrics.SurveyEngine.setEmbeddedData(\"comp_check_option1_text\", comp_check_option1_text);\n                Qualtrics.SurveyEngine.setEmbeddedData(\"comp_self_comp_check_y\", Number(comp_check_y).toFixed(2));\n                Qualtrics.SurveyEngine.setEmbeddedData(\"comp_self_comp_check_yplus1\", Number(comp_check_yplus1).toFixed(2));\n                Qualtrics.SurveyEngine.setEmbeddedData(\"comp_self_comp_check_correct_option\", comp_check_correct_option);\n\n                console.log(\"Embedded data set: comp_check_option1_text =\", comp_check_option1_text);\n                console.log(\"Embedded data set: comp_self_comp_check_y =\", comp_check_y);\n                console.log(\"Embedded data set: comp_self_comp_check_yplus1 =\", comp_check_yplus1);\n                console.log(\"Embedded data set: comp_self_comp_check_correct_option =\", comp_check_correct_option);\n\n                \/\/ ----------------------------------------------------\n                \/\/ Randomly selected row for later reveal\n                \/\/ ----------------------------------------------------\n                var existingRow = \"${e:\/\/Field\/comp_selected_row}\";\n                var selectedRow;\n\n                if (existingRow && existingRow !== \"\") {\n                    selectedRow = parseInt(existingRow, 10);\n                    console.log(\"Re-using existing selectedRow =\", selectedRow);\n                } else {\n                    selectedRow = Math.floor(Math.random() * nrows) + 1;\n                    console.log(\"Generated new selectedRow =\", selectedRow);\n                }\n\n                \/\/ CHANGED: selected fixed amount offset by minDollars\n                var selectedFixedAmount = Number((minDollars + (selectedRow - 1) * incrementDollars).toFixed(2));\n                var selectedChoiceText = \"\";\n                var selectedChoseTournament = \"\";\n\n                if (isTopCorner === \"1\") {\n                    selectedChoiceText = \"tournament payment\";\n                    selectedChoseTournament = \"1\";\n                } else if (isBottomCorner === \"1\") {\n                    selectedChoiceText = \"fixed payment\";\n                    selectedChoseTournament = \"0\";\n                } else if (isInterior === \"1\") {\n                    if (xside === \"RIGHT\") {\n                        if (selectedRow < rowNumber) {\n                            selectedChoiceText = \"tournament payment\";\n                            selectedChoseTournament = \"1\";\n                        } else {\n                            selectedChoiceText = \"fixed payment\";\n                            selectedChoseTournament = \"0\";\n                        }\n                    } else {\n                        if (selectedRow <= rowNumber) {\n                            selectedChoiceText = \"tournament payment\";\n                            selectedChoseTournament = \"1\";\n                        } else {\n                            selectedChoiceText = \"fixed payment\";\n                            selectedChoseTournament = \"0\";\n                        }\n                    }\n                }\n\n                Qualtrics.SurveyEngine.setEmbeddedData(\"comp_selected_row\", selectedRow);\n                Qualtrics.SurveyEngine.setEmbeddedData(\"comp_selected_fixed_amount\", selectedFixedAmount.toFixed(2));\n                Qualtrics.SurveyEngine.setEmbeddedData(\"comp_selected_choice_text\", selectedChoiceText);\n                Qualtrics.SurveyEngine.setEmbeddedData(\"comp_selected_chose_tournament\", selectedChoseTournament);\n\n                console.log(\"Embedded data set: comp_selected_row =\", selectedRow);\n                console.log(\"Embedded data set: comp_selected_fixed_amount =\", selectedFixedAmount);\n                console.log(\"Embedded data set: comp_selected_choice_text =\", selectedChoiceText);\n                console.log(\"Embedded data set: comp_selected_chose_tournament =\", selectedChoseTournament);\n\n                self.showNextButton();\n                console.log(\"=== CLICK EVENT END ===\");\n\n            } catch (err) {\n                console.error(\"Error in click handler:\", err);\n                console.error(err && err.stack ? err.stack : \"No stack\");\n            }\n        });\n\n        \/\/ ------------------------------------------------------------\n        \/\/ Optional floatThead\n        \/\/ ------------------------------------------------------------\n        if (typeof $j.fn.floatThead === \"function\") {\n            $j(\"table.uncertainty\").floatThead({\n                useAbsolutePositioning: false\n            });\n        }\n\n        console.log(\"=== COMPETITIVENESS MPL SCRIPT END ===\");\n\n    } catch (err) {\n        console.error(\"Fatal script error:\", err);\n        console.error(err && err.stack ? err.stack : \"No stack\");\n    }\n});","DefaultChoices":false,"DataExportTag":"competition_mpl","QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please indicate which payment option you prefer on each row by clicking on the row where you woul...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"QuestionText_Unsafe":"<div>Please indicate which payment option you prefer on each row by clicking on the row where you would like to switch from choosing the option on the left to choosing the option on the right.<\/div>\n\n<div>&nbsp;<\/div>\n\n<div>\n<div>(Note that you cannot click on the submit button until you have selected an answer.)<\/div>\n<\/div>","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":1,"NextAnswerId":1,"QuestionID":"QID1720918526"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID173","SecondaryAttribute":"Instructions for Part ${e:\/\/Field\/current_part}, Round 3 of ${e:\/\/Field\/comp_totalrounds} rounds...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Instructions for Part ${e:\/\/Field\/current_part}, Round 3 of ${e:\/\/Field\/comp_totalrounds} rounds<\/strong><br>\n<br>\n<span>In this round, you earn a fixed payment of $1.50 for answering 12 questions.<\/span><br>\n<br>\nThese questions will ask you to compare your choices between tournament payment and fixed payment to those of other participants who went through the same study and are <strong>equally likely to be men or women.<\/strong>\n<ul>\n\t<li><span>Recall, for the math task, you selected the <strong>tournament payment <\/strong>when the fixed payment was <strong>$${e:\/\/Field\/xcomp_xl} or less<\/strong> and the <strong>fixed payment <\/strong>when it was <strong>$${e:\/\/Field\/xcomp_xr} or more<\/strong>.&nbsp;<\/span><\/li>\n<\/ul>","DefaultChoices":false,"DataExportTag":"Q122","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Instructions for Part ${e:\/\/Field\/current_part}, Round 3 of ${e:\/\/Field\/comp_totalrounds} rounds...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID173","DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">xcomp_interior<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> 1 <\/span>","LeftOperand":"xcomp_interior","LogicType":"EmbeddedField","Operator":"EqualTo","RightOperand":"1","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"QuestionJS":"Qualtrics.SurveyEngine.addOnReady(function () {\n\tvar qthis = this;\n    var controller = this.getQuestionContainer();\n\n    \/\/ =========================\n    \/\/ SET THESE QIDs\n    \/\/ =========================\n    var qidQ2Interior = \"QID174\";  \/\/ question 2 if xcomp_interior == 1\n    var qidQ2Bottom = \"QID239\";    \/\/ question 2 if xcomp_bottomcorner == 1\n    var qidQ2Top = \"QID240\";       \/\/ question 2 if xcomp_topcorner == 1\n\n    \/\/ Read embedded variables\n    var isInterior = \"${e:\/\/Field\/xcomp_interior}\" == \"1\";\n    var isBottom   = \"${e:\/\/Field\/xcomp_bottomcorner}\" == \"1\";\n    var isTop      = \"${e:\/\/Field\/xcomp_topcorner}\" == \"1\";\n\n    \/\/ Determine which version of question 2 to use\n    var qidQuestion2 = null;\n    if (isInterior) {\n        qidQuestion2 = qidQ2Interior;\n    } else if (isBottom) {\n        qidQuestion2 = qidQ2Bottom;\n    } else if (isTop) {\n        qidQuestion2 = qidQ2Top;\n    }\n\n    \/\/ Questions to hide\/reveal\n    var questionIDs = [qidQuestion2].filter(Boolean);\n\n    \/\/ Unique key for this page\n    var revealKey = \"revealed_\" + this.questionId;\n\n    function getNextButton() {\n        return document.getElementById(\"NextButton\");\n    }\n\n    function forceHideNextButton() {\n        qthis.hideNextButton();\n        var nextButton = getNextButton();\n        if (nextButton) {\n            nextButton.style.display = \"none\";\n            nextButton.style.visibility = \"hidden\";\n        }\n    }\n\n    function forceShowNextButton() {\n        qthis.showNextButton();\n        var nextButton = getNextButton();\n        if (nextButton) {\n            nextButton.style.display = \"\";\n            nextButton.style.visibility = \"\";\n        }\n    }\n\n    function hideQuestions() {\n        questionIDs.forEach(function (qid) {\n            var q = document.getElementById(qid);\n            if (q) {\n                q.style.visibility = \"hidden\";\n                q.style.height = \"0px\";\n                q.style.overflow = \"hidden\";\n                q.style.margin = \"0\";\n                q.style.padding = \"0\";\n            }\n        });\n    }\n\n    function showQuestions() {\n        questionIDs.forEach(function (qid) {\n            var q = document.getElementById(qid);\n            if (q) {\n                q.style.visibility = \"visible\";\n                q.style.height = \"auto\";\n                q.style.overflow = \"visible\";\n                q.style.margin = \"\";\n                q.style.padding = \"\";\n            }\n        });\n\n        setTimeout(function () {\n            window.dispatchEvent(new Event(\"resize\"));\n        }, 50);\n    }\n\n    var alreadyRevealed = sessionStorage.getItem(revealKey) === \"true\";\n\n    if (alreadyRevealed) {\n        showQuestions();\n        forceShowNextButton();\n        return;\n    }\n\n    \/\/ Hide immediately\n    forceHideNextButton();\n    hideQuestions();\n\n    \/\/ Extra protection in case Qualtrics redraws footer after load\n    var hideInterval = setInterval(function () {\n        if (sessionStorage.getItem(revealKey) !== \"true\") {\n            forceHideNextButton();\n        } else {\n            clearInterval(hideInterval);\n        }\n    }, 300);\n\n    \/\/ Create centered button\n    var wrapper = document.createElement(\"div\");\n    wrapper.style.textAlign = \"center\";\n    wrapper.style.margin = \"30px 0\";\n\n\t\t\/\/ Styling\n\/\/ Styling\n\/\/ Read embedded color variables\nvar bgColor = \"${e:\/\/Field\/understanding_button_backgroundColor}\";\nvar borderColor = \"${e:\/\/Field\/understanding_button_border}\";\nvar textColor = \"${e:\/\/Field\/understanding_button_color}\";\n\n\/\/ Fallbacks (in case something is missing)\nbgColor = bgColor || \"#FFA500\";\nborderColor = borderColor || \"#cc8400\";\ntextColor = textColor || \"#2b1a00\";\n\nvar button = document.createElement(\"button\");\nbutton.type = \"button\";\n    button.innerHTML = \"Click to answer an understanding question\";\n\n\/\/ Styling\nbutton.style.padding = \"12px 24px\";\nbutton.style.cursor = \"pointer\";\nbutton.style.backgroundColor = bgColor;\nbutton.style.border = \"1px solid \" + borderColor;\nbutton.style.borderRadius = \"6px\";\nbutton.style.fontSize = \"16px\";\nbutton.style.fontWeight = \"600\";\nbutton.style.color = textColor;\n\t\n\t\n \n\n    wrapper.appendChild(button);\n    controller.appendChild(wrapper);\n\n    button.addEventListener(\"click\", function () {\n        sessionStorage.setItem(revealKey, \"true\");\n\n        showQuestions();\n        forceShowNextButton();\n\n        clearInterval(hideInterval);\n        wrapper.remove();\n    });\n});\n\nQualtrics.SurveyEngine.addOnReady(function () {\n    \/\/ Hide again on ready, in case theme scripts re-show it after onload\n    if (sessionStorage.getItem(\"revealed_\" + this.questionId) !== \"true\") {\n        this.hideNextButton();\n        var nextButton = document.getElementById(\"NextButton\");\n        if (nextButton) {\n            nextButton.style.display = \"none\";\n            nextButton.style.visibility = \"hidden\";\n        }\n    }\n});"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID174","SecondaryAttribute":"Understanding Question: For the math task, which of the following is correct?","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Understanding Question:<\/strong> For the math task, which of the following is correct?","DefaultChoices":false,"DataExportTag":"und_check_comp","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"Use