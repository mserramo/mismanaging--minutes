n            }\n        });\n        setTimeout(function() {\n            window.dispatchEvent(new Event(\"resize\"));\n        }, 50);\n    }\n    function darkenColor(hex, factor) {\n        hex = hex.replace(\"#\", \"\");\n        var r = parseInt(hex.substring(0,2), 16);\n        var g = parseInt(hex.substring(2,4), 16);\n        var b = parseInt(hex.substring(4,6), 16);\n        r = Math.floor(r * factor);\n        g = Math.floor(g * factor);\n        b = Math.floor(b * factor);\n        return \"#\" + [r,g,b].map(x => x.toString(16).padStart(2,\"0\")).join(\"\");\n    }\n\n    var alreadyRevealed = sessionStorage.getItem(revealKey) === \"true\";\n    if (alreadyRevealed) {\n        showQuestions();\n        qthis.showNextButton();\n        return;\n    }\n\n    qthis.hideNextButton();\n    hideQuestions();\n\n    var wrapper = document.createElement(\"div\");\n    wrapper.style.textAlign = \"center\";\n    wrapper.style.margin = \"30px 0\";\n    var button = document.createElement(\"button\");\n    button.type = \"button\";\n    button.innerHTML = \"Click to answer the next 4 questions\";\n    button.style.padding = \"12px 24px\";\n    button.style.cursor = \"pointer\";\n    button.style.backgroundColor = bgColor;\n    button.style.border = \"1px solid \" + borderColor;\n    button.style.borderRadius = \"6px\";\n    button.style.fontSize = \"16px\";\n    button.style.fontWeight = \"600\";\n    button.style.color = textColor;\n\n    var hoverColor = darkenColor(bgColor, 0.9);\n    button.addEventListener(\"mouseenter\", function() {\n        button.style.backgroundColor = hoverColor;\n    });\n    button.addEventListener(\"mouseleave\", function() {\n        button.style.backgroundColor = bgColor;\n    });\n\n    wrapper.appendChild(button);\n    controller.appendChild(wrapper);\n\n    button.addEventListener(\"click\", function () {\n        sessionStorage.setItem(revealKey, \"true\");\n        showQuestions();\n        qthis.showNextButton();\n        wrapper.remove();\n    });\n});","DefaultChoices":false,"DataExportTag":"Q206","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Instructions for Part ${e:\/\/Field\/current_part}, Round 2 of 2 rounds Recall, in this round, you e...","DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">xrisk_interior<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> 1 <\/span>","LeftOperand":"xrisk_interior","LogicType":"EmbeddedField","Operator":"EqualTo","RightOperand":"1","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID394"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID395","SecondaryAttribute":"Instructions for Part ${e:\/\/Field\/current_part}, Round 2 of 2 rounds Recall, in this round, you e...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong><span>Instructions for Part ${e:\/\/Field\/current_part}, Round 2 of 2 rounds<\/span><\/strong><br \/>\n<br \/>\nRecall, in this round, you earn a fixed payment of $1.50 for answering 12 questions.&nbsp;<br \/>\n<br \/>\nYou already answered some questions. The following 4 questions will ask you to compare your choices between lottery payment and fixed payment to those of <b>female participants<\/b>, specifically other participants who went through the same study who are women.\n<ul>\n\t<li><span>Recall, in Round 1, y<\/span><span>ou <strong>never selected the lottery.<\/strong>&nbsp;<\/span><\/li>\n<\/ul>","QuestionJS":"Qualtrics.SurveyEngine.addOnReady(function () {\n    var qthis = this;\n    var controller = this.getQuestionContainer();\n    var questionIDs = [\"QID360\", \"QID356\", \"QID355\", \"QID366\"];\n    var revealKey = \"revealed_\" + this.questionId;\n\n    var bgColor = \"${e:\/\/Field\/main_button_backgroundColor}\" || \"#AFE1AF\";\n    var borderColor = \"${e:\/\/Field\/main_button_border}\" || \"#7FBF7F\";\n    var textColor = \"${e:\/\/Field\/main_button_color}\" || \"#1f3d1f\";\n\n    function hideQuestions() {\n        questionIDs.forEach(function(qid) {\n            var q = document.getElementById(qid);\n            if (q) {\n                q.style.visibility = \"hidden\";\n                q.style.height = \"0px\";\n                q.style.overflow = \"hidden\";\n                q.style.margin = \"0\";\n                q.style.padding = \"0\";\n            }\n        });\n    }\n    function showQuestions() {\n        questionIDs.forEach(function(qid) {\n            var q = document.getElementById(qid);\n            if (q) {\n                q.style.visibility = \"visible\";\n                q.style.height = \"auto\";\n                q.style.overflow = \"visible\";\n                q.style.margin = \"\";\n                q.style.padding = \"\";\n                void q.offsetHeight;\n            }\n        });\n        setTimeout(function() {\n            window.dispatchEvent(new Event(\"resize\"));\n        }, 50);\n    }\n    function darkenColor(hex, factor) {\n        hex = hex.replace(\"#\", \"\");\n        var r = parseInt(hex.substring(0,2), 16);\n        var g = parseInt(hex.substring(2,4), 16);\n        var b = parseInt(hex.substring(4,6), 16);\n        r = Math.floor(r * factor);\n        g = Math.floor(g * factor);\n        b = Math.floor(b * factor);\n        return \"#\" + [r,g,b].map(x => x.toString(16).padStart(2,\"0\")).join(\"\");\n    }\n\n    var alreadyRevealed = sessionStorage.getItem(revealKey) === \"true\";\n    if (alreadyRevealed) {\n        showQuestions();\n        qthis.showNextButton();\n        return;\n    }\n\n    qthis.hideNextButton();\n    hideQuestions();\n\n    var wrapper = document.createElement(\"div\");\n    wrapper.style.textAlign = \"center\";\n    wrapper.style.margin = \"30px 0\";\n    var button = document.createElement(\"button\");\n    button.type = \"button\";\n    button.innerHTML = \"Click to answer the next 4 questions\";\n    button.style.padding = \"12px 24px\";\n    button.style.cursor = \"pointer\";\n    button.style.backgroundColor = bgColor;\n    button.style.border = \"1px solid \" + borderColor;\n    button.style.borderRadius = \"6px\";\n    button.style.fontSize = \"16px\";\n    button.style.fontWeight = \"600\";\n    button.style.color = textColor;\n\n    var hoverColor = darkenColor(bgColor, 0.9);\n    button.addEventListener(\"mouseenter\", function() {\n        button.style.backgroundColor = hoverColor;\n    });\n    button.addEventListener(\"mouseleave\", function() {\n        button.style.backgroundColor = bgColor;\n    });\n\n    wrapper.appendChild(button);\n    controller.appendChild(wrapper);\n\n    button.addEventListener(\"click\", function () {\n        sessionStorage.setItem(revealKey, \"true\");\n        showQuestions();\n        qthis.showNextButton();\n        wrapper.remove();\n    });\n});","DefaultChoices":false,"DataExportTag":"Q207","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Instructions for Part ${e:\/\/Field\/current_part}, Round 2 of 2 rounds Recall, in this round, you e...","DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">xrisk_bottomcorner<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> 1 <\/span>","LeftOperand":"xrisk_bottomcorner","LogicType":"EmbeddedField","Operator":"EqualTo","RightOperand":"1","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID395"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID396","SecondaryAttribute":"Instructions for Part ${e:\/\/Field\/current_part}, Round 2 of 2 rounds \u00a0 Recall, in this round, you..","TertiaryAttribute":null,"Payload":{"QuestionText":"<div class=\"relative w-full mt-4 mb-1\">\n<div class=\"relative\">\n<div class=\"h-full min-h-0 min-w-0\">\n<div class=\"h-full min-h-0 min-w-0\">\n<div class=\"border border-token-border-light border-radius-3xl corner-superellipse\/1.1 rounded-3xl\">\n<div class=\"h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse\/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback\">\n<div class=\"pe-11 pt-3\">\n<div class=\"relative z-0 flex max-w-full\">\n<div class=\"q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch \u037cs \u037c16\" dir=\"ltr\" id=\"code-block-viewer\">\n<div class=\"cm-scroller\">\n<div class=\"cm-content q9tKkq_readonly\"><strong><span>Instructions for Part ${e:\/\/Field\/current_part}, Round 2 of 2 rounds<\/span><\/strong><br \/>\n&nbsp;<\/div>\nRecall, in this round, you earn a fixed payment of $1.50 for answering 12 questions.&nbsp;<\/div>\n\n<div class=\"cm-scroller\">&nbsp;<\/div>\n\n<div class=\"cm-scroller\">You already answered some questions. The following 4 questions will ask you to compare your choices between lottery payment and fixed payment to those of <b>female participants<\/b>, specifically other participants who went through the same study who are women.\n\n<ul>\n\t<li class=\"cm-content q9tKkq_readonly\"><span>In Round 1, y<\/span><span>ou <strong>always selected the lottery<\/strong>.&nbsp;<\/span><\/li>\n<\/ul>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>","QuestionJS":"Qualtrics.SurveyEngine.addOnReady(function () {\n    var qthis = this;\n    var controller = this.getQuestionContainer();\n    \/\/ Replace with your actual QIDs\n    var questionIDs = [\"QID360\", \"QID356\", \"QID355\", \"QID366\"];\n    \/\/ Unique key for this page\n    var revealKey = \"revealed_\" + this.questionId;\n    \/\/ Get Qualtrics Next button\n    var nextButton = document.getElementById(\"NextButton\");\n    \/\/ =========================\n    \/\/ Read embedded color variables\n    \/\/ =========================\n    var bgColor = \"${e:\/\/Field\/main_button_backgroundColor}\";\n    var borderColor = \"${e:\/\/Field\/main_button_border}\";\n    var textColor = \"${e:\/\/Field\/main_button_color}\";\n    \/\/ Fallbacks\n    bgColor = bgColor || \"#AFE1AF\";\n    borderColor = borderColor || \"#7FBF7F\";\n    textColor = textColor || \"#1f3d1f\";\n    function hideQuestions() {\n        questionIDs.forEach(function(qid) {\n            var q = document.getElementById(qid);\n            if (q) {\n                q.style.visibility = \"hidden\";\n                q.style.height = \"0px\";\n                q.style.overflow = \"hidden\";\n                q.style.margin = \"0\";\n                q.style.padding = \"0\";\n            }\n        });\n    }\n    function showQuestions() {\n        questionIDs.forEach(function(qid) {\n            var q = document.getElementById(qid);\n            if (q) {\n                q.style.visibility = \"visible\";\n                q.style.height = \"auto\";\n                q.style.overflow = \"visible\";\n                q.style.margin = \"\";\n                q.style.padding = \"\";\n                void q.offsetHeight;\n            }\n        });\n        setTimeout(function() {\n            window.dispatchEvent(new Event(\"resize\"));\n        }, 50);\n    }\n    \/\/ Color helper for hover\n    function darkenColor(hex, factor) {\n        hex = hex.replace(\"#\", \"\");\n        var r = parseInt(hex.substring(0,2), 16);\n        var g = parseInt(hex.substring(2,4), 16);\n        var b = parseInt(hex.substring(4,6), 16);\n        r = Math.floor(r * factor);\n        g = Math.floor(g * factor);\n        b = Math.floor(b * factor);\n        return \"#\" + [r,g,b].map(x => x.toString(16).padStart(2,\"0\")).join(\"\");\n    }\n    \/\/ Check whether questions were already revealed\n    var alreadyRevealed = sessionStorage.getItem(revealKey) === \"true\";\n    if (alreadyRevealed) {\n        showQuestions();\n        qthis.showNextButton();\n        if (nextButton) {\n            nextButton.style.display = \"\";\n        }\n        return;\n    }\n    \/\/ First load: hide Next button and questions\n    qthis.hideNextButton();\n    if (nextButton) {\n        nextButton.style.display = \"none\";\n    }\n    hideQuestions();\n    \/\/ Create centered button\n    var wrapper = document.createElement(\"div\");\n    wrapper.style.textAlign = \"center\";\n    wrapper.style.margin = \"30px 0\";\n    var button = document.createElement(\"button\");\n    button.type = \"button\";\n    button.innerHTML = \"Click to answer the next 4 questions\";\n    \/\/ Styling\n    button.style.padding = \"12px 24px\";\n    button.style.cursor = \"pointer\";\n    button.style.backgroundColor = bgColor;\n    button.style.border = \"1px solid \" + borderColor;\n    button.style.borderRadius = \"6px\";\n    button.style.fontSize = \"16px\";\n    button.style.fontWeight = \"600\";\n    button.style.color = textColor;\n    \/\/ Hover effect\n    var hoverColor = darkenColor(bgColor, 0.9);\n    button.addEventListener(\"mouseenter\", function() {\n        button.style.backgroundColor = hoverColor;\n    });\n    button.addEventListener(\"mouseleave\", function() {\n        button.style.backgroundColor = bgColor;\n    });\n    wrapper.appendChild(button);\n    controller.appendChild(wrapper);\n    button.addEventListener(\"click\", function () {\n        sessionStorage.setItem(revealKey, \"true\");\n        showQuestions();\n        qthis.showNextButton();\n        if (nextButton) {\n            nextButton.style.display = \"\";\n        }\n        wrapper.remove();\n    });\n});","DefaultChoices":false,"DataExportTag":"Q208","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Instructions for Part ${e:\/\/Field\/current_part}, Round 2 of 2 rounds \u00a0 Recall, in this round, you...","DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">xrisk_topcorner<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> 1 <\/span>","LeftOperand":"xrisk_topcorner","LogicType":"EmbeddedField","Operator":"EqualTo","RightOperand":"1","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID396"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID397","SecondaryAttribute":"Click to write the question text","TertiaryAttribute":null,"Payload":{"QuestionText":"Click to write the question text","DataExportTag":"Q209","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Click to write the question text","Choices":{"1":{"Display":"Click to write Choice 1"},"2":{"Display":"Click to write Choice 2"},"3":{"Display":"Click to write Choice 3"}},"ChoiceOrder":["1","2","3"],"Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID397"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID398","SecondaryAttribute":"Page ${e:\/\/Field\/risk_position} of 4 pages of Final Questionnaire","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Page ${e:\/\/Field\/risk_position} of 4 pages of Final Questionnaire<\/strong>","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuratio