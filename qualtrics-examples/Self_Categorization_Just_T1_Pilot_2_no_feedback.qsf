trong><\/span><\/li>\n<\/ul>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>\n<\/div>","QuestionJS":"Qualtrics.SurveyEngine.addOnReady(function () {\n    var qthis = this;\n    var controller = this.getQuestionContainer();\n    \/\/ The 4 competitiveness MF self-categorization questions\n    var questionIDs = [\"QID373\", \"QID367\",  \"QID374\", \"QID368\"];\n    \/\/ Unique key for this page\n    var revealKey = \"revealed_\" + this.questionId;\n    \/\/ Get Qualtrics Next button\n    var nextButton = document.getElementById(\"NextButton\");\n    \/\/ =========================\n    \/\/ Read embedded color variables\n    \/\/ =========================\n    var bgColor = \"${e:\/\/Field\/main_button_backgroundColor}\";\n    var borderColor = \"${e:\/\/Field\/main_button_border}\";\n    var textColor = \"${e:\/\/Field\/main_button_color}\";\n    \/\/ Fallbacks\n    bgColor = bgColor || \"#AFE1AF\";\n    borderColor = borderColor || \"#7FBF7F\";\n    textColor = textColor || \"#1f3d1f\";\n    function hideQuestions() {\n        questionIDs.forEach(function(qid) {\n            var q = document.getElementById(qid);\n            if (q) {\n                q.style.visibility = \"hidden\";\n                q.style.height = \"0px\";\n                q.style.overflow = \"hidden\";\n                q.style.margin = \"0\";\n                q.style.padding = \"0\";\n            }\n        });\n    }\n    function showQuestions() {\n        questionIDs.forEach(function(qid) {\n            var q = document.getElementById(qid);\n            if (q) {\n                q.style.visibility = \"visible\";\n                q.style.height = \"auto\";\n                q.style.overflow = \"visible\";\n                q.style.margin = \"\";\n                q.style.padding = \"\";\n                void q.offsetHeight;\n            }\n        });\n        setTimeout(function() {\n            window.dispatchEvent(new Event(\"resize\"));\n        }, 50);\n    }\n    \/\/ Color helper for hover\n    function darkenColor(hex, factor) {\n        hex = hex.replace(\"#\", \"\");\n        var r = parseInt(hex.substring(0,2), 16);\n        var g = parseInt(hex.substring(2,4), 16);\n        var b = parseInt(hex.substring(4,6), 16);\n        r = Math.floor(r * factor);\n        g = Math.floor(g * factor);\n        b = Math.floor(b * factor);\n        return \"#\" + [r,g,b].map(function(x) { return x.toString(16).padStart(2,\"0\"); }).join(\"\");\n    }\n    \/\/ Check whether questions were already revealed\n    var alreadyRevealed = sessionStorage.getItem(revealKey) === \"true\";\n    if (alreadyRevealed) {\n        showQuestions();\n        qthis.showNextButton();\n        if (nextButton) {\n            nextButton.style.display = \"\";\n        }\n        return;\n    }\n    \/\/ First load: hide Next button and questions\n    qthis.hideNextButton();\n    if (nextButton) {\n        nextButton.style.display = \"none\";\n    }\n    hideQuestions();\n    \/\/ Create centered button\n    var wrapper = document.createElement(\"div\");\n    wrapper.style.textAlign = \"center\";\n    wrapper.style.margin = \"30px 0\";\n    var button = document.createElement(\"button\");\n    button.type = \"button\";\n    button.innerHTML = \"Click to answer the first 4 questions\";\n    \/\/ Styling\n    button.style.padding = \"12px 24px\";\n    button.style.cursor = \"pointer\";\n    button.style.backgroundColor = bgColor;\n    button.style.border = \"1px solid \" + borderColor;\n    button.style.borderRadius = \"6px\";\n    button.style.fontSize = \"16px\";\n    button.style.fontWeight = \"600\";\n    button.style.color = textColor;\n    \/\/ Hover effect\n    var hoverColor = darkenColor(bgColor, 0.9);\n    button.addEventListener(\"mouseenter\", function() {\n        button.style.backgroundColor = hoverColor;\n    });\n    button.addEventListener(\"mouseleave\", function() {\n        button.style.backgroundColor = bgColor;\n    });\n    wrapper.appendChild(button);\n    controller.appendChild(wrapper);\n    button.addEventListener(\"click\", function () {\n        sessionStorage.setItem(revealKey, \"true\");\n        showQuestions();\n        qthis.showNextButton();\n        if (nextButton) {\n            nextButton.style.display = \"\";\n        }\n        wrapper.remove();\n    });\n});","DefaultChoices":false,"DataExportTag":"Q279","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Instructions for Part ${e:\/\/Field\/current_part}, Round 3 of ${e:\/\/Field\/comp_totalrounds} rounds...","DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">xcomp_topcorner<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> 1 <\/span>","LeftOperand":"xcomp_topcorner","LogicType":"EmbeddedField","Operator":"EqualTo","RightOperand":"1","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID330"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID331","SecondaryAttribute":"Instructions for Part ${e:\/\/Field\/current_part}, Round 3 of\u00a0${e:\/\/Field\/comp_totalrounds} rounds...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Instructions for Part ${e:\/\/Field\/current_part}, Round 3 of&nbsp;${e:\/\/Field\/comp_totalrounds} rounds<\/strong><br \/>\n<br \/>\nRecall, in this round, you earn a fixed payment of $1.50 for answering 12 questions.&nbsp;<br \/>\n<br \/>\nYou already answered some questions. The following 4 questions will ask you to compare your choices between tournament payment and fixed payment to those of <b>male participants<\/b>, specifically other participants who went through the same study who are men.\n<ul>\n\t<li><span>Recall, for the math task, you selected the <strong>tournament payment <\/strong>when the fixed payment was <strong>$${e:\/\/Field\/xcomp_xl} or less<\/strong> and the <strong>fixed payment <\/strong>when it was <strong>$${e:\/\/Field\/xcomp_xr} or more<\/strong>.&nbsp;<\/span><\/li>\n<\/ul>","QuestionJS":"Qualtrics.SurveyEngine.addOnReady(function () {\n    var qthis = this;\n    var controller = this.getQuestionContainer();\n    \/\/ The 4 competitiveness MF self-categorization questions\n    var questionIDs = [\"QID370\", \"QID376\", \"QID369\", \"QID375\"];\n    \/\/ Unique key for this page\n    var revealKey = \"revealed_\" + this.questionId;\n    \/\/ Get Qualtrics Next button\n    var nextButton = document.getElementById(\"NextButton\");\n    \/\/ =========================\n    \/\/ Read embedded color variables\n    \/\/ =========================\n    var bgColor = \"${e:\/\/Field\/main_button_backgroundColor}\";\n    var borderColor = \"${e:\/\/Field\/main_button_border}\";\n    var textColor = \"${e:\/\/Field\/main_button_color}\";\n    \/\/ Fallbacks\n    bgColor = bgColor || \"#AFE1AF\";\n    borderColor = borderColor || \"#7FBF7F\";\n    textColor = textColor || \"#1f3d1f\";\n    function hideQuestions() {\n        questionIDs.forEach(function(qid) {\n            var q = document.getElementById(qid);\n            if (q) {\n                q.style.visibility = \"hidden\";\n                q.style.height = \"0px\";\n                q.style.overflow = \"hidden\";\n                q.style.margin = \"0\";\n                q.style.padding = \"0\";\n            }\n        });\n    }\n    function showQuestions() {\n        questionIDs.forEach(function(qid) {\n            var q = document.getElementById(qid);\n            if (q) {\n                q.style.visibility = \"visible\";\n                q.style.height = \"auto\";\n                q.style.overflow = \"visible\";\n                q.style.margin = \"\";\n                q.style.padding = \"\";\n                void q.offsetHeight;\n            }\n        });\n        setTimeout(function() {\n            window.dispatchEvent(new Event(\"resize\"));\n        }, 50);\n    }\n    \/\/ Color helper for hover\n    function darkenColor(hex, factor) {\n        hex = hex.replace(\"#\", \"\");\n        var r = parseInt(hex.substring(0,2), 16);\n        var g = parseInt(hex.substring(2,4), 16);\n        var b = parseInt(hex.substring(4,6), 16);\n        r = Math.floor(r * factor);\n        g = Math.floor(g * factor);\n        b = Math.floor(b * factor);\n        return \"#\" + [r,g,b].map(function(x) { return x.toString(16).padStart(2,\"0\"); }).join(\"\");\n    }\n    \/\/ Check whether questions were already revealed\n    var alreadyRevealed = sessionStorage.getItem(revealKey) === \"true\";\n    if (alreadyRevealed) {\n        showQuestions();\n        qthis.showNextButton();\n        if (nextButton) {\n            nextButton.style.display = \"\";\n        }\n        return;\n    }\n    \/\/ First load: hide Next button and questions\n    qthis.hideNextButton();\n    if (nextButton) {\n        nextButton.style.display = \"none\";\n    }\n    hideQuestions();\n    \/\/ Create centered button\n    var wrapper = document.createElement(\"div\");\n    wrapper.style.textAlign = \"center\";\n    wrapper.style.margin = \"30px 0\";\n    var button = document.createElement(\"button\");\n    button.type = \"button\";\n    button.innerHTML = \"Click to answer the next 4 questions\";\n    \/\/ Styling\n    button.style.padding = \"12px 24px\";\n    button.style.cursor = \"pointer\";\n    button.style.backgroundColor = bgColor;\n    button.style.border = \"1px solid \" + borderColor;\n    button.style.borderRadius = \"6px\";\n    button.style.fontSize = \"16px\";\n    button.style.fontWeight = \"600\";\n    button.style.color = textColor;\n    \/\/ Hover effect\n    var hoverColor = darkenColor(bgColor, 0.9);\n    button.addEventListener(\"mouseenter\", function() {\n        button.style.backgroundColor = hoverColor;\n    });\n    button.addEventListener(\"mouseleave\", function() {\n        button.style.backgroundColor = bgColor;\n    });\n    wrapper.appendChild(button);\n    controller.appendChild(wrapper);\n    button.addEventListener(\"click\", function () {\n        sessionStorage.setItem(revealKey, \"true\");\n        showQuestions();\n        qthis.showNextButton();\n        if (nextButton) {\n            nextButton.style.display = \"\";\n        }\n        wrapper.remove();\n    });\n});","DefaultChoices":false,"DataExportTag":"Q280","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Instructions for Part ${e:\/\/Field\/current_part}, Round 3 of\u00a0${e:\/\/Field\/comp_totalrounds} rounds...","DisplayLogic":{"0":{"0":{"Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"LeftOpDesc\">xcomp_interior<\/span> <span class=\"OpDesc\">Is Equal to<\/span> <span class=\"RightOpDesc\"> 1 <\/span>","LeftOperand":"xcomp_interior","LogicType":"EmbeddedField","Operator":"EqualTo","RightOperand":"1","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression","inPage":false},"ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID331"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID332","SecondaryAttribute":"Instructions for Part ${e:\/\/Field\/current_part}, Round 3 of ${e:\/\/Field\/comp_totalrounds} rounds...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Instructions for Part ${e:\/\/Field\/current_part}, Round 3 of ${e:\/\/Field\/comp_totalrounds} rounds<\/strong>\n<div class=\"relative w-full mt-4 mb-1\">\n<div>\n<div class=\"relative\">\n<div class=\"h-full min-h-0 min-w-0\">\n<div class=\"h-full min-h-0 min-w-0\">\n<div class=\"border border-token-border-light border-radius-3xl corner-super