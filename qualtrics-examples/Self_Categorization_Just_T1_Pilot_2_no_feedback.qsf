Field\/correct_T1_4}\")\n\tconst CorrectT15 = parseInt(\"${e:\/\/Field\/correct_T1_5}\")\n\tconst CorrectT16 = parseInt(\"${e:\/\/Field\/correct_T1_6}\")\n\tconst CorrectT17 = parseInt(\"${e:\/\/Field\/correct_T1_7}\")\n\tconst CorrectT18 = parseInt(\"${e:\/\/Field\/correct_T1_8}\")\n\tconst CorrectT19 = parseInt(\"${e:\/\/Field\/correct_T1_9}\")\n\tconst CorrectT110 = parseInt(\"${e:\/\/Field\/correct_T1_10}\")\n\tconst CorrectT111 = parseInt(\"${e:\/\/Field\/correct_T1_11}\")\n\tconst CorrectT112 = parseInt(\"${e:\/\/Field\/correct_T1_12}\")\n\tconst CorrectT113 = parseInt(\"${e:\/\/Field\/correct_T1_13}\")\n\tconst CorrectT114 = parseInt(\"${e:\/\/Field\/correct_T1_14}\")\n\tconst CorrectT115 = parseInt(\"${e:\/\/Field\/correct_T1_15}\")\n\n\tconst CorrectT21 = parseInt(\"${e:\/\/Field\/correct_T2_1}\")\n\tconst CorrectT22 = parseInt(\"${e:\/\/Field\/correct_T2_2}\")\n\tconst CorrectT23 = parseInt(\"${e:\/\/Field\/correct_T2_3}\")\n\tconst CorrectT24 = parseInt(\"${e:\/\/Field\/correct_T2_4}\")\n\tconst CorrectT25 = parseInt(\"${e:\/\/Field\/correct_T2_5}\")\n\tconst CorrectT26 = parseInt(\"${e:\/\/Field\/correct_T2_6}\")\n\tconst CorrectT27 = parseInt(\"${e:\/\/Field\/correct_T2_7}\")\n\tconst CorrectT28 = parseInt(\"${e:\/\/Field\/correct_T2_8}\")\n\tconst CorrectT29 = parseInt(\"${e:\/\/Field\/correct_T2_9}\")\n\tconst CorrectT210 = parseInt(\"${e:\/\/Field\/correct_T2_10}\")\n\tconst CorrectT211 = parseInt(\"${e:\/\/Field\/correct_T2_11}\")\n\tconst CorrectT212 = parseInt(\"${e:\/\/Field\/correct_T2_12}\")\n\tconst CorrectT213 = parseInt(\"${e:\/\/Field\/correct_T2_13}\")\n\tconst CorrectT214 = parseInt(\"${e:\/\/Field\/correct_T2_14}\")\n\tconst CorrectT215 = parseInt(\"${e:\/\/Field\/correct_T2_15}\")\n\n\tconst CorrectT31 = parseInt(\"${e:\/\/Field\/correct_T3_1}\")\n\tconst CorrectT32 = parseInt(\"${e:\/\/Field\/correct_T3_2}\")\n\tconst CorrectT33 = parseInt(\"${e:\/\/Field\/correct_T3_3}\")\n\tconst CorrectT34 = parseInt(\"${e:\/\/Field\/correct_T3_4}\")\n\tconst CorrectT35 = parseInt(\"${e:\/\/Field\/correct_T3_5}\")\n\tconst CorrectT36 = parseInt(\"${e:\/\/Field\/correct_T3_6}\")\n\tconst CorrectT37 = parseInt(\"${e:\/\/Field\/correct_T3_7}\")\n\tconst CorrectT38 = parseInt(\"${e:\/\/Field\/correct_T3_8}\")\n\tconst CorrectT39 = parseInt(\"${e:\/\/Field\/correct_T3_9}\")\n\tconst CorrectT310 = parseInt(\"${e:\/\/Field\/correct_T3_10}\")\n\tconst CorrectT311 = parseInt(\"${e:\/\/Field\/correct_T3_11}\")\n\tconst CorrectT312 = parseInt(\"${e:\/\/Field\/correct_T3_12}\")\n\tconst CorrectT313 = parseInt(\"${e:\/\/Field\/correct_T3_13}\")\n\tconst CorrectT314 = parseInt(\"${e:\/\/Field\/correct_T3_14}\")\n\tconst CorrectT315 = parseInt(\"${e:\/\/Field\/correct_T3_15}\")\n\t\n\n\tconst score1 = CorrectT11 + CorrectT12 + CorrectT13 + CorrectT14 + CorrectT15 + CorrectT16 + CorrectT17 + CorrectT18 + CorrectT19 + CorrectT110 + CorrectT111 + CorrectT112 + CorrectT113 + CorrectT114 + CorrectT115\n\tQualtrics.SurveyEngine.setEmbeddedData(\"score1\", score1);\n\t\n\tconst score2 = CorrectT21 + CorrectT22 + CorrectT23 + CorrectT24 + CorrectT25 + CorrectT26 + CorrectT27 + CorrectT28 + CorrectT29 + CorrectT210 + CorrectT211 + CorrectT212 + CorrectT213 + CorrectT214 + CorrectT215\n\tQualtrics.SurveyEngine.setEmbeddedData(\"score2\", score2);\n\t\n\tconst score3 = CorrectT31 + CorrectT32 + CorrectT33 + CorrectT34 + CorrectT35 + CorrectT36 + CorrectT37 + CorrectT38 + CorrectT39 + CorrectT310 + CorrectT311 + CorrectT312 + CorrectT313 + CorrectT314 + CorrectT315\n\tQualtrics.SurveyEngine.setEmbeddedData(\"score3\", score3);\n\n\tconst score = score1 + score2 + score3;\n\tQualtrics.SurveyEngine.setEmbeddedData(\"score\", score);\n\n\n});"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID132","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"risk_instruc_timing","QuestionID":"QID132","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":9,"NextAnswerId":1}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID133","SecondaryAttribute":"Please indicate which payment option you prefer on each row by clicking on the row where you woul...","TertiaryAttribute":null,"Payload":{"QuestionText":"<div><\/div>Please indicate which payment option you prefer on each row by clicking on the row where you would like to switch from choosing Option A on the left to choosing Option B on the right. <br><br>(You cannot click the submit button until you have selected an answer.)\n<div><div><\/div>\n<\/div>","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n    \/\/ var $j = jQuery;\n    try {\n        console.log(\"=== RISK MPL SCRIPT START ===\");\n\n        \/\/ ------------------------------------------------------------\n        \/\/ Basic setup\n        \/\/ ------------------------------------------------------------\n        console.log(\"this =\", this);\n        console.log(\"questionId =\", this.questionId);\n\n        this.hideNextButton();\n        console.log(\"Next button hidden\");\n\n        var loopRaw = \"${lm:\/\/CurrentLoopNumber}\";\n        var stakeRaw = \"${e:\/\/Field\/risk_max}\";\n        var listRaw = \"${e:\/\/Field\/list}\";\n        var riskOptionAHRaw = \"${e:\/\/Field\/risk_optionA_h}\";\n        var riskProbHRaw = \"${e:\/\/Field\/risk_prob_h}\";\n        var nrowsRaw = \"${e:\/\/Field\/risk_nrows}\";\n\n        console.log(\"loopRaw =\", loopRaw);\n        console.log(\"stakeRaw =\", stakeRaw);\n        console.log(\"listRaw =\", listRaw);\n        console.log(\"riskOptionAHRaw =\", riskOptionAHRaw);\n        console.log(\"riskProbHRaw =\", riskProbHRaw);\n        console.log(\"nrowsRaw =\", nrowsRaw);\n\n        var loop = parseInt(loopRaw, 10);\n        var stake = parseFloat(stakeRaw);\n        var riskOptionAH = parseFloat(riskOptionAHRaw);\n        var riskProbH = parseFloat(riskProbHRaw);\n        var nrows = parseInt(nrowsRaw, 10);\n\n        console.log(\"parsed loop =\", loop);\n        console.log(\"parsed stake =\", stake);\n        console.log(\"parsed riskOptionAH =\", riskOptionAH);\n        console.log(\"parsed riskProbH =\", riskProbH);\n        console.log(\"parsed nrows =\", nrows);\n\n        if (isNaN(loop)) console.warn(\"WARNING: loop is NaN\");\n        if (isNaN(stake)) console.warn(\"WARNING: stake is NaN\");\n        if (isNaN(riskOptionAH)) console.warn(\"WARNING: riskOptionAH is NaN\");\n        if (isNaN(riskProbH)) console.warn(\"WARNING: riskProbH is NaN\");\n        if (isNaN(nrows)) console.warn(\"WARNING: nrows is NaN\");\n        if (nrows <= 1) console.warn(\"WARNING: nrows <= 1, increment will break\");\n\n        var increment = stake \/ (nrows - 1);\n        console.log(\"computed increment =\", increment);\n\n        var inputId = \"#\" + String(this.questionId);\n        console.log(\"inputId =\", inputId);\n        console.log(\"input element exists? length =\", $j(inputId).length);\n\n        if ($j(inputId).length === 0) {\n            console.error(\"ERROR: question container not found for inputId =\", inputId);\n        }\n\n        \/\/ ------------------------------------------------------------\n        \/\/ Config\n        \/\/ ------------------------------------------------------------\n        var prefix = \"xrisk\";\n\n        console.log(\"prefix =\", prefix);\n\n        var prefixXL = prefix + \"_xl\";\n        var prefixXR = prefix + \"_xr\";\n        var prefixXSide = prefix + \"_xside\";\n        var prefixTopCorner = prefix + \"_topcorner\";\n        var prefixBottomCorner = prefix + \"_bottomcorner\";\n        var prefixInterior = prefix + \"_interior\";\n\n        console.log(\"dynamic embedded variable names:\");\n        console.log(\"prefixXL =\", prefixXL);\n        console.log(\"prefixXR =\", prefixXR);\n        console.log(\"prefixXSide =\", prefixXSide);\n        console.log(\"prefixTopCorner =\", prefixTopCorner);\n        console.log(\"prefixBottomCorner =\", prefixBottomCorner);\n        console.log(\"prefixInterior =\", prefixInterior);\n        console.log(\"main prefix variable =\", prefix);\n\n        \/\/ ------------------------------------------------------------\n        \/\/ Build table\n        \/\/ ------------------------------------------------------------\n        console.log(\"Appending table HTML...\");\n        $j(inputId).append(\n            \"<table align='center' class='uncertainty'>\\\n                <thead class='uncertaintyhead'>\\\n                    <tr>\\\n                        <th style='width:12em' class='thtext'> Option A: Lottery <\/th>\\\n                        <th style='width:1em'><\/th>\\\n                        <th style='width:12em' class='thtext'> Option B: Fixed Payment <\/th>\\\n                    <\/tr>\\\n                <\/thead>\\\n                <tbody class='uncert' id='maintable'>\\\n                    <tr class='middletd'>\\\n                        <td><\/td>\\\n                        <td><\/td>\\\n                        <td><\/td>\\\n                    <\/tr>\\\n                <\/tbody>\\\n            <\/table>\"\n        );\n        console.log(\"Table appended\");\n        console.log(\"maintable exists? length =\", $j(\"#maintable\").length);\n\n        var multistring = \"\";\n\n        console.log(\"Building rows using nrows =\", nrows, \"and increment =\", increment);\n\n        for (var i = 0; i < nrows; i++) {\n            var num = i * increment;\n            var n = num.toFixed(2);\n\n            console.log(\"Building row\", i + 1, \"num =\", num, \"display n =\", n);\n\n            multistring = multistring + \"\\\n<tr class='middletd'>\\\n<td style='width:10em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i + 1) + \"left' name='\" + (i + 1) + \"'>Receive $\" + riskOptionAH.toFixed(2) + \" with probability \" + riskProbH + \"%, $0 otherwise<\/td>\\\n<td style='width:10em'>OR<\/td>\\\n<td style='width:10em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i + 1) + \"right' name='\" + (i + 1) + \"'>Receive $\" + n + \"<\/td>\\\n<\/tr>\";\n        }\n\n        console.log(\"Finished building rows\");\n        console.log(\"multistring length =\", multistring.length);\n\n        $j(\"#maintable\").append(multistring);\n        console.log(\"Rows appended to #maintable\");\n        console.log(\"Number of .letters elements after append =\", $j(\".letters\").length);\n\n        \/\/ ------------------------------------------------------------\n        \/\/ Save arrays \/ timing\n        \/\/ ------------------------------------------------------------\n        var time_start = Date.now() \/ 1000;\n        var times = [];\n        var choices = [];\n        var changed = [];\n\n        console.log(\"time_start =\", time_start);\n        console.log(\"times initialized =\", times);\n        console.log(\"choices initialized =\", choices);\n        console.log(\"changed initialized =\", changed);\n\n        \/\/ ------------------------------------------------------------\n        \/\/ Update list count\n        \/\/ ------------------------------------------------------------\n        var list = \"${e:\/\/Field\/list}\";\n        console.log(\"list before parse =\", list);\n\n        list = parseInt(list, 10);\n        console.log(\"list after parse =\", list);\n\n        if (isNaN(list)) {\n            console.warn(\"WARNING: list is NaN before incrementing\");\n        }\n\n        list = list + 1;\n        console.log(\"list after increment =\", list);\n\n        Qualtrics.SurveyEngine.setEmbeddedData(\"list\", list);\n        console.log(\"Embedded data set: list =\", list);\n\n        \/\/ ------------------------------------------------------------\n        \/\/ Click behavior\n        \/\/ ------------------------------------------------------------\n        var choice_now = -1;\n        console.log(\"choice_now initialized =\", choice_now);\n\n        $j(\".letters\").click(function () {\n            try {\n                console.log(\"=== CLICK EVENT START ===\");\n                console.log(\"Clicked element =\", this);\n                console.log(\"Clicked element id =\", $j(this).attr(\"id\"));\n                console.log(\"Clicked element name =\", $j(this).attr(\"name\"));\n                console.log(\"Clicked element text =\", $j(this).text());\n\n                var id = $j(this).attr(\"name\");\n                var time = Date.now() \/ 1000 - time_start;\n                choice_now = $j(this).attr(\"id\");\n\n                console.log(\"id =\", id);\n                console.log(\"elapsed time =\", time);\n                console.log(\"choice_now =\", choice_now);\n\n                times.push(time.toFixed(2));\n                choices.push(choice_now);\n\n                console.log(\"times =\", times);\n                console.log(\"choices =\", choices);\n\n                Qualtrics.SurveyEngine.setEmbeddedData(prefix + \"Time\", times);\n                Qualtrics.SurveyEngine.setEmbeddedData(prefix + \"Choices\", choices);\n                console.log(\"Embedded data set:\", prefix + \"Time\", times);\n                console.log(\"Embedded data set:\", prefix + \"Choices\", choices);\n\n                var id_number = parseInt(id, 10);\n                console.log(\"id_number =\", id_number);\n\n                if (isNaN(id_number)) {\n                    console.error(\"ERROR: id_number is NaN\");\n                }\n\n                $j(\"td[name='\" + id + \"']\").removeClass(\"letters_selected\").addClass(\"letters\");\n                $j(this).removeClass(\"letters\").addClass(\"letters_selected\");\n                console.log(\"Updated selected class for clicked row\");\n\n                Qualtrics.SurveyEngine.setEmbeddedData(prefix + \"IdFinal\", id_number);\n                Qualtrics.SurveyEngine.setEmbeddedData(prefix + \"ChoiceFinal\", choice_now);\n                console.log(\"Embedded data set:\", prefix + \"IdFinal\", id_number);\n                console.log(\"Embedded data set:\", prefix + \"ChoiceFinal\", choice_now);\n\n                \/\/ ----------------------------------------------------\n                \/\/ Compute implied interval and scalar\n                \/\/ ----------------------------------------------------\n                var norm_lb, norm_ub;\n                var xside;\n                var xvalue;\n\n                if (choice_now.indexOf(\"left\") >= 0) {\n                    norm_lb = (id_number - 1) * increment;\n                    norm_ub = id_number * increment;\n                    xside = \"LEFT\";\n                    xvalue = (id_number - 1) * increment;\n                    console.log(\"Left choice detected\");\n                } else {\n                    norm_lb = (id_number - 2) * increment;\n                    norm_ub = (id_number - 1) * increment;\n                    xside = \"RIGHT\";\n                    xvalue = (id_number - 2) * increment;\n                    console.log(\"Right choice detected\");\n                }\n\n                console.log(\"Initial norm_lb =\", norm_lb);\n                console.log(\"Initial norm_ub =\", norm_ub);\n                console.log(\"Initial xside =\", xside);\n                console.log(\"Initial xvalue =\", xvalue);\n\n                if (choice_now == nrows + \"left\") {\n                    norm_lb = stake;\n                    norm_ub = stake;\n                    xvalue = stake;\n                    var changed_now = 1;\n                    changed.push(changed_now);\n                    console.log(\"Boundary case last-row-left triggered\");\n                }\n\n                if (choice_now == \"1right\") {\n                    norm_lb = 0;\n                    norm_ub = 0;\n                    xvalue = 0;\n                    changed_now = 2;\n                    changed.push(changed_now);\n                    console.log(\"Boundary case 1right triggered\");\n                }\n\n                if (norm_lb < increment) {\n                    norm_lb = 0;\n                    changed_now = 3;\n                    changed.push(changed_now);\n                    console.log(\"norm_lb < increment adjustment triggered\");\n                }\n\n                if (norm_lb > stake) {\n                    norm_lb = stake;\n                    changed_now = 4;\n                    changed.push(changed_now);\n                    console.log(\"norm_lb > stake adjustment triggered\");\n                }\n\n                if (norm_ub < increment) {\n                    norm_ub = 0;\n                    changed_now = 5;\n                    changed.push(changed_now);\n                    console.log(\"norm_ub < increment adjustment triggered\");\n                }\n\n                if (norm_ub > stake) {\n                    norm_ub = stake;\n                    changed_now = 6;\n                    changed.push(changed_now);\n                    console.log(\"norm_ub > stake adjustment triggered\");\n                }\n\n                if (xvalue <= 0) {\n                    console.log(\"xvalue <= 0, imputing first increment =\", increment);\n                    xvalue = increment;\n                }\n\n                if (xvalue > stake) {\n                    console.log(\"xvalue > stake, resetting to stake\");\n                    xvalue = stake;\n                }\n\n                norm_lb = Number(norm_lb.toFixed(2));\n                norm_ub = Number(norm_ub.toFixed(2));\n                xvalue = Number(xvalue.toFixed(2));\n\n                console.log(\"Final norm_lb =\", norm_lb);\n                console.log(\"Final norm_ub =\", norm_ub);\n                console.log(\"Final xside =\", xside);\n                console.log(\"Final xvalue =\", xvalue);\n                console.log(\"changed array =\", changed);\n\n                Qualtrics.SurveyEngine.setEmbeddedData(prefix + \"LB\", norm_lb);\n                Qualtrics.SurveyEngine.setEmbeddedData(prefix + \"UB\", norm_ub);\n                Qualtrics.SurveyEngine.setEmbeddedData(prefix + \"Changed\", changed);\n\n                console.log(\"Embedded data set:\", prefix + \"LB\", norm_lb);\n                console.log(\"Embedded data set:\", prefix + \"UB\", norm_ub);\n                console.log(\"Embedded data set:\", prefix + \"Changed\", changed);\n\n                \/\/ ----------------------------------------------------\n                \/\/ Respondent-facing thresholds\n                \/\/ ----------------------------------------------------\n                var xl_value = norm_lb;\n                var xr_value = norm_ub;\n\n                xl_value = Number(xl_value.toFixed(2));\n                xr_value = Number(xr_value.toFixed(2));\n\n                console.log(\"Respondent-facing xl_value =\", xl_value);\n                console.log(\"Respondent-facing xr_value =\", xr_value);\n\n                \/\/ Store display versions with two decimals\n                Qualtrics.SurveyEngine.setEmbeddedData(prefixXL, xl_value.toFixed(2));\n                Qualtrics.SurveyEngine.setEmbeddedData(prefixXR, xr_value.toFixed(2));\n\n                \/\/ Keep other downstream values in their original types\n                Qualtrics.SurveyEngine.setEmbeddedData(prefixXSide, xside);\n                Qualtrics.SurveyEngine.setEmbeddedData(prefix, xvalue);\n\n                console.log(\"Embedded data set:\", prefixXL, xl_value.toFixed(2));\n                console.log(\"Embedded data set:\", prefixXR, xr_value.toFixed(2));\n                console.log(\"Embedded data set:\", prefixXSide, xside);\n                console.log(\"Embedded data set:\", prefix, xvalue);\n\n                \/\/ ----------------------------------------------------\n                \/\/ Corner\/interior flags\n                \/\/ ----------------------------------------------------\n                var isTopCorner = (id_number === nrows && xside === \"LEFT\") ? \"1\" : \"0\";\n                var isBottomCorner = (id_number === 1 && xside === \"RIGHT\") ? \"1\" : \"0\";\n                var isInterior = (isTopCorner === \"0\" && isBottomCorner === \"0\") ? \"1\" : \"0\";\n\n                console.log(\"isTopCorner =\", isTopCorner);\n                console.log(\"isBottomCorner =\", isBottomCorner);\n                console.log(\"isInterior =\", isInterior);\n\n                Qualtrics.SurveyEngine.setEmbeddedData(prefixTopCorner, isTopCorner);\n                Qualtrics.SurveyEngine.setEmbeddedData(prefixBottomCorner, isBottomCorner);\n                Qualtrics.SurveyEngine.setEmbeddedData(prefixInterior, isInterior);\n\n                console.log(\"Embedded data set:\", prefixTopCorner, isTopCorner);\n                console.log(\"Embedded data set:\", prefixBottomCorner, isBottomCorner);\n                console.log(\"Embedded data set:\", prefixInterior, isInterior);\n\n                \/\/ ----------------------------------------------------\n                \/\/ Compute switch row numbers (X = last lottery row,\n                \/\/ X+1 = first fixed-payment row)\n                \/\/ ----------------------------------------------------\n                var switch_row_x, switch_row_xplus1;\n\n                if (isTopCorner === \"1\") {\n                    switch_row_x = nrows;\n                    switch_row_xplus1 = nrows + 1;\n                    console.log(\"Switch row: top-corner (always lottery)\");\n                } else if (isBottomCorner === \"1\") {\n                    switch_row_x = 0;\n                    switch_row_xplus1 = 1;\n                    console.log(\"Switch row: bottom-corner (always fixed payment)\");\n                } else {\n                    if (xside === \"RIGHT\") {\n                        switch_row_x = id_number - 1;\n                        switch_row_xplus1 = id_number;\n                    } else {\n                        switch_row_x = id_number;\n                        switch_row_xplus1 = id_number + 1;\n                    }\n                    console.log(\"Switch row: interior case\");\n                }\n\n                console.log(\"switch_row_x =\", switch_row_x);\n                console.log(\"switch_row_xplus1 =\", switch_row_xplus1);\n\n                Qualtrics.SurveyEngine.setEmbeddedData(\"risk_switch_row_x\", switch_row_x);\n                Qualtrics.SurveyEngine.setEmbeddedData(\"risk_switch_row_xplus1\", switch_row_xplus1);\n                console.log(\"Embedded data set: risk_switch_row_x =\", switch_row_x);\n                console.log(\"Embedded data set: risk_switch_row_xplus1 =\", switch_row_xplus1);\n\n                \/\/ ----------------------------------------------------\n                \/\/ Risk understanding check coding\n                \/\/ Option 1 = interior statement\n                \/\/ Option 2 = never chose lottery\n                \/\/ Option 3 = always chose lottery\n                \/\/ ----------------------------------------------------\n                var checkY;\n                var checkYPlus1;\n                var checkCorrectOption;\n\n                if (isInterior === \"1\") {\n                    checkY = xl_value;\n                    checkYPlus1 = xr_value;\n                    checkCorrectOption = \"1\";\n                    console.log(\"Risk understanding check: interior case\");\n                }\n\n                if (isBottomCorner === \"1\") {\n                    checkY = 7;\n                    checkYPlus1 = 8;\n                    checkCorrectOption = \"2\";\n                    console.log(\"Risk understanding check: bottom-corner case\");\n                }\n\n                if (isTopCorner === \"1\") {\n                    checkY = 7;\n                    checkYPlus1 = 8;\n                    checkCorrectOption = \"3\";\n                    console.log(\"Risk understanding check: top-corner case\");\n                }\n\n\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData(\"risk_self_comp_check_y\", Number(checkY).toFixed(2));\n\t\t\t\tQualtrics.SurveyEngine.setEmbeddedData(\"risk_self_comp_check_yplus1\", Number(checkYPlus1).toFixed(2));\n                Qualtrics.SurveyEngine.setEmbeddedData(\"risk_self_comp_check_correct_option\", checkCorrectOption);\n\n                console.log(\"Embedded data set: risk_self_comp_check_y =\", checkY);\n                console.log(\"Embedded data set: risk_self_comp_check_yplus1 =\", checkYPlus1);\n                console.log(\"Embedded data set: risk_self_comp_check_correct_option =\", checkCorrectOption);\n\n                \/\/ ----------------------------------------------------\n                \/\/ Randomly select payoff row for RISK (only once)\n                \/\/ ----------------------------------------------------\n                var existingRow = \"${e:\/\/Field\/risk_selected_row}\";\n                console.log(\"existing risk_selected_row =\", existingRow);\n\n                var selectedRow;\n\n                if (existingRow && existingRow !== \"\") {\n                    selectedRow = parseInt(existingRow, 10);\n                    console.log(\"Re-using existing selectedRow =\", selectedRow);\n                } else {\n                    selectedRow = Math.floor(Math.random() * nrows) + 1;\n                    console.log(\"Generated new selectedRow =\", selectedRow);\n                }\n\n                \/\/ ----------------------------------------------------\n                \/\/ Determine what was chosen in that selected row\n                \/\/ ----------------------------------------------------\n                var selectedChoiceText = \"\";\n                var selectedAmount = \"\";\n                var selectedChoseLottery = \"\";\n\n                console.log(\"xrisk_topcorner =\", isTopCorner);\n                console.log(\"xrisk_bottomcorner =\", isBottomCorner);\n                console.log(\"xrisk_interior =\", isInterior);\n                console.log(\"id_number =\", id_number);\n                console.log(\"xside =\", xside);\n                console.log(\"selectedRow =\", selectedRow);\n\n                if (isTopCorner === \"1\") {\n                    selectedChoiceText = \"lottery payment\";\n                    selectedAmount = 0;\n                    selectedChoseLottery = \"1\";\n                    console.log(\"Selected row choice determined from TOP CORNER: always lottery\");\n                }\n\n                else if (isBottomCorner === \"1\") {\n                    selectedAmount = Number(((selectedRow - 1) * increment).toFixed(2));\n                    selectedChoiceText = \"fixed payment\";\n                    selectedChoseLottery = \"0\";\n                    console.log(\"Selected row choice determined from BOTTOM CORNER: always fixed payment\");\n                }\n\n                else if (isInterior === \"1\") {\n                    if (xside === \"RIGHT\") {\n                        if (selectedRow < id_number) {\n                            selectedChoiceText = \"lottery payment\";\n                            selectedAmount = 0;\n                            selectedChoseLottery = \"1\";\n                            console.log(\"Interior case, xside RIGHT: selected row is lottery\");\n                        } else {\n                            selectedAmount = Number(((selectedRow - 1) * increment).toFixed(2));\n                            selectedChoiceText = \"fixed payment\";\n                            selectedChoseLottery = \"0\";\n                            console.log(\"Interior case, xside RIGHT: selected row is fixed payment\");\n                        }\n                    } else if (xside === \"LEFT\") {\n                        if (selectedRow <= id_number) {\n                            selectedChoiceText = \"lottery payment\";\n                            selectedAmount = 0;\n                            selectedChoseLottery = \"1\";\n                            console.log(\"Interior case, xside LEFT: selected row is lottery\");\n                        } else {\n                            selectedAmount = Number(((selectedRow - 1) * increment).toFixed(2));\n                            selectedChoiceText = \"fixed payment\";\n                            selectedChoseLottery = \"0\";\n                            console.log(\"Interior case, xside LEFT: selected row is fixed payment\");\n                        }\n                    } else {\n                        console.error(\"Interior case but xside is neither LEFT nor RIGHT:\", xside);\n                    }\n                }\n\n                else {\n                    console.error(\"Could not classify risk choice pattern.\");\n                }\n\n                Qualtrics.SurveyEngine.setEmbeddedData(\"risk_selected_row\", selectedRow);\n                Qualtrics.SurveyEngine.setEmbeddedData(\"risk_selected_amount\", selectedAmount);\n                Qualtrics.SurveyEngine.setEmbeddedData(\"risk_selected_choice_text\", selectedChoiceText);\n                Qualtrics.SurveyEngine.setEmbeddedData(\"risk_selected_chose_lottery\", selectedChoseLottery);\n\n                console.log(\"Embedded data set: risk_selected_row =\", selectedRow);\n                console.log(\"Embedded data set: risk_selected_amount =\", selectedAmount);\n                console.log(\"Embedded data set: risk_selected_choice_text =\", selectedChoiceText);\n                console.log(\"Embedded data set: risk_selected_chose_lottery =\", selectedChoseLottery);\n\n                \/\/ ----------------------------------------------------\n                \/\/ Update visual pattern\n                \/\/ ----------------------------------------------------\n                for (var k = id_number - 1; k > 0; k--) {\n                    var x = \"#\" + String(k) + \"left\";\n                    var y = \"#\" + String(k) + \"right\";\n\n                    console.log(\"Updating previous row k =\", k, \"x =\", x, \"y =\", y);\n\n                    $j(x).removeClass(\"letters\").addClass(\"letters_selected\");\n                    $j(y).addClass(\"letters\").removeClass(\"letters_selected\");\n                }\n\n                for (var m = id_number + 1; m <= nrows; m++) {\n                    var xr = \"#\" + String(m) + \"right\";\n                    var yl = \"#\" + String(m) + \"left\";\n\n                    console.log(\"Updating later row m =\", m, \"xr =\", xr, \"yl =\", yl);\n\n                    $j(xr).removeClass(\"letters\").addClass(\"letters_selected\");\n                    $j(yl).addClass(\"letters\").removeClass(\"letters_selected\");\n                }\n\n                console.log(\"=== CLICK EVENT END ===\");\n            } catch (err) {\n                console.error(\"ERROR INSIDE CLICK HANDLER:\", err);\n                console.error(\"Stack:\", err && err.stack ? err.stack : \"No stack available\");\n            }\n        });\n\n        console.log(\"Click handler attached to .letters elements\");\n\n        \/\/ ------------------------------------------------------------\n        \/\/ floatThead\n        \/\/ ------------------------------------------------------------\n        console.log(\"Checking floatThead plugin...\");\n        console.log(\"typeof $j.fn.floatThead =\", typeof $j.fn.floatThead);\n\n        if (typeof $j.fn.floatThead === \"function\") {\n            $j(\"table.uncertainty\").floatThead({\n                useAbsolutePositioning: false\n            });\n            console.log(\"floatThead initialized successfully\");\n        } else {\n            console.warn(\"floatThead plugin is not available; skipping initialization\");\n        }\n\n        \/\/ ------------------------------------------------------------\n        \/\/ Show next button once a choice exists\n        \/\/ ------------------------------------------------------------\n        this.questionclick = function (event, element) {\n            try {\n                console.log(\"questionclick fired\");\n                console.log(\"choice_now at questionclick =\", choice_now);\n\n                if (choice_now != -1) {\n                    this.showNextButton();\n                    console.log(\"Next button shown\");\n                } else {\n                    this.hideNextButton();\n                    console.log(\"Next button hidden again\");\n                }\n            } catch (err) {\n                console.error(\"ERROR INSIDE questionclick:\", err);\n                console.error(\"Stack:\", err && err.stack ? err.stack : \"No stack available\");\n            }\n        };\n\n        console.log(\"questionclick handler attached\");\n        console.log(\"=== RISK MPL SCRIPT END ===\");\n    } catch (err) {\n        console.error(\"FATAL SCRIPT ERROR:\", err);\n        console.error(\"Stack:\", err && err.stack ? err.stack : \"No stack available\");\n    }\n});","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please indicate which payment option you prefer on each row by clicking on the row where you woul...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"QuestionText_Unsafe":"<div>Please indicate which payment option you prefer on each row by clicking on the row where you would like to switch from choosing the option on the left to choosing the option on the right.<\/div>\n\n<div>&nbsp;<\/div>\n\n<div>\n<div>(Note that you cannot click on the submit button until you have selected an answer.)<\/div>\n<\/div>","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":1,"NextAnswerId":1,"DataExportTag":"risk_mpl","QuestionID":"QID133"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID134","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"QuestionType":"Timing","Selector":"PageTimer","Configuration":{"QuestionDescriptionOption":"UseText","MinSeconds":0,"MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"#QuestionText, TimingPageSubmit#"},"4":{"Display":"#QuestionText, TimingClickCount#"}},"GradingData":[],"Language":[],"QuestionText_Unsafe":"Timing","DataExportTag":"Q134","QuestionID":"QID134"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID135","SecondaryAttribute":"Please indicate which payment option you prefer on each row by clicking on the row where you woul...","TertiaryAttribute":null,"Payload":{"QuestionText":"Please indicate which payment option you prefer on each row by clicking on the row where you would like to switch from choosing Option A on the left to choosing Option B on the right. <br><br>(You cannot click the submit button until you have selected an answer.)","QuestionJS":"Qualtrics.SurveyEngine.addOnload(function () {\n    \/\/ var $j = jQuery;\n    try {\n        console.log(\"=== QUALTRICS SCRIPT START ===\");\n\n        \/\/ ------------------------------------------------------------\n        \/\/ Basic setup\n        \/\/ ------------------------------------------------------------\n        console.log(\"this =\", this);\n        console.log(\"questionId =\", this.questionId);\n\n        this.hideNextButton();\n        console.log(\"Next button hidden\");\n\n        var loopRaw = \"${lm:\/\/CurrentLoopNumber}\";\n        var stakeRaw = \"${e:\/\/Field\/generosity_max}\";\n        var minRaw = \"${e:\/\/Field\/generosity_min}\";\n        var listRaw = \"${e:\/\/Field\/list}\";\n        var nrowsRaw = \"${e:\/\/Field\/generosity_nrows}\";\n\n        console.log(\"loopRaw =\", loopRaw);\n        console.log(\"stakeRaw =\", stakeRaw);\n        console.log(\"minRaw =\", minRaw);\n        console.log(\"listRaw =\", listRaw);\n        console.log(\"nrowsRaw =\", nrowsRaw);\n\n        var loop = parseInt(loopRaw, 10);\n        var stake = parseFloat(stakeRaw);\n        var minSelf = parseFloat(minRaw);\n        var nrows = parseInt(nrowsRaw, 10);\n\n        console.log(\"parsed loop =\", loop);\n        console.log(\"parsed stake =\", stake);\n        console.log(\"parsed minSelf =\", minSelf);\n        console.log(\"parsed nrows =\", nrows);\n\n        if (isNaN(loop)) console.warn(\"WARNING: loop is NaN\");\n        if (isNaN(stake)) console.warn(\"WARNING: stake is NaN\");\n        if (isNaN(minSelf)) console.warn(\"WARNING: minSelf is NaN\");\n        if (isNaN(nrows)) console.warn(\"WARNING: nrows is NaN\");\n        if (nrows <= 1) console.warn(\"WARNING: nrows <= 1, increment will break\");\n\n        \/\/ CHANGED: increment now spans from minSelf to stake\n        var increment = (stake - minSelf) \/ (nrows - 1);\n        console.log(\"computed increment =\", increment);\n\n        var inputId = \"#\" + String(this.questionId);\n        console.log(\"inputId =\", inputId);\n        console.log(\"input element exists? length =\", $j(inputId).length);\n\n        if ($j(inputId).length === 0) {\n            console.error(\"ERROR: question container not found for inputId =\", inputId);\n        }\n\n        \/\/ ------------------------------------------------------------\n        \/\/ Config\n        \/\/ ------------------------------------------------------------\n        var prefix = \"xgenerosity\";\n\n        console.log(\"prefix =\", prefix);\n\n        var prefixXL = prefix + \"_xl\";\n        var prefixXR = prefix + \"_xr\";\n        var prefixXSide = prefix + \"_xside\";\n        var prefixTopCorner = prefix + \"_topcorner\";\n        var prefixBottomCorner = prefix + \"_bottomcorner\";\n        var prefixInterior = prefix + \"_interior\";\n\n        console.log(\"dynamic embedded variable names:\");\n        console.log(\"prefixXL =\", prefixXL);\n        console.log(\"prefixXR =\", prefixXR);\n        console.log(\"prefixXSide =\", prefixXSide);\n        console.log(\"prefixTopCorner =\", prefixTopCorner);\n        console.log(\"prefixBottomCorner =\", prefixBottomCorner);\n        console.log(\"prefixInterior =\", prefixInterior);\n        console.log(\"main prefix variable =\", prefix);\n\n        \/\/ ------------------------------------------------------------\n        \/\/ Build table\n        \/\/ ------------------------------------------------------------\n        console.log(\"Appending table HTML...\");\n        $j(inputId).append(\n            \"<table align='center' class='uncertainty'>\\\n                <thead class='uncertaintyhead'>\\\n                    <tr>\\\n                        <th style='width:12em' class='thtext'> Option A: Equal Payment<\/th>\\\n                        <th style='width:1em'><\/th>\\\n                        <th style='width:12em' class='thtext'> Option B: Payment for Self<\/th>\\\n                    <\/tr>\\\n                <\/thead>\\\n                <tbody class='uncert' id='maintable'>\\\n                    <tr class='middletd'>\\\n                        <td><\/td>\\\n                        <td><\/td>\\\n                        <td><\/td>\\\n                    <\/tr>\\\n                <\/tbody>\\\n            <\/table>\"\n        );\n        console.log(\"Table appended\");\n        console.log(\"maintable exists? length =\", $j(\"#maintable\").length);\n\n        var multistring = \"\";\n\n        console.log(\"Building rows using nrows =\", nrows, \"and increment =\", increment);\n\n        for (var i = 0; i < nrows; i++) {\n            \/\/ CHANGED: right-column value starts at minSelf and steps up by increment\n            var num = minSelf + i * increment;\n            var n = num.toFixed(2);\n\n            console.log(\"Building row\", i + 1, \"num =\", num, \"display n =\", n);\n\n            \/\/ CHANGED: left cell now shows \"You: $5.00, Other: $5.00\" (Option A: equal payment)\n            \/\/ CHANGED: right cell starts at minSelf instead of $0\n            multistring = multistring + \"\\\n<tr class='middletd'>\\\n<td style='width:10em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i + 1) + \"left' name='\" + (i + 1) + \"'>You: $5.00, Other: $5.00<\/td>\\\n<td style='width:10em'>OR<\/td>\\\n<td style='width:10em;border-top: 1px solid black;border-bottom: 1px solid black' class='letters' id='\" + (i + 1) + \"right' name='\" + (i + 1) + \"'>You: $\" + n + \", Other: $0.00<\/td>\\\n<\/tr>\";\n        }\n\n        console.log(\"Finished building rows\");\n        console.log(\"multistring length =\", multistring.length);\n\n        $j(\"#maintable\").append(multistring);\n        console.log(\"Rows appended to #maintable\");\n        console.log(\"Number of .letters elements after append =\", $j(\".letters\").length);\n\n        \/\/ ------------------------------------------------------------\n        \/\/ Save arrays \/ timing\n        \/\/ ------------------------------------------------------------\n        var time_start = Date.now() \/ 1000;\n        var times = [];\n        var choices = [];\n        var changed = [];\n\n        console.log(\"time_start =\", time_start);\n        console.log(\"times initialized =\", times);\n        console.log(\"choices initialized =\", choices);\n        console.log(\"changed initialized =\", changed);\n\n        \/\/ ------------------------------------------------------------\n        \/\/ Update list count\n        \/\/ ------------------------------------------------------------\n        var list = \"${e:\/\/Field\/list}\";\n        console.log(\"list before parse =\", list);\n\n        list = parseInt(list, 10);\n        console.log(\"list after parse =\", list);\n\n        if (isNaN(list)) {\n            console.warn(\"WARNING: list is NaN before incrementing\");\n        }\n\n        list = list + 1;\n        console.log(\"list after increment =\", list);\n\n        Qualtrics.SurveyEngine.setEmbeddedData(\"list\", list);\n        console.log(\"Embedded data set: list =\", list);\n\n        \/\/ ------------------------------------------------------------\n        \/\/ Click behavior\n        \/\/ ------------------------------------------------------------\n        var choice_now = -1;\n        console.log(\"choice_now initialized =\", choice_now);\n\n        $j(\".letters\").click(function () {\n            try {\n                console.log(\"=== CLICK EVENT START ===\");\n                console.log(\"Clicked element =\", this);\n                console.log(\"Clicked element id =\", $j(this).attr(\"id\"));\n                console.log(\"Clicked element name =\", $j(this).attr(\"name\"));\n                console.log(\"Clicked element text =\", $j(this).text());\n\n                var id = $j(this).attr(\"name\");\n                var time = Date.now() \/ 1000 - time_start;\n                choice_now = $j(this).attr(\"id\");\n\n                console.log(\"id =\", id);\n                console.log(\"elapsed time =\", time);\n                console.log(\"choice_now =\", choice_now);\n\n                times.push(time.toFixed(2));\n                choices.push(choice_now);\n\n                console.log(\"times =\", times);\n                console.log(\"choices =\", choices);\n\n                Qualtrics.SurveyEngine.setEmbeddedData(prefix + \"Time\", times);\n                Qualtrics.SurveyEngine.setEmbeddedData(prefix + \"Choices\", choices);\n                console.log(\"Embedded data set:\", prefix + \"Time\", times);\n                console.log(\"Embedded data set:\", prefix + \"Choices\", choices);\n\n                var id_number = parseInt(id, 10);\n                console.log(\"id_number =\", id_number);\n\n                if (isNaN(id_number)) {\n                    console.error(\"ERROR: id_number is NaN\");\n                }\n\n                $j(\"td[name='\" + id + \"']\").removeClass(\"letters_selected\").addClass(\"letters\");\n                $j(this).removeClass(\"letters\").addClass(\"letters_selected\");\n                console.log(\"Updated selected class for clicked row\");\n\n                Qualtrics.SurveyEngine.setEmbeddedData(prefix + \"IdFinal\", id_number);\n                Qualtrics.SurveyEngine.setEmbeddedData(prefix + \"ChoiceFinal\", choice_now);\n                console.log(\"Embedded data set:\", prefix + \"IdFinal\", id_number);\n                console.log(\"Embedded data set:\", prefix + \"ChoiceFinal\", choice_now);\n\n                \/\/ ----------------------------------------------------\n                \/\/ Compute implied interval and scalar\n                \/\/ CHANGED: all interval bounds offset by minSelf\n                \/\/ ----------------------------------------------------\n                var norm_lb, norm_ub;\n                var xside;\n                var xvalue;\n\n                if (choice_now.indexOf(\"left\") >= 0) {\n                    norm_lb = minSelf + (id_number - 1) * increment;\n                    norm_ub = minSelf + id_number * increment;\n                    xside = \"LEFT\";\n                    xvalue = minSelf + (id_number - 1) * increment;\n                    console.log(\"Left choice detected\");\n                } else {\n                    norm_lb = minSelf + (id_number - 2) * increment;\n                    norm_ub = minSelf + (id_number - 1) * increment;\n                    xside = \"RIGHT\";\n                    xvalue = minSelf + (id_number - 2) * increment;\n                    console.log(\"Right choice detected\");\n                }\n\n                console.log(\"Initial norm_lb =\", norm_lb);\n                console.log(\"Initial norm_ub =\", norm_ub);\n                console.log(\"Initial xside =\", xside);\n                console.log(\"Initial xvalue =\", xvalue);\n\n                if (choice_now == nrows + \"left\") {\n                    norm_lb = stake;\n                    norm_ub = stake;\n                    xvalue = stake;\n                    var changed_now = 1;\n                    changed.push(changed_now);\n                    console.log(\"Boundary case last-row-left triggered\");\n                }\n\n                \/\/ CHANGED: bottom corner now uses minSelf instead of 0\n                if (choice_now == \"1right\") {\n                    norm_lb = minSelf;\n                    norm_ub = minSelf;\n                    xvalue = minSelf;\n                    changed_now = 2;\n                    changed.push(changed_now);\n                    console.log(\"Boundary case 1right triggered\");\n                }\n\n                \/\/ CHANGED: boundary guards now compare against minSelf instead of increment\n                if (norm_lb < minSelf) {\n                    norm_lb = minSelf;\n                    changed_now = 3;\n                    changed.push(changed_now);\n                    console.log(\"norm_lb < minSelf adjustment triggered\");\n                }\n\n                if (norm_lb > stake) {\n                    norm_lb = stake;\n                    changed_now = 4;\n                    changed.push(changed_now);\n                    console.log(\"norm_lb > stake adjustment triggered\");\n                }\n\n                if (norm_ub < minSelf) {\n                    norm_ub = minSelf;\n                    changed_now = 5;\n                    changed.push(changed_now);\n                    console.log(\"norm_ub < minSelf adjustment triggered\");\n                }\n\n                if (norm_ub > stake) {\n                    norm_ub = stake;\n                    changed_now = 6;\n                    changed.push(changed_now);\n                    console.log(\"norm_ub > stake adjustment triggered\");\n                }\n\n                \/\/ CHANGED: floor imputation uses minSelf instead of 0\/increment\n                if (xvalue < minSelf) {\n                    console.log(\"xvalue < minSelf, imputing minSelf =\", minSelf);\n                    xvalue = minSelf;\n                }\n\n                if (xvalue > stake) {\n                    console.log(\"xvalue > stake, resetting to stake\");\n                    xvalue = stake;\n                }\n\n                norm_lb = Number(norm_lb.toFixed(2));\n                norm_ub = Number(norm_ub.toFixed(2));\n                xvalue = Number(xvalue.toFixed(2));\n\n                console.log(\"Final norm_lb =\", norm_lb);\n                console.log(\"Final norm_ub =\", norm_ub);\n                console.log(\"Final xside =\", xside);\n                console.log(\"Final xvalue =\", xvalue);\n                console.log(\"changed array =\", changed);\n\n                Qualtrics.SurveyEngine.setEmbeddedData(prefix + \"LB\", norm_lb);\n                Qualtrics.SurveyEngine.setEmbeddedData(prefix + \"UB\", norm_ub);\n                Qualtrics.SurveyEngine.setEmbeddedData(prefix + \"Changed\", changed);\n\n                console.log(\"Embedded data set:\", prefix + \"LB\", norm_lb);\n                console.log(\"Embedded data set:\", prefix + \"UB\", norm_ub);\n                console.log(\"Embedded data set:\", prefix + \"Changed\", changed);\n\n                \/\/ ----------------------------------------------------\n                \/\/ Respondent-facing thresholds\n                \/\/ ----------------------------------------------------\n                var xl_value = norm_lb;\n                var xr_value = norm_ub;\n\n                xl_value = Number(xl_value.toFixed(2));\n                xr_value = Number(xr_value.toFixed(2));\n\n                console.log(\"Respondent-facing xl_value =\", xl_value);\n                console.log(\"Respondent-facing xr_value =\", xr_value);\n\n                Qualtrics.SurveyEngine.setEmbeddedData(prefixXL, xl_value.toFixed(2));\n                Qualtrics.SurveyEngine.setEmbeddedData(prefixXR, xr_value.toFixed(2));\n                Qualtrics.SurveyEngine.setEmbeddedData(prefixXSide, xside);\n                Qualtrics.SurveyEngine.setEmbeddedData(prefix, xvalue);\n\n                console.log(\"Embedded data set:\", prefixXL, xl_value);\n                console.log(\"Embedded data set:\", prefixXR, xr_value);\n                console.log(\"Embedded data set:\", prefixXSide, xside);\n                console.log(\"Embedded data set:\", prefix, xvalue);\n\n                \/\/ ----------------------------------------------------\n                \/\/ Corner\/interior flags for Qualtrics display logic\n                \/\/ ----------------------------------------------------\n                var isTopCorner = (id_number === nrows && xside === \"LEFT\") ? \"1\" : \"0\";\n                var isBottomCorner = (id_number === 1 && xside === \"RIGHT\") ? \"1\" : \"0\";\n                var isInterior = (isTopCorner === \"0\" && isBottomCorner === \"0\") ? \"1\" : \"0\";\n\n                console.log(\"isTopCorner =\", isTopCorner);\n                console.log(\"isBottomCorner =\", isBottomCorner);\n                console.log(\"isInterior =\", isInterior);\n\n                Qualtrics.SurveyEngine.setEmbeddedData(prefixTopCorner, isTopCorner);\n                Qualtrics.SurveyEngine.setEmbeddedData(prefixBottomCorner, isBottomCorner);\n                Qualtrics.SurveyEngine.setEmbeddedData(prefixInterior, isInterior);\n\n                console.log(\"Embedded data set:\", prefixTopCorner, isTopCorner);\n                console.log(\"Embedded data set:\", prefixBottomCorner, isBottomCorner);\n                console.log(\"Embedded data set:\", prefixInterior, isInterior);\n\n                \/\/ ----------------------------------------------------\n                \/\/ Compute switch row numbers (Y = last generous row,\n                \/\/ Y+1 = first selfish row)\n                \/\/ ----------------------------------------------------\n                var switch_row_y, switch_row_yplus1;\n\n                if (isTopCorner === \"1\") {\n                    \/\/ Always generous \u2014 no selfish row exists\n                    switch_row_y = nrows;\n                    switch_row_yplus1 = nrows + 1;\n                    console.log(\"Switch row: top-corner (always generous)\");\n                } else if (isBottomCorner === \"1\") {\n                    \/\/ Always selfish \u2014 no generous row exists\n                    switch_row_y = 0;\n                    switch_row_yplus1 = 1;\n                    console.log(\"Switch row: bottom-corner (always selfish)\");\n                } else {\n                    \/\/ Interior switch\n                    if (xside === \"RIGHT\") {\n                        \/\/ Clicked right in row id_number \u2192 last generous row was id_number - 1\n                        switch_row_y = id_number - 1;\n                        switch_row_yplus1 = id_number;\n                    } else {\n                        \/\/ Clicked left in row id_number \u2192 generous through id_number, switch at id_number + 1\n                        switch_row_y = id_number;\n                        switch_row_yplus1 = id_number + 1;\n                    }\n                    console.log(\"Switch row: interior case\");\n                }\n\n                console.log(\"switch_row_y =\", switch_row_y);\n                console.log(\"switch_row_yplus1 =\", switch_row_yplus1);\n\n                Qualtrics.SurveyEngine.setEmbeddedData(\"generosity_switch_row_y\", switch_row_y);\n                Qualtrics.SurveyEngine.setEmbeddedData(\"generosity_switch_row_yplus1\", switch_row_yplus1);\n                console.log(\"Embedded data set: generosity_switch_row_y =\", switch_row_y);\n                console.log(\"Embedded data set: generosity_switch_row_yplus1 =\", switch_row_yplus1);\n\n                \/\/ ----------------------------------------------------\n                \/\/ Understanding check coding\n                \/\/ ----------------------------------------------------\n                var checkY;\n                var checkYPlus1;\n                var checkCorrectOption;\n\n                if (isInterior === \"1\") {\n                    checkY = xl_value;\n                    checkYPlus1 = xr_value;\n                    checkCorrectOption = \"1\";\n                    console.log(\"Understanding check: interior case\");\n                }\n\n                if (isBottomCorner === \"1\") {\n                    checkY = 7;\n                    checkYPlus1 = 8;\n                    checkCorrectOption = \"2\";\n                    console.log(\"Understanding check: bottom-corner case\");\n                }\n\n                if (isTopCorner === \"1\") {\n                    checkY = 7;\n                    checkYPlus1 = 8;\n                    checkCorrectOption = \"3\";\n                    console.log(\"Understanding check: top-corner case\");\n                }\n\n                Qualtrics.SurveyEngine.setEmbeddedData(\"gen_self_comp_check_y\", Number(checkY).toFixed(2));\n                Qualtrics.SurveyEngine.setEmbeddedData(\"gen_self_comp_check_yplus1\", Number(checkYPlus1).toFixed(2));\n                Qualtrics.SurveyEngine.setEmbeddedData(\"gen_self_comp_check_correct_option\", checkCorrectOption);\n\n                console.log(\"Embedded data set: gen_self_comp_check_y =\", checkY);\n                console.log(\"Embedded data set: gen_self_comp_check_yplus1 =\", checkYPlus1);\n                console.log(\"Embedded data set: gen_self_comp_check_correct_option =\", checkCorrectOption);\n\n                \/\/ ----------------------------------------------------\n                \/\/ Randomly select payoff row for GENEROSITY (only once)\n                \/\/ ----------------------------------------------------\n                var existingRow = \"${e:\/\/Field\/generosity_selected_row}\";\n                console.log(\"existing generosity_selected_row =\", existingRow);\n\n                var selectedRow;\n\n                if (existingRow && existingRow !== \"\") {\n                    selectedRow = parseInt(existingRow, 10);\n                    console.log(\"Re-using existing selectedRow =\", selectedRow);\n                } else {\n                    selectedRow = Math.floor(Math.random() * nrows) + 1;\n                    console.log(\"Generated new selectedRow =\", selectedRow);\n                }\n\n                \/\/ ----------------------------------------------------\n                \/\/ Determine what was chosen in that selected row\n                \/\/ using top\/bottom\/interior indicators\n                \/\/ CHANGED: selectedAmount offset by minSelf; Option A text updated\n                \/\/ ----------------------------------------------------\n                var selectedChoiceText = \"\";\n                var selectedAmount = \"\";\n                var selectedIsSelfish = \"\";\n\n                console.log(\"xgenerosity_topcorner =\", isTopCorner);\n                console.log(\"xgenerosity_bottomcorner =\", isBottomCorner);\n                console.log(\"xgenerosity_interior =\", isInterior);\n                console.log(\"id_number =\", id_number);\n                console.log(\"xside =\", xside);\n                console.log(\"selectedRow =\", selectedRow);\n\n                \/\/ always generous = always LEFT\n                if (isTopCorner === \"1\") {\n                    \/\/ CHANGED: Option A now pays $5 to self and $5 to other\n                    selectedChoiceText = \"receive $5.00 and give $5.00 to another participant\";\n                    selectedAmount = 0;\n                    selectedIsSelfish = \"0\";\n                    console.log(\"Selected row choice determined from TOP CORNER: always LEFT\");\n                }\n\n                \/\/ always selfish = always RIGHT\n                else if (isBottomCorner === \"1\") {\n                    \/\/ CHANGED: amount offset by minSelf\n                    selectedAmount = Number((minSelf + (selectedRow - 1) * increment).toFixed(2));\n                    selectedChoiceText = \"keep $\" + selectedAmount.toFixed(2) + \" for yourself\";\n                    selectedIsSelfish = \"1\";\n                    console.log(\"Selected row choice determined from BOTTOM CORNER: always RIGHT\");\n                }\n\n                \/\/ interior switch\n                else if (isInterior === \"1\") {\n                    if (xside === \"RIGHT\") {\n                        if (selectedRow < id_number) {\n                            \/\/ CHANGED: Option A text updated\n                            selectedChoiceText = \"receive $5.00 and give $5.00 to another participant\";\n                            selectedAmount = 0;\n                            selectedIsSelfish = \"0\";\n                            console.log(\"Interior case, xside RIGHT: selected row is LEFT\");\n                        } else {\n                            \/\/ CHANGED: amount offset by minSelf\n                            selectedAmount = Number((minSelf + (selectedRow - 1) * increment).toFixed(2));\n                            selectedChoiceText = \"keep $\" + selectedAmount.toFixed(2) + \" for yourself\";\n                            selectedIsSelfish = \"1\";\n                            console.log(\"Interior case, xside RIGHT: selected row is RIGHT\");\n                        }\n                    } else if (xside === \"LEFT\") {\n                        if (selectedRow <= id_number) {\n                            \/\/ CHANGED: Option A text updated\n                            selectedChoiceText = \"receive $5.00 and give $5.00 to another participant\";\n                            selectedAmount = 0;\n                            selectedIsSelfish = \"0\";\n                            console.log(\"Interior case, xside LEFT: selected row is LEFT\");\n                        } else {\n                            \/\/ CHANGED: amount offset by minSelf\n                            selectedAmount = Number((minSelf + (selectedRow - 1) * increment).toFixed(2));\n                            selectedChoiceText = \"keep $\" + selectedAmount.toFixed(2) + \" for yourself\";\n                            selectedIsSelfish = \"1\";\n                            console.log(\"Interior case, xside LEFT: selected row is RIGHT\");\n                        }\n                    } else {\n                        console.error(\"Interior case but xside is neither LEFT nor RIGHT:\", xside);\n                    }\n                }\n\n                else {\n                    console.error(\"Could not classify generosity choice pattern.\");\n                }\n\n                Qualtrics.SurveyEngine.setEmbeddedData(\"generosity_selected_row\", selectedRow);\n                Qualtrics.SurveyEngine.setEmbeddedData(\"generosity_selected_amount\", selectedAmount);\n                Qualtrics.SurveyEngine.setEmbeddedData(\"generosity_selected_choice_text\", selectedChoiceText);\n                Qualtrics.SurveyEngine.setEmbeddedData(\"generosity_selected_is_selfish\", selectedIsSelfish);\n\n                console.log(\"Embedded data set: generosity_selected_row =\", selectedRow);\n                console.log(\"Embedded data set: generosity_selected_amount =\", selectedAmount);\n                console.log(\"Embedded data set: generosity_selected_choice_text =\", selectedChoiceText);\n                console.log(\"Embedded data set: generosity_selected_is_selfish =\", selectedIsSelfish);\n\n                \/\/ ----------------------------------------------------\n                \/\/ Update visual pattern\n                \/\/ ----------------------------------------------------\n                for (var k = id_number - 1; k > 0; k--) {\n                    var x = \"#\" + String(k) + \"left\";\n                    var y = \"#\" + String(k) + \"right\";\n\n                    console.log(\"Updating previous row k =\", k, \"x =\", x, \"y =\", y);\n\n                    $j(x).removeClass(\"letters\").addClass(\"letters_selected\");\n                    $j(y).addClass(\"letters\").removeClass(\"letters_selected\");\n                }\n\n                for (var m = id_number + 1; m <= nrows; m++) {\n                    var xr = \"#\" + String(m) + \"right\";\n                    var yl = \"#\" + String(m) + \"left\";\n\n                    console.log(\"Updating later row m =\", m, \"xr =\", xr, \"yl =\", yl);\n\n                    $j(xr).removeClass(\"letters\").addClass(\"letters_selected\");\n                    $j(yl).addClass(\"letters\").removeClass(\"letters_selected\");\n                }\n\n                console.log(\"=== CLICK EVENT END ===\");\n            } catch (err) {\n                console.error(\"ERROR INSIDE CLICK HANDLER:\", err);\n                console.error(\"Stack:\", err && err.stack ? err.stack : \"No stack available\");\n            }\n        });\n\n        console.log(\"Click handler attached to .letters elements\");\n\n        \/\/ ------------------------------------------------------------\n        \/\/ floatThead\n        \/\/ ------------------------------------------------------------\n        console.log(\"Checking floatThead plugin...\");\n        console.log(\"typeof $j.fn.floatThead =\", typeof $j.fn.floatThead);\n\n        if (typeof $j.fn.floatThead === \"function\") {\n            $j(\"table.uncertainty\").floatThead({\n                useAbsolutePositioning: false\n            });\n            console.log(\"floatThead initialized successfully\");\n        } else {\n            console.warn(\"floatThead plugin is not available; skipping initialization\");\n        }\n\n        \/\/ ------------------------------------------------------------\n        \/\/ Show next button once a choice exists\n        \/\/ ------------------------------------------------------------\n        this.questionclick = function (event, element) {\n            try {\n                console.log(\"questionclick fired\");\n                console.log(\"choice_now at questionclick =\", choice_now);\n\n                if (choice_now != -1) {\n                    this.showNextButton();\n                    console.log(\"Next button shown\");\n                } else {\n                    this.hideNextButton();\n                    console.log(\"Next button hidden again\");\n                }\n            } catch (err) {\n                console.error(\"ERROR INSIDE questionclick:\", err);\n                console.error(\"Stack:\", err && err.stack ? err.stack : \"No stack available\");\n            }\n        };\n\n        console.log(\"questionclick handler attached\");\n        console.log(\"=== QUALTRICS SCRIPT END ===\");\n    } catch (err) {\n        console.error(\"FATAL SCRIPT ERROR:\", err);\n        console.error(\"Stack:\", err && err.stack ? err.stack : \"No stack available\");\n    }\n});","DefaultChoices":false,"QuestionType":"DB","Selector":"TB","Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Please indicate which payment option you prefer on each row by clicking on the row where you woul...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"QuestionText_Unsafe":"<div>RISK MPL<\/div><div><br><\/div><div>Please indicate which payment option you prefer on each row by clicking on the row where you would like to switch from choosing the option on the left to choosing the option on the right.<\/div>\n\n<div>&nbsp;<\/div>\n\n<div>\n<div>(Note that you cannot click on the submit button until you have selected an answer.)<\/div>\n<\/div>","DataVisibility":{"Private":false,"Hidden":false},"NextChoiceId":1,"NextAnswerId":1,"DataExportTag":"Q135","QuestionID":"QID135"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID136","SecondaryAttribute":"Instructions for Part ${e:\/\/Field\/current_part} out of ${e:\/\/Field\/n_totalparts} parts This part...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Instructions for Part ${e:\/\/Field\/current_part} out of ${e:\/\/Field\/n_totalparts} parts<\/strong><br>\n<br>\nThis part has ${e:\/\/Field\/risk_totalrounds} rounds.<br>&nbsp;&nbsp;<br>\n&nbsp;","DefaultChoices":false,"DataExportTag":"Risk_mpl_instruction","QuestionID":"QID136","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Instructions for Part ${e:\/\/Field\/current_part} out of ${e:\/\/Field\/n_totalparts} parts This part...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID137","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"QuestionText":"Timing","DefaultChoices":false,"DataExportTag":"Q86","QuestionType":"Timing","Selector":"PageTimer","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","MaxSeconds":"0"},"QuestionDescription":"Timing","Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID137"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID138","SecondaryAttribute":"Understanding Question: Suppose in the row-that-counts you chose Option A, the lottery. What are...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Understanding Question:<\/strong> Suppos