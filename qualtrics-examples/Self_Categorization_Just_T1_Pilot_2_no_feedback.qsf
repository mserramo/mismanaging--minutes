rFIVg","Element":"SQ","PrimaryAttribute":"QID7","SecondaryAttribute":"Please copy and paste your Prolific ID here: Please note that this response should auto-fill with...","TertiaryAttribute":null,"Payload":{"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"prolific_id","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":{"TEXT":{"Text":"${e:\/\/Field\/PROLIFIC_PID}"}},"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":4,"QuestionDescription":"Please copy and paste your Prolific ID here: Please note that this response should auto-fill with...","QuestionID":"QID7","QuestionJS":"\/\/ INCREMENT current_page\nQualtrics.SurveyEngine.addOnPageSubmit(function()\n{\t\n\tlet currentPage = parseInt(\"${e:\/\/Field\/current_page}\");\n\n\tcurrentPage = currentPage + 1;\n\tQualtrics.SurveyEngine.setEmbeddedData(\"current_page\", currentPage);\n\tconsole.log(\"current_page\", currentPage);\n});","QuestionText":"<b>Please copy and paste your Prolific ID here:<\/b><br \/>\n<br \/>\n<em>Please note that this response should auto-fill with the correct ID<\/em>","QuestionText_Unsafe":"<b>Please copy and paste your Prolific ID here:<\/b><br \/>\n<br \/>\n<em>Please note that this response should auto-fill with the correct ID<\/em>","QuestionType":"TE","SearchSource":{"AllowFreeResponse":"false"},"Selector":"SL","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","MinChars":"1","TotalChars":"24","Type":"TotalChar"}}}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID78","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"Configuration":{"MaxSeconds":"0","MinSeconds":"0","QuestionDescriptionOption":"UseText"},"DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":16,"QuestionDescription":"Timing","QuestionText":"Timing","QuestionText_Unsafe":"Timing","QuestionType":"Timing","Selector":"PageTimer","Validation":"None","DataExportTag":"Q78","QuestionID":"QID78"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID79","SecondaryAttribute":"Instructions for Part ${e:\/\/Field\/current_part}, Round 2 of ${e:\/\/Field\/comp_totalrounds} rounds...","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[],"Configuration":{"QuestionDescriptionOption":"UseText"},"DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":4,"QuestionDescription":"Instructions for Part ${e:\/\/Field\/current_part}, Round 2 of ${e:\/\/Field\/comp_totalrounds} rounds...","QuestionJS":"Qualtrics.SurveyEngine.addOnReady(function () {\n    var qthis = this;\n    var controller = this.getQuestionContainer();\n    \/\/ Replace with your actual QIDs\n    var questionIDs = [\"QID416\", \"QID81\", \"QID80\", \"QID82\"];\n    \/\/ Unique key for this page\n    var revealKey = \"revealed_\" + this.questionId;\n    \/\/ Get Qualtrics Next button\n    var nextButton = document.getElementById(\"NextButton\");\n    function hideQuestions() {\n        questionIDs.forEach(function (qid) {\n            var q = document.getElementById(qid);\n            if (q) {\n                q.style.visibility = \"hidden\";\n                q.style.height = \"0px\";\n                q.style.overflow = \"hidden\";\n                q.style.margin = \"0\";\n                q.style.padding = \"0\";\n                q.style.border = \"0\";\n            }\n        });\n    }\n    function showQuestions() {\n        questionIDs.forEach(function (qid) {\n            var q = document.getElementById(qid);\n            if (q) {\n                q.style.visibility = \"visible\";\n                q.style.height = \"auto\";\n                q.style.overflow = \"visible\";\n                q.style.margin = \"\";\n                q.style.padding = \"\";\n                q.style.border = \"\";\n                void q.offsetHeight;\n            }\n        });\n        setTimeout(function () {\n            window.dispatchEvent(new Event(\"resize\"));\n        }, 50);\n    }\n    var alreadyRevealed = sessionStorage.getItem(revealKey) === \"true\";\n    if (alreadyRevealed) {\n        showQuestions();\n        qthis.showNextButton();\n        if (nextButton) {\n            nextButton.style.display = \"\";\n        }\n        return;\n    }\n    qthis.hideNextButton();\n    if (nextButton) {\n        nextButton.style.display = \"none\";\n    }\n    hideQuestions();\n    var wrapper = document.createElement(\"div\");\n    wrapper.style.textAlign = \"center\";\n    wrapper.style.margin = \"30px 0\";\n    var bgColor = \"${e:\/\/Field\/understanding_button_backgroundColor}\";\n    var borderColor = \"${e:\/\/Field\/understanding_button_border}\";\n    var textColor = \"${e:\/\/Field\/understanding_button_color}\";\n    \/\/ Fallbacks (in case something is missing)\n    bgColor = bgColor || \"#FFA500\";\n    borderColor = borderColor || \"#cc8400\";\n    textColor = textColor || \"#2b1a00\";\n    var button = document.createElement(\"button\");\n    button.type = \"button\";\n    button.innerHTML = \"Click to answer understanding questions\";\n    \/\/ Styling\n    button.style.padding = \"12px 24px\";\n    button.style.cursor = \"pointer\";\n    button.style.backgroundColor = bgColor;\n    button.style.border = \"1px solid \" + borderColor;\n    button.style.borderRadius = \"6px\";\n    button.style.fontSize = \"16px\";\n    button.style.fontWeight = \"600\";\n    button.style.color = textColor;\n    wrapper.appendChild(button);\n    controller.appendChild(wrapper);\n    button.addEventListener(\"click\", function () {\n        sessionStorage.setItem(revealKey, \"true\");\n        showQuestions();\n        qthis.showNextButton();\n        if (nextButton) {\n            nextButton.style.display = \"\";\n        }\n        wrapper.remove();\n    });\n});\n\/\/ INCREMENT current_page\nQualtrics.SurveyEngine.addOnPageSubmit(function()\n{\t\n\tlet currentPage = parseInt(\"${e:\/\/Field\/current_page}\");\n\tcurrentPage = currentPage + 1;\n\tQualtrics.SurveyEngine.setEmbeddedData(\"current_page\", currentPage);\n\tconsole.log(\"current_page\", currentPage);\n});","QuestionText":"<strong>Instructions for Part ${e:\/\/Field\/current_part}, Round 2 of ${e:\/\/Field\/comp_totalrounds} rounds<\/strong><br>\n<br>\nIn Round 2, you complete a math task in a <strong>tournament<\/strong>.<br>\n<br>\nYou are now randomly paired with 3 other participants who solve problems in the exact same math task such that you are in a group of 4 consisting of 2 men and 2 women.<br>\n<br>\nIn this round, your final number of points will be compared to the final points of the other 3 group members.\n<ul>\n\t<li>If you have more points than the other 3 group members, you are the <strong>winner<\/strong>.<\/li>\n\t<li>If at least one of the other 3 group members has more points than you do, you are <strong>not the winner and lose the tournament<\/strong>.<\/li>\n\t<li>In the case of a tie, the winner will be randomly determined.<\/li>\n<\/ul>\n<br>\nYour tournament payment is:\n<ul>\n\t<li>If you win, $2 per point.<\/li>\n\t<li>If you lose, $0.<\/li>\n<\/ul>","QuestionText_Unsafe":"<h3>Study Information<\/h3>\n\n<p><strong>Study Overview<\/strong>: To complete this study, you must first answer a series of questions that are split across ${e:\/\/Field\/nparts} parts. Then, you will complete a short follow-up questionnaire. This study will take you approximately ${e:\/\/Field\/time} minutes to complete.&nbsp;<\/p>\n\n<p><strong>Payment<\/strong>: For completing this study, you are guaranteed to receive $${e:\/\/Field\/showup} within 24 hours. In addition, one part from Parts 1-${e:\/\/Field\/nparts} will be chosen as the part-that-counts. You will receive how much you earn in the part-that-counts as your bonus payment.<\/p>","QuestionType":"DB","Selector":"TB","Validation":{"Settings":{"Type":"None"}},"DataExportTag":"Q79","QuestionID":"QID79"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID8","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"Configuration":{"MaxSeconds":"0","MinSeconds":"0","QuestionDescriptionOption":"UseText"},"DataExportTag":"Q36","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":16,"QuestionDescription":"Timing","QuestionID":"QID8","QuestionText":"Timing","QuestionText_Unsafe":"Timing","QuestionType":"Timing","Selector":"PageTimer","Validation":"None"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID80","SecondaryAttribute":"Understanding Question: What is the tournament payment if you are the winner of the tournament?","TertiaryAttribute":null,"Payload":{"ChoiceOrder":["4","5","3"],"Choices":{"3":{"Display":"$2 per point"},"4":{"Display":"$0 per point"},"5":{"Display":"$0.50 per point"}},"Configuration":{"QuestionDescriptionOption":"UseText"},"DataVisibility":{"Hidden":false,"Private":false},"Language":[],"NextAnswerId":1,"NextChoiceId":6,"QuestionDescription":"Understanding Question: What is the tournament payment if you are the winner of the tournament?","QuestionText":"<b>Understanding Question: <\/b>What is the tournament payment if you are the winner of the tournament?","QuestionText_Unsafe":"<b>Comprehension check: <\/b>Which of the following is true?&nbsp;","QuestionType":"MC","Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"None"},"Selector":"SAVR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"QuestionID":"QID80","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID80\/SelectableChoice\/3","Operator":"Selected","QuestionIDFromLocator":"QID80","LeftOperand":"q:\/\/QID80\/SelectableChoice\/3","Type":"Expression","LogicType":"Question","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Understanding Question: What is the tournament payment if you are the winner of the tournament?<\/span> <span class=\"LeftOpDesc\">$2 per point<\/span> <span class=\"OpDesc\">Is Selected<\/span> "},"Type":"If"},"Type":"BooleanExpression"},"Message":{"messageID":"MS_42EWahFVsD2E0jY","subMessageID":"VE_CUSTOM_VALIDATION_0","libraryID":"UR_cAtjJf4eqOWGcDA","description":"incorrect answer"}}}},"DataExportTag":"Q80","QuestionID":"QID80"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID81","SecondaryAttribute":"Understanding Question: You are the winner if...","TertiaryAttribute":null,"Payload":{"QuestionText":"<b>Understanding Question: <\/b>You are the winner if...","DataExportTag":"","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Understanding Question: You are the winner if...","Choices":{"1":{"Display":"You score higher than all the other 3 group members"},"2":{"Display":"At least one of the other 3 group members scores higher than you"}},"ChoiceOrder":["1","2"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"None"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"QuestionID":"QID81","QuestionIsInLoop":"no","ChoiceLocator":"q:\/\/QID81\/SelectableChoice\/1","Operator":"Selected","QuestionIDFromLocator":"QID81","LeftOperand":"q:\/\/QID81\/SelectableChoice\/1","Type":"Expression","LogicType":"Question","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Understanding Question: You are the winner if...<\/span> <span class=\"LeftOpDesc\">You score higher than all the other 3 group members<\/span> <span class=\"OpDesc\">Is Selected<\/span> "},"Type":"If"},"Type":"BooleanExpression"},"Message":{"messageID":"MS_jHNVdNnhu9SyaST","subMessageID":"VE_ERROR","libraryID":"UR_cZPMLrEO6JJWxpk","description":"Error Text"}}}},"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID81"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID82","SecondaryAttribute":"Understanding Question: What is the tournament payment if you are not the winner and lose the tou...","TertiaryAttribute":null,"Payload":{"QuestionText":"<b>Understanding Question: <\/b>What is the tournament payment if you are not the winner and lose the tournament?","DataExportTag":"Q82","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Understanding Question: What is the tournament payment if you are not the winner and lose the tou...","Choices":{"3":{"Display":"$2 per point"},"4":{"Display":"$0 per point"},"5":{"Display":"$0.50 per point"}},"ChoiceOrder":["4","5","3"],"Randomization":{"Advanced":null,"TotalRandSubset":"","Type":"None"},"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"CustomValidation","CustomValidation":{"Logic":{"0":{"0":{"ChoiceLocator":"q:\/\/QID82\/SelectableChoice\/4","Description":"<span class=\"ConjDesc\">If<\/span> <span class=\"QuestionDesc\">Understanding check: If this round is selected as the round-that-counts, what is the tournament p...<\/span> <span class=\"LeftOpDesc\">$0 for each correct problem<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID82\/SelectableChoice\/4","LogicType":"Question","Operator":"Selected","QuestionID":"QID82","QuestionIDFromLocator":"QID82","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"incorrect answer","libraryID":"UR_cAtjJf4eqOWGcDA","messageID":"MS_42EWahFVsD2E0jY","subMessageID":"VE_CUSTOM_VALIDATION_0"}}}},"Language":[],"NextChoiceId":6,"NextAnswerId":1,"QuestionID":"QID82"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID9","SecondaryAttribute":"Study Overview \u00a0 This study has ${e:\/\/Field\/n_totalrounds}\u00a0rounds and will take you approximately.","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[],"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"study_overview","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":4,"QuestionDescription":"Study Overview \u00a0 This study has ${e:\/\/Field\/n_totalrounds}\u00a0rounds and will take you approximately...","QuestionID":"QID9","QuestionJS":"\/\/ INCREMENT current_page\nQualtrics.SurveyEngine.addOnPageSubmit(function()\n{\t\n\tlet currentPage = parseInt(\"${e:\/\/Field\/current_page}\");\n\n\tcurrentPage = currentPage + 1;\n\tQualtrics.SurveyEngine.setEmbeddedData(\"current_page\", currentPage);\n\tconsole.log(\"current_page\", currentPage);\n});","QuestionText":"<h3><strong>Study Overview<\/strong><\/h3>\n\n<div>&nbsp;<\/div>\nThis study has ${e:\/\/Field\/n_totalrounds}<strong>&nbsp;rounds<\/strong> and will take you approximately ${e:\/\/Field\/time} minutes to complete. The&nbsp;${e:\/\/Field\/n_totalrounds} rounds are distributed over three different parts.&nbsp;<br>\n<br>\n<strong>Payment<\/strong>: For completing this study, you are guaranteed to receive $${e:\/\/Field\/showup} within 24 hours. In addition, one of the&nbsp;${e:\/\/Field\/n_totalrounds} rounds will be chosen as the round-that-counts. You will receive the bonus payment from the round-that-counts within 2 weeks.\n\n<p><\/p>","QuestionText_Unsafe":"<h3>Study Information<\/h3>\n\n<p><strong>Study Overview<\/strong>: To complete this study, you must first answer a series of questions that are split across ${e:\/\/Field\/nparts} parts. Then, you will complete a short follow-up questionnaire. This study will take you approximately ${e:\/\/Field\/time} minutes to complete.&nbsp;<\/p>\n\n<p><strong>Payment<\/strong>: For completing this study, you are guaranteed to receive $${e:\/\/Field\/showup} within 24 hours. In addition, one of the questions from Parts 1-${e:\/\/Field\/nparts} will be chosen as the question-that-counts. You will receive how much you earn in the question-that-counts as your bonus payment.&nbsp;<\/p>","QuestionType":"DB","Selector":"TB","Validation":{"Settings":{"Type":"None"}}}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID93","SecondaryAttribute":"Timing","TertiaryAttribute":null,"Payload":{"Choices":{"1":{"Display":"First Click"},"2":{"Display":"Last Click"},"3":{"Display":"Page Submit"},"4":{"Display":"Click Count"}},"Configuration":{"MaxSeconds":"0","MinSeconds":"0","QuestionDescriptionOption":"UseText"},"DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":16,"QuestionDescription":"Timing","QuestionText":"Timing","QuestionText_Unsafe":"Timing","QuestionType":"Timing","Selector":"PageTimer","Validation":"None","DataExportTag":"Q93","QuestionID":"QID93"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID96","SecondaryAttribute":"Understanding Question: Which pair of numbers sums up to 100?","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[],"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"c_round1_comp_check","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":2,"QuestionDescription":"Understanding Question: Which pair of numbers sums up to 100?","QuestionID":"QID96","QuestionText":"<strong>Understanding Question: <\/strong>Which pair of numbers sums up to 100?","QuestionText_Unsafe":"<strong>Understanding check: <\/strong>Which pair of numbers sum up to 100?","QuestionType":"DB","Selector":"TB","Validation":{"Settings":{"Type":"None"}},"QuestionJS":"Qualtrics.SurveyEngine.addOnReady(function() {\n    const qthis = this;\n    const questionContainer = this.getQuestionContainer();\n\n    const style = document.createElement('style');\n    style.textContent = `\n        .q-grid-3x3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin: 16px 0; max-width: 720px }\n        .q-feedback { margin: 8px 0 12px 0; font-weight: 600; font-size: 1.1em; min-height: 1.4em; }\n        .q-grid-3x3 > div { aspect-ratio: 2 \/ 1; display: flex; align-items: center; justify-content: center; border: 1px solid #ccc; border-radius: 12px; font-weight: 600; font-size: 1.5em; transition: background-color .2s, border-color .2s, color .2s; cursor: pointer; }\n        .q-grid-3x3 > div.ready { background: #eaf2ff; border-color: #90b4ff; color: #10273f; }\n        .q-grid-3x3 > div.ready:hover { background: #dbe9ff; border-color: #79a6ff }\n        .q-grid-3x3 > div.correct { background: #d4edda; border-color: #28a745; color: #155724; }\n        .q-grid-3x3 > div.wrong { background: #f8d7da; border-color: #dc3545; color: #721c24; }\n    `;\n    document.head.appendChild(style);\n\n    \/\/ \u2500\u2500 helper functions (unchanged from your original) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n    function randInt(min, max) {\n        while (true) {\n            const x = Math.floor(Math.random() * (max - min + 1)) + min;\n            if (x % 10 !== 0) return x;\n        }\n    }\n    function shuffle(array) {\n        let m = array.length;\n        while (m > 0) {\n            const idx = Math.floor(Math.random() * m);\n            m -= 1;\n            const temp = array[m]; array[m] = array[idx]; array[idx] = temp;\n        }\n        return array;\n    }\n    function onesSumTo10(a, b) { return (a % 10) + (b % 10) === 10; }\n\n    function generateEqual100Pair(used, req) {\n        while (true) {\n            const a = randInt(10, 90); const b = 100 - a;\n            if (b < 10 || b > 99 || b % 10 === 0) continue;\n            if (req && !onesSumTo10(a, b)) continue;\n            if (!req && onesSumTo10(a, b)) continue;\n            const key = a + ',' + b; if (used[key]) continue;\n            used[key] = true; return [a, b];\n        }\n    }\n    function generateAbove100Pair(used, req) {\n        while (true) {\n            const a = randInt(10, 99); const b = randInt(10, 99); const t = a + b;\n            if (t <= 100 || t >= 120) continue;\n            if (req && !onesSumTo10(a, b)) continue;\n            if (!req && onesSumTo10(a, b)) continue;\n            const key = a + ',' + b; if (used[key]) continue;\n            used[key] = true; return [a, b];\n        }\n    }\n    function generateBelow100Pair(used, req) {\n        while (true) {\n            const a = randInt(10, 99); const b = randInt(10, 99); const t = a + b;\n            if (t <= 80 || t >= 100) continue;\n            if (req && !onesSumTo10(a, b)) continue;\n            if (!req && onesSumTo10(a, b)) continue;\n            const key = a + ',' + b; if (used[key]) continue;\n            used[key] = true; return [a, b];\n        }\n    }\n    function generateOneSet() {\n        const used = {}; const set = [];\n        set.push(generateEqual100Pair(used, true));\n        set.push(generateAbove100Pair(used, true));\n        set.push(generateAbove100Pair(used, false));\n        set.push(generateAbove100Pair(used, false));\n        set.push(generateAbove100Pair(used, false));\n        set.push(generateBelow100Pair(used, true));\n        set.push(generateBelow100Pair(used, false));\n        set.push(generateBelow100Pair(used, false));\n        set.push(generateBelow100Pair(used, false));\n        shuffle(set); return set;\n    }\n    \/\/ \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n    const feedback = document.createElement('div');\n    feedback.className = 'q-feedback';\n    feedback.textContent = '';\n\n    const grid = document.createElement('div');\n    grid.className = 'q-grid-3x3';\n\n    questionContainer.appendChild(feedback);\n    questionContainer.appendChild(grid);\n\n    const cells = [];\n    for (let j = 0; j < 9; j++) {\n        const cell = document.createElement('div');\n        cell.className = 'ready';\n        grid.appendChild(cell);\n        cells.push(cell);\n    }\n\n    let currentSet = generateOneSet();\n    let locked = false;\n\n    \/\/ Hide the Next button \u2014 participant cannot advance manually\n    qthis.hideNextButton();\n\n    function render() {\n        for (let k = 0; k < 9; k++) {\n            cells[k].textContent = '(' + currentSet[k][0] + ', ' + currentSet[k][1] + ')';\n            cells[k].dataset.idx = k;\n            cells[k].className = 'ready';\n        }\n    }\n\n    function pick(e) {\n        if (locked) return;\n        locked = true;\n\n        const idx = Number(e.currentTarget.dataset.idx);\n        const p = currentSet[idx];\n        const correct = (p[0] + p[1] === 100);\n\n        if (correct) {\n            cells[idx].className = 'correct';\n            feedback.style.color = '#155724';\n            feedback.textContent = '\u2713 Correct! Moving on\u2026';\n            setTimeout(function() { qthis.clickNextButton(); }, 800);\n        } else {\n            cells[idx].className = 'wrong';\n            feedback.style.color = '#721c24';\n            feedback.textContent = '\u2717 Not quite \u2014 ' + p[0] + ' + ' + p[1] + ' = ' + (p[0]+p[1]) + '. Try again!';\n            \/\/ Reset after a short pause so they can retry the same grid\n            setTimeout(function() {\n                cells[idx].className = 'ready';\n                locked = false;\n            }, 1000);\n        }\n    }\n\n    for (let k = 0; k < cells.length; k++) {\n        cells[k].addEventListener('click', pick);\n    }\n\n    render();\n});"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"STAT","PrimaryAttribute":"Survey Statistics","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"MobileCompatible":true,"ID":"Survey Statistics"}}]}