Color;\n    \/\/ Hover effect\n    var hoverColor = darkenColor(bgColor, 0.9);\n    button.addEventListener(\"mouseenter\", function() {\n        button.style.backgroundColor = hoverColor;\n    });\n    button.addEventListener(\"mouseleave\", function() {\n        button.style.backgroundColor = bgColor;\n    });\n    wrapper.appendChild(button);\n    controller.appendChild(wrapper);\n    button.addEventListener(\"click\", function () {\n        sessionStorage.setItem(revealKey, \"true\");\n        showQuestions();\n        qthis.showNextButton();\n        if (nextButton) {\n            nextButton.style.display = \"\";\n        }\n        wrapper.remove();\n    });\n});"}},{"SurveyID":"SV_5yUcDA5EfVrFIVg","Element":"SQ","PrimaryAttribute":"QID310","SecondaryAttribute":"Instructions for Part ${e:\/\/Field\/current_part}, Round 2 of ${e:\/\/Field\/generosity_totalrounds} r...","TertiaryAttribute":null,"Payload":{"QuestionText":"<strong>Instructions for Part ${e:\/\/Field\/current_part}, Round 2 of ${e:\/\/Field\/generosity_totalrounds} rounds<\/strong><br \/>\n<br \/>\nIn this round, you earn a fixed payment of $1.50 for answering 12 questions.<br \/>\n<br \/>\nThese questions will ask you to compare your choices between &ldquo;equal payment&rdquo; and &ldquo;payment for self&rdquo; to those of other participants<strong> <\/strong>who went through the same study and are <strong>equally likely to be men or women.<\/strong><br \/>\n<br \/>\nRecall, in Round 1, you selected between ($5 self, $5 other) and (fixed payment self, $0 other).\n<ul>\n\t<li><strong>You never selected the equal payment and always chose payment for yourself&nbsp;and $0 for the other participant.<\/strong><\/li>\n<\/ul>","DefaultChoices":false,"DataExportTag":"Q259","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Instructions for Part ${e:\/\/Field\/current_part}, Round 2 of ${e:\/\/F