Value extraction ----------\n  function cleanSliderValue(v) {\n    if (v === null || v === undefined || v === \"\" || v === false || v === true) {\n      return \"\";\n    }\n\n    var n = Number(v);\n    if (!Number.isFinite(n)) {\n      return \"\";\n    }\n\n    return Math.max(0, Math.min(100, Math.round(n)));\n  }\n\n  function getSliderValue() {\n    var value;\n\n    var inputs = qc.querySelectorAll(\"input\");\n    for (var i = 0; i < inputs.length; i++) {\n      value = cleanSliderValue(inputs[i].value);\n      if (value !== \"\") {\n        return value;\n      }\n    }\n\n    var handle = getHandle();\n    if (handle) {\n      value = cleanSliderValue(handle.getAttribute(\"aria-valuenow\"));\n      if (value !== \"\") {\n        return value;\n      }\n\n      value = cleanSliderValue(handle.getAttribute(\"data-value\"));\n      if (value !== \"\") {\n        return value;\n      }\n\n      var left = handle.style.left || \"\";\n      if (left.indexOf(\"%\") > -1) {\n        value = cleanSliderValue(parseFloat(left));\n        if (value !== \"\") {\n          return value;\n        }\n      }\n    }\n\n    return \"\";\n  }\n\n  function updateReadout() {\n    var value = getSliderValue();\n    readout.innerHTML = readoutText(value);\n  }\n\n  \/\/ ---------- Interaction ----------\n  function revealAfterQualtricsUpdates() {\n    started = true;\n\n    setTimeout(function () {\n      showHandle();\n      updateReadout();\n    }, 150);\n\n    setTimeout(function () {\n      showHandle();\n      updateReadout();\n    }, 300);\n  }\n\n  qc.addEventListener(\"click\", revealAfterQualtricsUpdates);\n  qc.addEventListener(\"mouseup\", revealAfterQualtricsUpdates);\n  qc.addEventListener(\"touchend\", revealAfterQualtricsUpdates);\n  qc.addEventListener(\"keydown\", revealAfterQualtricsUpdates);\n  qc.addEventListener(\"change\", revealAfterQualtricsUpdates);\n  qc.addEventListener(\"input\", revealAfterQualtricsUpdates);\n\n  qc.addEventListener(\"mousemove\", function () {\n    if (started) {\n      setTimeout(updateReadout, 50);\n    }\n  });\n\n  qc.addEventListener(\"touchmove\", function () {\n    if (started) {\n      setTimeout(updateReadout, 50);\n    }\n  });\n\n  \/\/ ---------- Initial cleanup ----------\n  hideChoiceText();\n  hideInitialHandle();\n\n  setTimeout(function () {\n    hideChoiceText();\n    hideInitialHandle();\n  }, 100);\n\n  setTimeout(function () {\n    hideChoiceText();\n    hideInitialHandle();\n  }, 300);\n\n  setTimeout(function () {\n    hideChoiceText();\n    hideInitialHandle();\n  }, 700);\n\n  var observer = new MutationObserver(function () {\n    hideChoiceText();\n    hideInitialHandle();\n  });\n\n  observer.observe(qc, {\n    childList: true,\n    subtree: true,\n    attributes: true,\n    attributeFilter: [\"style\", \"class\"]\n  });\n});"}},{"SurveyID":"SV_07McTW65bCwKmGi","Element":"SQ","PrimaryAttribute":"QID63","SecondaryAttribute":"A female candidate is randomly selected from the candidate pool. A male evaluator is asked: \u201cWhat.","TertiaryAttribute":null,"Payload":{"QuestionText":"A <span style=\"color:#c0392b;\"><b>female<\/b><\/span> <strong><span style=\"color:#c0392b;\">candidate<\/span><\/strong> is randomly selected from the candidate pool.<br>\n<br>\nA <span style=\"color:#2980b9;\"><strong>male evaluator <\/strong><\/span>is asked: \u201cWhat is the percent chance that this <span style=\"color:#c0392b;\"><b>female<\/b><\/span> <strong><span style=\"color:#c0392b;\">candidate<\/span><\/strong> scored above the median candidate?\u201d<br>\n<br>\nWhat do you think the average <strong><span style=\"color:#2980b9;\">male evaluator\u2019s<\/span> answer <\/strong>would be?","DefaultChoices":false,"DataExportTag":"Q63","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"above","CSSliderMin":0,"CSSliderMax":100,"GridLines":0,"SnapToGrid":false,"NumDecimals