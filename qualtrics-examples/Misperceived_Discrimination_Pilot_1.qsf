njDesc\">If<\/span> <span class=\"QuestionDesc\">What do candidates complete in Part 1?\n<\/span> <span class=\"LeftOpDesc\">A timed test with math, science, mechanical reasoning, and spatial reasoning questions<\/span> <span class=\"OpDesc\">Is Selected<\/span> ","LeftOperand":"q:\/\/QID5\/SelectableChoice\/2","LogicType":"Question","Operator":"Selected","QuestionID":"QID5","QuestionIDFromLocator":"QID5","QuestionIsInLoop":"no","Type":"Expression"},"Type":"If"},"Type":"BooleanExpression"},"Message":{"description":"Error Text","libraryID":"UR_cZPMLrEO6JJWxpk","messageID":"MS_jHNVdNnhu9SyaST","subMessageID":"VE_ERROR"}}}},"Language":[],"DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"NextChoiceId":5,"NextAnswerId":1}},{"SurveyID":"SV_07McTW65bCwKmGi","Element":"SQ","PrimaryAttribute":"QID50","SecondaryAttribute":"Which of the following racial or ethnic groups do you identify with? (You may select all that apply)","TertiaryAttribute":null,"Payload":{"ChoiceOrder":[1,2,3,4,5,6,7,8,9],"Choices":{"1":{"Display":"<strong>American Indian or Alaska Native<\/strong> (e.g., Navajo Nation, Blackfeet Tribe, Inupiat Traditional Gov&#39;t., etc.)"},"2":{"Display":"<strong>Asian or Asian American<\/strong> (e.g., Chinese, Japanese, Filipino, Korean, South Asian, Vietnamese, etc.)"},"3":{"Display":"<strong>Black or African American<\/strong> (e.g., Jamaican, Nigerian, Haitian, Ethiopian, etc.)"},"4":{"Display":"<strong>Hispanic or Latino\/a<\/strong> (e.g., Puerto Rican, Mexican, Cuban, Salvadoran, Colombian, etc.)"},"5":{"Display":"<strong>Middle Eastern or North African<\/strong> (e.g., Lebanese, Iranian, Egyptian, Moroccan, Israeli, Palestinian, etc.)"},"6":{"Display":"<strong>Native Hawaiian or Pacific Islander <\/strong>(e.g., Samoan, Guamanian, Chamorro, Tongan, etc.)"},"7":{"Display":"<strong>White or European<\/strong> (e.g., German, Irish, English, Italian, Polish, French, etc.)"},"8":{"Display":"<strong>My race or ethnicity is best described as:<\/strong><br \/>\n<br \/>\n<em>(Feel free to use the text box and\/or you can simply select categories above.)<\/em><br \/>\n&nbsp;","TextEntry":"true"},"9":{"Display":"Prefer not to say"}},"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"race","DataVisibility":{"Hidden":false,"Private":false},"Language":[],"NextAnswerId":1,"NextChoiceId":11,"QuestionDescription":"Which of the following racial or ethnic groups do you identify with? (You may select all that apply)","QuestionID":"QID50","QuestionText":"<b>Which of the following racial or ethnic groups do you identify with? (You may select all that apply)<\/b>","QuestionText_Unsafe":"<b>Which of the following racial or ethnic groups do you identify with? (You may select all that apply)<\/b>","QuestionType":"MC","Selector":"MAVR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","MinChoices":"1","Type":"None"}}}},{"SurveyID":"SV_07McTW65bCwKmGi","Element":"SQ","PrimaryAttribute":"QID51","SecondaryAttribute":"Which best describes your gender identity?\u00a0","TertiaryAttribute":null,"Payload":{"ChoiceOrder":["21","22","29","30"],"Choices":{"21":{"Display":"Man"},"22":{"Display":"Woman"},"29":{"Display":"Transgender, Non-binary, or another gender"},"30":{"Display":"Prefer not to answer"}},"Configuration":{"QuestionDescriptionOption":"UseText"},"DataExportTag":"gender","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":31,"QuestionDescription":"Which best describes your gender identity?\u00a0","QuestionID":"QID51","QuestionText":"<b>Which best describes your gender identity?&nbsp;<\/b>","QuestionText_Unsafe":"<b>Which best describes your gender identity? (You may select all that apply)<\/b>","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}}}},{"SurveyID":"SV_07McTW65bCwKmGi","Element":"SQ","PrimaryAttribute":"QID52","SecondaryAttribute":"What is the highest level of education you have achieved?","TertiaryAttribute":null,"Payload":{"ChoiceOrder":["1","4","5","6","7","8","9"],"Choices":{"1":{"Display":"Less than high school"},"4":{"Display":"High school"},"5":{"Display":"2 year college degree (e.g., AA, AS)"},"6":{"Display":"4 year college degree (e.g., BS, BA)"},"7":{"Display":"Master\u2019s degree (e.g., MA, MS, MEng, MEd, MSW, MBA)"},"8":{"Display":"Professional (MD, DDS, DVM, LLB, JD) or doctoral degree (PhD, EdD)"},"9":{"Display":"I\u2019m not sure"}},"Configuration":{"NumColumns":2,"QuestionDescriptionOption":"UseText"},"DataExportTag":"education","DataVisibility":{"Hidden":false,"Private":false},"Language":[],"NextAnswerId":1,"NextChoiceId":10,"QuestionDescription":"What is the highest level of education you have achieved?","QuestionID":"QID52","QuestionText":"<strong>What is the highest level of education you have achieved?<\/strong>","QuestionText_Unsafe":"<strong>What is the highest level of education you have achieved?<\/strong>","QuestionType":"MC","Selector":"SACOL","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}}}},{"SurveyID":"SV_07McTW65bCwKmGi","Element":"SQ","PrimaryAttribute":"QID53","SecondaryAttribute":"As of today, do you identify more as a Republican or a Democrat?","TertiaryAttribute":null,"Payload":{"ChoiceOrder":["1","2"],"Choices":{"1":{"Display":"a Republican"},"2":{"Display":"a Democrat"}},"Configuration":{"LabelPosition":"BELOW","QuestionDescriptionOption":"UseText"},"DataExportTag":"political_party","DataVisibility":{"Hidden":false,"Private":false},"DefaultChoices":false,"GradingData":[],"Language":[],"NextAnswerId":1,"NextChoiceId":5,"QuestionDescription":"As of today, do you identify more as a Republican or a Democrat?","QuestionID":"QID53","QuestionText":"<b>As of today, do you identify more as a Republican or a Democrat?<\/b>","QuestionText_Unsafe":"<b>As of today, do you identify more as a Republican or a Democrat?<\/b>","QuestionType":"MC","Selector":"SAHR","SubSelector":"TX","Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}}}},{"SurveyID":"SV_07McTW65bCwKmGi","Element":"SQ","PrimaryAttribute":"QID54","SecondaryAttribute":"You will now complete a final set of demographic questions. These will not affect your bonus paym...","TertiaryAttribute":null,"Payload":{"QuestionText":"You will now complete a final set of demographic questions. These will not affect your bonus payment.&nbsp;","DefaultChoices":false,"DataExportTag":"Q54","QuestionID":"QID54","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"You will now complete a final set of demographic questions. These will not affect your bonus paym...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_07McTW65bCwKmGi","Element":"SQ","PrimaryAttribute":"QID56","SecondaryAttribute":"The candidates who took this test are other participants on Prolific. The candidate pool contains...","TertiaryAttribute":null,"Payload":{"QuestionText":"The candidates who took this test are other participants on Prolific. The candidate pool contains equal numbers of male and female candidates.<br>\n<br>\nBefore seeing any individual information about a specific candidate, we would like to know <strong>your best guess about how male and female candidates performed in this candidate pool. <\/strong><br>\n<br>\nPlease answer each question as a percent chance from 0 to 100.<br>","DataExportTag":"Q56","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"The candidates who took this test are other participants on Prolific. The candidate pool contains...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"Language":[],"NextChoiceId":1,"NextAnswerId":1,"QuestionID":"QID56"}},{"SurveyID":"SV_07McTW65bCwKmGi","Element":"SQ","PrimaryAttribute":"QID57","SecondaryAttribute":"If one female candidate were randomly selected from this pool, what is your best guess of the per...","TertiaryAttribute":null,"Payload":{"QuestionText":"If one <span style=\"color:#c0392b;\"><b>female<\/b><\/span> candidate were randomly selected from this pool, what is your best guess of the <strong>percent chance she scored above the median candidate?<\/strong>","DefaultChoices":false,"DataExportTag":"Q57","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"above","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":true,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"If one female candidate were randomly selected from this pool, what is your best guess of the per...","Choices":{"1":{"Display":"&nbsp;"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":2,"Labels":[],"ChoiceDataExportTags":false,"QuestionID":"QID57"}},{"SurveyID":"SV_07McTW65bCwKmGi","Element":"SQ","PrimaryAttribute":"QID58","SecondaryAttribute":"How confident are you in your answers to the previous questions? ","TertiaryAttribute":null,"Payload":{"QuestionText":"How confident are you in your answers to the previous questions?&nbsp;","DefaultChoices":false,"DataExportTag":"Q58","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"above","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":true,"NotApplicable":false,"MobileFirst":true,"SliderStartPositions":{"1":0}},"QuestionDescription":"How confident are you in your answers to the previous questions? ","Choices":{"1":{"Display":"&nbsp;"}},"ChoiceOrder":[1],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":3,"Labels":{"1":{"Display":"Not at all confident"},"2":{"Display":"Extremely confident"}},"ChoiceDataExportTags":false,"QuestionID":"QID58"}},{"SurveyID":"SV_07McTW65bCwKmGi","Element":"SQ","PrimaryAttribute":"QID6","SecondaryAttribute":"Based on how candidates perform on this test, each candidate either scored above the median or no...","TertiaryAttribute":null,"Payload":{"QuestionText":"Based on how candidates perform on this test, each candidate either scored <strong>above<\/strong> the median or <strong>not above<\/strong> the median.<br \/>\n<br \/>\nA candidate is above the median if they performed better than at least half of the candidates in the pool.<br \/>\n<br \/>\nIn this study, you and other evaluators will be asked to estimate <strong>the percent chance that a candidate scored above the median.<\/strong>","DataExportTag":"above_median_info","QuestionID":"QID6","QuestionType":"DB","Selector":"TB","QuestionDescription":"Based on how candidates perform on this test, each candidate either scored above the median or no...","Validation":{"Settings":{"Type":"None"}},"Language":[],"DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"ChoiceOrder":[],"NextChoiceId":1,"NextAnswerId":1,"QuestionJS":"Qualtrics.SurveyEngine.addOnReady(function () {\n    var qthis = this; \/\/ ADDED: save reference for API calls\n\n    var controller = this.getQuestionContainer();\n\n    \/\/ Replace with your actual QIDs\n    var questionIDs = [\"QID7\"];\n\n    \/\/ Unique key for this page\n    var revealKey = \"revealed_\" + this.questionId;\n\n    \/\/ Get Qualtrics Next button\n    var nextButton = document.getElementById(\"NextButton\");\n\n    function hideQuestions() {\n        questionIDs.forEach(function(qid) {\n            var q = document.getElementById(qid);\n            if (q) {\n                q.style.visibility = \"hidden\";\n                q.style.height = \"0px\";\n                q.style.overflow = \"hidden\";\n                q.style.margin = \"0\";\n                q.style.padding = \"0\";\n            }\n        });\n    }\n\n    function showQuestions() {\n        questionIDs.forEach(function(qid) {\n            var q = document.getElementById(qid);\n            if (q) {\n                q.style.visibility = \"visible\";\n                q.style.height = \"auto\";\n                q.style.overflow = \"visible\";\n                q.style.margin = \"\";\n                q.style.padding = \"\";\n                void q.offsetHeight;\n            }\n        });\n\n        setTimeout(function() {\n            window.dispatchEvent(new Event(\"resize\"));\n        }, 50);\n    }\n\n    \/\/ Check whether questions were already revealed\n    var alreadyRevealed = sessionStorage.getItem(revealKey) === \"true\";\n\n    if (alreadyRevealed) {\n        showQuestions();\n        qthis.showNextButton(); \/\/ ADDED: Qualtrics API call\n        if (nextButton) {\n            nextButton.style.display = \"\";\n        }\n        return;\n    }\n\n    \/\/ First load: hide Next button and questions\n    qthis.hideNextButton(); \/\/ ADDED: Qualtrics API call\n    if (nextButton) {\n        nextButton.style.display = \"none\";\n    }\n\n    hideQuestions();\n\n    \/\/ Create centered button\n    var wrapper = document.createElement(\"div\");\n    wrapper.style.textAlign = \"center\";\n    wrapper.style.margin = \"30px 0\";\n\n    var bgColor = \"${e:\/\/Field\/understanding_button_backgroundColor}\";\n    var borderColor = \"${e:\/\/Field\/understanding_button_border}\";\n    var textColor = \"${e:\/\/Field\/understanding_button_color}\";\n\n    \/\/ Fallbacks (in case something is missing)\n    bgColor = bgColor || \"#FFA500\";\n    borderColor = borderColor || \"#cc8400\";\n    textColor = textColor || \"#2b1a00\";\n\n    var button = document.createElement(\"button\");\n    button.type = \"button\";\n    button.innerHTML = \"Click to answer understanding questions\";\n\n    \/\/ Styling\n    button.style.padding = \"12px 24px\";\n    button.style.cursor = \"pointer\";\n    button.style.backgroundColor = bgColor;\n    button.style.border = \"1px solid \" + borderColor;\n    button.style.borderRadius = \"6px\";\n    button.style.fontSize = \"16px\";\n    button.style.fontWeight = \"600\";\n    button.style.color = textColor;\n\n    wrapper.appendChild(button);\n    controller.appendChild(wrapper);\n\n    button.addEventListener(\"click\", function () {\n        sessionStorage.setItem(revealKey, \"true\");\n\n        showQuestions();\n        qthis.showNextButton(); \/\/ ADDED: Qualtrics API call\n        if (nextButton) {\n            nextButton.style.display = \"\";\n        }\n\n        wrapper.remove();\n    });\n});"}},{"SurveyID":"SV_07McTW65bCwKmGi","Element":"SQ","PrimaryAttribute":"QID60","SecondaryAttribute":"A male candidate is randomly selected from the candidate pool. A male evaluator is asked:\u00a0\u201cWhat i","TertiaryAttribute":null,"Payload":{"QuestionText":"A <span style=\"color:#2980b9;\"><b>male<\/b><\/span> <strong><span style=\"color:#2980b9;\">candidate<\/span><\/strong> is randomly selected from the candidate pool.<br \/>\n<br \/>\nA<b> <\/b><span style=\"color:#2980b9;\"><b>male<\/b><strong> evaluator <\/strong><\/span>is asked:&nbsp;&ldquo;What is the percent chance that this <span style=\"color:#2980b9;\"><b>male<\/b><\/span> <strong><span style=\"color:#2980b9;\">candidate<\/span><\/strong> scored above the median candidate?&rdquo;<br \/>\n<br \/>\nWhat do you think the average <span style=\"color:#2980b9;\"><b>male<\/b><\/span><strong> <span style=\"color:#2980b9;\">evaluator&rsquo;s<\/span> answer <\/strong>would be?","DefaultChoices":false,"DataExportTag":"avg_male_eval_male","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"above","CSSliderMin":0,"CSSliderMax":100,"GridLines":0,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":true,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"A male candidate is randomly selected from the candidate pool. A male evaluator is asked:\u00a0\u201cWhat i...","Choices":{"1":{"Display":"&nbsp;"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":5,"Labels":{"2":{"Display":"<span style=\"font-size:16px;\">0% chance<\/span>"},"3":{"Display":"<span style=\"font-size:16px;\">50% chance<\/span>"},"4":{"Display":"<span style=\"font-size:16px;\">100% chance<\/span>"}},"ChoiceDataExportTags":false,"QuestionID":"QID60","QuestionJS":"Qualtrics.SurveyEngine.addOnReady(function () {\n  var q = this;\n  var qid = q.questionId;\n  var qc = q.getQuestionContainer();\n  var started = false;\n\n  \/\/ ---------- Set wording here ----------\n  var evaluatorGender = \"male\"; \/\/ \"male\" or \"female\"\n  var candidateGender = \"male\";   \/\/ \"male\" or \"female\"\n\n  \/\/ ---------- Gender colors ----------\n  function genderColor(gender) {\n    if (gender === \"male\") {\n      return \"#2980b9\";\n    }\n    if (gender === \"female\") {\n      return \"#c0392b\";\n    }\n    return \"#222\";\n  }\n\n  function genderSpan(gender, noun) {\n    return (\n      '<span style=\"color:' +\n      genderColor(gender) +\n      '; font-weight:700;\">' +\n      gender +\n      \" \" +\n      noun +\n      \"<\/span>\"\n    );\n  }\n\n  \/\/ ---------- Text helper ----------\n  function readoutText(value) {\n    var displayedValue = value === \"\" ? \"__\" : value;\n\n    return (\n      '<div style=\"' +\n        'display:inline-block;' +\n        'max-width:760px;' +\n        'padding:14px 22px;' +\n        'border:1px solid #dddddd;' +\n        'border-radius:12px;' +\n        'background:#f7f7f7;' +\n        'font-size:18px;' +\n        'line-height:1.4;' +\n        'text-align:center;' +\n        'color:#222;' +\n      '\">' +\n        '<div style=\"font-weight:400; margin-bottom:8px;\">' +\n          \"Your answer: the average \" +\n          genderSpan(evaluatorGender, \"evaluator's\") +\n          \" answer would be\" +\n        \"<\/div>\" +\n\n        '<div style=\"font-weight:600;\">' +\n          '\"There\\'s a ' +\n          '<span style=\"font-weight:800; white-space:nowrap;\">' +\n          displayedValue +\n          \"%<\/span> chance that this \" +\n          genderSpan(candidateGender, \"candidate\") +\n          ' is above the median\"' +\n        \"<\/div>\" +\n      \"<\/div>\"\n    );\n  }\n\n  \/\/ ---------- Custom readout ----------\n  var readout = document.createElement(\"div\");\n  readout.innerHTML = readoutText(\"\");\n  readout.style.maxWidth = \"820px\";\n  readout.style.margin = \"18px auto 20px auto\";\n  readout.style.textAlign = \"center\";\n\n  var questionBody = qc.querySelector(\".QuestionBody\");\n  if (questionBody) {\n    questionBody.insertBefore(readout, questionBody.firstChild);\n  }\n\n  \/\/ ---------- Styling ----------\n  var style = document.createElement(\"style\");\n  style.innerHTML = `\n    #${qid} .QuestionBody {\n      max-width: 820px !important;\n      margin: 0 auto !important;\n    }\n\n    #${qid} .numbers,\n    #${qid} .Numbers,\n    #${qid} .labels,\n    #${qid} .Labels,\n    #${qid} .tickLabels,\n    #${qid} .TickLabels,\n    #${qid} .SliderLabels,\n    #${qid} .sliderLabels,\n    #${qid} .q-slider-label,\n    #${qid} .SliderLabel,\n    #${qid} .TickLabel,\n    #${qid} .tickLabel {\n      font-size: 15px !important;\n      line-height: 1.25 !important;\n    }\n\n    #${qid} .ToolTipBox,\n    #${qid} .sliderToolTipBox,\n    #${qid} .SliderValue,\n    #${qid} .q-slider-value {\n      visibility: hidden !important;\n      opacity: 0 !important;\n    }\n  `;\n  document.head.appendChild(style);\n\n  \/\/ ---------- Hide \"Click to write Choice 1\" ----------\n  function hideChoiceText() {\n    Array.from(qc.querySelectorAll(\"*\")).forEach(function (el) {\n      var txt = el.textContent.trim();\n      if (\n        el.children.length === 0 &&\n        (txt === \"Click to write Choice 1\" || txt === \"Choice 1\")\n      ) {\n        el.style.setProperty(\"display\", \"none\", \"important\");\n        el.style.setProperty(\"visibility\", \"hidden\", \"important\");\n        el.style.setProperty(\"height\", \"0\", \"important\");\n        el.style.setProperty(\"margin\", \"0\", \"important\");\n        el.style.setProperty(\"padding\", \"0\", \"important\");\n      }\n    });\n  }\n\n  \/\/ ---------- Handle ----------\n  function getHandle() {\n    return document.getElementById(qid + \"~1~handle\");\n  }\n\n  function hideInitialHandle() {\n    if (started) return;\n\n    var handle = getHandle();\n    if (handle) {\n      handle.style.setProperty(\"opacity\", \"0\", \"important\");\n    }\n  }\n\n  function showHandle() {\n    var handle = getHandle();\n    if (handle) {\n      handle.style.setProperty(\"opacity\", \"1\", \"important\");\n      handle.style.setProperty(\"visibility\", \"visible\", \"important\");\n    }\n  }\n\n  \/\/ ---------- Value extraction ----------\n  function cleanSliderValue(v) {\n    if (v === null || v === undefined || v === \"\" || v === false || v === true) {\n      return \"\";\n    }\n\n    var n = Number(v);\n    if (!Number.isFinite(n)) {\n      return \"\";\n    }\n\n    return Math.max(0, Math.min(100, Math.round(n)));\n  }\n\n  function getSliderValue() {\n    var value;\n\n    var inputs = qc.querySelectorAll(\"input\");\n    for (var i = 0; i < inputs.length; i++) {\n      value = cleanSliderValue(inputs[i].value);\n      if (value !== \"\") {\n        return value;\n      }\n    }\n\n    var handle = getHandle();\n    if (handle) {\n      value = cleanSliderValue(handle.getAttribute(\"aria-valuenow\"));\n      if (value !== \"\") {\n        return value;\n      }\n\n      value = cleanSliderValue(handle.getAttribute(\"data-value\"));\n      if (value !== \"\") {\n        return value;\n      }\n\n      var left = handle.style.left || \"\";\n      if (left.indexOf(\"%\") > -1) {\n        value = cleanSliderValue(parseFloat(left));\n        if (value !== \"\") {\n          return value;\n        }\n      }\n    }\n\n    return \"\";\n  }\n\n  function updateReadout() {\n    var value = getSliderValue();\n    readout.innerHTML = readoutText(value);\n  }\n\n  \/\/ ---------- Interaction ----------\n  function revealAfterQualtricsUpdates() {\n    started = true;\n\n    setTimeout(function () {\n      showHandle();\n      updateReadout();\n    }, 150);\n\n    setTimeout(function () {\n      showHandle();\n      updateReadout();\n    }, 300);\n  }\n\n  qc.addEventListener(\"click\", revealAfterQualtricsUpdates);\n  qc.addEventListener(\"mouseup\", revealAfterQualtricsUpdates);\n  qc.addEventListener(\"touchend\", revealAfterQualtricsUpdates);\n  qc.addEventListener(\"keydown\", revealAfterQualtricsUpdates);\n  qc.addEventListener(\"change\", revealAfterQualtricsUpdates);\n  qc.addEventListener(\"input\", revealAfterQualtricsUpdates);\n\n  qc.addEventListener(\"mousemove\", function () {\n    if (started) {\n      setTimeout(updateReadout, 50);\n    }\n  });\n\n  qc.addEventListener(\"touchmove\", function () {\n    if (started) {\n      setTimeout(updateReadout, 50);\n    }\n  });\n\n  \/\/ ---------- Initial cleanup ----------\n  hideChoiceText();\n  hideInitialHandle();\n\n  setTimeout(function () {\n    hideChoiceText();\n    hideInitialHandle();\n  }, 100);\n\n  setTimeout(function () {\n    hideChoiceText();\n    hideInitialHandle();\n  }, 300);\n\n  setTimeout(function () {\n    hideChoiceText();\n    hideInitialHandle();\n  }, 700);\n\n  var observer = new MutationObserver(function () {\n    hideChoiceText();\n    hideInitialHandle();\n  });\n\n  observer.observe(qc, {\n    childList: true,\n    subtree: true,\n    attributes: true,\n    attributeFilter: [\"style\", \"class\"]\n  });\n});"}},{"SurveyID":"SV_07McTW65bCwKmGi","Element":"SQ","PrimaryAttribute":"QID61","SecondaryAttribute":"A female candidate\u00a0is randomly selected from the candidate pool. A\u00a0female evaluator is asked: \u201cW","TertiaryAttribute":null,"Payload":{"QuestionText":"A <span style=\"color:#c0392b;\"><b>female candidate<\/b><\/span>&nbsp;is randomly selected from the candidate pool.<br>\n<br>A&nbsp;<span style=\"color:#c0392b;\"><b>fe<\/b><\/span><strong><span style=\"color:#c0392b;\">male evaluator<\/span> <\/strong>is asked: \u201cWhat is the percent chance that this <span style=\"color:#c0392b;\"><b>female<\/b><\/span> <strong><span style=\"color:#c0392b;\">candidate<\/span><\/strong> scored above the median candidate?\u201d<br>\n<br>\nWhat do you think the average <span style=\"color:#c0392b;\"><b>fe<\/b><\/span><strong><span style=\"color:#c0392b;\">male evaluator\u2019s<\/span> answer <\/strong>would be?","DefaultChoices":false,"DataExportTag":"Q61","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"above","CSSliderMin":0,"CSSliderMax":100,"GridLines":0,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":true,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"A female candidate\u00a0is randomly selected from the candidate pool. A\u00a0female evaluator is asked: \u201cWh...","Choices":{"1":{"Display":"&nbsp;"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}