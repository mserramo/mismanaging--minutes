rding here ----------\n  var candidateGender = \"female\"; \/\/ \"male\" or \"female\"\n\n  \/\/ ---------- Gender helpers ----------\n  function genderColor(gender) {\n    return gender === \"female\" ? \"#c0392b\" : \"#2980b9\";\n  }\n\n  function genderSpan(gender, noun) {\n    return (\n      '<span style=\"color:' +\n      genderColor(gender) +\n      '; font-weight:700;\">' +\n      gender +\n      \" \" +\n      noun +\n      \"<\/span>\"\n    );\n  }\n\n  \/\/ ---------- Live answer readout ----------\n  function readoutText(value) {\n    var displayedValue = value === \"\" ? \"__\" : value;\n\n    return (\n      '<div style=\"' +\n        'display:inline-block;' +\n        'max-width:760px;' +\n        'padding:14px 22px;' +\n        'border:1px solid #d9d9d9;' +\n        'border-radius:14px;' +\n        'background:#f3f3f3;' +\n        'font-size:18px;' +\n        'line-height:1.4;' +\n        'text-align:center;' +\n        'color:#222;' +\n        'box-sizing:border-box;' +\n      '\">' +\n        '<div style=\"font-weight:400; margin-bottom:8px;\">' +\n          \"Your answer:\" +\n        \"<\/div>\" +\n\n        '<div style=\"font-weight:600;\">' +\n          \"There's a \" +\n          '<span style=\"font-weight:800; white-space:nowrap;\">' +\n          displayedValue +\n          \"%<\/span> chance the \" +\n          genderSpan(candidateGender, \"candidate\") +\n          \" scored above the median candidate\" +\n        \"<\/div>\" +\n      \"<\/div>\"\n    );\n  }\n\n  \/\/ ---------- Insert custom readout ----------\n  var readout = document.createElement(\"div\");\n  readout.innerHTML = readoutText(\"\");\n  readout.style.maxWidth = \"820px\";\n  readout.style.margin = \"18px auto 20px auto\";\n  readout.style.textAlign = \"center\";\n\n  var questionBody = qc.querySelector(\".QuestionBody\");\n  if (questionBody) {\n    questionBody.insertBefore(readout, questionBody.firstChild);\n  }\n\n  \/\/ ---------- Styling ----------\n  var style = document.createElement(\"style\");\n  style.innerHTML = `\n    #${qid} .QuestionBody {\n      max-width: 820px !important;\n      margin: 0 auto !important;\n    }\n\n    #${qid} .numbers,\n    #${qid} .Numbers,\n    #${qid} .labels,\n    #${qid} .Labels,\n    #${qid} .tickLabels,\n    #${qid} .TickLabels,\n    #${qid} .SliderLabels,\n    #${qid} .sliderLabels,\n    #${qid} .q-slider-label,\n    #${qid} .SliderLabel,\n    #${qid} .TickLabel,\n    #${qid} .tickLabel {\n      font-size: 15px !important;\n      line-height: 1.25 !important;\n    }\n\n    #${qid} .ToolTipBox,\n    #${qid} .sliderToolTipBox,\n    #${qid} .SliderValue,\n    #${qid} .q-slider-value {\n      visibility: hidden !important;\n      opacity: 0 !important;\n    }\n  `;\n  document.head.appendChild(style);\n\n  \/\/ ---------- Hide \"Click to write Choice 1\" ----------\n  function hideChoiceText() {\n    Array.from(qc.querySelectorAll(\"*\")).forEach(function (el) {\n      var txt = el.textContent.trim();\n      if (\n        el.children.length === 0 &&\n        (txt === \"Click to write Choice 1\" || txt === \"Choice 1\")\n      ) {\n        el.style.setProperty(\"display\", \"none\", \"important\");\n        el.style.setProperty(\"visibility\", \"hidden\", \"important\");\n        el.style.setProperty(\"height\", \"0\", \"important\");\n        el.style.setProperty(\"margin\", \"0\", \"important\");\n        el.style.setProperty(\"padding\", \"0\", \"important\");\n      }\n    });\n  }\n\n  \/\/ ---------- Handle ----------\n  function getHandle() {\n    return document.getElementById(qid + \"~1~handle\");\n  }\n\n  function hideInitialHandle() {\n    if (started) return;\n\n    var handle = getHandle();\n    if (handle) {\n      handle.style.setProperty(\"opacity\", \"0\", \"important\");\n    }\n  }\n\n  function showHandle() {\n    var handle = getHandle();\n    if (handle) {\n      handle.style.setProperty(\"opacity\", \"1\", \"important\");\n      handle.style.setProperty(\"visibility\", \"visible\", \"important\");\n    }\n  }\n\n  \/\/ ---------- Value extraction ----------\n  function cleanSliderValue(v) {\n    if (v === null || v === undefined || v === \"\" || v === false || v === true) {\n      return \"\";\n    }\n\n    var n = Number(v);\n    if (!Number.isFinite(n)) {\n      return \"\";\n    }\n\n    return Math.max(0, Math.min(100, Math.round(n)));\n  }\n\n  function getSliderValue() {\n    var value;\n\n    var inputs = qc.querySelectorAll(\"input\");\n    for (var i = 0; i < inputs.length; i++) {\n      value = cleanSliderValue(inputs[i].value);\n      if (value !== \"\") {\n        return value;\n      }\n    }\n\n    var handle = getHandle();\n    if (handle) {\n      value = cleanSliderValue(handle.getAttribute(\"aria-valuenow\"));\n      if (value !== \"\") {\n        return value;\n      }\n\n      value = cleanSliderValue(handle.getAttribute(\"data-value\"));\n      if (value !== \"\") {\n        return value;\n      }\n\n      var left = handle.style.left || \"\";\n      if (left.indexOf(\"%\") > -1) {\n        value = cleanSliderValue(parseFloat(left));\n        if (value !== \"\") {\n          return value;\n        }\n      }\n    }\n\n    return \"\";\n  }\n\n  function updateReadout() {\n    var value = getSliderValue();\n    readout.innerHTML = readoutText(value);\n  }\n\n  \/\/ ---------- Interaction ----------\n  function revealAfterQualtricsUpdates() {\n    started = true;\n\n    setTimeout(function () {\n      showHandle();\n      updateReadout();\n    }, 150);\n\n    setTimeout(function () {\n      showHandle();\n      updateReadout();\n    }, 300);\n  }\n\n  qc.addEventListener(\"click\", revealAfterQualtricsUpdates);\n  qc.addEventListener(\"mouseup\", revealAfterQualtricsUpdates);\n  qc.addEventListener(\"touchend\", revealAfterQualtricsUpdates);\n  qc.addEventListener(\"keydown\", revealAfterQualtricsUpdates);\n  qc.addEventListener(\"change\", revealAfterQualtricsUpdates);\n  qc.addEventListener(\"input\", revealAfterQualtricsUpdates);\n\n  qc.addEventListener(\"mousemove\", function () {\n    if (started) {\n      setTimeout(updateReadout, 50);\n    }\n  });\n\n  qc.addEventListener(\"touchmove\", function () {\n    if (started) {\n      setTimeout(updateReadout, 50);\n    }\n  });\n\n  \/\/ ---------- Initial cleanup ----------\n  hideChoiceText();\n  hideInitialHandle();\n\n  setTimeout(function () {\n    hideChoiceText();\n    hideInitialHandle();\n  }, 100);\n\n  setTimeout(function () {\n    hideChoiceText();\n    hideInitialHandle();\n  }, 300);\n\n  setTimeout(function () {\n    hideChoiceText();\n    hideInitialHandle();\n  }, 700);\n\n  var observer = new MutationObserver(function () {\n    hideChoiceText();\n    hideInitialHandle();\n  });\n\n  observer.observe(qc, {\n    childList: true,\n    subtree: true,\n    attributes: true,\n    attributeFilter: [\"style\", \"class\"]\n  });\n});"}},{"SurveyID":"SV_07McTW65bCwKmGi","Element":"SQ","PrimaryAttribute":"QID73","SecondaryAttribute":"Remember: If you fully trust Evaluator A\u2019s report, your answer should be 40. If you think Evaluat.","TertiaryAttribute":null,"Payload":{"QuestionText":"Remember:\n<ul>\n\t<li>If you <strong>fully trust <\/strong>Evaluator A\u2019s report, your answer should be <b>40<\/b>.<\/li>\n\t<li>If you think Evaluator A\u2019s report is <strong>too high<\/strong>, your answer should be <strong>below 40.<\/strong><\/li>\n\t<li>If you think Evaluator A\u2019s report is <strong>too low<\/strong>, the answer should be <strong>above 40.<\/strong><\/li>\n<\/ul>","DefaultChoices":false,"DataExportTag":"Q73","QuestionID":"QID73","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Remember: If you fully trust Evaluator A\u2019s report, your answer should be 40. If you think Evaluat...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_07McTW65bCwKmGi","Element":"SQ","PrimaryAttribute":"QID74","SecondaryAttribute":"Remember: If you fully trust Evaluator A\u2019s report, your answer should be 40. If you think Evaluat.","TertiaryAttribute":null,"Payload":{"QuestionText":"Remember:<br><br>\nIf you <strong>fully trust <\/strong>Evaluator A\u2019s report, your answer should be <b>40<\/b>.<br>\n<br>\nIf you think Evaluator A\u2019s report is <strong>too high<\/strong>, your answer should be <strong>below 40.<\/strong><br>\n<br>\nIf you think Evaluator A\u2019s report is <strong>too low<\/strong>, the answer should be <strong>above 40.<\/strong>","DefaultChoices":false,"DataExportTag":"Q74","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Remember: If you fully trust Evaluator A\u2019s report, your answer should be 40. If you think Evaluat...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID74"}},{"SurveyID":"SV_07McTW65bCwKmGi","Element":"SQ","PrimaryAttribute":"QID75","SecondaryAttribute":"You have now been assigned a new\u00a0male candidate.\u00a0 Evaluator A is female.\u00a0With the information she","TertiaryAttribute":null,"Payload":{"QuestionText":"You have now been assigned a new&nbsp;<span style=\"color:#2980b9;\"><b>male<\/b><\/span> <strong><span style=\"color:#2980b9;\">candidate<\/span><\/strong>.&nbsp;<br>\n<br>\n<strong>Evaluator A is <\/strong><b><span style=\"color:#c0392b;\">female<\/span><\/b><strong>.<\/strong>&nbsp;With the information she received, she reported that this <span style=\"color:#2980b9;\"><b>male<\/b><\/span> <strong><span style=\"color:#2980b9;\">candidate<\/span><\/strong> had a <b>40<\/b><b>% chance <\/b>of scoring above the median candidate.&nbsp;<br>\n<br>\nWhat do <b>you<\/b> think the percent chance is that this <span style=\"color:#2980b9;\"><b>male<\/b><\/span> <strong><span style=\"color:#2980b9;\">candidate<\/span><\/strong> scored above the median candidate?","DefaultChoices":false,"DataExportTag":"Q75","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","TextPosition":"above","CSSliderMin":0,"CSSliderMax":100,"GridLines":0,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":true,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"You have now been assigned a new\u00a0male candidate.\u00a0 Evaluator A is female.\u00a0With the information she...","Choices":{"1":{"Display":"&nbsp;"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":5,"Labels":{"2":{"Display":"<span style=\"font-size:16px;\">0% chance<\/span>"},"3":{"Display":"<span style=\"font-size:16px;\">50% chance<\/span>"},"4":{"Display":"<span style=\"font-size:16px;\">100% chance<\/span>"}},"ChoiceDataExportTags":false,"QuestionID":"QID75","QuestionJS":"Qualtrics.SurveyEngine.addOnReady(function () {\n  var q = this;\n  var qid = q.questionId;\n  var qc = q.getQuestionContainer();\n  var started = false;\n\n  \/\/ ---------- Set wording here ----------\n  var candidateGender = \"male\"; \/\/ \"male\" or \"female\"\n\n  \/\/ ---------- Gender helpers ----------\n  function genderColor(gender) {\n    return gender === \"female\" ? \"#c0392b\" : \"#2980b9\";\n  }\n\n  function genderSpan(gender, noun) {\n    return (\n      '<span style=\"color:' +\n      genderColor(gender) +\n      '; font-weight:700;\">' +\n      gender +\n      \" \" +\n      noun +\n      \"<\/span>\"\n    );\n  }\n\n  \/\/ ---------- Live answer readout ----------\n  function readoutText(value) {\n    var displayedValue = value === \"\" ? \"__\" : value;\n\n    return (\n      '<div style=\"' +\n        'display:inline-block;' +\n        'max-width:760px;' +\n        'padding:14px 22px;' +\n        'border:1px solid #d9d9d9;' +\n        'border-radius:14px;' +\n        'background:#f3f3f3;' +\n        'font-size:18px;' +\n        'line-height:1.4;' +\n        'text-align:center;' +\n        'color:#222;' +\n        'box-sizing:border-box;' +\n      '\">' +\n        '<div style=\"font-weight:400; margin-bottom:8px;\">' +\n          \"Your answer:\" +\n        \"<\/div>\" +\n\n        '<div style=\"font-weight:600;\">' +\n          \"There's a \" +\n          '<span style=\"font-weight:800; white-space:nowrap;\">' +\n          displayedValue +\n          \"%<\/span> chance the \" +\n          genderSpan(candidateGender, \"candidate\") +\n          \" scored above the median candidate\" +\n        \"<\/div>\" +\n      \"<\/div>\"\n    );\n  }\n\n  \/\/ ---------- Insert custom readout ----------\n  var readout = document.createElement(\"div\");\n  readout.innerHTML = readoutText(\"\");\n  readout.style.maxWidth = \"820px\";\n  readout.style.margin = \"18px auto 20px auto\";\n  readout.style.textAlign = \"center\";\n\n  var questionBody = qc.querySelector(\".QuestionBody\");\n  if (questionBody) {\n    questionBody.insertBefore(readout, questionBody.firstChild);\n  }\n\n  \/\/ ---------- Styling ----------\n  var style = document.createElement(\"style\");\n  style.innerHTML = `\n    #${qid} .QuestionBody {\n      max-width: 820px !important;\n      margin: 0 auto !important;\n    }\n\n    #${qid} .numbers,\n    #${qid} .Numbers,\n    #${qid} .labels,\n    #${qid} .Labels,\n    #${qid} .tickLabels,\n    #${qid} .TickLabels,\n    #${qid} .SliderLabels,\n    #${qid} .sliderLabels,\n    #${qid} .q-slider-label,\n    #${qid} .SliderLabel,\n    #${qid} .TickLabel,\n    #${qid} .tickLabel {\n      font-size: 15px !important;\n      line-height: 1.25 !important;\n    }\n\n    #${qid} .ToolTipBox,\n    #${qid} .sliderToolTipBox,\n    #${qid} .SliderValue,\n    #${qid} .q-slider-value {\n      visibility: hidden !important;\n      opacity: 0 !important;\n    }\n  `;\n  document.head.appendChild(style);\n\n  \/\/ ---------- Hide \"Click to write Choice 1\" ----------\n  function hideChoiceText() {\n    Array.from(qc.querySelectorAll(\"*\")).forEach(function (el) {\n      var txt = el.textContent.trim();\n      if (\n        el.children.length === 0 &&\n        (txt === \"Click to write Choice 1\" || txt === \"Choice 1\")\n      ) {\n        el.style.setProperty(\"display\", \"none\", \"important\");\n        el.style.setProperty(\"visibility\", \"hidden\", \"important\");\n        el.style.setProperty(\"height\", \"0\", \"important\");\n        el.style.setProperty(\"margin\", \"0\", \"important\");\n        el.style.setProperty(\"padding\", \"0\", \"important\");\n      }\n    });\n  }\n\n  \/\/ ---------- Handle ----------\n  function getHandle() {\n    return document.getElementById(qid + \"~1~handle\");\n  }\n\n  function hideInitialHandle() {\n    if (started) return;\n\n    var handle = getHandle();\n    if (handle) {\n      handle.style.setProperty(\"opacity\", \"0\", \"important\");\n    }\n  }\n\n  function showHandle() {\n    var handle = getHandle();\n    if (handle) {\n      handle.style.setProperty(\"opacity\", \"1\", \"important\");\n      handle.style.setProperty(\"visibility\", \"visible\", \"important\");\n    }\n  }\n\n  \/\/ ---------- Value extraction ----------\n  function cleanSliderValue(v) {\n    if (v === null || v === undefined || v === \"\" || v === false || v === true) {\n      return \"\";\n    }\n\n    var n = Number(v);\n    if (!Number.isFinite(n)) {\n      return \"\";\n    }\n\n    return Math.max(0, Math.min(100, Math.round(n)));\n  }\n\n  function getSliderValue() {\n    var value;\n\n    var inputs = qc.querySelectorAll(\"input\");\n    for (var i = 0; i < inputs.length; i++) {\n      value = cleanSliderValue(inputs[i].value);\n      if (value !== \"\") {\n        return value;\n      }\n    }\n\n    var handle = getHandle();\n    if (handle) {\n      value = cleanSliderValue(handle.getAttribute(\"aria-valuenow\"));\n      if (value !== \"\") {\n        return value;\n      }\n\n      value = cleanSliderValue(handle.getAttribute(\"data-value\"));\n      if (value !== \"\") {\n        return value;\n      }\n\n      var left = handle.style.left || \"\";\n      if (left.indexOf(\"%\") > -1) {\n        value = cleanSliderValue(parseFloat(left));\n        if (value !== \"\") {\n          return value;\n        }\n      }\n    }\n\n    return \"\";\n  }\n\n  function updateReadout() {\n    var value = getSliderValue();\n    readout.innerHTML = readoutText(value);\n  }\n\n  \/\/ ---------- Interaction ----------\n  function revealAfterQualtricsUpdates() {\n    started = true;\n\n    setTimeout(function () {\n      showHandle();\n      updateReadout();\n    }, 150);\n\n    setTimeout(function () {\n      showHandle();\n      updateReadout();\n    }, 300);\n  }\n\n  qc.addEventListener(\"click\", revealAfterQualtricsUpdates);\n  qc.addEventListener(\"mouseup\", revealAfterQualtricsUpdates);\n  qc.addEventListener(\"touchend\", revealAfterQualtricsUpdates);\n  qc.addEventListener(\"keydown\", revealAfterQualtricsUpdates);\n  qc.addEventListener(\"change\", revealAfterQualtricsUpdates);\n  qc.addEventListener(\"input\", revealAfterQualtricsUpdates);\n\n  qc.addEventListener(\"mousemove\", function () {\n    if (started) {\n      setTimeout(updateReadout, 50);\n    }\n  });\n\n  qc.addEventListener(\"touchmove\", function () {\n    if (started) {\n      setTimeout(updateReadout, 50);\n    }\n  });\n\n  \/\/ ---------- Initial cleanup ----------\n  hideChoiceText();\n  hideInitialHandle();\n\n  setTimeout(function () {\n    hideChoiceText();\n    hideInitialHandle();\n  }, 100);\n\n  setTimeout(function () {\n    hideChoiceText();\n    hideInitialHandle();\n  }, 300);\n\n  setTimeout(function () {\n    hideChoiceText();\n    hideInitialHandle();\n  }, 700);\n\n  var observer = new MutationObserver(function () {\n    hideChoiceText();\n    hideInitialHandle();\n  });\n\n  observer.observe(qc, {\n    childList: true,\n    subtree: true,\n    attributes: true,\n    attributeFilter: [\"style\", \"class\"]\n  });\n});"}},{"SurveyID":"SV_07McTW65bCwKmGi","Element":"SQ","PrimaryAttribute":"QID76","SecondaryAttribute":"Remember: If you fully trust Evaluator A\u2019s report, your answer should be 40. If you think Evaluat.","TertiaryAttribute":null,"Payload":{"QuestionText":"Remember:<br><br>\nIf you <strong>fully trust <\/strong>Evaluator A\u2019s report, your answer should be <b>40<\/b>.<br>\n<br>\nIf you think Evaluator A\u2019s report is <strong>too high<\/strong>, your answer should be <strong>below 40.<\/strong><br>\n<br>\nIf you think Evaluator A\u2019s report is <strong>too low<\/strong>, the answer should be <strong>above 40.<\/strong>","DefaultChoices":false,"DataExportTag":"Q76","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Remember: If you fully trust Evaluator A\u2019s report, your answer should be 40. If you think Evaluat...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID76"}},{"SurveyID":"SV_07McTW65bCwKmGi","Element":"SQ","PrimaryAttribute":"QID77","SecondaryAttribute":"You have now been assigned a male candidate.\u00a0 Evaluator A is male.\u00a0With the information he receiv.","TertiaryAttribute":null,"Payload":{"QuestionText":"You have now been assigned a <span style=\"color:#2980b9;\"><b>male<\/b><\/span> <strong><span style=\"color:#2980b9;\">candidate<\/span><\/strong>.&nbsp;<br>\n<br>\n<strong>Evaluator A is <\/strong><span style=\"color:#2980b9;\"><b>male<\/b><\/span><strong>.<\/strong>&nbsp;With the information he received, he reported that this <span style=\"color:#2980b9;\"><b>male<\/b><\/span> <strong><span style=\"co