es() {\n    started = true;\n\n    setTimeout(function () {\n      showHandle();\n    }, 150);\n\n    setTimeout(function () {\n      showHandle();\n    }, 300);\n  }\n\n  qc.addEventListener(\"click\", revealAfterQualtricsUpdates);\n  qc.addEventListener(\"mouseup\", revealAfterQualtricsUpdates);\n  qc.addEventListener(\"touchend\", revealAfterQualtricsUpdates);\n  qc.addEventListener(\"keydown\", revealAfterQualtricsUpdates);\n  qc.addEventListener(\"change\", revealAfterQualtricsUpdates);\n  qc.addEventListener(\"input\", revealAfterQualtricsUpdates);\n\n  hideInitialHandle();\n\n  setTimeout(hideInitialHandle, 100);\n  setTimeout(hideInitialHandle, 300);\n  setTimeout(hideInitialHandle, 700);\n\n  var observer = new MutationObserver(function () {\n    hideInitialHandle();\n  });\n\n  observer.observe(qc, {\n    childList: true,\n    subtree: true,\n    attributes: true,\n    attributeFilter: [\"style\", \"class\"]\n  });\n});"}},{"SurveyID":"SV_07McTW65bCwKmGi","Element":"SQ","PrimaryAttribute":"QID93","SecondaryAttribute":"Remember: If you fully trust Evaluator A\u2019s report, your answer should be 40. If you think Evaluat.","TertiaryAttribute":null,"Payload":{"QuestionText":"Remember:\n<ul>\n\t<li>If you <strong>fully trust <\/strong>Evaluator A\u2019s report, your answer should be <b>40<\/b>.<\/li>\n\t<li>If you think Evaluator A\u2019s report is <strong>too high<\/strong>, your answer should be <strong>below 40.<\/strong><\/li>\n\t<li>If you think Evaluator A\u2019s report is <strong>too low<\/strong>, the answer should be <strong>above 40.<\/strong><\/li>\n<\/ul>","DefaultChoices":false,"DataExportTag":"Q74","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Remember: If you fully trust Evaluator A\u2019s report, your answer should be 40. If you think Evaluat...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Langu