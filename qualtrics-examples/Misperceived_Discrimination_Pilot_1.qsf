font-size: 15px !important;\n      line-height: 1.25 !important;\n    }\n\n    #${qid} .ToolTipBox,\n    #${qid} .sliderToolTipBox,\n    #${qid} .SliderValue,\n    #${qid} .q-slider-value {\n      visibility: hidden !important;\n      opacity: 0 !important;\n    }\n  `;\n  document.head.appendChild(style);\n\n  \/\/ ---------- Hide \"Click to write Choice 1\" ----------\n  function hideChoiceText() {\n    Array.from(qc.querySelectorAll(\"*\")).forEach(function (el) {\n      var txt = el.textContent.trim();\n      if (\n        el.children.length === 0 &&\n        (txt === \"Click to write Choice 1\" || txt === \"Choice 1\")\n      ) {\n        el.style.setProperty(\"display\", \"none\", \"important\");\n        el.style.setProperty(\"visibility\", \"hidden\", \"important\");\n        el.style.setProperty(\"height\", \"0\", \"important\");\n        el.style.setProperty(\"margin\", \"0\", \"important\");\n        el.style.setProperty(\"padding\", \"0\", \"important\");\n      }\n    });\n  }\n\n  \/\/ ---------- Handle ----------\n  function getHandle() {\n    return document.getElementById(qid + \"~1~handle\");\n  }\n\n  function hideInitialHandle() {\n    if (started) return;\n\n    var handle = getHandle();\n    if (handle) {\n      handle.style.setProperty(\"opacity\", \"0\", \"important\");\n    }\n  }\n\n  function showHandle() {\n    var handle = getHandle();\n    if (handle) {\n      handle.style.setProperty(\"opacity\", \"1\", \"important\");\n      handle.style.setProperty(\"visibility\", \"visible\", \"important\");\n    }\n  }\n\n  \/\/ ---------- Value extraction ----------\n  function cleanSliderValue(v) {\n    if (v === null || v === undefined || v === \"\" || v === false || v === true) {\n      return \"\";\n    }\n\n    var n = Number(v);\n    if (!Number.isFinite(n)) {\n      return \"\";\n    }\n\n    return Math.max(0, Math.min(100, Math.round(n)));\n  }\n\n  function getSliderValue() {\n    var value;\n\n    var inputs = qc.querySelectorAll(\"input\");\n    for (var i = 0; i < inputs.length; i++) {\n      value = cleanSliderValue(inputs[i].value);\n      if (value !== \"\") {\n        return value;\n      }\n    }\n\n    var handle = getHandle();\n    if (handle) {\n      value = cleanSliderValue(handle.getAttribute(\"aria-valuenow\"));\n      if (value !== \"\") {\n        return value;\n      }\n\n      value = cleanSliderValue(handle.getAttribute(\"data-value\"));\n      if (value !== \"\") {\n        return value;\n      }\n\n      var left = handle.style.left || \"\";\n      if (left.indexOf(\"%\") > -1) {\n        value = cleanSliderValue(parseFloat(left));\n        if (value !== \"\") {\n          return value;\n        }\n      }\n    }\n\n    return \"\";\n  }\n\n  function updateReadout() {\n    var value = getSliderValue();\n    readout.innerHTML = readoutText(value);\n  }\n\n  \/\/ ---------- Interaction ----------\n  function revealAfterQualtricsUpdates() {\n    started = true;\n\n    setTimeout(function () {\n      showHandle();\n      updateReadout();\n    }, 150);\n\n    setTimeout(function () {\n      showHandle();\n      updateReadout();\n    }, 300);\n  }\n\n  qc.addEventListener(\"click\", revealAfterQualtricsUpdates);\n  qc.addEventListener(\"mouseup\", revealAfterQualtricsUpdates);\n  qc.addEventListener(\"touchend\", revealAfterQualtricsUpdates);\n  qc.addEventListener(\"keydown\", revealAfterQualtricsUpdates);\n  qc.addEventListener(\"change\", revealAfterQualtricsUpdates);\n  qc.addEventListener(\"input\", revealAfterQualtricsUpdates);\n\n  qc.addEventListener(\"mousemove\", function () {\n    if (started) {\n      setTimeout(updateReadout, 50);\n    }\n  });\n\n  qc.addEventListener(\"touchmove\", function () {\n    if (started) {\n      setTimeout(updateReadout, 50);\n    }\n  });\n\n  \/\/ ---------- Initial cleanup ----------\n  hideChoiceText();\n  hideInitialHandle();\n\n  setTimeout(function () {\n    hideChoiceText();\n    hideInitialHandle();\n  }, 100);\n\n  setTimeout(function () {\n    hideChoiceText();\n    hideInitialHandle();\n  }, 300);\n\n  setTimeout(function () {\n    hideChoiceText();\n    hideInitialHandle();\n  }, 700);\n\n  var observer = new MutationObserver(function () {\n    hideChoiceText();\n    hideInitialHandle();\n  });\n\n  observer.observe(qc, {\n    childList: true,\n    subtree: true,\n    attributes: true,\n    attributeFilter: [\"style\", \"class\"]\n  });\n});"}},{"SurveyID":"SV_07McTW65bCwKmGi","Element":"SQ","PrimaryAttribute":"QID78","SecondaryAttribute":"Remember: If you fully trust Evaluator A\u2019s report, your answer should be 40. If you think Evaluat.","TertiaryAttribute":null,"Payload":{"QuestionText":"Remember:<br><br>\nIf you <strong>fully trust <\/strong>Evaluator A\u2019s report, your answer should be <b>40<\/b>.<br>\n<br>\nIf you think Evaluator A\u2019s report is <strong>too high<\/strong>, your answer should be <strong>below 40.<\/strong><br>\n<br>\nIf you think Evaluator A\u2019s report is <strong>too low<\/strong>, the answer should be <strong>above 40.<\/strong>","DefaultChoices":false,"DataExportTag":"Q78","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Remember: If you fully trust Evaluator A\u2019s report, your answer should be 40. If you think Evaluat...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID78"}},{"SurveyID":"SV_07McTW65bCwKmGi","Element":"SQ","PrimaryAttribute":"QID79","SecondaryAttribute":"Do you have any feedback? Was anything unclear or confusing? Thanks!","TertiaryAttribute":null,"Payload":{"QuestionText":"Do you have any feedback? Was anything unclear or confusing? Thanks!","DefaultChoices":false,"DataExportTag":"Q60","QuestionID":"QID79","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Do you have any feedback? Was anything unclear or confusing? Thanks!","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"}}},{"SurveyID":"SV_07McTW65bCwKmGi","Element":"SQ","PrimaryAttribute":"QID8","SecondaryAttribute":"The candidates who took the ASVAB cognitive test are other participants on Prolific.\u00a0The candidat..","TertiaryAttribute":null,"Payload":{"QuestionText":"The candidates who took the ASVAB cognitive test are other participants on Prolific.&nbsp;The candidate pool contains equal numbers of male and female candidates.<br>\n<br>\nBefore seeing any individual information about a specific candidate, we would like to know <strong>your best guess about how male and female candidates performed.&nbsp;<\/strong><br>\n<br>\nPlease answer each question as a percent chance from 0 to 100.<br>","DataExportTag":"own_beliefs_intro","QuestionID":"QID8","QuestionType":"DB","Selector":"TB","QuestionDescription":"The candidates who took the ASVAB cognitive test are other participants on Prolific.\u00a0The candidat...","Validation":{"Settings":{"Type":"None"}},"Language":[],"DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"ChoiceOrder":[],"NextChoiceId":1,"NextAnswerId":1}},{"SurveyID":"SV_07McTW65bCwKmGi","Element":"SQ","PrimaryAttribute":"QID80","SecondaryAttribute":"Remember: Based on their test performance, candidates are classified as either above the median o...","TertiaryAttribute":null,"Payload":{"QuestionText":"Remember:\n<ul>\n\t<li>Based on their test performance, candidates are classified as either above the median or not above the median.<\/li>\n\t<li>A candidate is above the median if they performed better than at least half of the candidates in the pool.<\/li>\n\t<li>A response of 0 means you think there is a 0% chance the candidate scored above the median.<\/li>\n\t<li>A response of 50 means you think the candidate is equally likely to have scored above or below the median.<\/li>\n\t<li>A response of 100 means you think there is a 100% chance the candidate scored above the median.<\/li>\n\t<li>One of your prediction questions will be randomly selected for bonus payment. You earn more when your prediction is closer to the average answer given by other participants in this study.<\/li>\n<\/ul>","DefaultChoices":false,"DataExportTag":"Q61","QuestionID":"QID80","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Remember: Based on their test performance, candidates are classified as either above the median o...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1}},{"SurveyID":"SV_07McTW65bCwKmGi","Element":"SQ","PrimaryAttribute":"QID81","SecondaryAttribute":"Remember: Based on their test performance, candidates are classified as either above the median o...","TertiaryAttribute":null,"Payload":{"QuestionText":"Remember:\n<ul>\n\t<li>Based on their test performance, candidates are classified as either above the median or not above the median.<\/li>\n\t<li>A candidate is above the median if they performed better than at least half of the candidates in the pool.<\/li>\n\t<li>A response of 0 means you think there is a 0% chance the candidate scored above the median.<\/li>\n\t<li>A response of 50 means you think the candidate is equally likely to have scored above or below the median.<\/li>\n\t<li>A response of 100 means you think there is a 100% chance the candidate scored above the median.<\/li>\n\t<li>One of your prediction questions will be randomly selected for bonus payment. You earn more when your prediction is closer to the average answer given by other participants in this study.<\/li>\n<\/ul>","DefaultChoices":fal